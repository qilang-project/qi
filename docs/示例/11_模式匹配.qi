// 模式匹配示例
包 主程序;

// 匹配是「语句」，不是「表达式」——不能写 `变量 x = 匹配 ...`。
// 编译器把它从表达式位置移了出去：`匹配 x {...}` 出现在语句开头时
// 与 `表达式;` 有归约冲突，而匹配本来也从不产生值。
// 要取值就在分支里 `返回`，或给一个提前声明的变量赋值。

枚举 危险等级 {
    未知,               // 兜底：分不清时落在这一格
    温和,
    危险(字符串)         // 变体可以带一个「附件」：为什么危险
}

// 分支里直接 返回：匹配不给值，但每条分支自己可以结束函数
函数 说等级(等级: 危险等级): 字符串 {
    匹配 等级 {
        未知 => { 返回 "说不好"; }
        温和 => { 返回 "温和，可以摸摸头"; }
        危险(理由) => { 返回 "危险！因为 " + 理由; }   // 括号里把附件取出来
    }
}

函数 入口() {
    打印("=== 模式匹配示例 ===");

    // ① 匹配整数字面量，`_` 是兜底的通配符
    变量 n: 整数 = 2;
    打印("匹配 2:");
    匹配 n {
        1 => { 打印("一"); }
        2 => { 打印("二"); }
        3 => { 打印("三"); }
        _ => { 打印("其他"); }
    }

    变量 m: 整数 = 5;
    打印("匹配 5:");
    匹配 m {
        1 => { 打印("一"); }
        2 => { 打印("二"); }
        3 => { 打印("三"); }
        _ => { 打印("其他"); }
    }

    // ② 匹配枚举：变体用 `类型.变体` 构造
    打印("");
    打印(说等级(危险等级.温和));
    打印(说等级(危险等级.危险("牙太尖了")));
    打印(说等级(危险等级.未知));

    // ③ 想「拿到结果」就先声明变量，在分支里赋值
    变量 名字: 字符串 = "";
    匹配 n {
        1 => { 名字 = "一"; }
        2 => { 名字 = "二"; }
        _ => { 名字 = "其他"; }
    }
    打印("取出的结果: " + 名字);

    打印("模式匹配完成");
}
