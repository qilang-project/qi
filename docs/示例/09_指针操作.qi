// 指针操作示例
包 主程序;

// qi 里没有 `取地址` / `解引用`——这两个词只是词法器里的保留字，
// 语法层没有对应规则，写了会直接报「意外的标记」。
// 语言不提供对普通变量取地址：变量归 qi 管，生命周期不外借。
//
// `指针` 是有的，但它的身份是**跨语言边界的不透明句柄**：
// 从 C 那边拿到，原样传回 C 那边，中间不解引用。
// 谁分配，谁释放——这是与 C 世界之间的契约。

外部 "c" {
    函数 malloc(字节数: 整数): 指针;
    函数 free(句柄: 指针): 空;
    函数 strlen(s: 字符串): 整数;
}

函数 入口() {
    打印("=== 指针（FFI 句柄）示例 ===");

    // ① 普通值就是普通值，不需要也拿不到地址
    变量 数值: 整数 = 42;
    打印("原始值:");
    打印(数值);

    // ② 指针只从边界那头来
    变量 缓冲: 指针 = malloc(64);
    打印("malloc(64) 已拿到句柄");

    // 句柄在 qi 这边是不透明的：只能传递，不能解引用。
    // 想读写这块内存，就把句柄交回给 C 那边的函数去做。

    // ③ 谁分配，谁释放
    free(缓冲);
    打印("free 已归还");

    // ④ 边界那头的世界观也一并借来了：strlen 数的是 UTF-8 字节，不是字符
    打印("strlen(\"你好\") 的字节数:");
    打印(strlen("你好"));

    打印("=== 指针示例完 ===");
}
