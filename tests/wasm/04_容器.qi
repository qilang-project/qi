// 列表 / 哈希表 / 字节切片 —— 句柄型容器在 wasm32 上的行为
//
// wasm32 指针是 4 字节，而这些容器的句柄走注册表 i64/ptr 通道。2026-09 接 wasm
// 时正是这里翻出两个老 bug（数组槽按元素类型 GEP、i32 句柄按 i64 声明）。
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.列表 作为 表列;
导入 标准库.哈希表 作为 表;
导入 标准库.字节切片 作为 字节;

函数 入口() {
    变量 名单: 整数 = 表列::创建字符串列表();
    表列::添加字符串(名单, "甲");
    表列::添加字符串(名单, "乙");
    表列::添加字符串(名单, "丙");
    IO.打印行("列表 " + 表列::字符串列表大小(名单) + " 项，第二个是 "
        + 表列::获取字符串(名单, 1));
    表列::删除列表(名单);

    变量 表值: 整数 = 表::创建整数表();
    表::设置整数(表值, "甲", 1);
    表::设置整数(表值, "乙", 22);
    IO.打印行("哈希表 甲=" + 表::获取整数(表值, "甲")
        + " 乙=" + 表::获取整数(表值, "乙")
        + " 有丙=" + 表::包含键(表值, "丙"));
    表::释放表(表值);

    // 带 NUL 和高位字节 —— 字符串通道会糟蹋它，必须走字节通道
    变量 片: 整数 = 字节::创建();
    字节::追加字节(片, 137);
    字节::追加字符串(片, "PNG");
    字节::追加字节(片, 0);
    IO.打印行("字节切片 " + 字节::长度(片) + " 字节 " + 字节::转十六进制(片));
    字节::释放切片(片);
}
