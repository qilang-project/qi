// wasm 回归：字符串模块（UTF-8 中文切分、查找、替换、分割、大小写）
包 主程序;

导入 标准库.字符串;
导入 标准库.列表 作为 表列;

函数 入口() {
    变量 s: 字符串 = "奇语，Qi Language，成都出品";
    打印行("字节 " + 字符串::字节长度(s) + " 字符 " + 字符串::字符数量(s));
    打印行("找 Qi 在 " + 字符串::查找(s, "Qi"));
    打印行("字符子串 " + 字符串::字符子串(s, 0, 2));
    打印行("替换 " + 字符串::替换(s, "成都", "蓉城"));
    打印行("大写 " + 字符串::转大写("qi lang") + " 小写 " + 字符串::转小写("QI LANG"));
    打印行("开始于奇 " + 字符串::开始于(s, "奇") + " 结束于品 " + 字符串::结束于(s, "品"));
    打印行("去空白[" + 字符串::去空白("  两边  ") + "]");
    变量 段: 整数 = 字符串::分割(s, "，");
    打印行("分了 " + 表列::字符串列表大小(段) + " 段，第二段 " + 表列::获取字符串(段, 1));
    表列::删除列表(段);
    变量 拼: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < 5) {
        拼 = 拼 + "第" + i + "轮;";
        i = i + 1;
    }
    打印行(拼);
    打印行("等于 " + 字符串::等于("a", "a") + " " + 字符串::等于("a", "b"));
    打印行("转整数 " + 字符串转整数("12345") + " 加一 " + (字符串转整数("99") + 1));
}
