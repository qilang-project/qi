// 时间与随机 —— 值本身两边必然不同，所以只断言**范围**，不打印具体值。
// 这类模块最容易在移植时被漏掉（返回 0 也"能跑"），范围断言至少能抓住那个。
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.时间;
导入 标准库.随机 作为 随;

函数 入口() {
    // 2026 年的秒数远大于 2020-01-01 的 1577836800
    IO.打印行("时间在动 " + (时间.现在() > 1577836800));
    IO.打印行("毫秒比秒大 " + (时间.现在毫秒() > 时间.现在()));

    变量 落在范围内: 整数 = 1;
    变量 i: 整数 = 0;
    当 (i < 50) {
        变量 点: 整数 = 随.生成整数(1, 6);
        如果 (点 < 1 || 点 > 6) { 落在范围内 = 0; }
        i = i + 1;
    }
    IO.打印行("随机五十次都在 1..6 " + 落在范围内);
}
