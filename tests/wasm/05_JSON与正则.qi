// JSON 编解码往返 + 正则 —— 两个纯计算模块，wasm 与原生必须逐字一致
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.JSON 作为 J;
导入 标准库.正则 作为 正;

函数 入口() {
    变量 对象: 整数 = J.解码("{\"名字\":\"小奇\",\"岁数\":7,\"在读\":true}");
    IO.打印行("JSON 名字=" + J.获取字符串(对象, "名字")
        + " 岁数=" + J.获取整数(对象, "岁数"));

    变量 新的: 整数 = J.创建对象();
    J.设置字符串(新的, "城市", "成都");
    J.设置整数(新的, "编号", 42);
    IO.打印行("JSON 回文 " + J.转字符串(新的));
    J.删除(新的);
    J.删除(对象);

    IO.打印行("正则 匹配=" + 正.是否匹配("^奇[a-z]+$", "奇lang")
        + " 不匹配=" + 正.是否匹配("^\\d+$", "abc"));
    IO.打印行("正则 替换 " + 正.全部替换("[0-9]+", "一二3四5六", "#"));
}
