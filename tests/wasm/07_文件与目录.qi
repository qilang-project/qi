// WASI 沙箱里的文件与目录 —— wasmtime 只授权 --dir .，所以全部在本目录下的
// 临时子目录里做完再删干净（这套测试会反复跑，留下残渣会让后面的断言飘）。
//
// 列出目录 2026-09 起返回字符串列表句柄：打不开回 -1，空目录回空表。
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.操作系统 作为 系统;
导入 标准库.列表 作为 表列;
导入 标准库.路径 作为 路;
导入 标准库.字符串;

变量 窝: 字符串 = "临时_文件测试";

函数 入口() {
    IO.创建目录(窝);
    IO.写入文件(窝 + "/甲.txt", "第一行");
    IO.追加文件(窝 + "/甲.txt", "\n第二行");
    IO.写入文件(窝 + "/乙.md", "# 标题");

    IO.打印行("读回 " + IO.读取文件(窝 + "/甲.txt"));
    IO.打印行("存在 " + IO.文件存在(窝 + "/乙.md")
        + " 不存在 " + IO.文件存在(窝 + "/没有.txt"));

    变量 名表: 整数 = 系统.列出目录(窝);
    IO.打印行("目录里 " + 表列::字符串列表大小(名表) + " 项");
    表列::删除列表(名表);

    IO.打印行("打不开的目录 " + 系统.列出目录("没有这个目录"));

    IO.打印行("路径 " + 路.连接("甲", "乙.txt") + " 扩展名 " + 路.扩展名("乙.txt"));

    IO.删除文件(窝 + "/甲.txt");
    IO.删除文件(窝 + "/乙.md");
    IO.删除目录(窝);
    IO.打印行("清理后还在吗 " + IO.文件存在(窝));
}
