// wasm 的 HTTP 走宿主导入（qi_host），原生走 reqwest。同一个程序两边跑，
// 输出必须一致。服务器由 wasm演示/试_http.mjs 起在本地 41573。
//   /big 回 150000 字节 —— 超过 wasm 侧 64KB 的首块缓冲，逼出「宿主报长度、
//   wasm 扩容重来」那条路；默认缓冲够用时这条路永远不会被走到。
//   请求 回的是 {"status","headers","body"} 信封；headers 里有 date 这种每次
//   都变的，所以只挑 status / content-type / body 三样打印。
包 主程序;
导入 标准库.输入输出 作为 IO;
导入 标准库.HTTP 作为 H;
导入 标准库.字符串;
导入 标准库.JSON 作为 J;
函数 入口() {
    变量 基址: 字符串 = "http://127.0.0.1:41573";
    IO.打印行("GET  " + H.获取(基址 + "/hello"));
    IO.打印行("POST " + H.发送(基址 + "/submit", "正文内容"));
    IO.打印行("状态码 " + H.获取状态码(基址 + "/status"));
    IO.打印行("HEAD " + H.请求头(基址 + "/head"));
    变量 大: 字符串 = H.获取(基址 + "/big");
    IO.打印行("大响应 " + 字符串::字节长度(大) + " 字节");

    变量 信封: 字符串 = H.请求("PUT", 基址 + "/put", "{\"X-Trace\":\"abc\"}", "改");
    变量 对象: 整数 = J.解码(信封);
    如果 (对象 <= 0) { IO.打印行("请求 信封解析失败: " + 信封); 返回; }
    变量 头: 整数 = J.获取对象(对象, "headers");
    IO.打印行("请求 status=" + J.获取整数(对象, "status")
        + " content-type=" + J.获取字符串(头, "content-type")
        + " body=" + J.获取字符串(对象, "body"));
    J.删除(对象);
}
