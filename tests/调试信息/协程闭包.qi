// 协程体 / 闭包体的调试信息验收样本 —— 这两种「编译器合成出来的函数」
// 以前没有 DISubprogram，断点根本设不进去。
包 主程序;

// 返回 未来<T> 且含 等待 → 走 llvm.coro 状态机。CoroSplit 会把它拆成
// ramp / .resume / .destroy / .cleanup 四个 LLVM 函数，行号表得跟着走。
函数 慢加(甲: 整数): 未来<整数> {
    变量 中途: 整数 = 甲 + 1;
    等待 睡眠(1);
    变量 答数: 整数 = 中途 + 10;
    返回 答数;
}

函数 外层(基数: 整数): 整数 {
    变量 回调: 函数(整数): 整数 = 闭包(增量: 整数): 整数 {
        变量 局部和: 整数 = 基数 + 增量;
        返回 局部和;
    };
    返回 回调(5);
}

函数 入口() {
    打印行(外层(100));
    变量 未来值 = 慢加(7);
    打印行(等待 未来值);
}
