// 复合类型的调试信息验收样本：结构体 / 嵌套结构体 / 自引用结构体 / 数组 / 两种枚举。
// 断点打在 查看() 里的 `返回 岁数;` 那一行，那时五种复合值都在作用域里活着。
包 主程序;

// 无载荷枚举 —— DWARF 里是 DW_TAG_enumeration_type，lldb 直接打变体名而不是 1
枚举 颜色 { 红, 绿, 蓝 }

// 带载荷枚举 —— 装箱：槽0 = 标记，槽1.. = 载荷位模式
枚举 快信 { 空信, 短话(字符串), 数字(整数) }

结构体 住处 {
    城市: 字符串,
    邮编: 整数
}

结构体 学生 {
    名字: 字符串,
    年龄: 整数,
    分数: 浮点数,
    住址: 住处
}

// 自引用：字段类型就是自身。DIType 建到这里最容易无限递归 —— 限深展开靠这条测。
结构体 车厢 {
    编号: 整数,
    下一节: 车厢
}

函数 查看(某学生: 学生, 车头: 车厢, 数字们: 数组<整数>, 某色: 颜色, 某信: 快信): 整数 {
    变量 岁数: 整数 = 某学生.年龄;
    返回 岁数;
}

函数 入口() {
    变量 家: 住处 = 新建 住处 { 城市: "杭州", 邮编: 310000 };
    变量 小明: 学生 = 新建 学生 { 名字: "小明", 年龄: 18, 分数: 92.5, 住址: 家 };
    变量 尾节: 车厢 = 新建 车厢 { 编号: 3 };
    变量 中节: 车厢 = 新建 车厢 { 编号: 2, 下一节: 尾节 };
    变量 车头: 车厢 = 新建 车厢 { 编号: 1, 下一节: 中节 };
    变量 数字们: 数组<整数> = [10, 20, 30];
    变量 某色: 颜色 = 颜色.绿;
    变量 某信: 快信 = 快信.数字(42);
    打印行(查看(小明, 车头, 数字们, 某色, 某信));
}
