包 主程序;

函数 斐波那契(甲: 整数): 整数 {
    如果 甲 < 2 {
        返回 甲;
    }
    变量 左: 整数 = 斐波那契(甲 - 1);
    变量 右: 整数 = 斐波那契(甲 - 2);
    返回 左 + 右;
}

函数 累加(上限: 整数): 整数 {
    变量 合计: 整数 = 0;
    变量 序号: 整数 = 0;
    当 序号 < 上限 {
        合计 = 合计 + 斐波那契(序号);
        序号 = 序号 + 1;
    }
    返回 合计;
}

函数 入口() {
    变量 总和: 整数 = 累加(10);
    打印行(总和);
}
