// 响应里的缓存字段解析。四家的字段名完全不同，假服务器按 provider 各给一套。
导入 标准库.大模型;

函数 一家(标: 字符串, 提供商: 字符串, 模型: 字符串) {
    变量 s: 整数 = 大模型::创建会话("__端点__/v1", 模型, "sk-fake");
    大模型::设置配置(s, "provider", 提供商);
    打印行(标 + " 答=" + 大模型::对话(s, "问一句"));
    打印行(标 + " 用量=" + 大模型::用量(s));
    打印行(标 + " 缓存=" + 大模型::缓存用量(s));
    打印行(标 + " 命中率=" + 整数转字符串(大模型::上次缓存命中率(s)));
    打印行(标 + " 已用预算=" + 整数转字符串(大模型::已用预算(s)));
    大模型::关闭会话(s);
}

函数 入口() {
    一家("anthropic", "anthropic", "claude-test");
    一家("gemini", "gemini", "gemini-test");
    一家("openai", "openai", "gpt-test");
    一家("deepseek", "openai", "deepseek-chat");
}
