导入 标准库.大模型;
函数 一家(提供商: 字符串) {
    变量 s: 整数 = 大模型::创建会话("__端点__/v1", "m-x", "sk-fake");
    大模型::设置配置(s, "provider", 提供商);
    打印行(提供商 + " 看图=" + 大模型::对话图像(s, "这是什么", "https://ex.com/a.png"));
    打印行(提供商 + " 历史=" + 大模型::历史JSON(s));
    // 看过图之后追问 —— 历史里的数组 content 要能继续成形
    打印行(提供商 + " 追问=" + 大模型::对话(s, "再说说细节"));
    打印行(提供商 + " 历史2=" + 大模型::历史JSON(s));
    打印行(提供商 + " 用量=" + 大模型::用量(s));
}
函数 入口() {
    一家("openai"); 一家("anthropic"); 一家("gemini");
    打印行("坏句柄=" + 大模型::对话图像(99999, "x", "y"));
}
