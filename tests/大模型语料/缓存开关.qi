// 提示缓存开关**开着**时的 Anthropic 请求成形。qi 实现专用
// （Rust 那条路没有这个开关 —— 它是 qi 侧的请求成形特性）。
导入 标准库.大模型;

函数 入口() {
    // 有 system：静态断点落在 system 上（它排在 tools 之后，一并盖住 tools）
    变量 s: 整数 = 大模型::创建会话("__端点__/v1", "claude-test", "sk-fake");
    大模型::设置配置(s, "provider", "anthropic");
    大模型::设置配置(s, "system", "你是一个严谨的助手");
    大模型::设置配置(s, "提示缓存", "1");
    打印行("答1=" + 大模型::对话(s, "第一问"));
    打印行("答2=" + 大模型::对话(s, "第二问"));
    大模型::关闭会话(s);

    // 无 system、有工具：静态断点退到最后一个 tool 上
    变量 t: 整数 = 大模型::创建会话("__端点__/v1", "claude-test", "sk-fake");
    大模型::设置配置(t, "provider", "anthropic");
    大模型::设置配置(t, "提示缓存", "1");
    大模型::注册工具(t, "查天气", "查询某地天气", "{\"type\":\"object\",\"properties\":{\"城市\":{\"type\":\"string\"}}}");
    变量 消息: 字符串 = 大模型::工具对话(t, "北京天气如何");
    大模型::添加工具结果(t, 大模型::工具调用ID(消息), "查天气", "晴 25度");
    打印行("续=" + 大模型::继续工具对话(t));
    大模型::关闭会话(t);

    // 开关只对 anthropic 生效：openai / gemini 的请求体不该多出任何东西
    变量 o: 整数 = 大模型::创建会话("__端点__/v1", "gpt-test", "sk-fake");
    大模型::设置配置(o, "提示缓存", "1");
    打印行("openai=" + 大模型::对话(o, "问一句"));
    大模型::关闭会话(o);
}
