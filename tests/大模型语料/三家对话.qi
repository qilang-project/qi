导入 标准库.大模型;
函数 一家(提供商: 字符串, 模型: 字符串) {
    变量 s: 整数 = 大模型::创建会话("__端点__/v1", 模型, "sk-fake");
    大模型::设置配置(s, "provider", 提供商);
    大模型::设置配置(s, "system", "系统提示");
    大模型::设置配置(s, "temperature", "0.3");
    大模型::设置配置(s, "max_tokens", "777");
    打印行(提供商 + " 答=" + 大模型::对话(s, "问一句"));
    打印行(提供商 + " 用量=" + 大模型::用量(s) + " 历史=" + 整数转字符串(大模型::历史数量(s)));
    打印行(提供商 + " 再问=" + 大模型::对话(s, "第二问"));
    打印行(提供商 + " 历史JSON=" + 大模型::历史JSON(s));
}
函数 入口() {
    一家("openai", "gpt-x");
    一家("anthropic", "claude-x");
    一家("gemini", "gemini-x");
}
