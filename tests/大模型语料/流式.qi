导入 标准库.大模型;
函数 跑一轮(s: 整数, 提示: 字符串) {
    变量 f: 整数 = 大模型::流式对话(s, 提示);
    如果 (f <= 0) { 打印行("开流失败 " + 整数转字符串(f)); 返回; }
    变量 全: 字符串 = "";
    变量 n: 整数 = 0;
    当 (n < 100) {
        变量 片: 字符串 = 大模型::读取流(f);
        如果 (字符串::字节长度(片) == 0) { 跳出; }
        全 = 全 + "|" + 片;
        n = n + 1;
    }
    打印行("片序列=" + 全);
    大模型::关闭流(f);
}
函数 入口() {
    变量 s: 整数 = 大模型::创建会话("__端点__/v1", "m", "sk-fake");
    跑一轮(s, "第一问");
    打印行("历史1=" + 大模型::历史JSON(s));
    跑一轮(s, "第二问");
    打印行("历史2=" + 大模型::历史JSON(s));
    // 流式之后接非流式，历史要能接上
    打印行("非流式=" + 大模型::对话(s, "第三问"));
    打印行("历史3=" + 大模型::历史JSON(s));
    // 开了不读就关（半途关流）
    变量 g: 整数 = 大模型::流式对话(s, "半途");
    大模型::关闭流(g);
    打印行("半途后历史数=" + 整数转字符串(大模型::历史数量(s)));
    打印行("坏句柄读=[" + 大模型::读取流(99999) + "] 关=" + 整数转字符串(大模型::关闭流(99999)));
}
