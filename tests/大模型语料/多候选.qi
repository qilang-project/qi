导入 标准库.大模型;
函数 一家(提供商: 字符串) {
    变量 s: 整数 = 大模型::创建会话("__端点__/v1", "m-x", "sk-fake");
    大模型::设置配置(s, "provider", 提供商);
    打印行(提供商 + " 三候选=" + 大模型::对话多候选(s, "问", 3));
    打印行(提供商 + " 历史=" + 大模型::历史JSON(s));
    打印行(提供商 + " 用量=" + 大模型::用量(s));
    打印行(提供商 + " n为0=" + 大模型::对话多候选(s, "再问", 0));
}
函数 入口() {
    一家("openai"); 一家("anthropic"); 一家("gemini");
    打印行("坏句柄=" + 大模型::对话多候选(99999, "x", 2));
}
