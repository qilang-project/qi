// 越界 / 无工具调用时的访问器行为。
// Rust 版返回**空指针**，qi 侧拿到它之后整条 打印行 静默消失（没输出没报错）；
// qi 版返回空串。这里钉住 qi 版的行为 —— 见 llm_qi.rs 的说明。
导入 标准库.大模型;
函数 入口() {
    变量 纯文本: 字符串 = "{\"role\":\"assistant\",\"content\":\"没有工具\"}";
    打印行("越界ID=[" + 大模型::工具调用ID索引(纯文本, 9) + "]");
    打印行("越界参数=[" + 大模型::工具调用参数索引(纯文本, 3) + "]");
    打印行("无调用ID=[" + 大模型::工具调用ID(纯文本) + "]");
    打印行("无调用参数=[" + 大模型::工具调用参数(纯文本) + "]");
    打印行("坏JSON_ID=[" + 大模型::工具调用ID("不是json") + "]");
    打印行("数量=" + 整数转字符串(大模型::工具调用数量(纯文本)));
    打印行("收尾");
}
