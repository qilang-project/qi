导入 标准库.大模型;
函数 排空(f: 整数) : 字符串 {
    变量 全: 字符串 = "";
    变量 n: 整数 = 0;
    当 (n < 50) {
        变量 片: 字符串 = 大模型::读取流(f);
        如果 (字符串::字节长度(片) == 0) { 跳出; }
        全 = 全 + "|" + 片;
        n = n + 1;
    }
    返回 全;
}
函数 入口() {
    变量 s: 整数 = 大模型::创建会话("__端点__/v1", "m", "sk-fake");
    大模型::注册工具(s, "查天气", "查天气", "{\"type\":\"object\",\"properties\":{}}");

    变量 f: 整数 = 大模型::流式工具对话(s, "北京天气");
    打印行("片=" + 排空(f));
    变量 消息: 字符串 = 大模型::流取助手消息(f);
    打印行("助手消息=" + 消息);
    打印行("有调用=" + 整数转字符串(大模型::有工具调用(消息)));
    打印行("名称=" + 大模型::工具调用名称(s, 消息));
    打印行("参数=" + 大模型::工具调用参数(消息));
    大模型::关闭流(f);
    打印行("历史1=" + 大模型::历史JSON(s));

    大模型::添加工具结果(s, 大模型::工具调用ID(消息), "查天气", "晴");
    变量 g: 整数 = 大模型::流式继续工具对话(s);
    打印行("续片=" + 排空(g));
    打印行("续助手=" + 大模型::流取助手消息(g));
    大模型::关闭流(g);
    打印行("历史2=" + 大模型::历史JSON(s));
}
