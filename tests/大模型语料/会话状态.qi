导入 标准库.大模型;
导入 标准库.JSON;

函数 秀(标: 字符串, 会话: 整数) {
    打印行(标 + " 历史数=" + 整数转字符串(大模型::历史数量(会话))
        + " 用量=" + 大模型::用量(会话)
        + " 已用预算=" + 整数转字符串(大模型::已用预算(会话)));
    打印行("  历史JSON=" + 大模型::历史JSON(会话));
}

函数 入口() {
    变量 s: 整数 = 大模型::创建会话("__端点__/v1", "gpt-test", "sk-fake");
    秀("初始", s);
    打印行("答1=" + 大模型::对话(s, "你好"));
    秀("一轮后", s);
    打印行("答2=" + 大模型::对话(s, "再问一句"));
    秀("两轮后", s);

    // 系统提示 + 温度 + max_tokens 都改掉，看请求成形是否一致
    变量 t: 整数 = 大模型::创建会话("__端点__/v1", "gpt-test", "sk-fake");
    大模型::设置配置(t, "system", "你是一个严谨的助手");
    大模型::设置配置(t, "temperature", "0.15");
    大模型::设置配置(t, "max_tokens", "512");
    大模型::设置配置(t, "response_format", "json");
    打印行("答3=" + 大模型::对话(t, "带配置的问题"));
    秀("带配置", t);

    // 嵌入：只读会话，不该动历史和预算
    变量 e: 整数 = 大模型::创建会话("__端点__/v1", "emb-test", "sk-fake");
    变量 v: 数组<浮点数> = 大模型::嵌入(e, "一段文本");
    打印行("嵌入维数=" + 整数转字符串(v.长度));
    变量 i: 整数 = 0;
    当 (i < v.长度) { 打印行("  v[" + 整数转字符串(i) + "]=" + 浮点数转字符串(v[i])); i = i + 1; }
    秀("嵌入后", e);

    // 预算闸：设 5 token 上限，第一轮就该把它用超，第二轮必须被拒
    变量 b: 整数 = 大模型::创建会话("__端点__/v1", "gpt-test", "sk-fake");
    大模型::设置预算(b, 5);
    打印行("预算轮1=" + 大模型::对话(b, "第一问"));
    打印行("预算轮2=" + 大模型::对话(b, "第二问"));
    秀("预算后", b);

    // 无效句柄
    打印行("坏句柄=" + 大模型::对话(99999, "x"));
    变量 bad: 数组<浮点数> = 大模型::嵌入(99999, "x");
    打印行("坏句柄嵌入维数=" + 整数转字符串(bad.长度));
}
