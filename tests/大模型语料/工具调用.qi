导入 标准库.大模型;
函数 一家(提供商: 字符串) {
    变量 s: 整数 = 大模型::创建会话("__端点__/v1", "m-x", "sk-fake");
    大模型::设置配置(s, "provider", 提供商);
    大模型::注册工具(s, "查天气", "查询某地天气", "{\"type\":\"object\",\"properties\":{\"城市\":{\"type\":\"string\"}}}");

    变量 消息: 字符串 = 大模型::工具对话(s, "北京天气如何");
    打印行(提供商 + " 有调用=" + 整数转字符串(大模型::有工具调用(消息)));
    打印行(提供商 + " 数量=" + 整数转字符串(大模型::工具调用数量(消息)));
    打印行(提供商 + " ID=" + 大模型::工具调用ID(消息));
    打印行(提供商 + " 名称=" + 大模型::工具调用名称(s, 消息));
    打印行(提供商 + " 参数=" + 大模型::工具调用参数(消息));
    打印行(提供商 + " 名称索引0=" + 大模型::工具调用名称索引(s, 消息, 0));

    大模型::添加工具结果(s, 大模型::工具调用ID(消息), "查天气", "晴 25度");
    打印行(提供商 + " 续=" + 大模型::继续工具对话(s));
    打印行(提供商 + " 历史=" + 大模型::历史JSON(s));
    打印行(提供商 + " 用量=" + 大模型::用量(s));
}
函数 入口() {
    一家("openai"); 一家("anthropic"); 一家("gemini");
    打印行("无工具调用的消息=" + 整数转字符串(大模型::有工具调用("{\"role\":\"assistant\",\"content\":\"纯文本\"}")));
    打印行("坏JSON=" + 整数转字符串(大模型::有工具调用("不是json")));
}
