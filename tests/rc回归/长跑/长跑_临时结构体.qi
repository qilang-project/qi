// 长跑：热循环里反复创建 / 丢弃临时结构体（含字符串字段），只读一个字段。
// 修前每轮漏 2 个本体 + 1 条串，RSS 应当持续爬升；修后应当平坦。
// 不进回归套件（跑得久），只给 RSS 斜率采样用。
包 主程序;

类型 点 {
    横: 整数,
    纵: 整数,
}

类型 名片 {
    姓名: 字符串,
    工号: 整数,
}

函数 新点(v: 整数): 点 {
    返回 新建 点 { 横: v, 纵: v };
}

函数 新名片(v: 整数): 名片 {
    返回 新建 名片 { 姓名: "员工" + 整数转字符串(v), 工号: v };
}

函数 入口() {
    变量 累计: 整数 = 0;
    变量 i: 整数 = 0;
    当 i < 20000000 {
        累计 = 累计 + (新建 点 { 横: i, 纵: 1 }).横;
        累计 = 累计 + 新点(i).纵;
        累计 = 累计 + 字符串::字节长度(新名片(i % 100).姓名);
        i = i + 1;
    }
    打印行(累计);
}
