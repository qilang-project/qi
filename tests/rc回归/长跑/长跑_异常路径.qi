// 长跑：热循环里反复抛出 / 捕获，抛出方持有 RC 局部。
// 修前每次抛出漏一帧对象 + 每次捕获漏一条消息串；修后应当平坦。
包 主程序;

类型 点 {
    横: 整数,
    纵: 整数,
}

函数 可能抛(序号: 整数): 整数 {
    变量 p: 点 = 新建 点 { 横: 序号, 纵: 序号 };
    变量 名: 字符串 = "点" + 整数转字符串(序号 % 100);
    如果 序号 % 2 == 0 {
        抛出 "偶数不收";
    }
    返回 p.横 + 字符串::字节长度(名);
}

函数 入口() {
    变量 累计: 整数 = 0;
    变量 i: 整数 = 0;
    当 i < 4000000 {
        尝试 {
            累计 = 累计 + 可能抛(i);
        } 捕获 错误 {
            累计 = 累计 + 字符串::字节长度(错误);
        }
        i = i + 1;
    }
    打印行(累计);
}
