// 场景 09：闭包捕获结构体 —— env 持有一份，闭包归零时 dtor 级联释放捕获。
包 主程序;

类型 点 {
    横: 整数,
    纵: 整数,
}

函数 入口() {
    变量 累计: 整数 = 0;
    变量 i: 整数 = 0;
    当 i < 100 {
        变量 p: 点 = 新建 点 { 横: i, 纵: i * 2 };
        变量 取和: 函数(整数): 整数 = 闭包(加数: 整数): 整数 {
            返回 p.横 + p.纵 + 加数;
        };
        累计 = 累计 + 取和(1);
        i = i + 1;
    }
    打印行(累计);
}
