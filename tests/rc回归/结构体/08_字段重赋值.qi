// 场景 08：结构体字段重赋值（字符串字段 + 嵌套结构体字段）——
// 覆写前必须释放旧值，否则每次赋值泄漏一份。
包 主程序;

类型 点 {
    横: 整数,
    纵: 整数,
}

类型 记录 {
    标签: 字符串,
    位置: 点,
}

函数 入口() {
    变量 r: 记录 = 新建 记录 { 标签: "初" + "值", 位置: 新建 点 { 横: 0, 纵: 0 } };
    变量 i: 整数 = 0;
    当 i < 100 {
        r.标签 = "第" + 整数转字符串(i);              // 旧串必须释放
        r.位置 = 新建 点 { 横: i, 纵: i };            // 旧点必须释放
        i = i + 1;
    }
    打印行(字符串::字节长度(r.标签) + r.位置.横);
}
