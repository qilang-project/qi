// 场景 10：抛出跨函数帧（setjmp/longjmp）—— 被跳过的那一帧里的 RC 局部。
// 不绑定 错误 变量，隔离掉「捕获变量槽」那条（见 13）。
包 主程序;

类型 点 {
    横: 整数,
    纵: 整数,
}

函数 可能抛(序号: 整数): 整数 {
    变量 p: 点 = 新建 点 { 横: 序号, 纵: 序号 };
    如果 序号 % 2 == 0 {
        抛出 "偶数不收";
    }
    返回 p.横 + p.纵;
}

函数 入口() {
    变量 累计: 整数 = 0;
    变量 i: 整数 = 0;
    当 i < 100 {
        尝试 {
            累计 = 累计 + 可能抛(i);
        } 捕获 {
            累计 = 累计 + 1;
        }
        i = i + 1;
    }
    打印行(累计);
}
