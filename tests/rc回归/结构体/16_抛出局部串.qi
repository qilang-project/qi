// 场景 16：抛出的消息本身就是本帧的一个 RC 局部串。
// 「抛出前释放局部」若先释放再把指针交给运行时，读的就是已释放内存 ——
// 消息必须先 stage（拷进 LAST_ERROR）再释放局部。输出错乱即是踩了。
包 主程序;

类型 点 {
    横: 整数,
    纵: 整数,
}

函数 抛局部串(序号: 整数): 整数 {
    变量 p: 点 = 新建 点 { 横: 序号, 纵: 序号 };
    变量 消息: 字符串 = "错误码" + 整数转字符串(序号 % 10);
    如果 序号 % 2 == 0 {
        抛出 消息;
    }
    返回 p.横;
}

函数 入口() {
    变量 累计: 整数 = 0;
    变量 i: 整数 = 0;
    当 i < 100 {
        尝试 {
            累计 = 累计 + 抛局部串(i);
        } 捕获 错误 {
            累计 = 累计 + 字符串::字节长度(错误);
        }
        i = i + 1;
    }
    打印行(累计);
}
