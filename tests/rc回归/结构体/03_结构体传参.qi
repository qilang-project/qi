// 场景 03：结构体传参（借用语义：被调方序言 retain、出口 release）。
// 含两种实参：BORROWED 变量、OWNED 内联字面量临时。
包 主程序;

类型 点 {
    横: 整数,
    纵: 整数,
}

函数 求和(p: 点): 整数 {
    返回 p.横 + p.纵;
}

函数 入口() {
    变量 累计: 整数 = 0;
    变量 基: 点 = 新建 点 { 横: 1, 纵: 2 };
    变量 i: 整数 = 0;
    当 i < 100 {
        累计 = 累计 + 求和(基);                          // BORROWED 实参
        累计 = 累计 + 求和(新建 点 { 横: i, 纵: i });     // OWNED 临时实参
        i = i + 1;
    }
    打印行(累计);
}
