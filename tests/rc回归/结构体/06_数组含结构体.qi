// 场景 06：数组<结构体> —— Round E2 说元素已做类型化释放，这里验证。
包 主程序;

类型 点 {
    横: 整数,
    纵: 整数,
}

函数 造数组(序号: 整数): 整数 {
    变量 群: 数组<点> = [新建 点 { 横: 序号, 纵: 1 }, 新建 点 { 横: 序号, 纵: 2 }];
    返回 群[0].纵 + 群[1].纵;
}

函数 入口() {
    变量 累计: 整数 = 0;
    变量 i: 整数 = 0;
    当 i < 100 {
        累计 = 累计 + 造数组(i);
        i = i + 1;
    }
    打印行(累计);
}
