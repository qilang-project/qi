// 场景 07：结构体在 如果 / 当 分支块里创建（块作用域槽，出口统一释放）。
包 主程序;

类型 点 {
    横: 整数,
    纵: 整数,
}

函数 分支造(序号: 整数): 整数 {
    变量 累计: 整数 = 0;
    如果 序号 % 2 == 0 {
        变量 p: 点 = 新建 点 { 横: 序号, 纵: 1 };
        累计 = 累计 + p.横 + p.纵;
    } 否则 {
        变量 q: 点 = 新建 点 { 横: 0, 纵: 序号 };
        累计 = 累计 + q.横 + q.纵;
    }
    变量 j: 整数 = 0;
    当 j < 3 {
        变量 r: 点 = 新建 点 { 横: j, 纵: j };
        累计 = 累计 + r.横;
        j = j + 1;
    }
    返回 累计;
}

函数 入口() {
    变量 累计: 整数 = 0;
    变量 i: 整数 = 0;
    当 i < 100 {
        累计 = 累计 + 分支造(i);
        i = i + 1;
    }
    打印行(累计);
}
