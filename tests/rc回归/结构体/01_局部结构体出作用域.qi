// 场景 01：局部结构体创建后出作用域。
// 期望：函数出口 弧释放局部 释放该槽，退出时活跃对象=0。
包 主程序;

类型 点 {
    横: 整数,
    纵: 整数,
}

函数 造点(序号: 整数): 整数 {
    变量 p: 点 = 新建 点 { 横: 序号, 纵: 序号 * 2 };
    返回 p.横 + p.纵;
}

函数 入口() {
    变量 累计: 整数 = 0;
    变量 i: 整数 = 0;
    当 i < 100 {
        累计 = 累计 + 造点(i);
        i = i + 1;
    }
    打印行(累计);
}
