// 场景 05：结构体嵌套结构体 —— 外层归零时内层本体必须级联释放。
包 主程序;

类型 点 {
    横: 整数,
    纵: 整数,
}

类型 线段 {
    起: 点,
    止: 点,
}

函数 造线段(序号: 整数): 整数 {
    变量 甲: 点 = 新建 点 { 横: 序号, 纵: 0 };
    变量 乙: 点 = 新建 点 { 横: 0, 纵: 序号 };
    变量 l: 线段 = 新建 线段 { 起: 甲, 止: 乙 };
    返回 l.起.横 + l.止.纵;
}

函数 入口() {
    变量 累计: 整数 = 0;
    变量 i: 整数 = 0;
    当 i < 100 {
        累计 = 累计 + 造线段(i);
        i = i + 1;
    }
    打印行(累计);
}
