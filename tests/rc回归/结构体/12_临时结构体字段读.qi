// 场景 12：OWNED 临时结构体只用来读一个**标量**字段，本体随即被丢弃。
//   新建 点{...}.横 / 新点(i).纵 —— 临时本体谁释放？
包 主程序;

类型 点 {
    横: 整数,
    纵: 整数,
}

函数 新点(v: 整数): 点 {
    返回 新建 点 { 横: v, 纵: v };
}

函数 入口() {
    变量 累计: 整数 = 0;
    变量 i: 整数 = 0;
    当 i < 100 {
        累计 = 累计 + (新建 点 { 横: i, 纵: i }).横;   // 字面量临时读字段
        累计 = 累计 + 新点(i).纵;                       // 返回值临时读字段
        i = i + 1;
    }
    打印行(累计);
}
