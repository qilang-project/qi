// 场景 13：捕获变量 `捕获 错误` 在循环里反复绑定 —— qi_exc_message 每次
// 返回 rc=1 新串，槽覆写前必须释放旧值。抛出方无 RC 局部，隔离掉场景 10。
包 主程序;

函数 只抛(序号: 整数): 整数 {
    如果 序号 % 2 == 0 {
        抛出 "偶数不收";
    }
    返回 序号;
}

函数 入口() {
    变量 累计: 整数 = 0;
    变量 i: 整数 = 0;
    当 i < 100 {
        尝试 {
            累计 = 累计 + 只抛(i);
        } 捕获 错误 {
            累计 = 累计 + 字符串::字节长度(错误);
        }
        i = i + 1;
    }
    打印行(累计);
}
