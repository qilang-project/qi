// 场景 02：结构体作为函数返回值（返回约定 +1，调用方接手）。
// 期望：调用方局部槽出口释放，净额 0。
包 主程序;

类型 点 {
    横: 整数,
    纵: 整数,
}

函数 新点(序号: 整数): 点 {
    返回 新建 点 { 横: 序号, 纵: 序号 * 2 };
}

函数 入口() {
    变量 累计: 整数 = 0;
    变量 i: 整数 = 0;
    当 i < 100 {
        变量 p: 点 = 新点(i);
        累计 = 累计 + p.横 + p.纵;
        i = i + 1;
    }
    打印行(累计);
}
