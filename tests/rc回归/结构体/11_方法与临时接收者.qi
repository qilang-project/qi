// 场景 11：结构体方法调用 —— 接收者是 OWNED 临时（函数返回值 / 链式中间值）时，
// 那份 +1 由谁释放。
包 主程序;

类型 计数器 {
    整数 值;
}

函数 (自身 计数器) 读() : 整数 {
    返回 自身.值;
}

函数 (自身 计数器) 加一() : 计数器 {
    返回 新建 计数器 { 值: 自身.值 + 1 };
}

函数 新计数器(v: 整数): 计数器 {
    返回 新建 计数器 { 值: v };
}

函数 入口() {
    变量 累计: 整数 = 0;
    变量 i: 整数 = 0;
    当 i < 100 {
        累计 = 累计 + 新计数器(i).读();        // OWNED 返回值当接收者
        变量 c: 计数器 = 新计数器(i).加一();   // 链式：中间临时
        累计 = 累计 + c.读();
        i = i + 1;
    }
    打印行(累计);
}
