// 场景 14：OWNED 临时结构体读一个 **RC 字段**（字符串 / 嵌套结构体）。
// 比场景 12 危险：本体一释放，刚 load 出来的字段指针就可能悬垂 ——
// 判定「能不能释放临时本体」的分水岭。
包 主程序;

类型 名片 {
    姓名: 字符串,
    工号: 整数,
}

函数 新名片(v: 整数): 名片 {
    返回 新建 名片 { 姓名: "员工" + 整数转字符串(v), 工号: v };
}

函数 入口() {
    变量 累计: 整数 = 0;
    变量 i: 整数 = 0;
    当 i < 100 {
        累计 = 累计 + 字符串::字节长度(新名片(i).姓名);
        i = i + 1;
    }
    打印行(累计);
}
