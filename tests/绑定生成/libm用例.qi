// libm 验收：math.h 是最大的系统头文件之一（几百个函数、一堆宏和 __builtin），
// 生成完能编能跑、cos(0)=1.0，就说明降噪与类型映射在真实系统头文件上站得住。

导入 libm绑定;

函数 入口() {
    打印行("cos(0)=" + cos(0.0));
    打印行("sqrt(16)=" + sqrt(16.0));
    打印行("pow(2,10)=" + pow(2.0, 10.0));
    如果 (cos(0.0) == 1.0) {
        打印行("cos(0) 等于 1.0: 是");
    } 否则 {
        打印行("cos(0) 等于 1.0: 否");
    }
}
