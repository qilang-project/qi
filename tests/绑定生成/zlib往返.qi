// zlib 端到端验收：用 `qi 绑定` 生成的 zlib绑定.qi 真压真解，比对往返一致。
//
// 这里刻意不碰生成文件一个字 —— 它由断言.sh 现场生成、`qi check` 过一遍再被本文件
// `导入`。能跑通就说明：类型映射对得上 C ABI、库名 "z" 一路传到了链接命令、
// 指针型出参（uLongf *destLen）用 标准库.内存 的裸读写原语能正常读回。
//
// 缓冲区里放的是 8 字节整数而不是字节：标准库.内存 目前只有 读整数/写整数
// 两个原语（见 module_registry.rs 的 register_mem_module），按 8 字节一格来
// 正好整除，也照样是 zlib 眼里的一段字节流。

导入 标准库.内存;
导入 zlib绑定;

// malloc/free 不在 zlib.h 里，自己声明一份（这几行就是「手写外部块」的样子，
// 拿来跟生成出来的那 79 行对照）。
外部 "c" {
    函数 malloc(字节数: 整数): 指针;
    函数 free(句柄: 指针): 空;
    函数 strlen(s: 字符串): 整数;
}

// 造一段有规律、可复算的数据：第 i 个 8 字节槽写 i*7+3。
函数 填充(基址: 指针, 词数: 整数) {
    变量 i: 整数 = 0;
    当 (i < 词数) {
        内存::写整数(基址, i * 8, i * 7 + 3);
        i = i + 1;
    }
}

// 逐槽比对，返回第一处不同的下标；全同返回 -1。
函数 首个差异(甲: 指针, 乙: 指针, 词数: 整数): 整数 {
    变量 i: 整数 = 0;
    当 (i < 词数) {
        如果 (内存::读整数(甲, i * 8) != 内存::读整数(乙, i * 8)) {
            返回 i;
        }
        i = i + 1;
    }
    返回 0 - 1;
}

函数 入口() {
    变量 词数: 整数 = 64;
    变量 原长: 整数 = 词数 * 8;

    // ── 1) compressBound：C 里返回 uLong(64 位)，不受 int 窄返回影响 ──
    变量 上界: 整数 = compressBound(原长);
    打印行("原长=" + 原长);
    打印行("上界=" + 上界);
    如果 (上界 > 原长) {
        打印行("上界大于原长: 是");
    } 否则 {
        打印行("上界大于原长: 否");
    }

    变量 原始: 指针 = malloc(原长);
    填充(原始, 词数);

    // ── 2) compress：destLen 是 uLongf* 出参，先写进上界，调用后读回真实长度 ──
    变量 压缩区: 指针 = malloc(上界);
    变量 压后长槽: 指针 = malloc(8);
    内存::写整数(压后长槽, 0, 上界);
    变量 码1: 整数 = compress(压缩区, 压后长槽, 原始, 原长);
    变量 压后长: 整数 = 内存::读整数(压后长槽, 0);
    打印行("compress 返回码=" + 码1);
    打印行("压后长=" + 压后长);

    // ── 3) uncompress 解回来 ──
    变量 还原区: 指针 = malloc(原长);
    变量 还原长槽: 指针 = malloc(8);
    内存::写整数(还原长槽, 0, 原长);
    变量 码2: 整数 = uncompress(还原区, 还原长槽, 压缩区, 压后长);
    变量 还原长: 整数 = 内存::读整数(还原长槽, 0);
    打印行("uncompress 返回码=" + 码2);
    打印行("还原长=" + 还原长);

    // ── 4) 往返一致 ──
    变量 差异位: 整数 = 首个差异(原始, 还原区, 词数);
    如果 (差异位 < 0 且 还原长 == 原长) {
        打印行("往返一致: 是");
    } 否则 {
        打印行("往返一致: 否（首个差异下标=" + 差异位 + "）");
    }

    // ── 5) 绑定里生成的常量真的能用（Z_OK / Z_BUF_ERROR 来自 #define）──
    如果 (码1 == Z_OK 且 码2 == Z_OK) {
        打印行("返回码都是 Z_OK: 是");
    } 否则 {
        打印行("返回码都是 Z_OK: 否");
    }
    打印行("Z_BEST_COMPRESSION=" + Z_BEST_COMPRESSION);

    // ── 6) char* 返回：zlibVersion 返回 const char*，调用点拷成 qi 堆串 ──
    变量 版本: 字符串 = zlibVersion();
    打印行("zlib 版本=" + 版本);
    如果 (strlen(版本) > 0) {
        打印行("版本非空: 是");
    } 否则 {
        打印行("版本非空: 否");
    }

    // ── 7) C 的 int 返回是负数错误码：喂垃圾数据，zlib 回 Z_DATA_ERROR = -3 ──
    // 这一条盯的是 `C整数`：生成的签名若写成 整数，-3 会读成 4294967293 那类大正数，
    // 「码 < 0」判负全线失效 —— 而 zlib 一半以上的函数都靠负数报错。
    变量 垃圾: 指针 = malloc(16);
    内存.写整数(垃圾, 0, 123456789);
    内存.写整数(垃圾, 8, 987654321);
    内存.写整数(还原长槽, 0, 64);
    变量 坏码: 整数 = uncompress(还原区, 还原长槽, 垃圾, 16);
    如果 (坏码 < 0) {
        打印行("坏数据返回负数错误码: 是");
    } 否则 {
        打印行("坏数据返回负数错误码: 否（读成了 " + 坏码 + "）");
    }
    free(垃圾);

    free(原始);
    free(压缩区);
    free(压后长槽);
    free(还原区);
    free(还原长槽);
    打印行("内存已释放，未崩溃");
}
