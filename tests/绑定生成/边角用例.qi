// 边角验收：调用由 bianjiao.h 生成的绑定，把「生成得对不对」变成「跑起来对不对」。
//
// 生成时用了 `--前缀 bj_`，所以 other_add 不在绑定里 —— 断言.sh 另有一条文本断言
// 盯着这点；这里只管能跑通的部分。

导入 标准库.内存;
导入 边角绑定;

外部 "c" {
    函数 malloc(字节数: 整数): 指针;
    函数 free(句柄: 指针): 空;
    函数 strlen(s: 字符串): 整数;
}

// C 回调槽 bj_reduce 的 step：顶层具名函数、无捕获，才拿得到裸函数指针。
函数 累加(累计: 整数, 元素: 整数): 整数 {
    返回 累计 + 元素;
}

// 同一个回调槽换一个函数就换一套规则 —— 验证传的确实是函数指针而不是常量。
函数 取最大(累计: 整数, 元素: 整数): 整数 {
    如果 (元素 > 累计) {
        返回 元素;
    }
    返回 累计;
}

函数 入口() {
    // ── 普通整数函数（C 返回 int，正数不受窄返回影响）──
    打印行("bj_add(2,3)=" + bj_add(2, 3));

    // ── 浮点 + 无名形参（生成时补成 arg1 / arg2）──
    打印行("bj_hypot(3,4)=" + bj_hypot(3.0, 4.0));

    // ── 函数指针参数：造一段 long 数组交给 C，由 C 回调 qi 函数 ──
    变量 个数: 整数 = 5;
    变量 数值区: 指针 = malloc(个数 * 8);
    内存::写整数(数值区, 0, 4);
    内存::写整数(数值区, 8, 11);
    内存::写整数(数值区, 16, 2);
    内存::写整数(数值区, 24, 30);
    内存::写整数(数值区, 32, 7);
    打印行("bj_reduce(累加)=" + bj_reduce(数值区, 个数, 累加));
    打印行("bj_reduce(取最大)=" + bj_reduce(数值区, 个数, 取最大));
    free(数值区);

    // ── struct* 当不透明句柄 + const char* 返回拷成 qi 堆串 ──
    bj_reset();
    变量 盒: 指针 = bj_box_new(14);
    打印行("bj_box_get=" + bj_box_get(盒));
    变量 名: 字符串 = bj_box_name(盒);
    打印行("bj_box_name=" + 名);
    打印行("bj_counter=" + bj_counter());
    bj_box_free(盒);

    // ── const char* 形参收 qi 串、非 const char* 形参当输出缓冲区（指针）──
    变量 缓冲: 指针 = malloc(64);
    变量 抄了: 整数 = bj_copy_name("hello-qi", 缓冲, 64);
    打印行("bj_copy_name 抄了=" + 抄了);
    free(缓冲);

    // ── 常量：#define 与 enum 都进来了 ──
    打印行("BJ_MAX=" + BJ_MAX);
    打印行("BJ_HEX=" + BJ_HEX);
    打印行("BJ_NEG=" + BJ_NEG);
    打印行("BJ_BIG=" + BJ_BIG);
    打印行("BJ_RED=" + BJ_RED);
    打印行("BJ_GREEN=" + BJ_GREEN);
    打印行("BJ_BLUE=" + BJ_BLUE);
    打印行("BJ_NEXT=" + BJ_NEXT);
}
