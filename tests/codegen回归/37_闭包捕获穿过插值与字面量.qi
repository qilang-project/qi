// 闭包捕获要能穿过所有带子表达式的节点，**尤其是插值串**。
//
// 捕获分析（闭包.rs 收集自由标识符）原来只认 17 种节点，其余落进 `_ => {}`
// 被吞掉。于是外层变量**只**出现在下面这些位置时就漏捕，闭包体生成时报
// 「未声明的变量: X」：
//   "${号}"              格式字符串表达式   ← 最先撞上：字符串一律写模板串是硬规则
//   表[i]                数组访问表达式
//   [甲, i]              数组字面量表达式
//   新建 点 { 横: 横值 }  结构体实例化表达式
//   闭包里再套闭包         闭包表达式（内层用的外层变量，外层得先捕进来）
// 修前五个各自单独编译全挂，修后输出如下期望。
导入 标准库.输入输出 作为 IO;
结构体 点 { 横: 整数, 纵: 整数 }

// 每个闭包里，外层变量都**只**在一种新补上的节点里出现
函数 插值(n: 整数) : 函数(字符串): 字符串 {
    变量 号: 整数 = n;
    返回 闭包(s: 字符串): 字符串 { 返回 "${s}${号}"; };
}
函数 下标(n: 整数) : 函数(整数): 整数 {
    变量 表: 数组<整数> = [n, n * 2, n * 3];
    返回 闭包(i: 整数): 整数 { 返回 表[i]; };
}
函数 数组字面(n: 整数) : 函数(整数): 整数 {
    变量 甲: 整数 = n;
    返回 闭包(i: 整数): 整数 { 变量 a: 数组<整数> = [甲, i]; 返回 a[0] + a[1]; };
}
函数 结构体字面(n: 整数) : 函数(整数): 整数 {
    变量 横值: 整数 = n;
    返回 闭包(纵值: 整数): 整数 { 变量 p: 点 = 新建 点 { 横: 横值, 纵: 纵值 }; 返回 p.横 * 100 + p.纵; };
}
函数 嵌套(n: 整数) : 函数(整数): 整数 {
    变量 外: 整数 = n;
    返回 闭包(i: 整数): 整数 {
        变量 内: 函数(整数): 整数 = 闭包(j: 整数): 整数 { 返回 外 + j; };
        返回 内(i);
    };
}
函数 入口() {
    变量 f1: 函数(字符串): 字符串 = 插值(7);
    变量 f2: 函数(整数): 整数 = 下标(5);
    变量 f3: 函数(整数): 整数 = 数组字面(40);
    变量 f4: 函数(整数): 整数 = 结构体字面(3);
    变量 f5: 函数(整数): 整数 = 嵌套(1000);
    IO.打印行(f1("号="));
    IO.打印行("${f2(2)}");
    IO.打印行("${f3(2)}");
    IO.打印行("${f4(9)}");
    IO.打印行("${f5(23)}");
}
