// C 回调回归 —— 顶层 Qi 函数当裸函数指针传给 libc 的 qsort。
//
// 契约：① 声明得下函数类型参数；② 传顶层具名函数取到的是真代码地址（不是闭包对象
// 地址，否则 C 一 call 就 SIGBUS）；③ 回调里能从 C 给的 void* 读出 i64；
// ④ 比较器返回的 i64 被 C 按 int 读低 32 位，-1/0/1 符号不丢。
导入 标准库.内存;

外部 "c" {
    函数 malloc(字节数: 整数): 指针;
    函数 free(句柄: 指针): 空;
    函数 qsort(基址: 指针, 个数: 整数, 宽度: 整数, 比较: 函数(指针, 指针): 整数): 空;
}

函数 升序(甲: 指针, 乙: 指针): 整数 {
    变量 x: 整数 = 内存::读整数(甲, 0);
    变量 y: 整数 = 内存::读整数(乙, 0);
    如果 (x < y) { 返回 0 - 1; }
    如果 (x > y) { 返回 1; }
    返回 0;
}

函数 入口() {
    变量 基址: 指针 = malloc(40);
    内存::写整数(基址, 0, 5);
    内存::写整数(基址, 8, 0 - 3);
    内存::写整数(基址, 16, 9);
    内存::写整数(基址, 24, 0);
    内存::写整数(基址, 32, 0 - 100);

    qsort(基址, 5, 8, 升序);

    变量 行: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < 5) {
        行 = 行 + 内存::读整数(基址, i * 8) + " ";
        i = i + 1;
    }
    打印行(行);
    free(基址);
    打印行("释放完成");
}
