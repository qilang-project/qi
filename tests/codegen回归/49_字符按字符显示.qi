// 字符值在插值 / 打印 / 拼接里按字符输出，不是码点数字。
//
// 后端类型格里 字符 就是 整数（i64 码点），`"${'中'}"` 以前输出 20013。
// 现在字面量、注解为 字符 的变量和形参、初值是字符的变量、声明返回 字符 的函数
// 都按字符显示；显式转成 整数 之后、以及算术结果，仍按数字显示。
包 主程序;

函数 取字(): 字符 { 返回 '好'; }
函数 显示(c: 字符) { 打印行("形参=${c}"); }

函数 入口() {
    变量 甲 = '中';
    变量 乙: 字符 = 'a';
    打印行("${'中'}");
    打印行("字面=${'文'} 变量=${甲}${乙} 函数=${取字()}");
    打印行(甲);
    打印(乙);
    打印行('!');
    打印行("拼接" + 甲 + 取字());
    显示('😀');
    如果 (真) {
        // 内层同名遮蔽成整数：按数字显示，出块后外层仍是字符
        变量 甲: 整数 = 7;
        打印行("内层=${甲}");
    }
    打印行("外层=${甲}");
    变量 码: 整数 = 甲;
    打印行("码点=${码} 加一=${甲 + 1}");
    如果 (甲 == '中') { 打印行("比较照常"); }
}
