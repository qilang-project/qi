包 主程序;
导入 标准库.文本;

// `<- ch` 与 选择 的 `情况 名 := <- ch:` 按通道元素类型推断：
// 以前无标注一律当整数，字符串通道收到的是指针地址。

结构体 点 {
    横: 整数;
    名: 字符串;
}

函数 发串(去处: 通道<字符串>, 个数: 整数) {
    对于 序号 在 0 直到 个数 {
        去处 <- "消息${序号}";
    }
}

函数 发点(去处: 通道<点>, 个数: 整数) {
    对于 序号 在 0 直到 个数 {
        变量 一个 = 新建 点 { 横: 序号, 名: "点${序号}" };
        去处 <- 一个;
    }
}

函数 入口() {
    变量 信 = 通道<字符串>(4);
    信 <- "你好";
    变量 直收 = <- 信;
    打印行("字符串：${直收}");

    变量 浮 = 通道<浮点数>(2);
    浮 <- 1.5;
    变量 浮收 = <- 浮;
    打印行("浮点数：${浮收 * 2.0}");

    变量 真假 = 通道<布尔>(2);
    真假 <- 真;
    变量 布收 = <- 真假;
    如果 布收 { 打印行("布尔：真"); }

    信 <- "再见";
    选择 {
        情况 消息 := <- 信:
            打印行("选择 字符串：${消息}");
    }
    浮 <- 2.25;
    选择 {
        情况 小数 := <- 浮:
            打印行("选择 浮点数：${小数}");
    }

    // 1 万条动态字符串：直收 + 选择 各一遍（QI_RC_REPORT 查零泄漏）
    启动 发串(信, 10000);
    变量 总长 = 0;
    对于 序号 在 0 直到 10000 {
        变量 收到 = <- 信;
        总长 = 总长 + 文本.字节长度(收到);
    }
    打印行("直收 总长 = ${总长}");
    启动 发串(信, 10000);
    变量 选择总长 = 0;
    对于 序号 在 0 直到 10000 {
        选择 {
            情况 消息 := <- 信:
                选择总长 = 选择总长 + 文本.字节长度(消息);
        }
    }
    打印行("选择 总长 = ${选择总长}");

    // 不绑定的接收分支、没选中的发送分支：值的引用计数都要还
    启动 发串(信, 100);
    变量 丢弃数 = 0;
    对于 序号 在 0 直到 100 {
        选择 {
            情况 <- 信:
                丢弃数 = 丢弃数 + 1;
        }
    }
    变量 本地 = "本地${丢弃数}";
    变量 发出数 = 0;
    对于 序号 在 0 直到 100 {
        选择 {
            情况 信 <- 本地:
                发出数 = 发出数 + 1;
            默认:
                发出数 = 发出数 + 0;
        }
        变量 回来 = <- 信;
    }
    打印行("丢弃 ${丢弃数} 发出 ${发出数} ${本地}");

    // 结构体通道
    变量 点通道 = 通道<点>(4);
    启动 发点(点通道, 1000);
    变量 横和 = 0;
    对于 序号 在 0 直到 1000 {
        变量 收到点 = <- 点通道;
        横和 = 横和 + 收到点.横;
    }
    打印行("结构体 横和 = ${横和}");
    启动 发点(点通道, 3);
    对于 序号 在 0 直到 3 {
        选择 {
            情况 一点 := <- 点通道:
                打印行("选择 结构体：${一点.名}");
        }
    }
}
