// 回归：`数组长度(x)` 的分发。
//
// 这个名字注册在 **JSON 模块**（qi_json_array_length，收句柄整数）。
// 拿它去量原生 `数组<T>`，指针被当句柄查 JSON 表，查不到就**返回 0** ——
// 不报错、不崩溃，给一个看着完全合理的数字。
//
// 线上真出过事：`如果 (第几 >= 数组长度(块)) 返回 ""` 恒真，课号后缀一律
// 解析不出来，「成人德语 B1」出的是英语幼儿内容，页面渲染正常、日志打 ✓。
//
// 两条路都要对：原生数组走长度头，整数句柄照旧交给 JSON。
包 主程序;
导入 标准库.输入输出 作为 IO;
导入 标准库.JSON 作为 J;
导入 标准库.列表 作为 列表库;
导入 标准库.字符串;

函数 入口() {
    // 原生数组：字面量、转换来的、整数元素
    变量 a: 数组<字符串> = 列表库::转字符串数组(字符串::分割("a-b-c", "-"));
    IO.打印行(整数转字符串(数组长度(a)));
    IO.打印行(整数转字符串(a.长度));
    变量 b: 数组<整数> = [10, 20, 30, 40];
    IO.打印行(整数转字符串(数组长度(b)));

    // JSON 句柄：裸调和限定调都得走 JSON
    变量 根: 整数 = J.解码("{\"卡片\":[{\"a\":1},{\"a\":2}]}");
    变量 arr: 整数 = J.获取数组(根, "卡片");
    IO.打印行(整数转字符串(J.数组长度(arr)));
    IO.打印行(整数转字符串(数组长度(arr)));
    J.删除(arr);
    J.删除(根);
}
