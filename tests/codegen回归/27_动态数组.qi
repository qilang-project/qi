// 数组<T>(n)：长度来自运行期。字面量 [a,b,c] 只能写死元素个数，
// 而「查库查出 n 行再渲染」这类场景 n 到运行时才知道。
// 配上本来就能用的索引赋值与 对于 迭代，动态列表就齐了。
包 主程序;

类型 行 { 名称: 字符串, 次数: 整数 }

函数 入口() {
    变量 n: 整数 = 4;
    变量 表: 数组<整数> = 数组<整数>(n);
    变量 i: 整数 = 0;
    当 (i < n) { 表[i] = (i + 1) * 10; i = i + 1; }
    对于 x 在 表 { 打印行(整数转字符串(x)); }
    打印行("长度=" + 整数转字符串(表.长度));

    // RC 元素：槽必须清零，否则本体归零时逐槽 release 会读到野指针
    变量 行们: 数组<行> = 数组<行>(2);
    行们[0] = 新建 行 { 名称: "甲", 次数: 5 };
    行们[1] = 新建 行 { 名称: "乙", 次数: 1 };
    对于 一行 在 行们 { 打印行(一行.名称 + "=" + 整数转字符串(一行.次数)); }

    // 边界：0 与负数长度都不能崩，负数夹成 0
    打印行("空=" + 整数转字符串(数组<整数>(0).长度));
    打印行("负=" + 整数转字符串(数组<整数>(0 - 3).长度));
}
