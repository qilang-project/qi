// 整数字面量：0x / 0X 十六进制、0b / 0B 二进制、数字间下划线分组。
// 以前 `0xFF` 被切成 `0` 加标识符 `xFF`，`1_000` 切成 `1` 加 `_000`，
// 只能得到一句「意外的标记」。十六进制/二进制按 64 位位模式解析，
// 0xFFFF_FFFF_FFFF_FFFF 就是 -1（写位掩码要的正是这些位）。
包 主程序;

函数 入口() {
    打印行("${0xFF} ${0X7f} ${0xdead_BEEF}");
    打印行("${0b1010_0101} ${0B11}");
    打印行("${1_000_000} ${0_7} ${1_000.250_5}");
    打印行("${0xFFFF_FFFF_FFFF_FFFF} ${0x7FFF_FFFF_FFFF_FFFF}");
    变量 掩码 = 0b1111_0000;
    打印行("${掩码 / 16} ${0x10 + 0b10 + 10}");
    匹配 0x2A {
        42 => 打印行("模式里也能用"),
        _ => 打印行("错"),
    }
    匹配 42 {
        0x2A => 打印行("十六进制模式"),
        _ => 打印行("错"),
    }
}
