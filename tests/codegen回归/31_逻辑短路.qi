包 试;
导入 标准库.输入输出 作为 IO;

// 回归：与/或 必须**短路**。
//
// 曾经这里是一句 build_and / build_or —— 两侧都先求值再按位算。对纯值表达式
// 没区别，可只要右边有副作用就露馅，而最常见的副作用恰恰是「守卫」：
//
//     变量 d: 整数 = 0;
//     如果 (d != 0 与 (100 / d) > 5) { … }   // 左边已判假，右边照样除 → 崩
//
// 差分模糊测试（tests/差分模糊.rs，种子 777024）跑出来的：生成的程序比参考
// 求值器多打印了一次函数副作用。
//
// 本用例正反两面都要盯：该短路的不许求值，**不该短路的必须照常求值** ——
// 只测前者的话，把 与/或 实现成「永远只算左边」也能过。

函数 副作用(标记: 整数) : 整数 {
    IO.打印行("副作用" + 整数转字符串(标记));
    返回 1;
}

函数 入口() {
    // 短路：右边一次都不该跑
    如果 (1 < 2 或 副作用(1) > 0) { IO.打印行("或-短路"); } 否则 { IO.打印行("坏"); }
    如果 (2 < 1 与 副作用(2) > 0) { IO.打印行("坏"); } 否则 { IO.打印行("与-短路"); }

    // 不短路：右边必须跑
    如果 (2 < 1 或 副作用(3) > 0) { IO.打印行("或-求值"); } 否则 { IO.打印行("坏"); }
    如果 (1 < 2 与 副作用(4) > 0) { IO.打印行("与-求值"); } 否则 { IO.打印行("坏"); }

    // 嵌套：右操作数本身也是短路表达式，phi 要认对块
    如果 (1 < 2 与 (2 < 1 或 副作用(5) > 0)) { IO.打印行("嵌套"); } 否则 { IO.打印行("坏"); }

    // 教科书守卫：短路之前这行直接除零，退出码 None
    变量 d: 整数 = 0;
    如果 (d != 0 与 (100 / d) > 5) { IO.打印行("坏"); } 否则 { IO.打印行("守卫住了"); }
}
