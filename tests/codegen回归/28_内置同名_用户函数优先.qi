包 试;
导入 标准库.输入输出 作为 IO;

// 回归：无限定内置并发/协程原语必须给用户的同名函数让路。
//
// 并发.rs 的 同步内建表 和 协程.rs 的 生成协程内建 挂着一批极短的裸名字
// （完成 / 加锁 / 解锁 / 获取时间 / 添加等待 / 取消协程 …），而它们在调用点的
// 解析顺序曾经排在用户函数**之前**。用户拿这些名字定义自己的函数，调用点就
// 静默绑到运行时 FFI 上，拿回一个句柄整数：
//   · 写了类型标注 → 报「声明为聚合类型 结构体(0)，初值却是标量 整数」，
//     提示把人往「返回句柄的库函数」上引，跟真实原因（撞了内置名）毫无关系；
//   · 没写标注     → 直接段错误，退出码 None，没有任何源码线索。
// 两种都不给「你撞了内置名」这半个字。

类型 盒 { 甲: 浮点数, 乙: 整数 }

// 撞 qi_runtime_waitgroup_done（同为 1 参 —— 元数一致最危险，静默调错）
函数 完成(x: 盒) : 盒 {
    x.乙 = 1;
    返回 x;
}

// 撞 qi_runtime_mutex_lock（1 参）
函数 加锁(名: 字符串) : 字符串 {
    返回 名 + "-锁";
}

// 撞 qi_runtime_get_time_ms（0 参）
函数 获取时间() : 字符串 {
    返回 "子时";
}

// 撞 qi_runtime_waitgroup_add（2 参）
函数 添加等待(甲: 整数, 乙: 整数) : 整数 {
    返回 甲 + 乙;
}

// 撞 协程.rs 生成协程内建 的 qi_coro_cancel（QI_CORO 默认开，这条同样会静默命中）
函数 取消协程(号: 整数) : 整数 {
    返回 号 * 2;
}

函数 入口() {
    变量 a: 盒 = 新建 盒 { 甲: 1.0, 乙: 0 };

    // 有标注：曾报「聚合类型 结构体(0) vs 标量 整数」
    变量 b: 盒 = 完成(a);
    IO.打印行(整数转字符串(b.乙));

    // 无标注：曾直接段错误（退出码 None）
    变量 c = 完成(a);
    IO.打印行(整数转字符串(c.乙));

    IO.打印行(加锁("甲"));
    IO.打印行(获取时间());
    IO.打印行(整数转字符串(添加等待(3, 4)));
    IO.打印行(整数转字符串(取消协程(21)));
}
