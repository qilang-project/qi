// 字符串.字节（按字节取，越界 -1）、清空字符串列表 / 清空浮点列表、进程.参数()。
包 主程序;
导入 标准库.字符串;
导入 标准库.列表;
导入 标准库.进程;

函数 入口() {
    变量 串 = "Az中";
    打印行("${字符串.字节(串, 0)} ${字符串.字节(串, 1)} ${字符串.字节(串, 2)}");
    打印行("${字符串.字节(串, 5)} ${字符串.字节(串, -1)} ${字符串.字节("", 0)}");

    变量 串表 = 列表.创建字符串列表();
    列表.添加字符串(串表, "a");
    列表.添加字符串(串表, "b");
    打印行("串表 ${列表.字符串列表大小(串表)} 清空 ${列表.清空字符串列表(串表)} 后 ${列表.字符串列表大小(串表)}");

    变量 浮表 = 列表.创建浮点列表();
    列表.添加浮点数(浮表, 1.5);
    打印行("浮表 ${列表.浮点列表大小(浮表)} 清空 ${列表.清空浮点列表(浮表)} 后 ${列表.浮点列表大小(浮表)}");
    打印行("类型不符 ${列表.清空浮点列表(串表)}");

    // 含程序名：[0] 是程序路径，没有用户参数时长度就是 1
    变量 参 = 进程.参数();
    打印行("参数 ${参.长度} ${字符串.字节(参[0], 0) > 0 与 字符串.字节长度(参[0]) > 0}");
}
