// 科学计数法浮点字面量：1e3 / 1.5e-3 / 2E+10 / 带分隔符；插值洞里同样可用。
// 0xE3 仍是十六进制整数，不被当成 0 乘 10 的 E3 次方。
包 主程序;

函数 入口() {
    变量 千 = 1e3;
    变量 小 = 1.5e-3;
    变量 大 = 2E+10;
    变量 分隔 = 1_000e1_0;
    变量 十六进制 = 0xE3;
    打印行(千);
    打印行(小);
    打印行(大 / 1e10);
    打印行(分隔 > 1e12);
    打印行(十六进制);
    打印行("洞里：${1e20} ${2.5E-1 * 4.0}");
}
