// 同一源码编多次，产物必须逐字节相同。
//
// 函数出口释放 RC 局部、main 出口释放 RC 全局、协程提前销毁时的 cleanup，
// 三处原来都直接 iter() 一张 HashMap —— release 的顺序跟着进程的随机哈希种子走，
// 连编两次就不一样（全仓 1528 个程序里 385 个中招）。
//
// 这里每处都放十几个字符串变量：只有两三个的话，两次恰好同序的概率不低，测不稳。

变量 全甲: 字符串 = "甲"; 变量 全乙: 字符串 = "乙"; 变量 全丙: 字符串 = "丙";
变量 全丁: 字符串 = "丁"; 变量 全戊: 字符串 = "戊"; 变量 全己: 字符串 = "己";
变量 全庚: 字符串 = "庚"; 变量 全辛: 字符串 = "辛"; 变量 全壬: 字符串 = "壬";
变量 全癸: 字符串 = "癸"; 变量 全子: 字符串 = "子"; 变量 全丑: 字符串 = "丑";

函数 拼(n: 整数) : 字符串 {
    变量 一: 字符串 = "一${n}"; 变量 二: 字符串 = "二${n}"; 变量 三: 字符串 = "三${n}";
    变量 四: 字符串 = "四${n}"; 变量 五: 字符串 = "五${n}"; 变量 六: 字符串 = "六${n}";
    变量 七: 字符串 = "七${n}"; 变量 八: 字符串 = "八${n}"; 变量 九: 字符串 = "九${n}";
    变量 十: 字符串 = "十${n}"; 变量 百: 字符串 = "百${n}"; 变量 千: 字符串 = "千${n}";
    返回 "${一}${二}${三}${四}${五}${六}${七}${八}${九}${十}${百}${千}";
}

函数 慢拼(n: 整数) : 未来<字符串> {
    变量 甲: 字符串 = "甲${n}"; 变量 乙: 字符串 = "乙${n}"; 变量 丙: 字符串 = "丙${n}";
    变量 丁: 字符串 = "丁${n}"; 变量 戊: 字符串 = "戊${n}"; 变量 己: 字符串 = "己${n}";
    变量 庚: 字符串 = "庚${n}"; 变量 辛: 字符串 = "辛${n}"; 变量 壬: 字符串 = "壬${n}";
    变量 前: 字符串 = 等待 未来::就绪("前");
    返回 "${前}${甲}${乙}${丙}${丁}${戊}${己}${庚}${辛}${壬}";
}

函数 入口() {
    打印行(拼(1));
    打印行(等待 慢拼(2));
    打印行("${全甲}${全乙}${全丙}${全丁}${全戊}${全己}${全庚}${全辛}${全壬}${全癸}${全子}${全丑}");
}
