// 时间戳永远是 Unix 秒；不带「本地」的分量按 UTC 拆，「本地」前缀那一族按机器时区拆。
//
// 以前 时间.本地时间() 返回 Local::now().timestamp() —— Unix 秒没有时区，于是跟
// 现在() 一模一样，时间.时(时间.本地时间()) 在北京早上 9 点给 1。
//
// 这里只断言与时区无关的恒等式（CI 的 Windows 不认 TZ）。东八区的具体数字
// 在 断言.sh 里用 TZ=Asia/Shanghai 另跑一遍（非 Windows）。
包 主程序;
导入 标准库.时间;

函数 入口() {
    变量 t: 整数 = 时间.从年月日时分秒(2026, 10, 9, 1, 0, 0);
    变量 偏: 整数 = 时间.时区偏移(t);
    打印行("本地时=UTC时+偏移: ${时间.本地时(t) == 时间.时(t + 偏)}");
    打印行("本地日=UTC日+偏移: ${时间.本地日(t) == 时间.日(t + 偏)}");
    打印行("转本地/从本地往返: ${时间.从本地(时间.转本地(t)) == t}");
    变量 九点: 整数 = 时间.从本地年月日时分秒(2026, 10, 9, 9, 0, 0);
    打印行("本地九点读回: ${时间.本地时(九点)}:${时间.本地分(九点)}");
    打印行("本地当天开始读回: ${时间.本地时(时间.本地当天开始(九点))}");
    打印行("解析本地读回: ${时间.本地时(时间.解析本地("2026-10-09 09:00:00", "%Y-%m-%d %H:%M:%S"))}");
    变量 现: 整数 = 时间.现在();
    变量 差: 整数 = 时间.本地时间() - 时间.转本地(现);
    打印行("本地时间()=转本地(现在()): ${差 >= 0 && 差 <= 1}");
    打印行("是本地今天: ${时间.是本地今天(现)}");
}
