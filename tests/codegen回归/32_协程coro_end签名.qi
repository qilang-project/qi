// 回归：llvm.coro.end 的签名必须跟着链接进来的 LLVM 走
//
// LLVM 21 是 i1 (ptr,i1,token)，LLVM 22 改成了 void (ptr,i1,token)，两边互斥。
// 写死一边，另一边就在模块校验阶段炸「Intrinsic has incorrect return type!」——
// 而且只有真走协程（返回 未来<T> 且含挂起点）的程序才炸，普通程序全绿，
// 所以这条必须有个最小用例钉住。
包 主程序;
导入 标准库.输入输出 作为 IO;

变量 信号 = 通道<整数>(4);

函数 工人() : 未来<整数> {
    变量 v: 整数 = <- 信号;
    返回 v + 1;
}

函数 入口() {
    信号 <- 41;
    变量 f: 未来<整数> = 工人();
    IO.打印行("协程结果 = " + 整数转字符串(等待 f));
}
