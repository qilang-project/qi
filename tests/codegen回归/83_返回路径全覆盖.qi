// 必须不报「漏写返回」的写法：否则如果链、匹配全分支返回/抛出、抛出收尾、
// 当 真（内层循环的 跳出 不算）、尝试/捕获两边都返回、最终 块返回、进程.退出 收尾、
// 无返回类型与 空 返回类型。
包 主程序;
导入 标准库.进程;

枚举 形状 { 圆(浮点数), 方(浮点数) }

函数 符号(数值: 整数): 整数 {
    如果 数值 < 0 {
        返回 -1;
    } 否则如果 数值 == 0 {
        返回 0;
    } 否则 {
        返回 1;
    }
}

函数 面积(图形: 形状): 浮点数 {
    匹配 图形 {
        圆(半径) => { 返回 3.0 * 半径 * 半径; }
        方(边长) => { 返回 边长 * 边长; }
    }
}

函数 必须正(数值: 整数): 整数 {
    如果 数值 > 0 {
        返回 数值;
    }
    抛出 "不是正数";
}

函数 第一个偶数(数列: 数组<整数>): 整数 {
    变量 下标 = 0;
    当 真 {
        如果 数列[下标] % 2 == 0 {
            返回 数列[下标];
        }
        下标 = 下标 + 1;
    }
}

函数 永远(): 整数 {
    当 真 {
        对于 序号 在 0..3 {
            如果 序号 == 2 { 跳出; }
        }
        返回 7;
    }
}

函数 尝试取(文本: 字符串): 整数 {
    尝试 {
        返回 字符串转整数(文本);
    } 捕获 错误 {
        返回 -1;
    }
}

函数 退出取(数值: 整数): 整数 {
    如果 数值 > 0 { 返回 数值; }
    进程.退出(2);
}

函数 块里返回(数值: 整数): 整数 {
    尝试 {
        打印行("试");
    } 捕获 错误 {
        打印行("错");
    } 最终 {
        返回 数值 + 1;
    }
}

函数 选首(数值: 整数): 整数 {
    匹配 数值 {
        1 => { 返回 10; }
        _ => { 抛出 "不认识"; }
    }
}

函数 无返回值(数值: 整数) {
    如果 数值 > 0 { 打印行("正"); }
}

函数 空返回(数值: 整数): 空 {
    如果 数值 > 0 { 打印行("正"); }
}

函数 入口() {
    打印行(符号(-5));
    打印行(面积(形状.方(2.0)));
    打印行(必须正(3));
    打印行(第一个偶数([1, 3, 4]));
    打印行(永远());
    打印行(尝试取("12"));
    打印行(退出取(5));
    打印行(块里返回(1));
    打印行(选首(1));
    无返回值(1);
    空返回(1);
}
