// 方法同样要查；当 真 循环里有 跳出，循环就能落出来。
包 主程序;

类型 计数器 {
    整数 值;
}

函数 (自己 计数器) 首个大于(下限: 整数): 整数 {
    变量 当前 = 自己.值;
    当 真 {
        如果 当前 > 100 {
            跳出;
        }
        如果 当前 > 下限 {
            返回 当前;
        }
        当前 = 当前 + 1;
    }
}

函数 入口() {
    变量 甲 = 新建 计数器 { 值: 1 };
    打印行(甲.首个大于(5));
}
