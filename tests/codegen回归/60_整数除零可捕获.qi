包 主程序;

// 整数除零抛可捕获异常；INT64_MIN / -1 按回绕（Go 语义）；浮点除零仍是 inf

函数 除(被除数: 整数, 除数: 整数): 整数 { 返回 被除数 / 除数; }
函数 余(被除数: 整数, 除数: 整数): 整数 { 返回 被除数 % 除数; }

函数 入口() {
    尝试 {
        打印行("不该到这：${除(10, 0)}");
    } 捕获 错误 {
        打印行("跨函数除：${错误}");
    }
    尝试 {
        打印行("不该到这：${余(10, 0)}");
    } 捕获 错误 {
        打印行("跨函数余：${错误}");
    }
    变量 零 = 0;
    尝试 {
        变量 结果 = 10 / 零;
        打印行("不该到这：${结果}");
    } 捕获 错误 {
        打印行("变量除：${错误}");
    }
    尝试 {
        打印行("不该到这：${10 / 0}");
    } 捕获 错误 {
        打印行("常量除：${错误}");
    }
    尝试 {
        打印行("不该到这：${10 % 0}");
    } 捕获 错误 {
        打印行("常量余：${错误}");
    }
    变量 累计 = 100;
    尝试 {
        累计 /= 零;
        打印行("不该到这：${累计}");
    } 捕获 错误 {
        打印行("复合除：${错误} 累计仍是 ${累计}");
    }
    尝试 {
        累计 %= 零;
        打印行("不该到这：${累计}");
    } 捕获 错误 {
        打印行("复合余：${错误}");
    }
    // 正常除法不受影响
    打印行("7 / 2 = ${7 / 2}，-7 / 2 = ${-7 / 2}，-7 % 3 = ${-7 % 3}，7 % -3 = ${7 % -3}");
    变量 二 = 2;
    打印行("变量除数：${9 / 二} ${9 % 二} ${除(-9, 二)} ${余(-9, 二)}");
    // INT64_MIN / -1：回绕成 INT64_MIN，余数 0，不抛
    变量 最小 = -9223372036854775807 - 1;
    变量 负一 = -1;
    打印行("最小 / 负一 = ${最小 / 负一}，最小 % 负一 = ${最小 % 负一}");
    打印行("常量负一：${最小 / -1} ${最小 % -1} ${除(42, -1)} ${余(42, -1)}");
    // 浮点除零：IEEE inf，不抛
    打印行("浮点：${10.0 / 0.0} ${-1.0 / 0.0}");
    // catch 变量与外层同名：出 catch 后外层那个原样回来
    变量 错误 = "外层";
    尝试 {
        打印行("不该到这：${1 / 零}");
    } 捕获 错误 {
        打印行("内层：${错误}");
    }
    打印行("出来后：${错误}");
    打印行("还活着");
}
