包 主程序;

// 数组下标读/写越界（含负下标、空数组、可增长数组、函数参数）抛可捕获异常

结构体 点 {
    横: 整数;
}

函数 取(数列: 数组<整数>, 位置: 整数): 整数 { 返回 数列[位置]; }

函数 入口() {
    变量 数列 = [10, 20, 30];
    对于 位置 在 [3, -1, 1000000, 2] {
        尝试 {
            打印行("读 [${位置}] = ${取(数列, 位置)}");
        } 捕获 错误 {
            打印行("读：${错误}");
        }
    }
    尝试 {
        数列[3] = 99;
        打印行("不该到这");
    } 捕获 错误 {
        打印行("写：${错误}");
    }
    尝试 {
        数列[-1] = 99;
        打印行("不该到这");
    } 捕获 错误 {
        打印行("写负：${错误}，长度仍是 ${数列.长度}");
    }
    数列[2] = 33;
    打印行("界内写读：${数列[2]}");

    变量 可增长 = 数组<整数>();
    尝试 {
        打印行("不该到这：${可增长[0]}");
    } 捕获 错误 {
        打印行("空数组：${错误}");
    }
    可增长.添加(7);
    打印行("添加后：${可增长[0]}");
    尝试 {
        打印行("不该到这：${可增长[1]}");
    } 捕获 错误 {
        打印行("可增长：${错误}");
    }
    变量 弹出值 = 可增长.弹出();
    尝试 {
        打印行("不该到这：${可增长[0]}");
    } 捕获 错误 {
        打印行("弹出后 ${弹出值}：${错误}");
    }

    变量 定长 = 数组<字符串>(2);
    定长[1] = "乙";
    尝试 {
        定长[2] = "丙";
    } 捕获 错误 {
        打印行("字符串数组：${错误}");
    }
    变量 第一点 = 新建 点 { 横: 1 };
    变量 点列 = [第一点];
    尝试 {
        打印行("不该到这：${点列[1].横}");
    } 捕获 错误 {
        打印行("结构体数组：${错误}");
    }
    打印行("还活着 ${数列[0]} ${定长[1]} ${点列[0].横}");
}
