// bug③回归：内建 长度 的分发 ——
//   长度(字符串变量) 修前被误分发到 向量.长度（模长，返回 double），LLVM 校验崩；
//   方法体内 长度(自己.字段)（字符串字段 / 数组字段）同样崩。
// 语义：长度(字符串) = UTF-8 字符数；长度(数组) = 元素个数。
包 主程序;
导入 标准库.输入输出 作为 IO;

类型 名片 {
    字符串 姓名;
    数组<字符串> 标签;
}

实现 名片 {
    函数 名长() : 整数 {
        返回 长度(自己.姓名);
    }
    函数 标签数() : 整数 {
        返回 长度(自己.标签);
    }
}

函数 入口() {
    变量 s: 字符串 = "你好世界";
    IO.打印行(整数转字符串(长度(s)));
    变量 a: 数组<整数> = [1, 2, 3];
    IO.打印行(整数转字符串(长度(a)));
    变量 c: 名片 = 新建 名片 { 姓名: "张三", 标签: ["甲", "乙"] };
    IO.打印行(整数转字符串(c.名长()));
    IO.打印行(整数转字符串(c.标签数()));
}
