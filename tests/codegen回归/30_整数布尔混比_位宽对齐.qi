包 试;
导入 标准库.输入输出 作为 IO;

// 回归：整数(i64) 与 布尔(i1) 混在同一个算术/比较表达式里，位宽必须先对齐。
//
// 「布尔(i1) 按隐式加宽规则 zext 成 i64 参与」这条规则位运算和逻辑运算都照做，
// 唯独算术与比较那条路径漏了，于是 `n == b` 发出
//     icmp eq i64 %n1, i1 %b2
// ——非法 IR。verifier 兜得住，但报的是一句没有源码定位的英文
// 「Both operands to ICmp instruction are not of the same type!」，
// 拿着它回头找是哪一行写错了，没有任何线索。
//
// 让它可比而不是报错：qi 惯用整数当布尔（`字符串::等于(甲,乙) == 1` 满仓库都是），
// 真=1 / 假=0 的 zext 正是这套惯用法的语义。

函数 入口() {
    变量 n: 整数 = 1;
    变量 b: 布尔 = 真;
    变量 零: 整数 = 0;

    如果 (n == b) { IO.打印行("1==真"); } 否则 { IO.打印行("坏"); }
    如果 (零 == 假) { IO.打印行("0==假"); } 否则 { IO.打印行("坏"); }
    如果 (n == 假) { IO.打印行("坏"); } 否则 { IO.打印行("1!=假"); }
    // 两侧同宽（布尔==布尔）不该多发 zext，结果照常
    如果 (真 == 真) { IO.打印行("真==真"); } 否则 { IO.打印行("坏"); }
    // 算术同理：曾经是 add i64, i1
    IO.打印行(整数转字符串(n + b));
    IO.打印行(整数转字符串(零 + 真));
}
