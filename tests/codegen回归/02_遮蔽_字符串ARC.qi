// bug①回归（ARC 变体）：字符串（RC 槽）遮蔽 —— 外层值不被覆盖，
// 内层 RC 变量出块后仍在函数出口正确释放（QI_RC_REPORT=1 全 0，断言脚本校验）。
包 主程序;
导入 标准库.输入输出 作为 IO;
函数 入口() {
    变量 s: 字符串 = "外" + 整数转字符串(1);
    如果 (1 == 1) {
        变量 s: 字符串 = "中" + 整数转字符串(2);
        如果 (2 == 2) {
            变量 s: 字符串 = "内" + 整数转字符串(3);
            IO.打印行(s);
        }
        IO.打印行(s);
    }
    IO.打印行(s);
}
