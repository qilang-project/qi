// 回归 ⑬：同一接收器类型上的同名方法按元数重载。
// 以前方法表的键只有 (结构体, 方法名)、LLVM 符号也不带元数，第二个同名方法把第一个
// 的签名盖掉，调短元数的那个报「缺少第 N 个形参」。自由函数早就按元数重载了，
// 方法要一致。qi-web 链式.qi 里 实时块路由带请求(9 参 / 10 参) 就是这个形状。
包 主程序;

类型 计数器 {
    整数 数值;
}

函数 (自身 计数器) 加(n: 整数) : 计数器 {
    返回 新建 计数器 { 数值: 自身.数值 + n };
}

// 同名、多一个参数：带倍率
函数 (自身 计数器) 加(n: 整数, 倍: 整数) : 计数器 {
    返回 新建 计数器 { 数值: 自身.数值 + n * 倍 };
}

// 同名、零参数：加一
函数 (自身 计数器) 加() : 计数器 {
    返回 新建 计数器 { 数值: 自身.数值 + 1 };
}

函数 (自身 计数器) 读() : 整数 {
    返回 自身.数值;
}

// 另一个类型上也有 加，且返回类型不同 —— 跨类型同名一直是好的，这里只是守住
类型 文案 {
    字符串 内容;
}

函数 (自身 文案) 加(尾: 字符串) : 文案 {
    返回 新建 文案 { 内容: 自身.内容 + 尾 };
}

函数 (自身 文案) 加(尾: 字符串, 次: 整数) : 文案 {
    变量 出: 字符串 = 自身.内容;
    变量 i: 整数 = 0;
    当 (i < 次) {
        出 = 出 + 尾;
        i = i + 1;
    }
    返回 新建 文案 { 内容: 出 };
}

函数 入口() {
    变量 c = 新建 计数器 { 数值: 1 };
    // 三种元数各调一次，再链起来
    打印行(c.加(4).读());
    打印行(c.加(4, 10).读());
    打印行(c.加().读());
    打印行(c.加().加(2).加(3, 3).读());

    变量 t = 新建 文案 { 内容: "啊" };
    打印行(t.加("！").内容);
    打印行(t.加("哈", 3).加("。").内容);
}
