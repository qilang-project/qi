包 主程序;

// 数组<数组<T>>：取出内层、链式下标读写、作参数/返回值、三层嵌套、字面量嵌套。
// 以前元素类型退化成 整数，取出来的内层数组是个 i64，再取下标编译器直接 panic。

函数 总和(矩阵: 数组<数组<整数> >): 整数 {
    变量 合计 = 0;
    对于 行 在 矩阵 {
        对于 值 在 行 { 合计 = 合计 + 值; }
    }
    返回 合计;
}

函数 方阵(边长: 整数): 数组<数组<整数> > {
    变量 结果 = 数组<数组<整数> >();
    对于 行号 在 0 直到 边长 {
        变量 行 = 数组<整数>();
        对于 列号 在 0 直到 边长 { 行.添加(行号 * 边长 + 列号); }
        结果.添加(行);
    }
    返回 结果;
}

函数 入口() {
    变量 表 = 数组<数组<整数> >();
    变量 首行 = 数组<整数>();
    首行.添加(1);
    表.添加(首行);
    变量 取出 = 表[0];
    打印行("${取出[0]} ${取出.长度} ${表[0][0]}");

    // 九九乘法表（下三角）
    变量 乘法表 = 数组<数组<整数> >();
    对于 甲 在 1 到 9 {
        变量 行 = 数组<整数>();
        对于 乙 在 1 到 甲 { 行.添加(甲 * 乙); }
        乘法表.添加(行);
    }
    对于 行号 在 0 直到 乘法表.长度 {
        变量 行 = 乘法表[行号];
        变量 文本 = "";
        对于 列号 在 0 直到 行.长度 { 文本 = "${文本}${列号 + 1}x${行号 + 1}=${行[列号]} "; }
        打印行(文本);
    }
    打印行("乘法表[8][8] = ${乘法表[8][8]}");

    变量 字面 = [[1, 2], [3, 4, 5]];
    打印行("字面 ${字面.长度} ${字面[1].长度} ${字面[1][2]} 和=${总和(字面)}");
    变量 矩阵 = 方阵(3);
    打印行("方阵 和=${总和(矩阵)} 角=${矩阵[2][2]}");

    // 链式下标赋值
    矩阵[1][1] = 100;
    打印行("链式写 ${矩阵[1][1]} 和=${总和(矩阵)}");
    矩阵[0] = [7, 8, 9];
    打印行("整行替换 ${矩阵[0][2]}");

    变量 名单 = 数组<数组<字符串> >();
    变量 组 = 数组<字符串>();
    组.添加("甲乙");
    组.添加("丙丁");
    名单.添加(组);
    名单[0][1] = "戊己";
    打印行("名单 ${名单[0][0]} ${名单[0][1]} ${名单[0].长度}");

    变量 三层 = 数组<数组<数组<整数> > >();
    三层.添加(矩阵);
    打印行("三层 ${三层[0][1][2]} ${三层[0][1][1]}");
    变量 浮 = [[1.5, 2.5]];
    打印行("浮 ${浮[0][1]}");

    // 内外两层都查越界
    尝试 {
        打印行("不该到这：${矩阵[3][0]}");
    } 捕获 错误 {
        打印行("外层：${错误}");
    }
    尝试 {
        矩阵[0][3] = 1;
    } 捕获 错误 {
        打印行("内层：${错误}");
    }
}
