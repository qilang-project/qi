包 主程序;
导入 标准库.同步;
导入 标准库.时间;

// 带缓冲通道写满后，非协程上下文（goroutine 线程 / 入口）的发送要阻塞到对端腾位。
// 以前满了就把值丢掉，接收方永远等不到 —— 整个程序挂住。

函数 生产者(出口: 通道<整数>, 编号: 整数) {
    对于 序号 在 0 直到 5 {
        出口 <- 编号 * 100 + 序号;
    }
}

函数 慢消费者(入口通道: 通道<整数>, 个数: 整数, 回报: 通道<整数>) {
    变量 和 = 0;
    对于 序号 在 0 直到 个数 {
        时间.睡眠毫秒(1);
        变量 值 = <- 入口通道;
        和 = 和 + 值;
    }
    回报 <- 和;
}

// 信号量：容量 3 的通道当令牌桶
变量 在跑: 整数 = 0;
变量 峰值: 整数 = 0;

函数 任务(令牌: 通道<整数>, 组: 整数) {
    令牌 <- 1;
    变量 现在 = 同步.原子加(在跑, 1);
    变量 旧峰值 = 同步.读原子(峰值);
    当 现在 > 旧峰值 {
        如果 同步.原子比较交换(峰值, 旧峰值, 现在) == 1 { 跳出; }
        旧峰值 = 同步.读原子(峰值);
    }
    时间.睡眠毫秒(30);
    同步.原子加(在跑, -1);
    变量 还回 = <- 令牌;
    完成(组);
}

// 协程两端：满了挂起、空了挂起，对端是线程也要能唤醒
函数 协程消费(来源: 通道<整数>, 个数: 整数): 未来<整数> {
    变量 和 = 0;
    对于 序号 在 0 直到 个数 {
        变量 值 = <- 来源;
        和 = 和 + 值;
    }
    等待 让出();
    返回 和;
}

函数 协程生产(去处: 通道<整数>, 个数: 整数): 未来<整数> {
    对于 序号 在 0 直到 个数 {
        去处 <- 序号;
    }
    等待 让出();
    返回 个数;
}

函数 线程生产(去处: 通道<整数>, 个数: 整数) {
    对于 序号 在 0 直到 个数 {
        去处 <- 序号;
    }
}

函数 入口() {
    // goroutine 发、入口收（容量 2 < 5 个值）
    变量 管道 = 通道<整数>(2);
    启动 生产者(管道, 1);
    变量 和 = 0;
    对于 序号 在 0 直到 5 { 和 = 和 + <- 管道; }
    打印行("单生产者 和 = ${和}");

    // 三个生产者、容量 4
    变量 多管道 = 通道<整数>(4);
    启动 生产者(多管道, 1);
    启动 生产者(多管道, 2);
    启动 生产者(多管道, 3);
    变量 多和 = 0;
    对于 序号 在 0 直到 15 { 多和 = 多和 + <- 多管道; }
    打印行("三生产者 和 = ${多和}");

    // 入口发、goroutine 慢收：入口在满通道上阻塞
    变量 慢管道 = 通道<整数>(2);
    变量 回报 = 通道<整数>();
    启动 慢消费者(慢管道, 50, 回报);
    对于 序号 在 0 直到 50 { 慢管道 <- 序号; }
    打印行("入口发 goroutine 收 和 = ${<- 回报}");

    // 信号量
    在跑 = 同步.创建原子(0);
    峰值 = 同步.创建原子(0);
    变量 令牌 = 通道<整数>(3);
    变量 组 = 创建等待组();
    添加等待(组, 10);
    对于 序号 在 0 直到 10 { 启动 任务(令牌, 组); }
    等待组等待(组);
    打印行("信号量 峰值 = ${同步.读原子(峰值)}");

    // goroutine 发、协程收
    变量 管道二 = 通道<整数>(2);
    启动 线程生产(管道二, 200);
    打印行("goroutine 发 协程收 和 = ${等待 协程消费(管道二, 200)}");

    // 协程发、入口收
    变量 管道三 = 通道<整数>(3);
    变量 生产未来 = 协程生产(管道三, 300);
    变量 和三 = 0;
    对于 序号 在 0 直到 300 { 和三 = 和三 + <- 管道三; }
    打印行("协程发 入口收 和 = ${和三} 个数 = ${等待 生产未来}");
}
