// GUI 脚本冒烟：一个按钮 + 一个计数标签。
//
// 断言.sh 用 QI_GUI_SCRIPT 在固定帧点按钮、存截图，再用 QI_GUI_AUTOCLOSE_MS
// 收工。程序最后打印计数，脚本据此确认「点击真的进了控件」，
// 截图则确认软光栅真的画出了东西。

包 主程序;

导入 标准库.图形化 作为 图形;
导入 标准库.输入输出 作为 IO;

变量 计数: 整数 = 0;

函数 入口() {
    变量 应用: 整数 = 图形.应用创建("qi GUI 冒烟", 480, 320);
    如果 (应用 == 0) {
        IO.打印行("应用创建失败");
        返回;
    }
    变量 帧数: 整数 = 0;
    当 (图形.帧开始(应用) == 1) {
        帧数 = 帧数 + 1;
        如果 (图形.按钮("点我") == 1) {
            计数 = 计数 + 1;
        }
        图形.标签("计数 ${计数}");
        图形.帧结束(应用);
    }
    图形.关闭应用(应用);
    IO.打印行("共渲染 ${帧数} 帧");
    IO.打印行("计数 ${计数}");
    IO.打印行("窗口已关闭");
}
