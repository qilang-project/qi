导入 标准库.时间;

函数 秀(标: 字符串, t: 整数) {
    打印行(标 + " -> " + 整数转字符串(时间::年(t)) + "-"
        + 整数转字符串(时间::月(t)) + "-" + 整数转字符串(时间::日(t)));
}

函数 入口() {
    秀("1月31日 +1月", 时间::加月(时间::从年月日(2026, 1, 31), 1));
    秀("1月31日 +2月", 时间::加月(时间::从年月日(2026, 1, 31), 2));
    秀("3月31日 +1月", 时间::加月(时间::从年月日(2026, 3, 31), 1));
    秀("12月15日 +1月", 时间::加月(时间::从年月日(2026, 12, 15), 1));
    秀("1月15日 -1月", 时间::加月(时间::从年月日(2026, 1, 15), 0 - 1));
    秀("1月15日 -13月", 时间::加月(时间::从年月日(2026, 1, 15), 0 - 13));
    秀("2月29日 +1年", 时间::加年(时间::从年月日(2024, 2, 29), 1));
    秀("8月26日 +1年", 时间::加年(时间::从年月日(2026, 8, 26), 1));
    秀("8月26日 -3年", 时间::加年(时间::从年月日(2026, 8, 26), 0 - 3));
}
