// 半迁移验证：时间戳由 qi 实现算出，格式化仍走 Rust FFI。
导入 标准库.时间;

函数 显(标: 字符串, t: 整数) {
    打印行(标 + " " + 时间::格式化(t, "%Y-%m-%d %H:%M:%S"));
}

函数 入口() {
    变量 基: 整数 = 时间::从年月日时分秒(2026, 8, 26, 14, 30, 45);
    显("本月开始", 时间::本月开始(基));
    显("本年结束", 时间::本年结束(基));
    显("加月跨年", 时间::加月(时间::从年月日时分秒(2026, 12, 15, 8, 30, 0), 1));
    显("往回三年", 时间::加年(基, 0 - 3));
}
