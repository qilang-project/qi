// 同一份源码跑两遍：默认走 qi 实现，QI_STDLIB_FFI=时间 走 Rust FFI。
// 两次输出必须逐字节一致。
导入 标准库.时间;

函数 报(名: 字符串, 值: 整数) {
    打印行(名 + "=" + 整数转字符串(值));
}

函数 查一个(t: 整数) {
    打印行("--- t=" + 整数转字符串(t));
    报("年", 时间::年(t));
    报("月", 时间::月(t));
    报("日", 时间::日(t));
    报("时", 时间::时(t));
    报("分", 时间::分(t));
    报("秒", 时间::秒(t));
    报("星期几", 时间::星期几(t));
    报("季度", 时间::季度(t));
    报("年的第几天", 时间::年的第几天(t));
    报("年的第几周", 时间::年的第几周(t));
    报("当天开始", 时间::当天开始(t));
    报("当天结束", 时间::当天结束(t));
    报("本周开始", 时间::本周开始(t));
    报("本周结束", 时间::本周结束(t));
    报("本月开始", 时间::本月开始(t));
    报("本月结束", 时间::本月结束(t));
    报("本年开始", 时间::本年开始(t));
    报("本年结束", 时间::本年结束(t));
    报("本季度开始", 时间::本季度开始(t));
    报("本季度结束", 时间::本季度结束(t));
    报("是周末", 时间::是周末(t));
    报("是工作日", 时间::是工作日(t));
    报("加秒", 时间::加秒(t, 3661));
    报("加分钟", 时间::加分钟(t, 90));
    报("加小时", 时间::加小时(t, 25));
    报("加天", 时间::加天(t, 45));
    报("加周", 时间::加周(t, 3));
    报("相差天数", 时间::相差天数(t, 0));
    报("相差小时", 时间::相差小时(t, 0));
    报("相差分钟", 时间::相差分钟(t, 0));
    报("相差秒数", 时间::相差秒数(t, 0));
    报("在范围内", 时间::在范围内(t, 0, 2000000000));
}

函数 入口() {
    // 覆盖：纪元、闰年 2/29、月末、跨年、负时间戳（1970 前）、当下、远期
    查一个(0);
    查一个(1);
    查一个(86399);
    查一个(86400);
    查一个(951782400);
    查一个(1709164800);
    查一个(1787754645);
    查一个(1735689599);
    查一个(1735689600);
    查一个(0 - 1);
    查一个(0 - 86400);
    查一个(0 - 86401);
    查一个(0 - 2208988800);
    查一个(4102444800);
    查一个(2147483647);

    打印行("=== 构造 ===");
    报("从年月日", 时间::从年月日(2026, 8, 26));
    报("从年月日时分秒", 时间::从年月日时分秒(2026, 8, 26, 14, 30, 45));
    报("从年月日_闰", 时间::从年月日(2024, 2, 29));
    报("从年月日_1900", 时间::从年月日(1900, 3, 1));

    打印行("=== 闰年月长 ===");
    报("闰2000", 时间::是闰年(2000));
    报("闰1900", 时间::是闰年(1900));
    报("闰2024", 时间::是闰年(2024));
    报("闰2026", 时间::是闰年(2026));
    报("2月2024", 时间::月天数(2024, 2));
    报("2月2026", 时间::月天数(2026, 2));
    报("12月", 时间::月天数(2026, 12));
    报("4月", 时间::月天数(2026, 4));

    打印行("=== 换算 ===");
    报("秒转毫秒", 时间::秒转毫秒(7));
    报("毫秒转秒", 时间::毫秒转秒(7999));
    报("秒转微秒", 时间::秒转微秒(3));
    报("微秒转秒", 时间::微秒转秒(3999999));
    报("毫秒", 时间::毫秒(1787754645123));
}
