// 绿码：全局变量/常量 + 块级遮蔽 + 相互递归 + 函数名当值传 —— 零报错
包 主程序;

变量 全局计数: 整数 = 100;
常量 问候语 = "你好";
变量 无注解全局 = 3.5;

// 相互递归：偶判定
函数 是偶(n: 整数) : 布尔 {
    如果 n == 0 { 返回 真; }
    返回 是奇(n - 1);
}

函数 是奇(n: 整数) : 布尔 {
    如果 n == 0 { 返回 假; }
    返回 是偶(n - 1);
}

// 自递归
函数 阶乘(n: 整数) : 整数 {
    如果 n <= 1 { 返回 1; }
    返回 n * 阶乘(n - 1);
}

函数 套用(f: 函数(整数): 整数, x: 整数) : 整数 {
    返回 f(x);
}

函数 入口() {
    打印行(全局计数);
    打印行(问候语);
    打印行(无注解全局);

    // 局部遮蔽全局（同名不同类型 —— 合法）
    变量 全局计数 = "遮蔽后是字符串";
    打印行(全局计数);

    // 块内再遮蔽
    如果 真 {
        变量 全局计数 = 7;
        打印行(全局计数 + 1);
    }

    打印行(是偶(10));
    打印行(是奇(7));
    打印行(阶乘(6));

    // 函数名当值传给高阶函数
    打印行(套用(阶乘, 5));
}
