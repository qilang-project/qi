// 绿码：字面量来源判定的合法边界 —— 字面量组合出的值赋给同族变量必须放行
包 主程序;

函数 收整数(n: 整数) : 整数 {
    返回 n + 1;
}

函数 收字符串(s: 字符串) : 字符串 {
    返回 s;
}

函数 算式() : 整数 {
    // 返回：纯字面量算术组合（字面量来源 → 与声明返回同族 → 放行）
    返回 (1 + 2) * 3 - 4 / 2;
}

函数 入口() {
    // 声明+字面量组合：全部同族
    变量 a: 整数 = (1 + 2) * 3;
    变量 b: 浮点数 = 1 + 2.5;           // 整浮混合提升 → 浮点，数值族
    变量 c: 布尔 = 1 < 2;               // 比较 → 布尔，数值族
    变量 d: 字符 = 'A';
    变量 e: 字符串 = "a" + "b";
    变量 g: 字符串 = "编号" + 7;         // + 一侧字符串 = 拼接
    变量 h: 整数 = -5;                   // 一元负号字面量
    变量 i: 布尔 = 非 假;
    变量 j: 数组<整数> = [1, 2, 3, 4, 5]; // 尺寸只写在值里 —— 同族放行
    变量 k: 数组<字符串> = ["x", "y"];

    打印行(a + h);
    打印行(b);
    如果 c 且 i { 打印行("布尔边界通过"); }
    打印行(d);
    打印行(e + g);
    打印行(j[4] + 长度(k));

    // 实参位：字面量算术组合传同族形参
    打印行(收整数(2 * 3 + 1));
    打印行(收字符串("拼" + "接"));

    // 返回位
    打印行(算式());

    // 模板串（字面量来源）赋给字符串
    变量 名 = "奇语";
    变量 m: 字符串 = f"你好{名}";
    打印行(m);
}
