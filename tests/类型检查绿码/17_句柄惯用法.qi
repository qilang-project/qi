// 绿码：句柄惯用法 —— 非字面量来源的「家族错配」必须放行（这是裁决核心）
// 真实绿码（Harness MCP 描述符等）大量把字符串句柄存进 整数 变量再传递，
// codegen 以 ptr↔i64 协调；检查器只对字面量来源开火。
包 主程序;

导入 标准库.哈希表;

// 用户函数返回字符串 —— 返回值存进 整数 变量（句柄惯用法）
函数 造描述符() : 字符串 {
    返回 "{\"kind\":\"handle\"}";
}

// 形参是整数 —— 但绿码里常传句柄
函数 用描述符(h: 整数) : 整数 {
    返回 h - h;
}

函数 入口() {
    // ① 注册表返回整数句柄：哈希表句柄存 整数 变量再传回注册表函数
    变量 表: 整数 = 哈希表.创建整数表();
    哈希表.设置整数(表, "键", 7);
    打印行(哈希表.获取整数(表, "键"));

    // ② 用户函数返回 字符串 → 存 整数 变量（非字面量来源 → 检查器必须沉默）
    变量 h: 整数 = 造描述符();

    // ③ 句柄再传给 整数 形参（实参非字面量 → 沉默）
    变量 r = 用描述符(h);
    打印行(r);

    // ④ 函数返回值链上再赋值（连环非字面量赋值 → 沉默）
    变量 s: 字符串 = "初始";
    s = 造描述符();
    变量 h2: 整数 = 0;
    h2 = 造描述符();
    打印行(s);

    打印行("句柄惯用法通过");
}
