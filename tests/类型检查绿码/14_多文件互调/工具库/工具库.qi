// 被导入模块：跨文件符号（函数/结构体）供主程序使用
包 主程序;

类型 坐标 {
    整数 横;
    整数 纵;
}

函数 造坐标(x: 整数, y: 整数) : 坐标 {
    返回 新建 坐标 { 横: x, 纵: y };
}

函数 曼哈顿(p: 坐标) : 整数 {
    变量 h = p.横;
    变量 v = p.纵;
    如果 h < 0 { h = 0 - h; }
    如果 v < 0 { v = 0 - v; }
    返回 h + v;
}

函数 工具问候(名: 字符串) : 字符串 {
    返回 "工具库你好，" + 名;
}
