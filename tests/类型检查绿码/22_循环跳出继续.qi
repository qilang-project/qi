// 绿码：当 真 无限循环/当/跳出/继续 + 深嵌套块作用域 —— 零报错
包 主程序;

函数 入口() {
    // 无限循环（当 真）+ 跳出
    变量 计 = 0;
    当 真 {
        计 = 计 + 1;
        如果 计 >= 5 {
            跳出;
        }
    }
    打印行(计);

    // 当 + 继续（跳过偶数）
    变量 i = 0;
    变量 奇数和 = 0;
    当 i < 10 {
        i = i + 1;
        如果 i % 2 == 0 {
            继续;
        }
        奇数和 = 奇数和 + i;
    }
    打印行(奇数和);

    // 对于 + 跳出/继续 组合
    变量 找到 = 0 - 1;
    对于 k 在 0 直到 100 {
        如果 k < 10 {
            继续;
        }
        如果 k * k > 200 {
            找到 = k;
            跳出;
        }
    }
    打印行(找到);

    // 深嵌套块作用域：同名变量层层遮蔽
    变量 x = 1;
    如果 真 {
        变量 x = "第二层";
        如果 真 {
            变量 x = 3.5;
            打印行(x);
        }
        打印行(x);
    }
    打印行(x);
}
