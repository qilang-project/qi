// 整数/浮点数/布尔之间互比是合法的（codegen 会提升），比较检查不能误伤。
包 主程序;

函数 入口() {
    变量 整 = 5;
    变量 浮 = 5.0;
    变量 真值 = 真;
    如果 整 == 浮 { 打印行("整等于浮"); }
    如果 整 < 2.5 { 打印行("错"); } 否则 { 打印行("整不小于2.5"); }
    如果 1 == 真值 { 打印行("1等于真"); }
    如果 浮 >= 整 { 打印行("浮大于等于整"); }
    变量 名字 = "乙";
    如果 名字 != "甲" { 打印行("串不等"); }
    如果 名字 < "甲" { 打印行("串可比大小"); }
}
