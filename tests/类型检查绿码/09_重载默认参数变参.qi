// 绿码：元数重载 + 默认参数省略 + 变参边界 —— 零报错
包 主程序;

// 元数重载：同名两个签名
函数 面积(边: 整数) : 整数 {
    返回 边 * 边;
}

函数 面积(宽: 整数, 高: 整数) : 整数 {
    返回 宽 * 高;
}

// 默认参数：后两个可省
函数 问候(名字: 字符串, 前缀: 字符串 = "你好，", 尾巴: 字符串 = "！") : 字符串 {
    返回 前缀 + 名字 + 尾巴;
}

// 变参：0 个到多个
函数 求和(数字们...: 整数) : 整数 {
    变量 总 = 0;
    对于 n 在 数字们 {
        总 = 总 + n;
    }
    返回 总;
}

// 必需参数 + 变参混合
函数 带底求和(底: 整数, 数字们...: 整数) : 整数 {
    变量 总 = 底;
    对于 n 在 数字们 {
        总 = 总 + n;
    }
    返回 总;
}

函数 入口() {
    // 重载：两个元数各调一次
    打印行(面积(5));
    打印行(面积(3, 4));

    // 默认参数：省 0/1/2 个
    打印行(问候("张三"));
    打印行(问候("李四", "嗨，"));
    打印行(问候("王五", "喂，", "？"));

    // 变参：0 个 / 1 个 / 多个
    打印行(求和());
    打印行(求和(7));
    打印行(求和(1, 2, 3, 4));

    // 必需 + 变参边界：恰好只给必需
    打印行(带底求和(100));
    打印行(带底求和(100, 1, 2));
}
