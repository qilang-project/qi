// 绿码：模板字符串（f"..."）洞里塞复杂表达式 —— 零报错
包 主程序;

类型 人 {
    字符串 名;
    整数 岁;
}

函数 (自身 人) 简介() : 字符串 {
    返回 自身.名;
}

函数 平方(n: 整数) : 整数 {
    返回 n * n;
}

函数 入口() {
    变量 名字 = "张三";
    变量 年龄 = 25;
    变量 圆周率 = 3.14;

    // 洞里：变量 / 算术 / 函数调用 / 比较
    打印行(f"你好 {名字}，明年 {年龄 + 1} 岁");
    打印行(f"平方: {平方(7)}，双倍平方: {平方(3) * 2}");
    打印行(f"圆周率 {圆周率}");

    // 洞里：字段访问 / 方法调用
    变量 某人 = 新建 人 { 名: "李四", 岁: 30 };
    打印行(f"字段: {某人.岁}，方法: {某人.简介()}");

    // 模板串拼接 + 嵌套引用变量
    变量 前缀 = f"[{名字}]";
    打印行(前缀 + f" 年龄={年龄}");
}
