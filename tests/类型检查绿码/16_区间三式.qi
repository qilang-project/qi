// 绿码：对于 x 在 起..止 / 起 到 止 / 起 直到 止 三种区间 —— 零报错
包 主程序;

函数 上限() : 整数 {
    返回 4;
}

函数 入口() {
    // 半开 ..
    变量 甲 = 0;
    对于 i 在 0..5 {
        甲 = 甲 + i;
    }
    打印行(甲);

    // 闭区间 到
    变量 乙 = 0;
    对于 j 在 1 到 5 {
        乙 = 乙 + j;
    }
    打印行(乙);

    // 半开 直到（中文自然读法）
    变量 丙 = 0;
    对于 k 在 0 直到 5 {
        丙 = 丙 + k;
    }
    打印行(丙);

    // 区间端点是表达式/函数调用
    变量 丁 = 0;
    对于 m 在 1 到 上限() {
        丁 = 丁 + m;
    }
    打印行(丁);

    // 嵌套区间循环 + 循环变量参与索引
    变量 表: 数组<整数> = [10, 20, 30];
    变量 总 = 0;
    对于 r 在 0 直到 长度(表) {
        对于 c 在 0..2 {
            总 = 总 + 表[r] + c;
        }
    }
    打印行(总);

    // 零次迭代：起 >= 止 不倒走
    对于 z 在 5..5 {
        打印行("不可达");
    }
    打印行("零次迭代通过");
}
