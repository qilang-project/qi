// 绿码：闭包捕获外层变量 + 函数类型返回值 + 闭包作参数 —— 零报错
包 主程序;

// 闭包工厂：捕获 base
函数 制造加法器(base: 整数) : 函数(整数): 整数 {
    返回 闭包(值: 整数): 整数 {
        返回 值 + base;
    };
}

// 捕获两个变量
函数 制造步进(起点: 整数, 步长: 整数) : 函数(整数): 整数 {
    返回 闭包(次数: 整数): 整数 {
        返回 起点 + 次数 * 步长;
    };
}

// 函数值作参数（间接调用）
函数 施加两次(f: 函数(整数): 整数, x: 整数) : 整数 {
    返回 f(f(x));
}

函数 入口() {
    变量 加十 = 制造加法器(10);
    打印行(加十(5));
    打印行(加十(90));

    变量 步进 = 制造步进(100, 7);
    打印行(步进(3));

    // 闭包传给高阶函数
    打印行(施加两次(加十, 1));

    // 就地闭包：捕获局部字符串
    变量 前缀 = "结果=";
    变量 标注: 函数(整数): 字符串 = 闭包(n: 整数): 字符串 {
        返回 前缀 + 整数转字符串(n);
    };
    打印行(标注(42));
}
