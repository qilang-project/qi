// 绿码：特性默认方法 + 多类型 impl + 特性作参数 —— 零报错
包 主程序;

特性 报数 {
    函数 数值() : 整数;
    // 默认方法：调用抽象方法，做算术再拼字符串
    函数 播报() : 字符串 {
        变量 n = 自己.数值() * 2 + 1;
        返回 "结果是 " + 整数转字符串(n);
    }
}

类型 甲种 {
    整数 底数;
}

实现 报数 对于 甲种 {
    函数 数值() : 整数 {
        返回 自己.底数;
    }
}

类型 乙种 {
    字符串 标签;
    整数 计数;
}

// 覆盖默认方法
实现 报数 对于 乙种 {
    函数 数值() : 整数 {
        返回 自己.计数 * 3;
    }
    函数 播报() : 字符串 {
        返回 自己.标签 + " 数值 " + 整数转字符串(自己.数值());
    }
}

// 特性作参数类型（impl-Trait 式）
函数 广播(t: 报数) : 字符串 {
    返回 t.播报();
}

函数 入口() {
    变量 a = 新建 甲种 { 底数: 20 };
    变量 b = 新建 乙种 { 标签: "hello", 计数: 4 };
    打印行(a.播报());
    打印行(b.播报());
    打印行(广播(a));
    打印行(广播(b));
}
