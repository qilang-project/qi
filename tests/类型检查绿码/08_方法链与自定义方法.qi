// 绿码：方法返回自身类型形成调用链 + Go 式接收者方法 + 实现块方法 —— 零报错
包 主程序;

类型 计数器 {
    整数 数值;
}

// Go 式接收者方法：返回新计数器（值语义链）
函数 (自身 计数器) 增(n: 整数) : 计数器 {
    返回 新建 计数器 { 数值: 自身.数值 + n };
}

函数 (自身 计数器) 倍(n: 整数) : 计数器 {
    返回 新建 计数器 { 数值: 自身.数值 * n };
}

函数 (自身 计数器) 读() : 整数 {
    返回 自身.数值;
}

类型 文案 {
    字符串 内容;
}

实现 文案 {
    函数 接(尾: 字符串) : 文案 {
        返回 新建 文案 { 内容: 自己.内容 + 尾 };
    }
    函数 取() : 字符串 {
        返回 自己.内容;
    }
}

函数 入口() {
    变量 c = 新建 计数器 { 数值: 1 };
    // 三级方法链：增 → 倍 → 读
    变量 结果值: 整数 = c.增(4).倍(3).读();
    打印行(结果值);

    // 链上中间值存变量再续链
    变量 中 = c.增(9);
    打印行(中.倍(2).读());

    变量 t = 新建 文案 { 内容: "你好" };
    打印行(t.接("，").接("世界").取());
}
