// 绿码：类型转换（内建函数 + 作为）+ 字符串/数组内建方法 + 混合算术 —— 零报错
包 主程序;

函数 入口() {
    // 内建转换全家
    变量 i = 字符串转整数("42");
    打印行(i + 1);
    变量 f = 字符串转浮点数("2.5");
    打印行(f * 2.0);
    变量 s = 整数转字符串(99) + "!" + 浮点数转字符串(1.5);
    打印行(s);
    变量 g = 整数转浮点数(3);
    打印行(g + 0.5);
    变量 j = 浮点数转整数(9.9);
    打印行(j);

    // 混合算术：整数+浮点 提升
    变量 混 = 3 + 4.5;
    打印行(混);

    // + 拼接：任一侧字符串
    打印行("编号" + 5);
    打印行(3.5 + "元");

    // 未导入标准库模块裸用：字符串::字节长度（检查器应沉默或正确解析）
    变量 词 = "你好世界";
    打印行(字符串::字节长度(词));

    // 布尔 + 逻辑运算符
    变量 b = 真 且 (1 < 2);
    变量 c = 假 或 非 假;
    如果 b 且 c {
        打印行("逻辑通过");
    }

    // 一元负号 / 位运算
    变量 n = 0 - 8;
    打印行(n * n);
    打印行(6 & 3);
    打印行(6 | 3);
    打印行(1 << 4);
}
