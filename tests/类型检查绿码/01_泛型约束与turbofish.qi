// 绿码：带约束泛型 + turbofish + 泛型枚举/结构体 —— QI_TYPECHECK 必须零报错
包 主程序;

特性 可称重 {
    函数 重量() : 整数;
}

类型 箱子 {
    整数 千克;
}

实现 可称重 对于 箱子 {
    函数 重量() : 整数 {
        返回 自己.千克;
    }
}

类型 包裹 {
    整数 克;
}

实现 可称重 对于 包裹 {
    函数 重量() : 整数 {
        返回 自己.克 / 1000;
    }
}

// 带约束泛型：体内调用约束方法
函数 更重<T: 可称重>(a: T, b: T) : T {
    如果 (a.重量() >= b.重量()) {
        返回 a;
    }
    返回 b;
}

// 无约束泛型 + turbofish 调用点
函数 挑一个<T>(x: T, y: T) : T {
    如果 x > y { 返回 x; }
    返回 y;
}

枚举 盒装<T> { 满(T), 空盒 }

类型 对<T> {
    T 左;
    T 右;
}

函数 入口() {
    变量 甲 = 新建 箱子 { 千克: 7 };
    变量 乙 = 新建 箱子 { 千克: 3 };
    变量 胜者 = 更重(甲, 乙);
    打印行(胜者.重量());

    // turbofish 显式实例化
    打印行(挑一个::<整数>(4, 9));
    打印行(挑一个::<字符串>("a", "b"));
    打印行(挑一个(1.5, 2.5));

    // 泛型结构体 + 泛型枚举 + 嵌套泛型（>> 之间要空格）
    变量 点: 对<整数> = 新建 对<整数> { 左: 1, 右: 2 };
    点.左 = 10;
    打印行(点.左 + 点.右);
    变量 套: 盒装<对<整数> > = 盒装.满(点);
    匹配 套 {
        满(内) => { 打印行(内.右); }
        空盒 => { 打印行(0); }
    }
}
