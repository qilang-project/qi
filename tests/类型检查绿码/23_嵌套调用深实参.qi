// 绿码：函数嵌套调用实参 + 调用结果直接再运算/再传参 —— 零报错
包 主程序;

函数 平方(n: 整数) : 整数 {
    返回 n * n;
}

函数 相加(a: 整数, b: 整数) : 整数 {
    返回 a + b;
}

函数 修饰(s: 字符串, 次: 整数) : 字符串 {
    变量 r = s;
    对于 i 在 1 直到 次 {
        r = r + s;
    }
    返回 r;
}

函数 入口() {
    // 三层嵌套实参
    打印行(相加(平方(2), 平方(3)));
    打印行(平方(相加(1, 2)));
    打印行(相加(相加(1, 2), 相加(3, 4)));

    // 调用结果直接进算术再传参
    打印行(平方(2) * 相加(1, 1) + 平方(1));

    // 字符串函数结果再传参
    打印行(修饰(修饰("哈", 2), 2));

    // 调用结果拼字符串
    打印行("平方=" + 平方(9));

    // 条件表达式里嵌调用
    如果 平方(3) > 相加(4, 4) {
        打印行("9 > 8");
    }

    // 循环边界是嵌套调用
    对于 i 在 0 直到 相加(1, 2) {
        打印行(i);
    }
}
