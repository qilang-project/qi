// 绿码：带载荷枚举 + 匹配全解构（守卫/或模式/范围/通配符/嵌套载荷）—— 零报错
包 主程序;

枚举 形状 {
    圆(浮点数),
    矩形(浮点数, 浮点数),
    点
}

枚举 事件 {
    按键(整数),
    挪动(整数, 整数),
    关闭
}

函数 面积(s: 形状) : 浮点数 {
    匹配 s {
        圆(r) => { 返回 3.14159 * r * r; }
        矩形(w, h) => { 返回 w * h; }
        点 => { 返回 0.0; }
    }
    返回 0.0;
}

函数 描述事件(e: 事件) : 字符串 {
    匹配 e {
        按键(k) 如果 k == 27 => { 返回 "ESC"; }
        按键(k) => { 返回 "键 " + 整数转字符串(k); }
        挪动(x, y) => { 返回 "移到 " + 整数转字符串(x) + "," + 整数转字符串(y); }
        关闭 => { 返回 "再见"; }
    }
    返回 "";
}

函数 分级(n: 整数) : 字符串 {
    匹配 n {
        0 => { 返回 "零"; }
        1 | 2 | 3 => { 返回 "小"; }
        n 如果 n < 10 => { 返回 "中"; }
        _ => { 返回 "大"; }
    }
    返回 "";
}

函数 入口() {
    打印行(面积(形状.圆(2.0)));
    打印行(面积(形状.矩形(3.0, 4.0)));
    打印行(面积(形状.点));
    打印行(描述事件(事件.按键(27)));
    打印行(描述事件(事件.按键(65)));
    打印行(描述事件(事件.挪动(10, 20)));
    打印行(描述事件(事件.关闭));
    打印行(分级(0));
    打印行(分级(2));
    打印行(分级(5));
    打印行(分级(99));
}
