// 绿码：尝试/捕获/最终 + 抛出 + 跨函数传播 + 嵌套尝试 —— 零报错
包 主程序;

函数 危险除法(甲: 整数, 乙: 整数) : 整数 {
    如果 乙 == 0 {
        抛出 "除数为零";
    }
    返回 甲 / 乙;
}

函数 二级(n: 整数) : 整数 {
    // 异常穿透本层
    返回 危险除法(100, n);
}

函数 入口() {
    // 基本 尝试/捕获
    尝试 {
        变量 r = 危险除法(10, 2);
        打印行(r);
        变量 x = 危险除法(1, 0);
        打印行("不可达");
    } 捕获 错误 {
        打印行("抓到：" + 错误);
    }

    // 跨栈传播 + 最终
    尝试 {
        变量 y = 二级(0);
        打印行(y);
    } 捕获 错误 {
        打印行("跨栈抓到：" + 错误);
    } 最终 {
        打印行("最终必走");
    }

    // 嵌套尝试：内层抓不住类型交给外层？——内层直接抓
    尝试 {
        尝试 {
            抛出 "内层错误";
        } 捕获 内错 {
            打印行("内层抓到：" + 内错);
            抛出 "转抛的错误";
        }
    } 捕获 外错 {
        打印行("外层抓到：" + 外错);
    }

    打印行("完成");
}
