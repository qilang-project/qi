// 绿码（只编译不跑）：AI 原语 询问::<T> / 异步询问 / 工具模式 / 选项字段结构化输出
// 运行需要 QI_CHAT_URL/QI_CHAT_KEY —— 断言脚本对本文件只做 compile 检查。
包 主程序;

导入 标准库.大模型 作为 大模型;
导入 标准库.操作系统 作为 系统;

类型 人物 {
    名字: 字符串,
    年龄: 选项<整数>
}

// 工具函数：签名即工具（工具模式 从签名派生 schema）
函数 查天气(城市: 字符串, 单位: 字符串) : 字符串 {
    返回 "晴";
}

函数 入口() {
    // 工具模式：编译期改写，从函数签名生成 JSON schema
    打印行(工具模式(查天气));

    变量 端点: 字符串 = 系统.获取环境变量("QI_CHAT_URL");
    变量 密钥: 字符串 = 系统.获取环境变量("QI_CHAT_KEY");
    如果 (端点 == "" || 密钥 == "") {
        打印行("未配置端点，跳过在线部分");
        返回;
    }

    变量 会话: 整数 = 大模型.创建会话(端点, "qwen-plus", 密钥);

    // 询问::<T>：结构化输出直接建 T
    变量 谁 = 询问::<人物>(会话, "介绍鲁迅");
    打印行(谁.名字);
    匹配 谁.年龄 {
        有(岁) => { 打印行(岁); }
        无 => { 打印行("年龄未知"); }
    }

    // 异步询问::<T> → 未来<T> + 等待
    变量 f: 未来<人物> = 异步询问::<人物>(会话, "介绍老舍");
    变量 别人: 人物 = 等待 f;
    打印行(别人.名字);
}
