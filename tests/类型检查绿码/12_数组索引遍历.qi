// 绿码：数组字面量/索引读写/长度/遍历/作参数与返回值 —— 零报错
包 主程序;

函数 首项(a: 数组<整数>) : 整数 {
    返回 a[0];
}

函数 造数组() : 数组<整数> {
    返回 [7, 8, 9];
}

函数 入口() {
    变量 数列: 数组<整数> = [10, 20, 30];
    打印行(数列[0]);
    打印行(数列[1] + 数列[2]);

    // 索引写
    数列[1] = 99;
    打印行(数列[1]);

    // 长度 + 下标循环（直到 = 半开区间）
    变量 总 = 0;
    对于 i 在 0 直到 长度(数列) {
        总 = 总 + 数列[i];
    }
    打印行(总);

    // 元素直接遍历
    对于 x 在 数列 {
        打印行(x);
    }

    // 字符串数组 + 浮点数组
    变量 词 = ["甲", "乙", "丙"];
    打印行(词[2]);
    变量 向量: 数组<浮点数> = [1.5, 2.5];
    打印行(向量[0] + 向量[1]);

    // 数组进出函数
    打印行(首项(数列));
    变量 得 = 造数组();
    打印行(得[2]);

    // 表达式作索引
    变量 k = 1;
    打印行(数列[k + 1]);
}
