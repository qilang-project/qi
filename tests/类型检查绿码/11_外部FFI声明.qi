// 绿码：外部 C FFI 声明 + 裸调用（含变参 printf 家族除外，选稳定 libm/libc）—— 零报错
包 主程序;

外部 "m" {
    函数 cos(x: 浮点数): 浮点数;
    函数 sqrt(x: 浮点数): 浮点数;
    函数 pow(底: 浮点数, 指: 浮点数): 浮点数;
}

外部 "c" {
    函数 abs(n: 整数): 整数;
    函数 strlen(s: 字符串): 整数;
}

函数 入口() {
    变量 c: 浮点数 = cos(0.0);
    打印行(c);

    变量 r: 浮点数 = sqrt(16.0);
    打印行(r);

    // FFI 结果直接进算术
    变量 p: 浮点数 = pow(2.0, 10.0) + sqrt(4.0);
    打印行(p);

    变量 a: 整数 = abs(0 - 5);
    打印行(a);

    // FFI 结果传给用户逻辑
    变量 n: 整数 = strlen("你好") + abs(0 - 3);
    打印行(n);
}
