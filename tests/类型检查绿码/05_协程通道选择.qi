// 绿码：启动/通道/<-/选择/等待/异步函数 全家桶 —— 零报错
包 主程序;

函数 生产(信道: 通道<整数>, 起: 整数) {
    变量 i = 起;
    当 i < 起 + 3 {
        信道 <- i;
        i = i + 1;
    }
}

函数 喊话(信道: 通道<字符串>) {
    信道 <- "来自协程";
}

// 异步函数：返回 未来<T>，体内返回值自动装箱
函数 异步平方(n: 整数) : 未来<整数> {
    返回 n * n;
}

函数 入口() {
    // 通道 + 启动 + <-
    变量 数道: 通道<整数> = 通道<整数>(8);
    启动 生产(数道, 10);
    变量 一 = <-数道;
    变量 二 = <-数道;
    变量 三 = <-数道;
    打印行(一 + 二 + 三);

    变量 话道: 通道<字符串> = 通道<字符串>(1);
    启动 喊话(话道);
    变量 话: 字符串 = <-话道;
    打印行(话);

    // 选择：就绪通道优先 / 超时分支
    变量 甲道 = 通道<整数>(4);
    甲道 <- 42;
    选择 {
        情况 值 := <-甲道:
            打印行("收到 " + 整数转字符串(值));
        情况 超时(200):
            打印行("不应超时");
    }
    变量 空道 = 通道<整数>(4);
    选择 {
        情况 值 := <-空道:
            打印行("不应收到 " + 整数转字符串(值));
        情况 超时(100):
            打印行("超时分支");
    }

    // 未来 + 等待（含 未来::就绪 静态构造）
    变量 任务甲: 未来<整数> = 异步平方(6);
    变量 结果值: 整数 = 等待 任务甲;
    打印行(结果值);
    变量 就绪: 未来<整数> = 未来::就绪(7);
    打印行(等待 就绪);
    打印行(等待 异步平方(9));
}
