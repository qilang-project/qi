// 绿码：选项<T>/结果<T> 四构造子 + 定型四规则 + 链式函数传递 —— 零报错
包 主程序;

函数 找用户(编号: 整数) : 选项<字符串> {
    如果 编号 == 1 {
        返回 有("张三");
    }
    返回 无;
}

函数 除法(甲: 整数, 乙: 整数) : 结果<整数> {
    如果 乙 == 0 {
        返回 败("除数为零");
    }
    返回 成(甲 / 乙);
}

// 选项作参数（实参位定型）
函数 拆选项(o: 选项<整数>) : 整数 {
    匹配 o {
        有(v) => { 返回 v; }
        无 => { 返回 0 - 1; }
    }
    返回 0;
}

// 结果链：一个结果的载荷再进下一个计算
函数 连除(a: 整数, b: 整数, c: 整数) : 结果<整数> {
    匹配 除法(a, b) {
        成(中) => { 返回 除法(中, c); }
        败(错) => { 返回 败(错); }
    }
    返回 败("不可达");
}

函数 入口() {
    匹配 找用户(1) {
        有(名) 如果 名 == "张三" => { 打印行("管理员：" + 名); }
        有(名) => { 打印行("用户：" + 名); }
        无 => { 打印行("查无此人"); }
    }
    匹配 找用户(9) {
        有(名) => { 打印行(名); }
        无 => { 打印行("查无此人"); }
    }

    // 注解定型 + 实参位定型 + 反推
    变量 甲: 选项<整数> = 有(42);
    打印行(拆选项(甲));
    打印行(拆选项(无));
    变量 乙 = 成(7);
    匹配 乙 {
        成(数) => { 打印行(数); }
        败(错) => { 打印行(错); }
    }

    匹配 连除(100, 5, 2) {
        成(商) => { 打印行(商); }
        败(错) => { 打印行("错误：" + 错); }
    }
    匹配 连除(100, 0, 2) {
        成(商) => { 打印行(商); }
        败(错) => { 打印行("错误：" + 错); }
    }
}
