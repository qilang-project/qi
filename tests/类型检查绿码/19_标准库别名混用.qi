// 绿码：标准库导入别名 + 模块.函数 / 模块::函数 两种限定 + 裸模块名 —— 零报错
包 主程序;

导入 标准库.文本 作为 T;
导入 标准库.数学;
导入 标准库.输入输出 作为 IO;

函数 入口() {
    // 别名限定调用
    变量 s = "你好世界";
    打印行(T.包含(s, "世界"));

    // 原模块名（导入过）
    打印行(数学.最大(3.0, 9.0));
    打印行(数学.绝对值(0.0 - 7.0));

    // :: 形式限定
    IO::打印行("双冒号调用");

    // 未导入的标准库模块裸用（镜像 codegen：无需导入）
    打印行(字符串::字节长度("abc"));

    // 注册表返回值直接进表达式
    变量 m = 数学.最小(4.0, 2.0) + 数学.最大(1.0, 8.0);
    打印行(m);
}
