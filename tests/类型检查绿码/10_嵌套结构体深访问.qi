// 绿码：结构体套结构体 + 深层字段链 + 嵌套字面量 —— 零报错
包 主程序;

类型 地址 {
    字符串 城市;
    整数 邮编;
}

类型 公司 {
    字符串 名称;
    地址 所在;
}

类型 员工 {
    字符串 姓名;
    公司 雇主;
    整数 工号;
}

函数 入口() {
    // 嵌套字面量一次成型
    变量 e = 新建 员工 {
        姓名: "赵六",
        雇主: 新建 公司 {
            名称: "奇语科技",
            所在: 新建 地址 { 城市: "北京", 邮编: 100000 }
        },
        工号: 42
    };

    // 深层字段链读
    打印行(e.姓名);
    打印行(e.雇主.名称);
    打印行(e.雇主.所在.城市);
    打印行(e.雇主.所在.邮编 + e.工号);

    // 深层字段写
    e.雇主.所在.邮编 = 200000;
    打印行(e.雇主.所在.邮编);

    // 中间层取出再访问
    变量 a: 地址 = e.雇主.所在;
    打印行(a.城市);
}
