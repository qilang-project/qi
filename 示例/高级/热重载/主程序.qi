// 运行时反射 + dlopen 插件热重载 综合示例
//
// 面向 AI Agent 时代「prompt/工具变了不重启」的诉求：
//   1) 反射：运行中的程序自省「当前有哪些中文函数 / 结构体」——AI 知道自己有哪些工具；
//   2) 插件热重载：运行中 dlopen 一个 Qi 编的工具 .so，卸载后换新版，同进程内行为切换、不重启。
//
// 运行：见同目录 运行.sh（先编两个插件，再运行本程序）。

导入 标准库.反射;
导入 标准库.插件;

// —— 一些用户定义，供反射自省演示 ——
类型 用户 {
    名字: 字符串;
    年龄: 整数;
}

枚举 颜色 {
    红,
    绿,
    蓝,
}

函数 问候(名: 字符串): 字符串 {
    返回 "你好, " + 名;
}

函数 相加(甲: 整数, 乙: 整数): 整数 {
    返回 甲 + 乙;
}

函数 入口() {
    打印行("========== 运行时反射自省 ==========");
    变量 数量: 整数 = 反射.函数数量();
    打印("用户函数数量: ");
    打印行(数量);

    变量 i: 整数 = 0;
    当 (i < 数量) {
        变量 名: 字符串 = 反射.函数名(i);
        打印("  ");
        打印(名);
        打印(" : ");
        打印行(反射.函数签名(名));
        i = i + 1;
    }

    打印("有函数 问候? ");
    如果 (反射.有函数("问候") == 1) {
        打印行("是");
    } 否则 {
        打印行("否");
    }
    打印("有函数 不存在? ");
    如果 (反射.有函数("不存在的函数") == 1) {
        打印行("是");
    } 否则 {
        打印行("否");
    }

    打印("结构体 用户 的字段: ");
    打印行(反射.结构体字段("用户"));

    变量 名单 = 反射.函数列表();
    打印("反射.函数列表() 长度: ");
    打印行(名单.长度);

    打印行("");
    打印行("========== dlopen 插件热重载 ==========");

    // —— 加载 v1，调用 ——
    变量 句柄1: 整数 = 插件.加载("./工具v1.plugin");
    如果 (句柄1 == 0) {
        打印("加载 v1 失败: ");
        打印行(插件.错误());
        返回;
    }
    变量 处理1: 整数 = 插件.取函数(句柄1, "chuli");
    变量 问候1: 整数 = 插件.取函数(句柄1, "wenhou");
    打印("v1  处理(21) = ");
    打印行(插件.调用整数(处理1, 21));
    打印("v1  问候(\"齐\") = ");
    打印行(插件.调用字符串(问候1, "齐"));
    插件.卸载(句柄1);

    // —— 同一进程内换 v2（进程没有重启）——
    变量 句柄2: 整数 = 插件.加载("./工具v2.plugin");
    如果 (句柄2 == 0) {
        打印("加载 v2 失败: ");
        打印行(插件.错误());
        返回;
    }
    变量 处理2: 整数 = 插件.取函数(句柄2, "chuli");
    变量 问候2: 整数 = 插件.取函数(句柄2, "wenhou");
    打印("v2  处理(21) = ");
    打印行(插件.调用整数(处理2, 21));
    打印("v2  问候(\"齐\") = ");
    打印行(插件.调用字符串(问候2, "齐"));
    插件.卸载(句柄2);

    打印行("");
    打印行("同一进程内 处理(21): 42 → 63；问候: v1 → v2。行为已切换，进程从未重启。");
}
