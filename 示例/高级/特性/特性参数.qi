// 特性作参数类型（impl-Trait 式）：参数类型写特性名，
// 编译器自动改写成带约束的泛型（隐式单态化）—— 零运行时开销的多态。

包 主程序;

特性 会叫 {
    函数 叫() : 字符串;
}

类型 狗 {
    字符串 名字;
}

实现 会叫 对于 狗 {
    函数 叫() : 字符串 {
        返回 "汪！";
    }
}

类型 猫 {
    字符串 名字;
}

实现 会叫 对于 猫 {
    函数 叫() : 字符串 {
        返回 "喵～";
    }
}

// 参数类型是特性：任何实现了 会叫 的类型都能传进来
函数 让它叫(动物: 会叫) : 字符串 {
    返回 动物.叫();
}

// 多个特性参数：各自独立类型参数（狗猫混traits传都行）
函数 二重奏(甲: 会叫, 乙: 会叫) : 字符串 {
    返回 甲.叫() + " " + 乙.叫();
}

函数 入口() {
    变量 小狗 = 新建 狗 { 名字: "旺财" };
    变量 小猫 = 新建 猫 { 名字: "咪咪" };

    打印行(让它叫(小狗));
    打印行(让它叫(小猫));
    打印行(二重奏(小狗, 小猫));
}
