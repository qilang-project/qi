// 特性默认方法：特性里可以直接写方法体，实现块没覆盖时自动用默认体。
// 默认体里能调 自己.抽象方法()（模板方法模式 —— 无继承语言的复用核心）。

包 主程序;

特性 问候 {
    函数 名字() : 字符串;
    // 默认方法：调用抽象方法 名字()，各实现类型自动获得
    函数 打招呼() : 字符串 {
        返回 "你好，" + 自己.名字() + "！";
    }
}

类型 学生 {
    字符串 姓名;
}

// 只实现 名字()，打招呼() 用特性默认体
实现 问候 对于 学生 {
    函数 名字() : 字符串 {
        返回 自己.姓名;
    }
}

类型 老师 {
    字符串 姓名;
}

// 覆盖 打招呼() —— 覆盖优先于默认体
实现 问候 对于 老师 {
    函数 名字() : 字符串 {
        返回 自己.姓名;
    }
    函数 打招呼() : 字符串 {
        返回 自己.名字() + "老师好！";
    }
}

// 特性参数 + 默认方法组合：多态调用统一入口
函数 迎接(人: 问候) : 字符串 {
    返回 人.打招呼();
}

函数 入口() {
    变量 小明 = 新建 学生 { 姓名: "小明" };
    变量 王 = 新建 老师 { 姓名: "王" };

    打印行(小明.打招呼());
    打印行(王.打招呼());
    打印行(迎接(小明));
    打印行(迎接(王));
}
