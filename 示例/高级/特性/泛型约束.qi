// 泛型约束：函数 最大值<T: 可比较>(a: T, b: T): T
// 单态化时校验：类型实参必须有 `实现 可比较 对于 该类型`。

包 主程序;

特性 可比较 {
    函数 比较值() : 整数;
}

类型 温度 {
    整数 摄氏度;
}

实现 可比较 对于 温度 {
    函数 比较值() : 整数 {
        返回 自己.摄氏度;
    }
}

类型 重量 {
    整数 克数;
}

实现 可比较 对于 重量 {
    函数 比较值() : 整数 {
        返回 自己.克数;
    }
}

// 带约束的泛型函数：体内可以放心调 比较值()（约束保证实现存在）
函数 最大值<T: 可比较>(a: T, b: T) : T {
    如果 (a.比较值() >= b.比较值()) {
        返回 a;
    }
    返回 b;
}

函数 入口() {
    变量 冷 = 新建 温度 { 摄氏度: 3 };
    变量 热 = 新建 温度 { 摄氏度: 37 };
    变量 更热 = 最大值(冷, 热);
    打印行("更热的温度(摄氏度):");
    打印行(更热.比较值());

    变量 轻 = 新建 重量 { 克数: 120 };
    变量 重 = 新建 重量 { 克数: 900 };
    变量 更重 = 最大值(轻, 重);
    打印行("更重的重量(克):");
    打印行(更重.比较值());
}
