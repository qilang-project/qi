// R3 铁证：统一调度 —— `启动` 把两个协程排进同一个 M:N 执行器，
// 它们通过「可挂起通道」通信：生产者边产边让出；消费者收空通道时挂起（不占线程），
// 生产者一发即被唤醒。时序交错 + RC 全 0 证明真跑在一个调度器上、通道传值不漏。
包 主程序;
导入 标准库.输入输出 作为 IO;

变量 数据通 = 通道<整数>(8);   // 生产者→消费者
变量 结果通 = 通道<整数>(1);   // 消费者→主程序

函数 生产者() : 未来<整数> {
    变量 i: 整数 = 1;
    当 (i <= 3) {
        IO.打印行("  生产 " + 整数转字符串(i));
        数据通 <- i * 10;
        等待 让出();              // 让出：给消费者机会
        i = i + 1;
    }
    返回 0;
}

函数 消费者() : 未来<整数> {
    变量 和: 整数 = 0;
    变量 n: 整数 = 0;
    当 (n < 3) {
        变量 x: 整数 = <- 数据通;   // 空通道 → 挂起等待被唤醒
        IO.打印行("消费 " + 整数转字符串(x));
        和 = 和 + x;
        n = n + 1;
    }
    结果通 <- 和;
    返回 和;
}

函数 入口() {
    启动 生产者();               // 入协程执行器
    启动 消费者();               // 入协程执行器
    执行器运行全部();            // 驱动二者协作到完成
    变量 总: 整数 = <- 结果通;    // 顶层收结果（协程模式下不足则驱动执行器）
    IO.打印行("消费总和 = " + 整数转字符串(总));
}
