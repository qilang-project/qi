// R2 验收 B + D：结构体/数组跨挂起（含嵌套结构体字段读写）+ 协程返回结构体。
//
// - 等待 前创建嵌套结构体与数组，等待 后字段读写/数组读；
// - 协程返回 结构体（promise +1 take，走 等待 未来<结构体> 的延迟解码直通路）；
// - QI_RC_REPORT=1 必须全 0。
//
// 运行：QI_CORO=1 QI_RC_REPORT=1 qi run RC结构体跨挂起测.qi

包 主程序;

类型 坐标 {
    整数 x;
    整数 y;
}

类型 轨迹 {
    字符串 名称;
    坐标 起点;
    整数 步数;
}

函数 走线(编号: 整数) : 未来<轨迹> {
    变量 t: 轨迹 = 新建 轨迹 {
        名称: 整数转字符串(编号) + "路",
        起点: 新建 坐标 { x: 1, y: 2 },
        步数: 0
    };
    变量 nums: 数组<整数> = [10, 20];       // 数组跨挂起
    等待 让出();                             // 挂起点 1
    t.步数 = t.步数 + 长度(nums);            // 挂起后字段写 + 数组读
    t.起点.x = t.起点.x + 100;               // 嵌套字段写
    等待 异步睡眠(5);                        // 挂起点 2
    t.步数 = t.步数 + 1;
    返回 t;                                  // 返回结构体（promise +1）
}

函数 入口() {
    变量 r: 轨迹 = 等待 走线(9);
    打印行("名称: " + r.名称);
    打印行("起点x: " + 整数转字符串(r.起点.x));
    打印行("步数: " + 整数转字符串(r.步数));
    如果 r.起点.x == 101 && r.步数 == 3 {
        打印行("结构体跨挂起字段读写正确 ✓");
    } 否则 {
        打印行("错误：字段值不符");
    }
}
