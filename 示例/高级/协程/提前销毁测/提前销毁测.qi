// R2 灵魂测试 C：提前销毁 —— 协程停在挂起点时直接 destroy，frame 内 RC 槽必须释放。
//
// 丙 在首个挂起点前创建字符串/结构体/数组 RC 局部；spawn 后停在首挂起点；
// 取消未来() 直接 destroy —— destroy 克隆走 cleanup 路径，coro.free 前逐槽释放。
// 挂起点之后的代码（打印/返回）永不执行。QI_RC_REPORT=1 必须全 0。
//
// 变体：丁 被执行器单步() 推进到第二个挂起点再取消（第二段 RC 局部也已创建）。
//
// 运行：QI_CORO=1 QI_RC_REPORT=1 qi run 提前销毁测.qi

包 主程序;

类型 包裹 {
    字符串 标签;
    整数 重量;
}

函数 丙() : 未来<整数> {
    变量 s: 字符串 = 整数转字符串(42) + "号包裹";          // RC 串（运行时拼接）
    变量 p: 包裹 = 新建 包裹 { 标签: s + "-贴", 重量: 5 };  // RC 结构体（含串字段）
    变量 a: 数组<整数> = [1, 2, 3];                          // RC 数组
    打印行("丙: 挂起前 " + s);
    等待 让出();                        // ← 停在这里被 destroy
    打印行("丙: 不该打印 " + p.标签 + 整数转字符串(长度(a)));
    返回 1;
}

函数 丁() : 未来<整数> {
    变量 s1: 字符串 = 整数转字符串(7) + "段一";
    打印行("丁: 第一段 " + s1);
    等待 让出();                        // 挂起点 1（单步跨过）
    变量 s2: 字符串 = s1 + "-段二";     // 第二段 RC 局部
    打印行("丁: 第二段 " + s2);
    等待 让出();                        // ← 停在这里被 destroy
    打印行("丁: 不该打印 " + s2);
    返回 2;
}

函数 入口() {
    // 场景 1：停在首挂起点直接取消
    变量 f1: 未来<整数> = 丙();        // spawn：跑到首挂起点（打印 丙: 挂起前）
    取消未来(f1);                       // destroy → cleanup 释放 s/p/a
    打印行("丙已取消");

    // 场景 2：单步推进一次（到第二挂起点）再取消
    变量 f2: 未来<整数> = 丁();        // 停在挂起点 1
    执行器单步();                       // resume 一次 → 打印 丁: 第二段，停在挂起点 2
    取消未来(f2);                       // destroy → cleanup 释放 s1/s2
    打印行("丁已取消");
}
