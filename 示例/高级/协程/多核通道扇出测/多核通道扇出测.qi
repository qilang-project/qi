包 主程序;
导入 标准库.输入输出 作为 IO;
变量 活通 = 通道<整数>(2);
变量 完成通 = 通道<整数>(64);
函数 消费者() : 未来<整数> { 变量 x: 整数 = <- 活通; 完成通 <- x; 返回 x; }
函数 生产者() : 未来<整数> { 变量 i: 整数 = 0; 当 (i < 10) { 活通 <- i; i = i + 1; } 返回 10; }
函数 入口() {
    变量 i: 整数 = 0; 当 (i < 10) { 启动 消费者(); i = i + 1; }
    启动 生产者(); 执行器运行全部();
    变量 和: 整数 = 0; 变量 k: 整数 = 0;
    当 (k < 10) { 和 = 和 + (<- 完成通); k = k + 1; }
    IO.打印行(模板"和={和}(应45)");
}
