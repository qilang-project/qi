包 主程序;
导入 标准库.输入输出 作为 IO;
变量 通 = 通道<整数>(4);
// 纯 CPU 函数(无挂起点) —— 目前走 tokio
函数 纯算(x: 整数) : 整数 { 变量 s: 整数 = 0; 变量 i: 整数 = 0; 当 (i < x) { s = s + i; i = i + 1; } 返回 s; }
// 协程:用通道(含挂起点→自动协程化)
函数 生产者() : 未来<整数> { 变量 i: 整数 = 0; 当 (i < 3) { 通 <- 纯算(100); i = i + 1; } 返回 3; }
函数 消费者() : 未来<整数> { 变量 和: 整数 = 0; 变量 n: 整数 = 0; 当 (n < 3) { 和 = 和 + (<- 通); n = n + 1; } 返回 和; }
函数 入口() {
    启动 生产者(); 启动 消费者();
    执行器运行全部();
    // 也 启动 一个纯 CPU 的(走 tokio)
    IO.打印行("协程通道跑完(每个纯算(100)=4950,3个入通道)");
    IO.打印行("纯算直接调=" + 整数转字符串(纯算(100)));
}
