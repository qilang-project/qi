// 挂起点恢复值正确性测试（Round 1 / QI_CORO=1）。
//
// 协程含两次 `等待 异步睡眠(ms)` 挂起点，中间对**局部整数**累加。
// 局部整数跨两次挂起由 LLVM CoroSplit 自动搬进 frame，最终返回值须算对。
//
// 期望：累加 = 10 + 20 + 30 = 60；跨两次挂起后返回 60。
//
// 运行：QI_CORO=1 qi run 挂起值测.qi

包 主程序;

函数 累加器() : 未来<整数> {
    变量 总和: 整数 = 0;
    总和 = 总和 + 10;
    等待 异步睡眠(10);        // 挂起点 1（局部 总和 跨挂起存活）
    总和 = 总和 + 20;
    等待 异步睡眠(10);        // 挂起点 2
    总和 = 总和 + 30;
    返回 总和;               // 60
}

函数 入口() {
    变量 结果值: 整数 = 等待 累加器();   // 直接 等待：executor 驱动到完成取值
    打印行("累加结果 = " + 整数转字符串(结果值));
    如果 结果值 == 60 {
        打印行("跨挂起点局部累加正确 ✓");
    } 否则 {
        打印行("错误：期望 60");
    }
}
