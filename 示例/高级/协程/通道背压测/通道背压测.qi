包 主程序;
导入 标准库.输入输出 作为 IO;
变量 通 = 通道<整数>(2);
函数 生产者() : 未来<整数> {
    变量 i: 整数 = 0;
    当 (i < 5) { IO.打印行("发 " + 整数转字符串(i)); 通 <- i; i = i + 1; }
    IO.打印行("发完5个"); 返回 5;
}
函数 消费者() : 未来<整数> {
    变量 n: 整数 = 0;
    当 (n < 5) { 变量 x: 整数 = <- 通; IO.打印行("  收 " + 整数转字符串(x)); 等待 让出(); n = n + 1; }
    返回 5;
}
函数 入口() { 启动 生产者(); 启动 消费者(); 执行器运行全部(); IO.打印行("完成"); }
