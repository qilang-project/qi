// R2 验收 A + D + F：RC 字符串跨挂起点 + 协程返回字符串 + retain/release 平衡。
//
// - 等待 前创建字符串（运行时拼接产物，非字面量），等待 后使用并再拼接；
// - 跨两种挂起点（让出 / 异步睡眠）；挂起前后各用一次（F：计数自洽）；
// - 协程返回 字符串（promise +1 take），同步侧 等待 拿到后使用；
// - QI_RC_REPORT=1 必须全 0。
//
// 运行：QI_CORO=1 QI_RC_REPORT=1 qi run RC字符串跨挂起测.qi

包 主程序;

函数 织字(编号: 整数) : 未来<字符串> {
    变量 头: 字符串 = 整数转字符串(编号) + "号线";   // 运行时拼接（OWNED，非字面量）
    打印行("挂起前用: " + 头);                          // F：挂起前用一次
    等待 让出();                                        // 挂起点 1（头 跨挂起存活）
    变量 身: 字符串 = 头 + "-中段";                     // 挂起后再用（F：平衡）
    等待 异步睡眠(5);                                   // 挂起点 2（头/身 都跨挂起）
    变量 尾: 字符串 = 身 + "-完";
    打印行("挂起后拼: " + 尾);
    返回 尾 + "!";                                      // 返回 RC 串（promise +1）
}

函数 入口() {
    变量 甲串: 字符串 = 等待 织字(3);    // take：+1 移交入口局部
    变量 乙串: 字符串 = 等待 织字(7);
    打印行("甲: " + 甲串);
    打印行("乙: " + 乙串);
}
