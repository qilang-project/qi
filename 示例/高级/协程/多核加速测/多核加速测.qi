// R6 铁证：CPU 密集协程真吃多核。8 个协程各数一段素数（重计算），
// QI_CORO_WORKERS=8 应比 =1 明显快（接近 ×核数，扣调度开销）。
包 主程序;
导入 标准库.输入输出 作为 IO;
导入 标准库.时间 作为 时间;

变量 完成通 = 通道<整数>(16);

函数 是素数(n: 整数) : 布尔 {
    如果 (n < 2) { 返回 假; }
    变量 i: 整数 = 2;
    当 (i * i <= n) {
        如果 (n % i == 0) { 返回 假; }
        i = i + 1;
    }
    返回 真;
}

函数 数素数() : 未来<整数> {
    变量 计: 整数 = 0;
    变量 n: 整数 = 2;
    当 (n < 300000) {
        如果 (是素数(n)) { 计 = 计 + 1; }
        如果 (n % 20000 == 0) { 等待 让出(); }   // 偶尔让出，给调度机会
        n = n + 1;
    }
    完成通 <- 计;
    返回 计;
}

函数 入口() {
    变量 起: 整数 = 时间.现在毫秒();
    变量 i: 整数 = 0;
    当 (i < 8) { 启动 数素数(); i = i + 1; }
    执行器运行全部();
    变量 总: 整数 = 0; 变量 k: 整数 = 0;
    当 (k < 8) { 总 = 总 + (<- 完成通); k = k + 1; }
    IO.打印行(模板"8 协程各数 30 万内素数, 总计 {总}, 耗时 {时间.现在毫秒() - 起} ms");
}
