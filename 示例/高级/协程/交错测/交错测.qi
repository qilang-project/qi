// 真协程灵魂测试（Round 1 / QI_CORO=1）——两个协程交错执行的铁证。
//
// 甲、乙 各含两个 `等待 让出()` 挂起点。入口 先各调一次（跑到首个挂起点，
// 分别打印 甲1、乙1），再 执行器运行全部() 轮转驱动余下。
//
// 期望输出（交错序）：甲1 乙1 甲2 乙2 甲完 乙完
// —— eager future 模型下绝不可能（那会是 甲1 甲2 甲完 乙1 乙2 乙完）。
//
// 运行：QI_CORO=1 qi run 交错测.qi

包 主程序;

函数 甲() : 未来<整数> {
    打印行("甲1");
    等待 让出();
    打印行("甲2");
    等待 让出();
    打印行("甲完");
    返回 42;
}

函数 乙() : 未来<整数> {
    打印行("乙1");
    等待 让出();
    打印行("乙2");
    等待 让出();
    打印行("乙完");
    返回 7;
}

函数 入口() {
    变量 甲未来: 未来<整数> = 甲();   // 跑到首挂起点：打印 甲1
    变量 乙未来: 未来<整数> = 乙();   // 打印 乙1
    执行器运行全部();                 // 轮转：甲2 乙2 甲完 乙完
    变量 甲值: 整数 = 等待 甲未来;    // 已完成，取返回值 42
    变量 乙值: 整数 = 等待 乙未来;    // 7
    打印行("甲值 = " + 整数转字符串(甲值));
    打印行("乙值 = " + 整数转字符串(乙值));
}
