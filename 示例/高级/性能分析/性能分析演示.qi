// 性能分析演示 — 适合用 qiprof 工具采集 CPU 热点
// 包含几个运算特征不同的函数，方便观察火焰图差异

包 主程序;

// ── 计算密集：斐波那契（指数级调用次数）──
函数 斐波那契(第几项: 整数): 整数 {
    如果 第几项 <= 1 {
        返回 第几项;
    }
    返回 斐波那契(第几项 - 1) + 斐波那契(第几项 - 2);
}

// ── 迭代：累加求和（线性循环）──
函数 累加求和(上限: 整数): 整数 {
    变量 总和 = 0;
    变量 i = 1;
    当 i <= 上限 {
        总和 = 总和 + i;
        i = i + 1;
    }
    返回 总和;
}

// ── 轻量：最大公约数（欧几里得递归，快速收敛）──
函数 最大公约数(甲: 整数, 乙: 整数): 整数 {
    如果 乙 == 0 {
        返回 甲;
    }
    返回 最大公约数(乙, 甲 % 乙);
}

// ── 批量调度函数 ──
函数 批量GCD(次数: 整数): 整数 {
    变量 结果值 = 0;
    变量 i = 1;
    当 i <= 次数 {
        结果值 = 最大公约数(结果值 + i * 97, i * 53 + 1);
        i = i + 1;
    }
    返回 结果值;
}

函数 入口() {
    打印行("── 性能分析演示 ──");
    打印行("");

    // 斐波那契（展示递归热点）
    变量 fib结果 = 斐波那契(30);
    打印("斐波那契(30) = ");
    打印行(fib结果);

    // 累加（展示循环热点）
    变量 和 = 累加求和(500000);
    打印("累加(1..500000) = ");
    打印行(和);

    // 批量 GCD（展示函数调用分布）
    变量 gcd结果 = 批量GCD(10000);
    打印("批量GCD(10000) 末值 = ");
    打印行(gcd结果);

    打印行("");
    打印行("── 完成 ──");
}
