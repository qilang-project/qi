// 大模型.对话多候选 示例 —— 一次请求多个候选回答（OpenAI 的 n 参数）
//
//   变量 候选JSON: 字符串 = 大模型.对话多候选(会话, 提示, n);
//
// 返回 JSON 数组文本，每个元素是一个候选的 content 字符串，用 JSON 模块解析遍历。
//
// Provider 差别与计费：
// - openai 家族：请求体带 "n": n，一次请求服务端采样 n 个候选，
//   prompt tokens 只计一次 —— 最省钱的形态。
// - anthropic / gemini 没有 n 语义：运行时退化为串行调 n 次（各次独立采样），
//   计费等于 n 次完整请求，耗时线性叠加。
//
// 会话历史语义：只把第一个候选追加进历史（否则历史就分叉了），
// 其余候选只作为返回值给调用方 —— 适合「生成 n 个再挑一个」的场景。
//
// 运行前设环境变量：QI_CHAT_URL / QI_CHAT_KEY（OpenAI 兼容端点）；
// 未设置密钥时只演示到创建会话前（保证本示例始终可编译、可空跑）。

包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.操作系统 作为 系统;
导入 标准库.大模型 作为 大模型;
导入 标准库.JSON 作为 JSON;

函数 入口() {
    IO.打印行("=== 大模型 对话多候选 示例 ===");

    变量 端点: 字符串 = 系统.获取环境变量("QI_CHAT_URL");
    变量 密钥: 字符串 = 系统.获取环境变量("QI_CHAT_KEY");
    变量 模型: 字符串 = 系统.获取环境变量("QI_CHAT_MODEL");
    如果 (模型 == "") {
        模型 = "qwen-plus";
    }

    如果 (端点 == "" || 密钥 == "") {
        // 无密钥分支：不打真实 API，只说明用法（CI / 无网环境下照常编译运行）
        IO.打印行("未设置 QI_CHAT_URL / QI_CHAT_KEY，跳过真实调用。");
        IO.打印行("用法：变量 候选JSON: 字符串 = 大模型.对话多候选(会话, 提示, 3);");
        IO.打印行("返回 JSON 数组文本，如 [\"候选一\",\"候选二\",\"候选三\"]。");
        返回;
    }

    变量 会话: 整数 = 大模型.创建会话(端点, 模型, 密钥);
    如果 (会话 < 0) {
        IO.打印行("创建会话失败");
        返回;
    }

    // 一次请求 3 个候选：适合「多生成几个再挑最好的」
    变量 提示: 字符串 = "给一款中文编程语言起一个响亮的中文口号，只回口号本身。";
    变量 候选JSON: 字符串 = 大模型.对话多候选(会话, 提示, 3);
    IO.打印行("原始返回（JSON 数组文本）：" + 候选JSON);

    // 用 JSON 模块解析数组，逐个打印候选
    变量 数组句柄: 整数 = JSON.解码(候选JSON);
    如果 (数组句柄 < 0) {
        // 失败时返回的是 "LLM调用失败: ..." 文本（非 JSON 数组）
        IO.打印行("调用失败：" + 候选JSON);
        大模型.关闭会话(会话);
        返回;
    }

    变量 个数: 整数 = JSON.数组长度(数组句柄);
    IO.打印行("共 " + 整数转字符串(个数) + " 个候选：");
    对于 i 在 0 直到 个数 {
        变量 候选: 字符串 = JSON.数组获取字符串(数组句柄, i);
        IO.打印行("  候选 " + 整数转字符串(i + 1) + ": " + 候选);
    }
    JSON.删除(数组句柄);

    // 历史只进了第一个候选：后续追问接在候选 1 之后，不会分叉
    变量 追问: 字符串 = 大模型.对话(会话, "把你刚才那个口号再精简到六个字以内。");
    IO.打印行("基于候选 1 的追问：" + 追问);

    大模型.关闭会话(会话);
    IO.打印行("完成");
}
