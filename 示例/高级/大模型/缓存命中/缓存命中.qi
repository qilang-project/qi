// 提示缓存（prompt cache）命中率实测
//
// 跑一段多轮 agent trace（每轮往历史里追加一点东西），把每轮的
//   p  = prompt tokens
//   c  = completion tokens
//   cr = 缓存**读**走的 token
//   cw = 缓存**写入**的 token
// 打出来，末尾汇总。
//
// ## 各家的口径不一样，看数之前先看这个
//
// - **Anthropic**：`input_tokens`（这里的 p）**不含** cr 和 cw，三者并列。
//   真实输入量 = p + cr + cw。请求侧要显式打 cache_control 断点，本例开了
//   `设置配置(会话, "提示缓存", "1")`；不开就一定全 0。
//   还有一条硬门槛：前缀不够长（一般 1024 token）根本不会被缓存，
//   所以下面故意堆了一段长 system。
// - **DeepSeek / OpenAI**：服务端自动缓存，请求侧**没有**标记；p 里
//   **已经含**命中部分，所以 p 不会因为命中而变小。
// - **Gemini**：这里读的是 cachedContentTokenCount。
//
// ## 没有凭据就跳过
//
// 这个例子要真打 API，没配 key 时直接打印怎么配然后退出 —— 它进不了
// scripts/run_examples.sh 的名单，但手滑跑到也不该变成一条红。
//
// 用法：
//   export LLM_API_KEY=...            # 或 ANTHROPIC_API_KEY / DEEPSEEK_API_KEY
//   export LLM_PROVIDER=anthropic     # anthropic / openai / gemini，默认按 key 猜
//   export LLM_BASE_URL=...           # 可选，默认按 provider 给
//   export LLM_MODEL=...              # 可选
//   qi run 示例/高级/大模型/缓存命中/缓存命中.qi

包 主程序;

导入 标准库.大模型;
导入 标准库.操作系统;
导入 标准库.JSON;

函数 取环境(名: 字符串) : 字符串 {
    返回 操作系统.获取环境变量(名);
}

函数 怎么配() {
    打印行("跳过：没有找到模型凭据。");
    打印行("");
    打印行("配任意一个环境变量即可（按这个顺序找）：");
    打印行("  LLM_API_KEY / ANTHROPIC_API_KEY / DEEPSEEK_API_KEY / QI_LLM_KEY");
    打印行("");
    打印行("可选：");
    打印行("  LLM_PROVIDER=anthropic|openai|gemini   默认按 key 的来源猜");
    打印行("  LLM_BASE_URL=...                       默认按 provider 给");
    打印行("  LLM_MODEL=...                          默认按 provider 给");
    打印行("");
    打印行("例：");
    打印行("  ANTHROPIC_API_KEY=sk-ant-... qi run 示例/高级/大模型/缓存命中/缓存命中.qi");
}

// 堆一段够长的 system —— 短前缀根本不会被缓存，那样跑出来的 0 说明不了任何事
函数 长系统提示() : 字符串 {
    变量 文: 字符串 = "你是一个耐心的技术助手，回答中文。";
    变量 k: 整数 = 0;
    当 (k < 80) {
        文 = 文 + "写作要求：先给结论，再给理由，最后给一个可执行的下一步；不要复述问题。";
        k = k + 1;
    }
    返回 文;
}

函数 入口() {
    打印行("======== 提示缓存命中率实测 ========");
    操作系统.加载环境文件("示例/高级/大模型/.env");

    变量 密钥: 字符串 = 取环境("LLM_API_KEY");
    变量 提供商: 字符串 = 取环境("LLM_PROVIDER");
    如果 (密钥 == "") {
        密钥 = 取环境("ANTHROPIC_API_KEY");
        如果 (密钥 != "" && 提供商 == "") { 提供商 = "anthropic"; }
    }
    如果 (密钥 == "") {
        密钥 = 取环境("DEEPSEEK_API_KEY");
        如果 (密钥 != "" && 提供商 == "") { 提供商 = "openai"; }
    }
    如果 (密钥 == "") { 密钥 = 取环境("QI_LLM_KEY"); }
    如果 (密钥 == "") { 怎么配(); 返回; }
    如果 (提供商 == "") { 提供商 = "openai"; }

    变量 端点: 字符串 = 取环境("LLM_BASE_URL");
    变量 模型: 字符串 = 取环境("LLM_MODEL");
    如果 (提供商 == "anthropic") {
        如果 (端点 == "") { 端点 = "https://api.anthropic.com"; }
        如果 (模型 == "") { 模型 = "claude-sonnet-4-5"; }
    } 否则 {
        如果 (提供商 == "gemini") {
            如果 (端点 == "") { 端点 = "https://generativelanguage.googleapis.com/v1beta"; }
            如果 (模型 == "") { 模型 = "gemini-2.5-flash"; }
        } 否则 {
            如果 (端点 == "") { 端点 = "https://api.deepseek.com/v1"; }
            如果 (模型 == "") { 模型 = "deepseek-chat"; }
        }
    }

    打印行("provider=" + 提供商 + "  model=" + 模型);
    变量 会话: 整数 = 大模型.创建会话(端点, 模型, 密钥);
    如果 (会话 < 0) { 打印行("创建会话失败"); 返回; }

    大模型.设置配置(会话, "provider", 提供商);
    大模型.设置配置(会话, "system", 长系统提示());
    大模型.设置配置(会话, "max_tokens", "200");
    大模型.设置配置(会话, "temperature", "0");
    // 请求侧断点只有 Anthropic 需要（也只有它认）。别家开了也没害处，
    // 但请求体会白多一个键 —— 所以只对 anthropic 开。
    如果 (提供商 == "anthropic") {
        大模型.设置配置(会话, "提示缓存", "1");
        打印行("已开启请求侧 cache_control 断点");
    } 否则 {
        打印行("该提供商是服务端自动缓存，请求侧无需标记");
    }

    打印行("");
    打印行("轮次 |      p |      c |     cr |     cw | 本轮命中率");
    打印行("-----+--------+--------+--------+--------+-----------");

    变量 轮: 整数 = 1;
    当 (轮 <= 8) {
        变量 答: 字符串 = 大模型.对话(会话, "第" + 整数转字符串(轮)
            + "个问题：用两句话说说 Qi 语言在第 " + 整数转字符串(轮) + " 个方面的取舍。");
        如果 (字符串::开始于(答, "LLM调用失败")) {
            打印行("第" + 整数转字符串(轮) + "轮失败：" + 答);
            大模型.关闭会话(会话);
            返回;
        }
        变量 用量: 整数 = JSON.解码(大模型.用量(会话));
        变量 缓存: 整数 = JSON.解码(大模型.缓存用量(会话));
        打印行("  " + 整数转字符串(轮)
            + "  | " + 整数转字符串(JSON.获取整数(用量, "prompt"))
            + " | " + 整数转字符串(JSON.获取整数(用量, "completion"))
            + " | " + 整数转字符串(JSON.获取整数(缓存, "read"))
            + " | " + 整数转字符串(JSON.获取整数(缓存, "write"))
            + " | " + 整数转字符串(大模型.上次缓存命中率(会话)) + "%");
        JSON.删除(用量);
        JSON.删除(缓存);
        轮 = 轮 + 1;
    }

    变量 汇总: 整数 = JSON.解码(大模型.缓存用量(会话));
    变量 读: 整数 = JSON.获取整数(汇总, "read_total");
    变量 写: 整数 = JSON.获取整数(汇总, "write_total");
    打印行("");
    打印行("======== 汇总 ========");
    打印行("累计 usage.total（预算口径，不含缓存）= " + 整数转字符串(大模型.已用预算(会话)));
    打印行("累计缓存读 cr = " + 整数转字符串(读));
    打印行("累计缓存写 cw = " + 整数转字符串(写));
    如果 (读 + 写 == 0) {
        打印行("");
        打印行("全 0 的常见原因：前缀不到最小可缓存长度、provider 不支持、");
        打印行("或者 Anthropic 这边忘了开 提示缓存 开关。");
    }
    JSON.删除(汇总);
    大模型.关闭会话(会话);
}
