包 主程序;

// 互斥锁烟测 — 互斥锁 API 功能验证
//
// 注意：Qi goroutine 目前共享句柄（整数），通过 标准库.同步 互斥锁保护。
// 本测试验证 创建锁/加锁/解锁/尝试加锁/销毁锁 的 FFI 接口正确工作。

导入 标准库.同步 作为 同步;
导入 标准库.时间 作为 时间;

函数 入口() {
    打印行("=== 互斥锁烟测 ===");

    // 1. 创建锁
    变量 锁句柄: 整数 = 同步.创建锁();
    如果 (锁句柄 > 0) {
        打印行("PASS: 创建锁 (句柄=", 锁句柄, ")");
    } 否则 {
        打印行("FAIL: 创建锁失败");
        返回;
    }

    // 2. 加锁
    变量 加锁结果: 整数 = 同步.加锁(锁句柄);
    如果 (加锁结果 == 1) {
        打印行("PASS: 加锁成功");
    } 否则 {
        打印行("FAIL: 加锁失败");
    }

    // 3. 已加锁时，尝试加锁应返回 0（锁被占用）
    变量 尝试结果: 整数 = 同步.尝试加锁(锁句柄);
    如果 (尝试结果 == 0) {
        打印行("PASS: 尝试加锁（已加锁）返回 0");
    } 否则 {
        打印行("FAIL: 尝试加锁期望 0, 得到 ", 尝试结果);
    }

    // 4. 解锁
    变量 解锁结果: 整数 = 同步.解锁(锁句柄);
    如果 (解锁结果 == 1) {
        打印行("PASS: 解锁成功");
    } 否则 {
        打印行("FAIL: 解锁失败");
    }

    // 5. 解锁后，尝试加锁应返回 1（成功）
    变量 尝试结果2: 整数 = 同步.尝试加锁(锁句柄);
    如果 (尝试结果2 == 1) {
        打印行("PASS: 解锁后尝试加锁成功");
        // 释放这次 trylock 持有的锁
        同步.解锁(锁句柄);
    } 否则 {
        打印行("FAIL: 解锁后尝试加锁期望 1, 得到 ", 尝试结果2);
    }

    // 6. 销毁锁
    变量 销毁结果: 整数 = 同步.销毁锁(锁句柄);
    如果 (销毁结果 == 1) {
        打印行("PASS: 销毁锁成功");
    } 否则 {
        打印行("FAIL: 销毁锁失败");
    }

    打印行("=== 互斥锁烟测完成 ===");
}
