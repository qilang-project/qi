包 主程序;

// 选择（select）超时/默认分支验证：
//   1) 就绪通道优先：通道里已有数据，选择应选中该通道分支，而不是超时分支。
//   2) 超时触发：通道里没有数据，选择应在 ~200ms 后走超时分支，且程序不会卡住。

函数 入口() {
    打印行("=== 选择超时演示 ===");

    // ---- 场景 1：就绪通道优先 ----
    变量 通道甲 = 通道<整数>(10);
    通道甲 <- 42;            // 先把值塞进通道（mpsc 无界，立即缓冲）

    选择 {
        情况 值甲 := <-通道甲:
            打印行("场景1: 通道就绪, 收到 " + 整数转字符串(值甲));
        情况 超时(200):
            打印行("场景1: 错误! 不应该超时");
    }

    // ---- 场景 2：超时触发 ----
    变量 通道乙 = 通道<整数>(10);   // 空通道, 没有任何发送

    选择 {
        情况 值乙 := <-通道乙:
            打印行("场景2: 错误! 不应该收到数据 " + 整数转字符串(值乙));
        情况 超时(200):
            打印行("场景2: 超时触发, 走超时分支");
    }

    打印行("=== 演示结束 ===");
}
