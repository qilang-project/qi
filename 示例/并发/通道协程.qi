包 主程序;

// 通道在 goroutine（启动）与主协程之间收发的回归用例。
// 历史 bug：goroutine 发送、主协程接收会永久挂死——
//   1) channel_receive 在阻塞的 recv() 期间持有全局通道注册表锁，
//      导致 goroutine 的 channel_send 无法拿到同一把锁去投递，互相死锁；
//   2) 带「通道<整数>」参数的函数读取其它整数参数时，codegen 错误地
//      生成 `load i64, ptr %<未mangle名>`（把 i64 参数当指针 load），无法编译。
// 本例覆盖：单 goroutine 收发、N goroutine join 求和、无缓冲通道。

导入 标准库.输入输出 作为 IO;

// 单个 goroutine 把一个值发到通道
函数 发送一个(信道: 通道<整数>) {
    信道 <- 42;
}

// 工人：把自己的编号发到通道（验证「整数参数 + 通道参数」同时存在）
函数 工人(编号: 整数, 信道: 通道<整数>) {
    信道 <- 编号;
}

函数 入口() {
    // 1) 单 goroutine 发送 / 主协程接收
    变量 信道一 = 通道<整数>(1);
    启动 发送一个(信道一);
    变量 收 = <- 信道一;
    IO.打印行("收到:" + 整数转字符串(收));

    // 2) 多 goroutine join：4 个工人各发一个编号，主协程收 4 次求和
    变量 信道二 = 通道<整数>(8);
    启动 工人(1, 信道二);
    启动 工人(2, 信道二);
    启动 工人(3, 信道二);
    启动 工人(4, 信道二);

    变量 总和 = 0;
    变量 计数 = 0;
    当 计数 < 4 {
        变量 值 = <- 信道二;
        总和 = 总和 + 值;
        计数 = 计数 + 1;
    }
    IO.打印行("总和:" + 整数转字符串(总和)); // 应为 10

    // 3) 无缓冲通道：goroutine 发送，主协程接收
    变量 信道三 = 通道<整数>();
    启动 发送一个(信道三);
    变量 无缓冲收 = <- 信道三;
    IO.打印行("无缓冲:" + 整数转字符串(无缓冲收));
}
