包 主程序;

// 原子计数 — 真实跨 goroutine 竞争测试
//
// 8 个 goroutine 并发，每个对同一原子整数 +1 共 1000 次。
// 使用 标准库.同步.原子加 保证无竞争，期望最终值恰好为 8000。
// join 策略：睡眠 2 秒（充分等待 8*1000 轻量循环完成）。

导入 标准库.同步 作为 同步;
导入 标准库.时间 作为 时间;

函数 原子工作(计数句柄: 整数, 次数: 整数) {
    变量 i = 0;
    当 i < 次数 {
        同步.原子加(计数句柄, 1);
        i = i + 1;
    }
}

函数 入口() {
    打印行("=== 原子计数竞争测试 ===");

    变量 协程数 = 8;
    变量 每协程次数 = 1000;
    变量 期望值 = 协程数 * 每协程次数;

    变量 计数句柄: 整数 = 同步.创建原子(0);

    // 启动 8 个并发 goroutine
    变量 已启动 = 0;
    当 已启动 < 协程数 {
        启动 原子工作(计数句柄, 每协程次数);
        已启动 = 已启动 + 1;
    }

    打印行("已启动 ", 协程数, " 个 goroutine，每个执行 ", 每协程次数, " 次原子加");

    // 等待所有 goroutine 完成（2s 足够）
    时间.睡眠毫秒(2000);

    变量 实际值: 整数 = 同步.读原子(计数句柄);

    打印行("期望值: ", 期望值);
    打印行("实际值: ", 实际值);

    如果 (实际值 == 期望值) {
        打印行("PASS: 原子计数正确，无竞争丢失");
    } 否则 {
        打印行("FAIL: 发现数据丢失（竞争），差值: ", 期望值 - 实际值);
    }

    同步.销毁原子(计数句柄);
    打印行("=== 测试结束 ===");
}
