// 标准库.向量 示例 —— 点积 / 加法 / 数乘 / 模 / 归一化 / 余弦相似度
//
// 向量就是普通的浮点数组（如 [1.0, 2.0, 3.0]），长度从数组头自动读取，
// 无需手动传维度或出参缓冲。注意元素必须是浮点数字面量（1.0 而非 1）。

包 主程序;

导入 标准库.向量;

函数 入口() {
    变量 甲 = [1.0, 2.0, 3.0];
    变量 乙 = [4.0, 5.0, 6.0];

    // 点积: 1*4 + 2*5 + 3*6 = 32
    打印行("点积 = " + 向量.点积(甲, 乙));

    // 向量加法：逐元素相加，返回新数组
    变量 和向量 = 向量.加(甲, 乙);
    打印行("加 = [" + 和向量[0] + ", " + 和向量[1] + ", " + 和向量[2] + "]");

    // 数乘：每个元素乘以标量
    变量 倍向量 = 向量.数乘(甲, 2.0);
    打印行("数乘 = [" + 倍向量[0] + ", " + 倍向量[1] + ", " + 倍向量[2] + "]");

    // 模（向量长度）：3-4-5 勾股
    变量 勾股 = [3.0, 4.0];
    打印行("模 = " + 向量.长度(勾股));

    // 归一化：方向不变，模变 1
    变量 单位向量 = 向量.归一化(勾股);
    打印行("归一化 = [" + 单位向量[0] + ", " + 单位向量[1] + "]");
    打印行("归一化后的模 = " + 向量.长度(单位向量));

    // 余弦相似度：平行 = 1，正交 = 0
    变量 横 = [1.0, 0.0];
    变量 纵 = [0.0, 1.0];
    打印行("平行相似度 = " + 向量.余弦相似度(甲, 向量.数乘(甲, 3.0)));
    打印行("正交相似度 = " + 向量.余弦相似度(横, 纵));
}
