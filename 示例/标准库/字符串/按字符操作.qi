// 字符串「按字符（Unicode 标量）」操作示例
//
// 背景：字符串::子串/查找/字节长度 全部按【字节】偏移，一个汉字占 3 字节、
// 一个 emoji 占 4 字节。用字节偏移切中文会把一个字符切成半个，产出非法 UTF-8。
// 本示例演示新增的按【字符】API：字符子串 / 字符查找 / 字符取 / 字符从位置，
// 并用纯中文、中英混排、含 emoji 三组数据自校验，同时演示旧 API 的字节语义。

// 断言两个字符串相等，打印 PASS/FAIL
函数 断言(标签: 字符串, 实际: 字符串, 期望: 字符串) {
    如果 (字符串::等于(实际, 期望) == 1) {
        打印行("  PASS  " + 标签 + " => \"" + 实际 + "\"");
    } 否则 {
        打印行("  FAIL  " + 标签 + " 实际=\"" + 实际 + "\" 期望=\"" + 期望 + "\"");
    }
}

// 断言两个整数相等，打印 PASS/FAIL
函数 断言整数(标签: 字符串, 实际: 整数, 期望: 整数) {
    如果 (实际 == 期望) {
        打印行("  PASS  " + 标签 + " => " + 整数转字符串(实际));
    } 否则 {
        打印行("  FAIL  " + 标签 + " 实际=" + 整数转字符串(实际) + " 期望=" + 整数转字符串(期望));
    }
}

函数 入口() {
    打印行("=== 字符串按字符操作示例 ===");

    // ---------- 第 1 组：纯中文 ----------
    打印行("");
    打印行("[纯中文] 你好世界朋友");
    变量 甲: 字符串 = "你好世界朋友";  // 6 个字符，18 字节

    断言整数("字节长度(旧)", 字符串::字节长度(甲), 18);
    断言整数("字符数量", 字符串::字符数量(甲), 6);
    // 字符子串：从第 2 个字符起取 2 个字符 → "世界"
    断言("字符子串(2,2)", 字符串::字符子串(甲, 2, 2), "世界");
    // 字符从位置：从第 4 个字符到末尾 → "朋友"
    断言("字符从位置(4)", 字符串::字符从位置(甲, 4), "朋友");
    // 字符取：第 0 个字符 → "你"
    断言("字符取(0)", 字符串::字符取(甲, 0), "你");
    // 字符查找："世界" 从第 2 个字符开始 → 字符索引 2
    断言整数("字符查找(世界)", 字符串::字符查找(甲, "世界"), 2);
    断言整数("字符查找(不存在)", 字符串::字符查找(甲, "喵"), -1);

    // 对照：旧 子串 按字节切前 4 字节 = 1 个整汉字 + 半个汉字 → 非法/乱码
    // 这里只演示「按字节切会切坏」：字节 0..4 落在第 2 个汉字中间
    变量 坏切: 字符串 = 字符串::子串(甲, 0, 4);
    打印行("  演示  旧子串(0,4)按字节 => 字节长度=" + 整数转字符串(字符串::字节长度(坏切))
        + "（防御性收缩到字符边界，只得到 \"" + 坏切 + "\"，证明字节偏移对中文不可用）");

    // ---------- 第 2 组：中英混排 ----------
    打印行("");
    打印行("[混排] Hi你好Bye世界");
    变量 乙: 字符串 = "Hi你好Bye世界";  // H i 你 好 B y e 世 界 = 9 个字符

    断言整数("字符数量", 字符串::字符数量(乙), 9);
    // 字符 2..4 → "你好"
    断言("字符子串(2,2)", 字符串::字符子串(乙, 2, 2), "你好");
    // 字符 4..7 → "Bye"
    断言("字符子串(4,3)", 字符串::字符子串(乙, 4, 3), "Bye");
    // "世界" 在字符索引 7
    断言整数("字符查找(世界)", 字符串::字符查找(乙, "世界"), 7);
    // "Bye" 在字符索引 4
    断言整数("字符查找(Bye)", 字符串::字符查找(乙, "Bye"), 4);
    断言("字符取(2)", 字符串::字符取(乙, 2), "你");
    断言("字符从位置(7)", 字符串::字符从位置(乙, 7), "世界");

    // ---------- 第 3 组：含 emoji（4 字节字符） ----------
    打印行("");
    打印行("[emoji] 🎉庆祝🚀发射");
    变量 丙: 字符串 = "🎉庆祝🚀发射";  // 🎉 庆 祝 🚀 发 射 = 6 个字符

    断言整数("字符数量", 字符串::字符数量(丙), 6);
    // 🎉 与 🚀 各 4 字节，庆/祝/发/射 各 3 字节 → 4+3+3+4+3+3 = 20 字节
    断言整数("字节长度(旧)", 字符串::字节长度(丙), 20);
    // 字符 0 → "🎉"（4 字节 emoji 完整取出）
    断言("字符取(0)=🎉", 字符串::字符取(丙, 0), "🎉");
    // 字符 3 → "🚀"
    断言("字符取(3)=🚀", 字符串::字符取(丙, 3), "🚀");
    // 字符 0..3 → "🎉庆祝"
    断言("字符子串(0,3)", 字符串::字符子串(丙, 0, 3), "🎉庆祝");
    // "🚀" 在字符索引 3
    断言整数("字符查找(🚀)", 字符串::字符查找(丙, "🚀"), 3);
    // 从字符 4 到末尾 → "发射"
    断言("字符从位置(4)", 字符串::字符从位置(丙, 4), "发射");

    // ---------- 第 4 组：越界钳制不 panic ----------
    打印行("");
    打印行("[越界] 钳制而非崩溃");
    断言("字符子串起点越界", 字符串::字符子串(甲, 100, 2), "");
    断言("字符子串长度超出", 字符串::字符子串(甲, 4, 999), "朋友");  // 只取到末尾
    断言("字符取越界", 字符串::字符取(甲, 100), "");
    断言("字符从位置越界", 字符串::字符从位置(甲, 100), "");

    // ---------- 第 5 组：旧函数零回归 ----------
    打印行("");
    打印行("[旧函数零回归] 字节语义保持不变");
    变量 混: 字符串 = "abc世界";  // a b c 各 1 字节，世界各 3 字节 = 9 字节，5 个字符
    断言整数("字节长度", 字符串::字节长度(混), 9);
    断言整数("字符数量", 字符串::字符数量(混), 5);
    // 旧子串按字节：前 3 字节 = "abc"
    断言("子串(0,3)按字节", 字符串::子串(混, 0, 3), "abc");
    // 旧查找按字节：'世' 在字节偏移 3
    断言整数("查找(世)按字节", 字符串::查找(混, "世"), 3);
    // 对比新查找按字符：'世' 在字符索引 3（此例前 3 个都是 1 字节，恰好相等）
    断言整数("字符查找(世)按字符", 字符串::字符查找(混, "世"), 3);

    打印行("");
    打印行("=== 全部检查完成 ===");
}
