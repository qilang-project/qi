包 主程序;

导入 标准库.MCP服务器;
导入 标准库.JSON 作为 J;
导入 标准库.字符串;

// 全局服务器ID
变量 全局服务器: 整数 = 0;

// 计算工具处理函数：调用时也推送日志和进度通知
函数 计算处理(参数JSON: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(参数JSON);
    如果 (对象 <= 0) {
        返回 "{\"error\":\"JSON解析失败\"}";
    }
    变量 a: 整数 = J.获取整数(对象, "a");
    变量 b: 整数 = J.获取整数(对象, "b");

    // P2: 发送进度通知
    MCP服务器.通知进度(全局服务器, "http-calc", 1, 2);

    变量 和: 整数 = a + b;

    // P2: 发送日志消息通知
    MCP服务器.日志消息(全局服务器, "info", "HTTP工具被调用了");

    // P2: 发送进度通知（完成）
    MCP服务器.通知进度(全局服务器, "http-calc", 2, 2);

    返回 "{\"sum\":" + 整数转字符串(和) + "}";
}

函数 入口() {
    变量 服务器ID: 整数 = MCP服务器.创建服务器(
        "qi-http-notify-server",
        "0.1.0",
        "奇语 MCP HTTP 通知演示服务器（P2）"
    );

    如果 (服务器ID <= 0) {
        返回;
    }

    全局服务器 = 服务器ID;

    MCP服务器.注册工具(
        服务器ID,
        "计算",
        "对两个整数求和，同时推送日志和进度通知（HTTP SSE）"
    );

    MCP服务器.添加工具参数(服务器ID, "计算", "a", "number", "第一个加数", 1);
    MCP服务器.添加工具参数(服务器ID, "计算", "b", "number", "第二个加数", 1);
    MCP服务器.设置工具回调指针(服务器ID, "计算", 计算处理);

    // 启动 HTTP 服务，监听 43532
    MCP服务器.运行HTTP(服务器ID, "127.0.0.1", 43532);

    MCP服务器.销毁服务器(服务器ID);
}
