包 主程序;

导入 标准库.MCP服务器;
导入 标准库.JSON 作为 J;
导入 标准库.字符串;

// 加法工具处理函数
// ABI: 函数(参数JSON: 字符串) : 字符串
// 输入: {"a": <数字>, "b": <数字>}
// 输出: {"sum": <结果>}
函数 加法处理(参数JSON: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(参数JSON);
    如果 (对象 <= 0) {
        返回 "{\"error\":\"JSON解析失败\"}";
    }
    变量 a: 整数 = J.获取整数(对象, "a");
    变量 b: 整数 = J.获取整数(对象, "b");
    变量 和: 整数 = a + b;
    返回 "{\"sum\":" + 整数转字符串(和) + "}";
}

函数 入口() {
    // 创建服务器
    变量 服务器ID: 整数 = MCP服务器.创建服务器(
        "qi-math-server-http",
        "0.1.0",
        "奇语 MCP 数学服务器 HTTP 传输示例"
    );

    如果 (服务器ID <= 0) {
        打印行("服务器创建失败");
        返回;
    }

    // 注册加法工具
    MCP服务器.注册工具(
        服务器ID,
        "加法",
        "对两个整数求和，输入 {\"a\":整数, \"b\":整数}，返回 {\"sum\":整数}"
    );

    // 添加参数 a
    MCP服务器.添加工具参数(
        服务器ID,
        "加法",
        "a",
        "number",
        "第一个加数",
        1
    );

    // 添加参数 b
    MCP服务器.添加工具参数(
        服务器ID,
        "加法",
        "b",
        "number",
        "第二个加数",
        1
    );

    // 设置 Qi 函数指针作为工具回调
    MCP服务器.设置工具回调指针(服务器ID, "加法", 加法处理);

    // 启动 HTTP Streamable 传输，监听 127.0.0.1:43531
    MCP服务器.运行HTTP(服务器ID, "127.0.0.1", 43531);

    // 清理（运行HTTP 退出后到达此处）
    MCP服务器.销毁服务器(服务器ID);
}
