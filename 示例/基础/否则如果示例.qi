包 主程序;

// 否则如果（else if 链）示例
// 连写 `否则如果` 与空格分开 `否则 如果` 两种写法等价，
// 语义脱糖为 else { if ... } 嵌套。

函数 评级(分数: 整数) : 字符串 {
    如果 分数 >= 90 {
        返回 "优秀";
    } 否则如果 分数 >= 80 {
        返回 "良好";
    } 否则 如果 分数 >= 60 {   // 空格分开写法，等价于连写
        返回 "及格";
    } 否则 {
        返回 "不及格";
    }
}

// 末尾无兜底 `否则` 的 else-if 链也合法
函数 星期名(n: 整数) {
    如果 n == 1 {
        打印行("周一");
    } 否则如果 n == 6 {
        打印行("周六");
    } 否则如果 n == 7 {
        打印行("周日");
    }
}

函数 入口() {
    打印行(评级(95));
    打印行(评级(85));
    打印行(评级(70));
    打印行(评级(40));
    星期名(1);
    星期名(7);
    星期名(3);  // 无匹配，不打印
    打印行("完成");
}
