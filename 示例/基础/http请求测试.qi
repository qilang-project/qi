包 主程序;
导入 标准库.HTTP;
导入 标准库.输入输出 作为 IO;
函数 入口() {
    变量 头: 字符串 = "{\"Accept\":\"application/json\",\"User-Agent\":\"qi-lang/1.0\"}";
    变量 响应: 字符串 = HTTP.请求("GET", "https://api.github.com/zen", 头, "");
    如果 (字符串::字节长度(响应) > 0) { IO.打印行("ok len=" + 整数转字符串(字符串::字节长度(响应))); }
    否则 { IO.打印行("空"); }
}
