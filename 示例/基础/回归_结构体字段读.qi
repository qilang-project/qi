包 主程序;

// 回归（雷 C）：结构体字面量里对**同一实参**做多次字段读（含算术变体）。
// 历史病历（旧文本 builder）称此会「损坏其它全局变量」——例如 应用值.主机
// 打印成 "@T:" 而非 "127.0.0.1"。现后端改为具名 struct 类型 + typed GEP，
// 字段索引精确、不再字节偏移猜测，应结构上免疫。此例：构造前后各读一次全局
// 字符串常量，并逐字段核对拷贝值，全 PASS 即无损坏。

常量 全局主机 = "127.0.0.1";
常量 全局密钥 = "SECRET-KEY-9527";

类型 应用 {
    默认时限: 整数,
    限流次数: 整数,
    主机: 字符串,
    端口: 整数,
    静态目录: 字符串,
    密钥头名: 字符串,
    跨域来源: 字符串,
    最大体积: 整数,
    重试次数: 整数,
    模板目录: 字符串,
    日志级别: 整数,
    工作线程: 整数,
    队列深度: 整数,
    心跳秒: 整数,
    版本号: 整数,
}

类型 场景 {
    时限: 整数,
    限流: 整数,
    主机: 字符串,
    端口: 整数,
    静态目录: 字符串,
    密钥头名: 字符串,
    跨域来源: 字符串,
    最大体积: 整数,
    重试次数: 整数,
    模板目录: 字符串,
    日志级别: 整数,
    工作线程: 整数,
    队列深度: 整数,
    心跳秒: 整数,
    版本号加倍: 整数,
}

// 结构体字面量里对同一实参 应用值 做 15 个字段读（末位是算术变体）
函数 匹配场景(应用值: 应用): 场景 {
    返回 新建 场景 {
        时限: 应用值.默认时限,
        限流: 应用值.限流次数,
        主机: 应用值.主机,
        端口: 应用值.端口,
        静态目录: 应用值.静态目录,
        密钥头名: 应用值.密钥头名,
        跨域来源: 应用值.跨域来源,
        最大体积: 应用值.最大体积,
        重试次数: 应用值.重试次数,
        模板目录: 应用值.模板目录,
        日志级别: 应用值.日志级别,
        工作线程: 应用值.工作线程,
        队列深度: 应用值.队列深度,
        心跳秒: 应用值.心跳秒,
        版本号加倍: 应用值.版本号 * 2,
    };
}

函数 入口() {
    变量 app = 新建 应用 {
        默认时限: 30, 限流次数: 100, 主机: "app-host", 端口: 6794,
        静态目录: "/static", 密钥头名: "X-Key", 跨域来源: "*",
        最大体积: 1024, 重试次数: 3, 模板目录: "/tpl",
        日志级别: 2, 工作线程: 4, 队列深度: 256, 心跳秒: 15, 版本号: 7,
    };
    变量 ctx = 匹配场景(app);

    如果 全局主机 == "127.0.0.1" { 打印行("PASS 雷C全局主机未损坏"); }
    否则 { 打印行("FAIL 雷C全局主机被踩: " + 全局主机); }
    如果 全局密钥 == "SECRET-KEY-9527" { 打印行("PASS 雷C全局密钥未损坏"); }
    否则 { 打印行("FAIL 雷C全局密钥被踩: " + 全局密钥); }
    如果 ctx.主机 == "app-host" { 打印行("PASS 雷C字符串字段拷贝正确"); }
    否则 { 打印行("FAIL 雷C字符串字段拷贝: " + ctx.主机); }
    如果 ctx.静态目录 == "/static" { 打印行("PASS 雷C静态目录拷贝正确"); }
    否则 { 打印行("FAIL 雷C静态目录拷贝: " + ctx.静态目录); }
    如果 ctx.端口 == 6794 { 打印行("PASS 雷C整数字段拷贝正确"); }
    否则 { 打印行("FAIL 雷C整数字段拷贝 得" + ctx.端口); }
    如果 ctx.版本号加倍 == 14 { 打印行("PASS 雷C算术变体字段正确"); }
    否则 { 打印行("FAIL 雷C算术变体字段 得" + ctx.版本号加倍); }
}
