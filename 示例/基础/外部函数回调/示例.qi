// C 回调 —— 把 Qi 顶层函数当裸函数指针交给 C 库（FFI v3）。
//
// `外部` 块的参数位可以写函数类型，声明出一个 C 回调槽：
//     函数 qsort(基址: 指针, 个数: 整数, 宽度: 整数, 比较: 函数(指针, 指针): 整数): 空;
// 调用点传一个**顶层具名函数**，编译器取它的裸 LLVM 函数指针（真代码地址）传给 C。
// Qi 顶层函数的调用约定本来就是 C ABI（整数/布尔→i64、浮点数→f64、指针→void*），
// 所以 C 可以直接 call，不需要任何蹦床。
//
// 闭包一律编译期拒绝。闭包值是「env 对象地址」而不是代码指针，C 一 call 就是 SIGBUS，
// 宁可缺功能也不能给这个坑。要带状态就用 C 库自己的 userdata 参数模式
// （把状态放进 指针 交给 C，由 C 在每次回调时回传）。示例末尾有负例说明。
//
// 关于返回宽度：C 的 qsort 比较器原型返回 int(i32)，Qi 的 整数 是 i64。
// 收窄由**读取方**完成 —— AArch64 上 callee 写 x0、caller 按 int 读 w0；
// x86-64 上 callee 写 rax、caller 读 eax。-1/0/1 截成 i32 仍是 -1/0/1，符号正确。
// 所以下面的比较器只返回 -1/0/1，绝不写成 `甲值 - 乙值`：
// 那种写法在纯 C 里同样会因为差值溢出 i32 而翻符号，是经典 UB，不是 Qi 的锅。

导入 标准库.内存;

外部 "c" {
    函数 malloc(字节数: 整数): 指针;
    函数 free(句柄: 指针): 空;
    // 最后一个参数是回调槽：C 侧原型 int (*)(const void *, const void *)
    函数 qsort(基址: 指针, 个数: 整数, 宽度: 整数, 比较: 函数(指针, 指针): 整数): 空;
}

// 比较器：顶层具名函数，无捕获。甲/乙 是 C 递给我们的元素地址，
// 用 内存::读整数 从地址处取出 i64（偏移 0）。
函数 升序比较(甲: 指针, 乙: 指针): 整数 {
    变量 甲值: 整数 = 内存::读整数(甲, 0);
    变量 乙值: 整数 = 内存::读整数(乙, 0);
    如果 (甲值 < 乙值) {
        返回 0 - 1;
    }
    如果 (甲值 > 乙值) {
        返回 1;
    }
    返回 0;
}

// 降序：同一个 C 回调槽换一个 Qi 函数就换一套排序规则。
函数 降序比较(甲: 指针, 乙: 指针): 整数 {
    返回 0 - 升序比较(甲, 乙);
}

// 把整块内存按 8 字节一格打印出来（自己也走 内存::读整数，验证读写对称）。
函数 打印数组(基址: 指针, 个数: 整数) {
    变量 行: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < 个数) {
        行 = 行 + 内存::读整数(基址, i * 8) + " ";
        i = i + 1;
    }
    打印行(行);
}

函数 入口() {
    打印行("=== C 回调（qsort + Qi 比较器）===");

    变量 个数: 整数 = 8;
    // 8 个 i64 = 64 字节。这块内存是裸的，没有 ARC header，由我们自己 free。
    变量 基址: 指针 = malloc(个数 * 8);

    // 手写乱序数据（含负数，验证符号在 i32 截断后仍正确）。
    内存::写整数(基址, 0, 42);
    内存::写整数(基址, 8, 0 - 7);
    内存::写整数(基址, 16, 1000);
    内存::写整数(基址, 24, 3);
    内存::写整数(基址, 32, 0 - 999);
    内存::写整数(基址, 40, 256);
    内存::写整数(基址, 48, 0);
    内存::写整数(基址, 56, 88);

    打印行("排序前:");
    打印数组(基址, 个数);

    qsort(基址, 个数, 8, 升序比较);
    打印行("升序后:");
    打印数组(基址, 个数);

    qsort(基址, 个数, 8, 降序比较);
    打印行("降序后:");
    打印数组(基址, 个数);

    free(基址);
    打印行("内存已释放，未崩溃");

    // ── 负例（编译期拒绝，取消注释即可复现）──────────────────────────
    //
    // 1) 闭包变量：捕获了 阈值，没有裸代码指针
    //      变量 门槛: 整数 = 5;
    //      变量 比较器 = 闭包(甲: 指针, 乙: 指针): 整数 { 返回 门槛; };
    //      qsort(基址, 个数, 8, 比较器);
    //    → 代码生成错误: 外部函数 qsort 的回调实参 比较器 不是无捕获顶层函数 ——
    //      C 回调只能传裸函数指针，有捕获的闭包 / 闭包变量无处安放 env。
    //      带状态请改用 C 库的 userdata 参数模式（把状态放进 指针，由 C 回传给回调）。
    //
    // 2) 闭包字面量：同理
    //      qsort(基址, 个数, 8, 闭包(甲: 指针, 乙: 指针): 整数 { 返回 0; });
    //    → 代码生成错误: 外部函数 qsort 的回调实参必须是无捕获顶层函数名
    //      （不能是闭包字面量 / 表达式）。带状态请改用 C 库的 userdata 参数模式。
    //
    // 3) 元数不符：一元函数塞进二元回调槽
    //      函数 少一个参数(甲: 指针): 整数 { 返回 0; }
    //      qsort(基址, 个数, 8, 少一个参数);
    //    → 代码生成错误: 外部函数 qsort 的回调实参 少一个参数 元数不符 ——
    //      声明要 2 个参数，少一个参数 有 1 个。C 按声明的个数调用，
    //      多出来的形参会读到没人写过的寄存器。
}
