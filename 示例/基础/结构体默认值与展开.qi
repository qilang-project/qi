// 结构体字段默认值 + spread 更新语法演示。
//
// 覆盖点：
//   1) 默认值填充（未提供的字段取声明处的默认字面量）
//   2) 显式值覆盖默认值
//   3) spread 复制（..基 拷贝未覆写字段）
//   4) spread + 覆写（显式字段优先）
//   5) 字符串字段的 ARC：循环 1000 次创建含字符串字段的 spread 副本，收支平衡不崩
//   6) 缺字段且无默认值 —— 保持既有语义（零/空初值，不报错）

类型 元信息 {
    标题: 字符串,
    图宽: 整数 = 1200,
    语言: 字符串 = "zh_CN",
}

类型 点 {
    横: 整数,
    纵: 整数,
}

// 循环里反复创建含字符串字段的 spread 副本 —— 每次调用返回后，函数出口统一释放
// 局部 副本（含其字符串字段），压测 ARC 的 retain/release 是否收支平衡。
函数 造副本(基: 元信息, 序号: 整数): 整数 {
    变量 副本: 元信息 = 新建 元信息 { ..基, 图宽: 序号 };
    返回 副本.图宽 + 字符串::字节长度(副本.标题);
}

函数 入口() {
    // 1) 默认值填充
    变量 甲: 元信息 = 新建 元信息 { 标题: "首页" };
    打印行("甲.标题=", 甲.标题);
    打印行("甲.图宽=", 甲.图宽);
    打印行("甲.语言=", 甲.语言);

    // 2) 显式值覆盖默认值
    变量 乙: 元信息 = 新建 元信息 { 标题: "详情", 图宽: 800 };
    打印行("乙.图宽=", 乙.图宽);

    // 3) spread 复制 + 4) 覆写：标题 被覆写，图宽/语言 从 甲 继承
    变量 丙: 元信息 = 新建 元信息 { ..甲, 标题: "改了" };
    打印行("丙.标题=", 丙.标题);
    打印行("丙.图宽=", 丙.图宽);
    打印行("丙.语言=", 丙.语言);

    // 5) ARC 压测：基值字符串用拼接产生真堆串（非 immortal 字面量），
    // 才能真正走 retain/release 的引用计数路径。
    变量 基: 元信息 = 新建 元信息 { 标题: "标题" + "行" };
    变量 累计: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < 1000) {
        累计 = 累计 + 造副本(基, i);
        i = i + 1;
    }
    打印行("ARC压测累计=", 累计);

    // 6) 缺字段且无默认值：纵 保持 0（既有语义，不报错）
    变量 p: 点 = 新建 点 { 横: 7 };
    打印行("p.横=", p.横);
    打印行("p.纵(无默认缺省)=", p.纵);
}
