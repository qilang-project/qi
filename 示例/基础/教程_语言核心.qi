// 语言核心入门教程 —— 一个文件覆盖奇语的核心特性
// 涵盖：包/导入、变量与基本类型、函数与返回、控制流、
//       自定义类型/方法、字符串与标准库、未来<T> + 等待 异步
包 主程序;

导入 标准库.文本;

// ---- 函数与返回 ----
函数 加法(甲: 整数, 乙: 整数): 整数 {
    返回 甲 + 乙;
}

// ---- 自定义类型（结构体）与方法 ----
类型 矩形 {
    浮点数 宽;
    浮点数 高;
}

// 方法：接收者写在函数名前的括号里（Go 风格）
函数 (自身 矩形) 面积(): 浮点数 {
    返回 自身.宽 * 自身.高;
}

// ---- 异步：返回 未来<整数> 的函数，返回值自动包装为 Future ----
函数 异步翻倍(数值: 整数): 未来<整数> {
    返回 数值 * 2;
}

函数 入口() {
    打印行("===== 奇语语言核心 =====");

    // 变量与基本类型
    变量 名字 = "奇语";                  // 类型推断：字符串
    变量 年龄: 整数 = 1;                  // 整数（i64）
    变量 圆周率: 浮点数 = 3.14159;        // 浮点数（f64）
    变量 启用: 布尔 = 真;                 // 布尔：真 / 假
    打印行("语言: ", 名字, "  年龄: ", 年龄);

    // 控制流：如果 / 否则
    如果 启用 == 真 {
        打印行("圆周率约等于 ", 圆周率);
    } 否则 {
        打印行("未启用");
    }

    // 函数调用
    打印行("3 + 4 = ", 加法(3, 4));

    // 控制流：对于（遍历数组）
    对于 i 在 [1, 2, 3] {
        打印行("循环第 ", i, " 次");
    }

    // 控制流：当（while）
    变量 计数 = 0;
    当 计数 < 3 {
        计数 = 计数 + 1;
    }
    打印行("计数累加到 ", 计数);

    // 自定义类型实例化 + 调用方法
    变量 矩 = 新建 矩形 { 宽: 3.0, 高: 4.0 };
    变量 面: 浮点数 = 矩.面积();          // 先存入有类型的变量再打印
    打印行("矩形面积 = ", 面);

    // 字符串拼接 + 标准库.文本
    变量 问候 = "你好，" + 名字 + "！";
    打印行(问候);
    打印行("是否包含「奇」: ", 文本.包含(问候, "奇"));   // 1 = 是

    // 数组下标
    变量 数列 = [10, 20, 30];
    打印行("数组首项 = ", 数列[0]);

    // 异步：未来<整数> + 等待（M:N 协程调度）
    打印行("----- 异步 -----");
    变量 翻倍任务: 未来<整数> = 异步翻倍(21);
    变量 结果值: 整数 = 等待 翻倍任务;       // 等待协程完成并取值
    打印行("异步翻倍(21) = ", 结果值);

    变量 就绪: 未来<整数> = 未来::就绪(7);   // 静态方法构造已就绪的 Future
    变量 就绪值: 整数 = 等待 就绪;
    打印行("就绪值 = ", 就绪值);

    打印行("===== 全部完成 =====");
}
