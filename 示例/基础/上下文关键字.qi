// 上下文关键字演示
// 常用名词类保留字（类型 / 结果 / 列表 / 数组 / 通道 / 选项 / 默认 / 最终）
// 现在可以在「字段名」「形参名」等安全位置当普通名字使用；
// 它们在类型 / 语句位置的本职用法（列表<T>、数组<T>、默认分支、最终块）保持不变。
// 另外「任务」已完全松绑为普通标识符，可用作变量名 / 形参名并在函数体内引用。
包 主程序;

// ---- 字段名用保留字：声明（冒号形式）----
结构体 记录 {
    类型: 字符串,
    结果: 整数,
    列表: 字符串,
    数组: 整数,
    默认: 字符串,
    最终: 整数,
}

// ---- 形参名用保留字：任务 可在函数体内引用 ----
函数 递增任务号(任务: 整数): 整数 {
    返回 任务 + 1;
}

函数 入口() {
    打印行("===== 上下文关键字 =====");

    // 字面量构造：字段名位置放行保留字
    变量 记 = 新建 记录 {
        类型: "用户",
        结果: 42,
        列表: "甲乙丙",
        数组: 3,
        默认: "无",
        最终: 43,
    };

    // 读字段：对象.字段 位置放行保留字
    打印行("类型 = ", 记.类型);
    打印行("结果 = ", 记.结果);
    打印行("列表 = ", 记.列表);
    打印行("最终 = ", 记.最终);

    // 写字段
    记.结果 = 100;
    记.类型 = "管理员";
    打印行("改后 类型 = ", 记.类型, "  结果 = ", 记.结果);

    // 任务：作为普通变量名 + 作为形参传入并在函数体内引用
    变量 任务 = 7;
    打印行("任务号 = ", 任务, "  递增后 = ", 递增任务号(任务));
}
