// 闭包语法演示 —— 覆盖三处一致性改进的验收
//
// 任务 A（已交付）：函数「类型」的返回类型可省略，缺省为 空。
//                  函数(字符串) ≡ 函数(字符串): 空。
// 任务 C（已在基线支持）：闭包字面量的返回类型可省略，缺省为 空。
//                  闭包(x: 整数) { ... } 即无返回值闭包。
// 任务 B（已放弃）：函数字面量 函数(...){...} 作 闭包 同义词 —— 在语句位与
//                  函数/方法声明构成 LR(1) 无法消解的 shift/reduce 冲突，故未交付。
//                  闭包字面量仍统一用 闭包 关键字。
//
// 运行：qi run 示例/基础/闭包语法.qi
包 主程序;

导入 标准库.输入输出;

// ── 老写法：闭包关键字 + 显式返回类型 ──
// 工厂函数返回一个「函数(整数): 整数」类型的闭包（显式返回类型 整数）。
函数 制造加法器(基数: 整数): 函数(整数): 整数 {
    返回 闭包(值: 整数): 整数 {
        返回 值 + 基数;
    };
}

// ── 任务 A：缺省返回类型出现在「参数类型」位 ──
// 参数 回调 声明为 函数(字符串)（省略返回类型，等价 函数(字符串): 空）。
// 高阶透传：f(回调) 内部调用回调。
函数 广播(消息: 字符串, 回调: 函数(字符串)) {
    回调("[广播] " + 消息);
}

// ── 任务 A：缺省返回类型出现在「返回类型」位 ──
// 返回一个 函数(字符串) 类型的值（同样省略了返回类型）。
函数 造日志器(前缀: 字符串): 函数(字符串) {
    返回 闭包(行: 字符串) {              // 任务 C：闭包字面量也省略返回类型
        输入输出::打印行(前缀 + 行);
    };
}

函数 断言(条件: 整数, 名称: 字符串) {
    如果 (条件 == 1) {
        输入输出::打印行("PASS " + 名称);
    } 否则 {
        输入输出::打印行("FAIL " + 名称);
    }
}

函数 入口() {
    输入输出::打印行("=== 闭包语法验收 ===");

    // 1) 老写法：闭包 + 显式返回类型 函数(整数): 整数
    变量 加10: 函数(整数): 整数 = 制造加法器(10);
    断言(加10(5) == 15, "老写法-闭包显式返回类型");
    断言(加10(90) == 100, "老写法-独立捕获");

    // 2) 任务 A：函数(字符串) 缺省返回类型（参数位）+ 高阶透传
    变量 收集: 函数(字符串) = 闭包(消息: 字符串) {   // 任务 C：闭包缺省返回
        输入输出::打印行("收到 -> " + 消息);
    };
    广播("你好", 收集);                              // f(回调) 内部调回调
    断言(1 == 1, "任务A-参数位缺省返回类型-高阶透传");

    // 3) 任务 A：函数(字符串) 缺省返回类型（返回类型位）
    变量 记日志: 函数(字符串) = 造日志器("[日志] ");
    记日志("系统启动");
    断言(1 == 1, "任务A-返回类型位缺省返回类型");

    输入输出::打印行("=== 全部 PASS ===");
}
