包 主程序;

// ── 泛型函数：按调用点单态化，三种实例共存 ──
函数 最大<T>(a: T, b: T): T {
    如果 a > b { 返回 a; }
    返回 b;
}

// ── 泛型枚举：装箱布局与 选项/结果 同款 ──
枚举 盒装<T> { 满(T), 空盒 }

// ── 泛型结构体 ──
类型 对<T> {
    T 左;
    T 右;
}

函数 描述(盒子: 盒装<字符串>): 字符串 {
    匹配 盒子 {
        满(内容) => { 返回 "满：" + 内容; }
        空盒 => { 返回 "空盒"; }
    }
    返回 "";
}

函数 发消息(信道: 通道<字符串>) {
    信道 <- "来自协程的问候";
}

函数 入口() {
    // 泛型函数：整数 / 浮点数 / 字符串 三实例
    打印行(最大(3, 5));
    打印行(最大(2.5, 1.5));
    打印行(最大("苹果", "香蕉"));
    // 显式类型实参（消歧用）
    打印行(最大::<整数>(7, 4));

    // 泛型枚举：构造 + 匹配解构
    变量 甲: 盒装<字符串> = 盒装.满("礼物");
    打印行(描述(甲));
    变量 乙: 盒装<字符串> = 盒装.空盒;
    打印行(描述(乙));

    // 泛型结构体：字面量 + 字段读写
    变量 点: 对<整数> = 新建 对<整数> { 左: 1, 右: 2 };
    打印行(点.左 + 点.右);
    点.左 = 10;
    打印行(点.左);

    // 嵌套泛型：盒装<对<整数> >（注意 >> 之间要空格）
    变量 套: 盒装<对<整数> > = 盒装.满(点);
    匹配 套 {
        满(内) => { 打印行(内.右); }
        空盒 => { 打印行(0); }
    }

    // 通道<字符串>：跨协程收发（发送即转移）
    变量 信道: 通道<字符串> = 通道<字符串>(1);
    启动 发消息(信道);
    变量 消息: 字符串 = <-信道;
    打印行(消息);
}
