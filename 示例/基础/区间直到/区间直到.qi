包 主程序;

// 半开区间 `直到` 对比闭区间 `到`。
//   起 直到 止  →  遍历 起, 起+1, …, 止-1（不含 止，半开）
//   起 到  止   →  遍历 起, 起+1, …, 止  （含 止，闭区间）
// 典型场景：遍历数组下标用 `0 直到 长度(数组)`，
// 比老写法 `0 到 长度(数组) - 1` 更自然、也不怕空数组时 -1 越下界。

函数 入口() {
    打印行("== 到：闭区间 0 到 3（含 3）==");
    对于 (i 在 0 到 3) {
        打印行(i);            // 0 1 2 3
    }

    打印行("== 直到：半开 0 直到 3（不含 3）==");
    对于 (i 在 0 直到 3) {
        打印行(i);            // 0 1 2
    }

    // 数组下标遍历：直到 长度(…) 恰好覆盖 [0, 长度) 全部合法下标。
    变量 城市: 数组<字符串> = ["北京", "上海", "广州", "深圳"];
    打印行("== 用 直到 遍历数组下标 ==");
    对于 (下标 在 0 直到 长度(城市)) {
        打印行(整数转字符串(下标) + ": " + 城市[下标]);
    }

    // 边界：起 == 止 时零次迭代；起 > 止 时也零次（不倒走）。
    打印行("== 边界：3 直到 3 与 5 直到 3 都不进循环 ==");
    对于 (i 在 3 直到 3) {
        打印行("不该出现");
    }
    对于 (i 在 5 直到 3) {
        打印行("不该出现");
    }
    打印行("完成");
}
