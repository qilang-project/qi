// 外部 C 函数 FFI v2 —— 指针、char* 返回、小结构体按值返回。
//
// v1 只支持 整数/浮点数/布尔/字符串 传参与 整数/浮点数/布尔 返回。v2 补齐：
//   1. 指针（不透明 void*）：malloc/free 等句柄型 C API。指针非 RC，
//      Qi 只存/传/回传，不解引用。打印时按整数地址显示（观察是否非零）。
//   2. char* 返回：C 返回的裸字符串在调用点**拷贝**进 Qi 拥有的堆串（ARC 安全），
//      原 C 内存一概不碰（getenv 静态串安全）。
//   3. 小结构体（≤16 字节、全整数/浮点字段）按值返回：走 SysV/AArch64 寄存器
//      ABI，C 返回的 struct 值 store 进带 ARC header 的 Qi 结构体。
//
// 全部只用 libc（mac/linux 自带），保证跨平台可运行。

类型 除结果 {
    整数 商;
    整数 余;
}

外部 "c" {
    // 指针：malloc 拿句柄，free 归还
    函数 malloc(字节数: 整数): 指针;
    函数 free(句柄: 指针): 空;
    // char* 返回：读环境变量（返回静态串，拷贝进 Qi 堆串）
    函数 getenv(名: 字符串): 字符串;
    // 小结构体按值返回：imaxdiv 返回 {intmax_t quot; intmax_t rem;}（16 字节）
    函数 imaxdiv(分子: 整数, 分母: 整数): 除结果;
}

函数 入口() {
    打印行("=== C FFI v2 ===");

    // 1) 指针
    变量 缓冲: 指针 = malloc(64);
    打印行("malloc 地址(非零):");
    打印行(缓冲);
    free(缓冲);
    打印行("free 完成，未崩溃");

    // 2) char* 返回 + 与普通 ARC 字符串拼接
    变量 路径: 字符串 = getenv("HOME");
    变量 消息: 字符串 = "HOME = " + 路径;
    打印行(消息);

    // 3) 小结构体按值返回
    变量 商余: 除结果 = imaxdiv(17, 5);
    打印行("17 / 5 商:");
    打印行(商余.商);
    打印行("17 % 5 余:");
    打印行(商余.余);
}
