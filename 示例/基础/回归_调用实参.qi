包 主程序;

// 回归（雷 A）：两个函数调用的结果直接作为实参（相加后传 / 分别作多实参 / 嵌套），
// 不先绑定到带类型局部变量。历史病历称此路径会「出垃圾 / 段错误」，且改成
// 「先存局部变量再传」就正常。此例逐项自校验，全部 PASS 即该路径无损坏。
//
// 覆盖：字符串（字面量返回 + 动态堆串返回，压 ARC 临时释放时机）、整数、
// 结构体返回、嵌套调用。运行输出应全部为 PASS。

函数 甲串(): 字符串 { 返回 "甲值"; }
函数 乙串(): 字符串 { 返回 "乙值"; }
函数 外层串(s: 字符串): 字符串 { 返回 s; }

// 返回动态构建的堆串（OWNED，非字面量）—— 压 ARC 临时值提前释放
函数 造甲(n: 整数): 字符串 { 返回 "甲" + n; }
函数 造乙(n: 整数): 字符串 { 返回 "乙" + n; }
函数 外层加叹号(s: 字符串): 字符串 { 返回 s + "!"; }

函数 取甲(): 整数 { 返回 10; }
函数 取乙(): 整数 { 返回 20; }
函数 求和(a: 整数, b: 整数): 整数 { 返回 a + b; }
函数 双串(x: 字符串, y: 字符串): 字符串 { 返回 x + "|" + y; }

类型 点 { x: 整数, y: 整数 }
函数 造点(a: 整数): 点 { 返回 新建 点 { x: a, y: a * 2 }; }
函数 用点(p: 点): 整数 { 返回 p.x + p.y; }

函数 入口() {
    // 1) 字符串：两调用相加直接传参 vs 先绑定局部变量再传
    变量 直接 = 外层串(甲串() + 乙串());
    变量 t = 甲串() + 乙串();
    变量 间接 = 外层串(t);
    如果 直接 == 间接 { 打印行("PASS 雷A字面量串直接传参"); }
    否则 { 打印行("FAIL 雷A字面量串直接传参: 直接=[" + 直接 + "] 间接=[" + 间接 + "]"); }

    // 2) 整数：两调用相加直接作两个实参
    变量 r1 = 求和(取甲() + 取乙(), 取甲() + 取乙());
    如果 r1 == 60 { 打印行("PASS 雷A整数相加传参"); }
    否则 { 打印行("FAIL 雷A整数相加传参 得" + r1); }

    // 3) 两调用结果分别作两实参 + 相加后作两实参
    变量 r2 = 双串(甲串(), 乙串());
    变量 r3 = 双串(甲串() + 乙串(), 乙串() + 甲串());
    如果 r2 == "甲值|乙值" { 打印行("PASS 雷A两串分别传参"); }
    否则 { 打印行("FAIL 雷A两串分别传参 得" + r2); }
    如果 r3 == "甲值乙值|乙值甲值" { 打印行("PASS 雷A两串相加双实参"); }
    否则 { 打印行("FAIL 雷A两串相加双实参 得" + r3); }

    // 4) 嵌套调用：外层(内层(A()+B()))
    变量 r4 = 求和(求和(取甲(), 取乙()), 求和(取乙(), 取甲()));
    如果 r4 == 60 { 打印行("PASS 雷A嵌套调用"); }
    否则 { 打印行("FAIL 雷A嵌套调用 得" + r4); }

    // 5) 堆串（OWNED）两调用相加直接传参，循环放大暴露 use-after-free
    变量 i = 0;
    变量 坏 = 0;
    当 i < 200 {
        变量 d = 外层加叹号(造甲(i) + 造乙(i));
        变量 g = 造甲(i) + 造乙(i);
        变量 e = 外层加叹号(g);
        如果 d != e { 坏 = 坏 + 1; }
        i = i + 1;
    }
    如果 坏 == 0 { 打印行("PASS 雷A堆串循环200"); }
    否则 { 打印行("FAIL 雷A堆串循环 坏=" + 坏); }

    // 6) 结构体返回直接作实参
    变量 s1 = 用点(造点(5));
    如果 s1 == 15 { 打印行("PASS 雷A结构体返回传参"); }
    否则 { 打印行("FAIL 雷A结构体返回传参 得" + s1); }
}
