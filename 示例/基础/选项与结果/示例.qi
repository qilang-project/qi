// 选项<T> 与 结果<T> —— 内建参数化枚举（按需单态实例化）
//
//   枚举 选项<T> { 有(T), 无 }
//   枚举 结果<T> { 成(T), 败(字符串) }
//
// 构造子：有(x) / 无 / 成(x) / 败(消息)。定型四规则见下方注释。

// 规则①：返回语句用声明的返回类型定型（选项<字符串>）
函数 找用户(编号: 整数): 选项<字符串> {
    如果 编号 == 1 {
        返回 有("张三");
    }
    返回 无;              // 裸 无 —— 由返回类型定型
}

// 规则①：结果<整数>（错误固定为字符串）
函数 除法(甲: 整数, 乙: 整数): 结果<整数> {
    如果 乙 == 0 {
        返回 败("除数为零");
    }
    返回 成(甲 / 乙);
}

// 规则③：实参位以形参类型定型（调用点写 有(9) 即可）
函数 描述选项(值: 选项<整数>) {
    匹配 值 {
        有(数) => { 打印行("有值：" + 整数转字符串(数)); }
        无 => { 打印行("空"); }
    }
}

函数 入口() {
    // 匹配解构 + 守卫
    匹配 找用户(1) {
        有(名) 如果 名 == "张三" => { 打印行("找到管理员：" + 名); }
        有(名) => { 打印行("找到：" + 名); }
        无 => { 打印行("查无此人"); }
    }
    匹配 找用户(2) {
        有(名) => { 打印行(名); }
        无 => { 打印行("查无此人"); }
    }

    // 结果解构
    匹配 除法(10, 2) {
        成(商) => { 打印行("商 = " + 整数转字符串(商)); }
        败(错) => { 打印行("错误：" + 错); }
    }
    匹配 除法(10, 0) {
        成(商) => { 打印行("商 = " + 整数转字符串(商)); }
        败(错) => { 打印行("错误：" + 错); }
    }

    // 规则②：变量注解定型
    变量 甲: 选项<整数> = 有(42);
    描述选项(甲);
    描述选项(无);          // 规则③：实参位 无 由形参类型定型

    // 规则④：无注解，按参数反推实例（成(7) → 结果<整数>）
    变量 乙 = 成(7);
    匹配 乙 {
        成(数) => { 打印行("反推成功：" + 整数转字符串(数)); }
        败(错) => { 打印行(错); }
    }

    // 字符串载荷循环（ARC 纪律：构造 → 匹配消费，无泄漏）
    变量 计: 整数 = 0;
    当 计 < 3 {
        变量 项: 选项<字符串> = 有("第" + 整数转字符串(计) + "项");
        匹配 项 {
            有(文) => { 打印行(文); }
            无 => { 打印行("无"); }
        }
        计 = 计 + 1;
    }
}
