// 枚举（enum）+ 匹配 解构示例
// 演示：无载荷枚举（纯 tag）、带载荷枚举（装箱）、匹配 解构与守卫。

包 主程序;

// 无载荷枚举：纯 C 风格，底层就是整数 tag，可用 等于 比较。
枚举 颜色 { 红, 绿, 蓝 }

// 带载荷枚举：任一变体带载荷 ⇒ 整个枚举装箱（堆指针）。
枚举 形状 {
    圆(浮点数),
    矩形(浮点数, 浮点数),
    点
}

函数 颜色名(c: 颜色) : 字符串 {
    匹配 c {
        红 => { 返回 "红"; }
        绿 => { 返回 "绿"; }
        蓝 => { 返回 "蓝"; }
    }
}

函数 面积(s: 形状) : 浮点数 {
    匹配 s {
        圆(半径) => { 返回 半径 乘 半径 乘 3.14; }
        矩形(宽, 高) => { 返回 宽 乘 高; }
        点 => { 返回 0.0; }
    }
}

函数 入口() {
    // 无载荷：构造 + 匹配
    变量 c: 颜色 = 颜色.绿;
    打印行("颜色：" + 颜色名(c));

    // 相等比较（无载荷枚举 == 可用）
    如果 c 等于 颜色.绿 {
        打印行("确认是绿色");
    }

    // 带载荷：构造 + 解构
    打印行("圆面积：" + 浮点数转字符串(面积(形状.圆(2.0))));
    打印行("矩形面积：" + 浮点数转字符串(面积(形状.矩形(3.0, 4.0))));
    打印行("点面积：" + 浮点数转字符串(面积(形状.点)));

    // 守卫 + 兜底
    匹配 形状.圆(5.0) {
        圆(半径) 如果 半径 大于 3.0 => { 打印行("这是一个大圆"); }
        _ => { 打印行("其他形状"); }
    }
}
