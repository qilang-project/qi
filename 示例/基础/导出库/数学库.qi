包 数学库;

// 反向 FFI 示例 —— 把 Qi 中文函数以 C ABI 导出，供 C / Rust / Go 等调用。
//
// 构建静态库 + C 头文件：
//   qi compile --库 静态 数学库.qi -o lib数学库.a
// 构建动态库：
//   qi compile --库 动态 数学库.qi -o lib数学库.dylib
// 生成的 数学库.h 声明所有导出函数；运行时在库加载时自动初始化。

// 默认用函数原名当 C 符号（clang/gcc/rustc 均接受 UTF-8 标识符，中文名可直接调用）。
导出 函数 加法(a: 整数, b: 整数): 整数 {
    返回 a + b;
}

导出 函数 减法(a: 整数, b: 整数): 整数 {
    返回 a - b;
}

// 字符串往返：C 传 const char*，返回 char*（C 侧用毕 free()）。
导出 函数 问候(名: 字符串): 字符串 {
    返回 "你好, " + 名;
}

// 显式指定干净的 ASCII C 符号名 —— 方便 Rust/Go 直接 extern "C" 链接。
导出 "qi_add" 函数 相加(a: 整数, b: 整数): 整数 {
    返回 a + b;
}

// 导出函数体内可正常用 Qi 全部特性：这里演示 打印行 + 选项<T> + 控制流。
导出 "qi_fib" 函数 斐波那契(n: 整数): 整数 {
    如果 (n < 2) {
        返回 n;
    }
    变量 a: 整数 = 0;
    变量 b: 整数 = 1;
    变量 i: 整数 = 2;
    当 (i <= n) {
        变量 c: 整数 = a + b;
        a = b;
        b = c;
        i = i + 1;
    }
    返回 b;
}
