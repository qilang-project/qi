// 字符串插值演示 | String Interpolation
// 普通双引号串里写 ${表达式}，脱糖为字符串拼接（复用格式串脱糖链）。
// - 反引号原始串里的 ${} 保持字面（JS/模板语义，绝不动）
// - \${ 输出字面 ${（转义）
包 主程序;

结构体 用户 {
    名字: 字符串,
    年龄: 整数,
}

函数 加一(n: 整数): 整数 {
    返回 n + 1;
}

函数 入口() {
    打印行("===== 字符串插值 =====");

    // 标识符插值
    变量 名 = "小奇";
    打印行("你好 ${名}！");

    // 整数 + 算术表达式
    变量 n = 5;
    打印行("n=${n}，n+1=${n + 1}，n*2=${n * 2}");

    // 浮点数
    变量 价格 = 3.14;
    打印行("圆周率约等于 ${价格}");

    // 字符串变量拼接
    变量 前缀 = "Qi";
    变量 后缀 = "语言";
    打印行("语言名：${前缀}${后缀}");

    // 结构体字段访问
    变量 用户甲 = 新建 用户 {
        名字: "阿奇",
        年龄: 8,
    };
    打印行("${用户甲.名字} 今年 ${用户甲.年龄} 岁");

    // 函数调用
    打印行("加一(10) = ${加一(10)}");

    // 一句里多个洞 + 起手就是洞
    打印行("${名} 说：${n} + ${加一(n)} = ${n + 加一(n)}");

    // 转义：\${ 输出字面 ${（不插值）
    打印行("单价写法：\${价格} 表示字面量，实际值是 ${价格}");

    // 反引号原始串：${} 保持字面，绝不插值（内嵌 JS 模板）
    打印行(`前端模板 <span>${user.name}</span> 不会被替换`);

    // 无插值的普通串：行为不变，字面 { } 原样
    打印行("普通 JSON 片段 {\"键\": \"值\"} 原样输出");
}
