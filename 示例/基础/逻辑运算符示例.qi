包 主程序;

// 中文逻辑运算符示例
//   且 == &&（逻辑与）
//   或 == ||（逻辑或）
//   非 == !（逻辑非）
// 优先级与 && || ! 完全一致：非 最高，且 次之，或 最低。
// 中英文写法可自由混用。

函数 可否入场(年龄: 整数, 有票: 布尔, 是嘉宾: 布尔) : 布尔 {
    // 是嘉宾 直接放行；否则需成年且持票
    返回 是嘉宾 或 (年龄 >= 18 且 有票);
}

函数 入口() {
    变量 a: 整数 = 3;
    变量 b: 整数 = 2;
    变量 关闭: 布尔 = 假;

    如果 (a > 1 且 b < 5 或 非 关闭) {
        打印行("条件命中");
    }

    如果 非 关闭 {
        打印行("非 关闭 为真");
    }

    // 与 / && 等价于 且
    如果 a > 0 与 b > 0 {
        打印行("与 也可用");
    }

    如果 可否入场(20, 真, 假) {
        打印行("成年持票，可入场");
    }
    如果 可否入场(10, 假, 真) {
        打印行("嘉宾，可入场");
    }
    如果 非 可否入场(10, 假, 假) {
        打印行("未成年无票非嘉宾，拒绝");
    }
}
