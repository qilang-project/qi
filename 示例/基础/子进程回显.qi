包 主程序;

导入 标准库.子进程 作为 子进程;
导入 标准库.输入输出 作为 IO;

函数 入口() {
    变量 句柄: 整数 = 子进程.生成("cat", "[]");
    如果 (句柄 <= 0) {
        IO.打印行("启动失败");
        返回;
    }
    子进程.写入行(句柄, "你好子进程");
    变量 行内容: 字符串 = 子进程.读取行(句柄);
    IO.打印行("读回: " + 行内容);
    子进程.结束(句柄);
    变量 存活状态: 整数 = 子进程.存活(句柄);
    如果 (存活状态 == 0) {
        IO.打印行("存活=0");
    } 否则 {
        IO.打印行("存活=1");
    }
}
