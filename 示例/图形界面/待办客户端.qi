// 奇语 Qi · GUI 示例 —— 待办「桌面客户端」（egui + HTTP + 后端，纯 Qi 全栈）
//
// 单轨 egui 架构：桌面客户端用 标准库.HTTP 调 qi-todo-api（qi-web + SQLite）后端，
// 渲染成原生 egui 复选框列表。勾选某行：先**乐观更新**本地状态（immediate mode
// 即时反馈），再**开协程**在后台把改动 PUT 持久化到后端——后端慢也不卡 UI。
//
// 先启动后端：  qi run qi-todo-api/主程序.qi
// 再运行本程序：qi run 待办客户端.qi
// 勾选某行切换完成状态（即时反馈，数据异步落库）。后端未启动时列表为空但窗口正常。

包 主程序;

导入 标准库.图形化 作为 图形;
导入 标准库.HTTP 作为 HTTP;
导入 标准库.JSON 作为 JSON;
导入 标准库.列表 作为 列表库;
导入 标准库.输入输出 作为 IO;

常量 接口地址 = "http://127.0.0.1:43717/todos";

变量 id表: 整数 = 0;        // 整数列表
变量 标题表: 整数 = 0;      // 字符串列表
变量 完成表: 整数 = 0;      // 整数列表（0/1），乐观更新就改它
变量 总数: 整数 = 0;
变量 待持久化行: 整数 = -1;  // 传给后台协程

// 从后端拉取并填充本地缓存（后端未起时安全返回空）
函数 加载() {
    变量 组: 整数 = JSON.解码(HTTP.获取(接口地址));
    总数 = JSON.数组长度(组);
    id表 = 列表库.创建整数列表();
    标题表 = 列表库.创建字符串列表();
    完成表 = 列表库.创建整数列表();
    变量 i: 整数 = 0;
    当 (i < 总数) {
        变量 记录: 整数 = JSON.数组获取对象(组, i);
        列表库.添加整数(id表, JSON.获取整数(记录, "id"));
        列表库.添加字符串(标题表, JSON.获取字符串(记录, "标题"));
        列表库.添加整数(完成表, JSON.获取整数(记录, "完成"));
        i = i + 1;
    }
}

// 后台协程：把某行 PUT 到后端（与 UI 解耦，慢也不卡）
函数 后台持久化() {
    变量 行号: 整数 = 待持久化行;
    如果 (行号 >= 0) {
        变量 编号: 整数 = 列表库.获取整数(id表, 行号);
        HTTP.更新(接口地址 + "/" + 整数转字符串(编号), "done");
    }
}

函数 入口() {
    变量 应用: 整数 = 图形.应用创建("奇语 Qi · 待办客户端", 560, 560);
    如果 (应用 == 0) {
        IO.打印行("应用创建失败（GUI 库不可用？）");
        返回;
    }
    加载();
    IO.打印行("就绪：勾选切换完成（即时反馈，后台异步落库）。关窗退出。");

    当 (图形.帧开始(应用) == 1) {
        图形.设置主题(0);
        图形.标题文本("待办 · 点击切换");
        图形.彩色标签("异步落库 · qi-web + SQLite 后端", 214, 68, 47);
        图形.分隔线();

        如果 (总数 == 0) {
            图形.标签("（列表为空：请先启动 qi-todo-api 后端）");
        }

        图形.滚动开始("列表", 380);
        变量 下标: 整数 = 0;
        当 (下标 < 总数) {
            变量 当前: 整数 = 列表库.获取整数(完成表, 下标);
            变量 标题: 字符串 = 列表库.获取字符串(标题表, 下标);
            变量 行id: 字符串 = "row" + 整数转字符串(下标);
            变量 新值: 整数 = 图形.复选框(行id, 标题, 当前);
            如果 (新值 != 当前) {
                列表库.设置整数(完成表, 下标, 新值);   // 1) 乐观更新
                待持久化行 = 下标;
                启动 后台持久化();                     // 2) 后台协程落库
            }
            下标 = 下标 + 1;
        }
        图形.滚动结束();

        图形.帧结束(应用);
    }

    图形.关闭应用(应用);
    IO.打印行("窗口已关闭，干净退出。");
}
