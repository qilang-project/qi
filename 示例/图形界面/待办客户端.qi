// 奇语 Qi · GUI 示例 —— 待办「桌面客户端」（GUI + 事件 + HTTP + 后端）
//
// 全栈纯 Qi 演示：桌面客户端用 标准库.HTTP 调 qi-todo-api（qi-web + SQLite）后端，
// 渲染成原生窗口列表，并且**可点击交互**：点某一行 → PUT 切换该待办完成状态 →
// 重新拉取 → 重绘。事件经 图形.设置事件处理 接入 Qi。
//
// 先启动后端（默认 127.0.0.1:43717）：
//     qi run qi-todo-api/主程序.qi
// 再运行本客户端：
//     qi run 待办客户端.qi
// 然后在窗口里点击某一行，待办的完成状态会即时切换（数据真的落到后端 SQLite）。

包 主程序;

导入 标准库.图形化 作为 图形;
导入 标准库.HTTP 作为 HTTP;
导入 标准库.JSON 作为 JSON;
导入 标准库.输入输出 作为 IO;

常量 宽 = 560;
常量 高 = 480;
常量 接口地址 = "http://127.0.0.1:43717/todos";
常量 行高 = 60;
常量 首行顶 = 96;

变量 渲染器: 整数 = 0;
变量 上次X: 整数 = 0;
变量 上次Y: 整数 = 0;

// 画一行待办（完成=1 翡翠实心框+删除线，否则浅灰空框）
函数 画待办行(行号: 整数, 完成: 整数, 文本: 字符串) {
    变量 顶: 整数 = 首行顶 + 行号 * 行高;
    变量 框X: 整数 = 28;
    变量 框宽: 整数 = 28;
    变量 文本X: 整数 = 72;
    变量 文本Y: 整数 = 顶 + 4;

    图形.绘制直线(渲染器, 24, 顶 + 46, 宽 - 24, 顶 + 46, 230, 224, 214);

    如果 (完成 == 1) {
        图形.绘制矩形(渲染器, 框X, 顶, 框宽, 框宽, 92, 180, 148);
        图形.绘制直线(渲染器, 框X + 6, 顶 + 14, 框X + 12, 顶 + 20, 250, 250, 250);
        图形.绘制直线(渲染器, 框X + 12, 顶 + 20, 框X + 22, 顶 + 6, 250, 250, 250);
        图形.绘制缩放文本(渲染器, 文本, 文本X, 文本Y, 2, 150, 140, 130);
        图形.绘制直线(渲染器, 文本X, 顶 + 16, 文本X + 360, 顶 + 16, 150, 140, 130);
    } 否则 {
        图形.绘制矩形(渲染器, 框X, 顶, 框宽, 框宽, 224, 218, 208);
        图形.绘制矩形(渲染器, 框X + 3, 顶 + 3, 框宽 - 6, 框宽 - 6, 245, 240, 232);
        图形.绘制缩放文本(渲染器, 文本, 文本X, 文本Y, 2, 40, 35, 30);
    }
}

// 从后端拉取并重绘整个列表
函数 重绘() {
    变量 响应: 字符串 = HTTP.获取(接口地址);
    变量 记录组: 整数 = JSON.解码(响应);
    变量 总数: 整数 = JSON.数组长度(记录组);

    图形.清除画面(渲染器, 245, 240, 232);
    图形.绘制矩形(渲染器, 0, 0, 宽, 64, 214, 68, 47);
    图形.绘制缩放文本(渲染器, "待办 · 点击切换", 24, 18, 3, 250, 250, 250);
    图形.绘制缩放文本(渲染器, "HTTP", 宽 - 90, 24, 2, 250, 235, 230);

    变量 下标: 整数 = 0;
    当 (下标 < 总数) {
        变量 记录: 整数 = JSON.数组获取对象(记录组, 下标);
        变量 标题: 字符串 = JSON.获取字符串(记录, "标题");
        变量 完成: 整数 = JSON.获取整数(记录, "完成");
        画待办行(下标, 完成, 标题);
        下标 = 下标 + 1;
    }

    图形.绘制矩形(渲染器, 0, 高 - 36, 宽, 36, 236, 230, 220);
    图形.绘制缩放文本(渲染器, "点某一行切换完成 · 数据落后端 SQLite", 24, 高 - 28, 2, 110, 100, 90);
}

// 命中某一行 → 取该待办 id → PUT 切换完成 → 重绘
函数 切换行(行号: 整数) {
    变量 响应: 字符串 = HTTP.获取(接口地址);
    变量 记录组: 整数 = JSON.解码(响应);
    变量 总数: 整数 = JSON.数组长度(记录组);
    如果 (行号 >= 0) {
        如果 (行号 < 总数) {
            变量 记录: 整数 = JSON.数组获取对象(记录组, 行号);
            变量 编号: 整数 = JSON.获取整数(记录, "id");
            HTTP.更新(接口地址 + "/" + 整数转字符串(编号), "done");
            重绘();
        }
    }
}

// 事件处理：4=光标移动（记录逻辑坐标），3=鼠标键（按下时按行命中切换）
函数 处理事件(窗口: 整数, 事件类型: 整数, 甲: 整数, 乙: 整数) {
    如果 (事件类型 == 4) {
        上次X = 甲;
        上次Y = 乙;
    }
    如果 (事件类型 == 3) {
        如果 (乙 == 1) {
            如果 (上次Y >= 首行顶) {
                变量 行号: 整数 = (上次Y - 首行顶) / 行高;
                切换行(行号);
            }
        }
    }
}

函数 入口() {
    变量 窗口: 整数 = 图形.创建窗口("奇语 Qi · 待办客户端", 宽, 高);
    图形.显示窗口(窗口);
    渲染器 = 图形.创建渲染器(窗口);
    重绘();
    图形.设置事件处理(窗口, 处理事件);
    IO.打印行("就绪：在窗口里点击某一行切换完成状态（关闭窗口退出）");
    图形.运行();
}
