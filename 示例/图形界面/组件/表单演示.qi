// 奇语 Qi · 组件库示例 —— 用户注册
//
// 一个真表单该有的东西全在这一屏里：一行一个字段、填错了当场出红字、
// 一列可点的城市、一块「你填了什么」的摘要、以及一个圆环告诉你还差几项。
//
// 全部用 qi-widgets（包名「组件」）搭出来，这个文件里没有一行直接调
// 图形化的布局原语 —— 那些都被组件包起来了。对比一下 控件演示.qi：
// 那个是直接调原语的写法，同样的东西要长两三倍，而且每加一个字段就要
// 重抄一遍 水平开始/标签/输入框/水平结束。
//
// ── immediate mode：变量是唯一的真相 ─────────────────────────────────
//
// 每一帧都把当前变量交给组件，组件把用户改过的新值还回来，存回变量。
// 屏幕上显示的永远就是变量里的值，不存在「控件里是一个值、程序里是另一个值」
// 这种传统 GUI 的经典 bug。
//
// 运行：
//     cd qi/示例/图形界面/组件
//     qi run 表单演示.qi
// 关窗即退出。自动化跑用 QI_GUI_AUTOCLOSE_MS=2500 让它自己关。

包 主程序;

导入 标准库.图形化 作为 图形;
导入 标准库.输入输出 作为 IO;
导入 组件.主题 作为 主题;
导入 组件.表单 作为 表单;
导入 组件.校验 作为 校验;
导入 组件.列表视图 作为 视图;
导入 组件.键值表 作为 键值;
导入 组件.进度环 作为 环;

// ═══════════════════════════════════════════════════════════════════
//  界面状态：全部由本程序持有
// ═══════════════════════════════════════════════════════════════════

变量 姓名: 字符串 = "";
变量 年龄: 整数 = 18;
变量 邮箱: 字符串 = "";
变量 手机: 字符串 = "";
变量 同意: 整数 = 0;
变量 城市序号: 整数 = 0 - 1;      // -1 = 还没选
变量 已提交: 整数 = 0;

常量 城市表 = "北京,上海,广州,深圳,杭州,成都,西安,武汉,南京,重庆";
常量 总项数 = 6;

// ═══════════════════════════════════════════════════════════════════
//  「填好了吗」：界面上三个地方都要问，所以摘成函数
// ═══════════════════════════════════════════════════════════════════
//
// 红字提示、摘要里的状态、进度环的百分比，问的是同一件事。
// 三处各写一遍判断条件，改规则的时候必定漏掉一处 —— 那种 bug 表现为
// 「环显示 100% 但按确定说还没填完」，用户会觉得程序疯了。

函数 姓名合格() : 整数 {
    如果 (校验.非空(姓名) == 0) { 返回 0; }
    返回 校验.长度在(姓名, 2, 12);
}

函数 年龄合格() : 整数 {
    如果 (年龄 >= 6 且 年龄 <= 120) { 返回 1; }
    返回 0;
}

函数 邮箱合格() : 整数 { 返回 校验.像邮箱(邮箱); }
函数 手机合格() : 整数 { 返回 校验.像手机号(手机); }

函数 城市合格() : 整数 {
    如果 (城市序号 >= 0) { 返回 1; }
    返回 0;
}

函数 已填项数() : 整数 {
    变量 计: 整数 = 0;
    计 = 计 + 姓名合格();
    计 = 计 + 年龄合格();
    计 = 计 + 邮箱合格();
    计 = 计 + 手机合格();
    计 = 计 + 城市合格();
    计 = 计 + 同意;
    返回 计;
}

函数 全部合格() : 整数 {
    如果 (已填项数() == 总项数) { 返回 1; }
    返回 0;
}

// 摘要串："姓名=张三,年龄=18,..."。键值表 直接吃这种串。
//
// 没填的字段填「—」而不是跳过：字段列表长度固定，用户扫一眼就知道
// 还有哪几行是空的；跳过的话行数每帧都在变，看着晃。
函数 摘要串() : 字符串 {
    变量 一串: 字符串 = "姓名=" + 或缺(姓名);
    一串 = 一串 + ",年龄=" + 整数转字符串(年龄) + " 岁";
    一串 = 一串 + ",邮箱=" + 或缺(邮箱);
    一串 = 一串 + ",手机=" + 或缺(手机);
    一串 = 一串 + ",城市=" + 或缺(视图.选中文本(城市表, 城市序号));
    返回 一串;
}

函数 或缺(值: 字符串) : 字符串 {
    如果 (校验.非空(值) == 1) { 返回 值; }
    返回 "—";
}

// ═══════════════════════════════════════════════════════════════════
//  三块界面
// ═══════════════════════════════════════════════════════════════════

// 表单本体。
//
// 每个字段下面紧跟它自己的提示 —— 提示离字段越近越好。所有错误堆在表单
// 底下的那种设计，用户看到「第 3 项有误」还得数一遍是哪一行。
函数 画表单() {
    图形.分组开始("填写资料");

    姓名 = 表单.表单行("姓名", 姓名);
    如果 (校验.非空(姓名) == 0) {
        表单.必填提示(姓名, "姓名必填");
    } 否则 {
        表单.规则提示(校验.长度在(姓名, 2, 12), "姓名请填 2~12 个字");
    }

    年龄 = 表单.数字行("年龄", 年龄, 0, 120);
    表单.规则提示(年龄合格(), "年龄需在 6~120 岁之间");

    邮箱 = 表单.表单行("邮箱", 邮箱);
    如果 (校验.非空(邮箱) == 0) {
        表单.必填提示(邮箱, "邮箱必填");
    } 否则 {
        表单.规则提示(邮箱合格(), "邮箱格式不对，例：ming@example.com");
    }

    手机 = 表单.表单行("手机", 手机);
    如果 (校验.非空(手机) == 0) {
        表单.必填提示(手机, "手机号必填");
    } 否则 {
        表单.规则提示(手机合格(), "手机号是 11 位数字、1 开头");
    }

    图形.分隔线();
    同意 = 表单.开关行("条款", 同意);
    表单.规则提示(同意, "要继续得先同意用户条款");

    图形.分组结束();
}

// 城市列表。
//
// 用列表视图而不是下拉：选中的那条整行高亮，一眼看得见「我选的是哪个」。
// 十个城市摊开来太占地方，所以用滚动版 —— 视口只占 108pt，剩下的滚轮滚。
函数 画城市() {
    图形.分组开始("常住城市（滚动列表，滚轮往下翻）");
    城市序号 = 视图.列表视图滚动("城市", 城市表, 城市序号, 108);
    图形.分组结束();
}

// 摘要 + 进度环。
//
// 两块合在一个分组里、进度数字写进分组标题，都是为了省行 —— 一屏放得下才叫演示，
// 要滚动才看得见完成度环，那这个环就白画了。
函数 画摘要() {
    图形.分组开始("填写摘要 · 已完成 " + 整数转字符串(已填项数())
                  + " / " + 整数转字符串(总项数) + " 项");
    键值.键值表(摘要串());
    // 进度环画的是**画布图元**，必须在画布里 —— 进度环独占 帮忙把
    // 画布开始/画布结束 配对好了，调用方不用管。
    环.进度环独占("完成度环", 40, 环.完成百分比(已填项数(), 总项数));
    图形.分组结束();
}

// 底部：提交栏 + 结果。
函数 画底栏() {
    图形.分隔线();
    变量 选了: 整数 = 表单.提交栏("提交注册", "重填");

    如果 (选了 == 1) {
        如果 (全部合格() == 1) {
            已提交 = 1;
            IO.打印行("已提交：" + 摘要串());
        } 否则 {
            已提交 = 0;
        }
    }
    如果 (选了 == 2) {
        重填();
    }

    如果 (已提交 == 1) {
        变量 成: 整数 = 主题.成功色();
        图形.彩色标签("注册成功，欢迎加入！", 主题.拆R(成), 主题.拆G(成), 主题.拆B(成));
        返回;
    }
    如果 (全部合格() == 0) {
        表单.弱提示("还有 " + 整数转字符串(总项数 - 已填项数()) + " 项没填好，填完才能提交。");
    }
}

函数 重填() {
    姓名 = "";
    年龄 = 18;
    邮箱 = "";
    手机 = "";
    同意 = 0;
    城市序号 = 0 - 1;
    已提交 = 0;
}

// ═══════════════════════════════════════════════════════════════════

函数 入口() {
    // 单列布局：不是不想左右分栏，是分不了 —— 图形化的 水平开始 里放输入框，
    // 输入框会把整行宽度吃光，右栏被挤出屏幕。缺「定宽/分栏」原语，已记在报告里。
    变量 应用: 整数 = 图形.应用创建("奇语 Qi · 组件库 · 用户注册", 820, 880);
    如果 (应用 == 0) {
        IO.打印行("窗口打不开（图形库不可用？）");
        返回;
    }

    // 组件库色板：亮。窗口那边的控件配色在循环里设（见下面）。
    主题.用亮主题();
    表单.设提交栏缩进(46);       // 按 820pt 宽的窗口把两个按钮顶到右边

    IO.打印行("窗口已弹出：填几个字段，看红字提示、摘要和完成度圆环怎么跟着变。");

    当 (图形.帧开始(应用) == 1) {
        // ⚠ 两套主题得对齐，而且 设置主题 只能在帧里调。
        //
        // 图形化自己有深/浅两套控件配色（背景、边框、按钮），组件库的 主题 是另一套
        // （红字、灰键、进度环的颜色从它取）。只调一边就会出现「深色背景 + 深色文字」
        // 这种看不见的字 —— 进度环中间那个百分比第一次就是这么整个消失的。
        //
        // 而 设置主题 拿的是当前帧的上下文，放在 帧开始 之前调是空调一场（没有报错，
        // 就是没生效）—— 第二次踩的就是这个。
        图形.设置主题(0);

        图形.标题文本("用户注册");
        表单.弱提示("整屏用 qi-widgets 搭的：表单行 / 校验 / 列表视图 / 键值表 / 进度环。");

        画表单();
        画城市();
        画摘要();
        画底栏();

        图形.帧结束(应用);
    }

    图形.关闭应用(应用);
    IO.打印行("窗口已关闭，干净退出。");
}
