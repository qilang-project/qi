// 奇语 Qi · 组件库示例 —— 基础组件五件
//
// 一个窗口里摆全 qi-widgets 的五件基础组件：
//     标签页  顶上一排页签，点谁看谁
//     卡片    带标题的方块，把内容分组
//     徽章    一小块带颜色的状态字
//     工具栏  横着一排按钮，返回点了第几个
//     对话框  「真的删除吗」这一下（读后即清的边沿语义）
//
// 组件库是纯 qi 写的，建在 标准库.图形化 的控件原语上，一行 Rust 都没有。
//
// ── 立即模式怎么读这段代码 ─────────────────────────────────────
//
// 整个 当 (帧开始) { ... } 循环体每秒钟跑六十遍，每遍都把界面从头画一次。
// 所以：
//   · 所有界面状态（第几页、点了几次、待办勾没勾）都是本文件顶上的普通变量
//   · 组件不替你记东西，它把「你给的值」画出来，把「用户改成了什么」还给你
//   · 对话框是个例外，它自己记着弹没弹 —— 那是一次交互的中间态，不是数据
//
// 跑：
//     cd qi/示例/图形界面/组件
//     qi run 基础组件演示.qi
//
// 想让它自己关（比如在 CI 里跑一遍确认不崩）：
//     QI_GUI_AUTOCLOSE_MS=2500 qi run 基础组件演示.qi

包 主程序;

导入 标准库.图形化 作为 图形;
导入 标准库.输入输出 作为 IO;
导入 组件.主题 作为 主题;
导入 组件.卡片 作为 卡片;
导入 组件.标签页 作为 标签页;
导入 组件.工具栏 作为 工具条;
导入 组件.对话框 作为 对话框;
导入 组件.徽章 作为 徽章;

// ── 界面状态：全在这儿，组件一个都不替我们记 ──────────────────
变量 页号: 整数 = 0;
变量 点击次数: 整数 = 0;
变量 上次动作: 字符串 = "还没点过";
变量 待办条数: 整数 = 3;
变量 删过一次: 整数 = 0;
变量 主题已同步: 整数 = 0;

// ═══════════════════════════════════════════════════════════════════
//  第一页：卡片 + 徽章
// ═══════════════════════════════════════════════════════════════════

函数 画首页() {
    // 一行式便捷卡片：标题 + 一句话。
    卡片.信息卡("欢迎", "这是用 qi-widgets 拼出来的界面，五件基础组件都在这儿。");

    // 三段式卡片：自己往里塞任意控件。
    卡片.卡片开始("服务器状态");
    图形.水平开始();
    图形.标签("主库 pg-01");
    徽章.徽章("在线", "成功");
    图形.水平结束();
    图形.水平开始();
    图形.标签("从库 pg-02");
    徽章.徽章("延迟偏高", "警告");
    图形.水平结束();
    图形.水平开始();
    图形.标签("备份任务");
    徽章.徽章("失败", "危险");
    图形.水平结束();
    图形.水平开始();
    图形.标签("灰度实验");
    徽章.徽章("草稿", "默认");
    图形.水平结束();
    卡片.卡片结束();

    卡片.卡片开始("徽章的几种用法");
    图形.水平开始();
    徽章.计数徽章("未读", 0);          // 0 条用灰色：没有消息不该抢注意力
    徽章.计数徽章("未读", 7);          // 有消息才亮起主色
    徽章.开关徽章("已启用", "已停用", 1);
    徽章.开关徽章("已启用", "已停用", 0);
    图形.水平结束();
    卡片.卡片结束();

    // 带灰色小字的卡片：主要信息配次要信息。
    卡片.说明卡("待办", "还剩 " + 整数转字符串(待办条数) + " 条",
                "去「工具栏」页可以删掉它们");
}

// ═══════════════════════════════════════════════════════════════════
//  第二页：工具栏 + 点击计数
// ═══════════════════════════════════════════════════════════════════

函数 画工具页() {
    卡片.卡片开始("工具栏：返回本帧点了第几个（没点是 -1）");

    变量 点了: 整数 = 工具条.带题工具栏("文件", "新建,打开,保存,另存为");
    如果 (点了 >= 0) {
        点击次数 = 点击次数 + 1;
        上次动作 = "文件 · " + 工具条.按钮名("新建,打开,保存,另存为", 点了)
                 + "（下标 " + 整数转字符串(点了) + "）";
    }

    变量 点了二: 整数 = 工具条.带题工具栏("编辑", "撤销,重做,查找");
    如果 (点了二 >= 0) {
        点击次数 = 点击次数 + 1;
        上次动作 = "编辑 · " + 工具条.按钮名("撤销,重做,查找", 点了二)
                 + "（下标 " + 整数转字符串(点了二) + "）";
    }

    图形.分隔线();
    图形.标签("一共点了 " + 整数转字符串(点击次数) + " 次");
    图形.标签("最近一次：" + 上次动作);
    卡片.卡片结束();

    卡片.卡片开始("为什么返回下标不返回按钮名");
    图形.标签("按钮名一改，拿名字比对的判断就悄悄失效，编译器不会吭声。");
    图形.标签("下标是数字，改名不影响。");
    卡片.卡片结束();
}

// ═══════════════════════════════════════════════════════════════════
//  第三页：对话框
// ═══════════════════════════════════════════════════════════════════

函数 画危险页() {
    卡片.卡片开始("危险动作");
    图形.标签("待办还剩 " + 整数转字符串(待办条数) + " 条。");
    如果 (图形.按钮("删除全部待办") == 1) {
        对话框.弹确认("真的删除全部 " + 整数转字符串(待办条数) + " 条待办？删了就没了。");
    }
    如果 (删过一次 == 1) {
        徽章.徽章("已清空", "危险");
    }
    卡片.卡片结束();

    卡片.说明卡("模态是怎么回事",
                "立即模式没有窗口层级，谁也拦不住底下那层。",
                "所以约定是：弹着的时候调用方自己跳过别的界面 —— 见主循环里那个 如果。");
}

// ═══════════════════════════════════════════════════════════════════
//  主循环
// ═══════════════════════════════════════════════════════════════════

函数 入口() {
    主题.用亮主题();

    变量 应用: 整数 = 图形.应用创建("奇语 Qi · 基础组件五件", 720, 760);
    如果 (应用 == 0) {
        IO.打印行("应用创建失败（GUI 库不可用？）");
        返回;
    }

    IO.打印行("窗口已弹出：点顶上的页签切页，第三页试试删除确认。关窗即退出。");

    当 (图形.帧开始(应用) == 1) {
        // 组件库的 主题 只管自己画的那几种颜色（卡片标题、徽章、灰色小字），
        // egui 的底色和边框走它自己的明暗主题 —— 两边不打招呼的话，亮主题的
        // 深色文字会画在 egui 的深色底上，糊成一片。所以开头对齐一次。
        //
        // 必须放在**帧里面**：设置主题 是靠当前帧的 egui 上下文生效的，
        // 帧外调用（比如紧跟着 应用创建 写一行）会静悄悄不起作用。
        如果 (主题已同步 == 0) {
            图形.设置主题(0);          // 0 = 浅色，配 主题.用亮主题()
            主题已同步 = 1;
        }

        图形.标题文本("奇语 Qi · 基础组件五件");

        // 对话框优先：弹着就只画它，连页签一起跳过。
        //
        // 页签也要跳过是有讲究的：立即模式没人替你拦住底下那层，页签要是照画，
        // 用户就能在「确定要删吗」还挂着的时候切到别的页 —— 对话框跟着飘过去，
        // 问的还是上一页的事。这就是文件头说的「模态靠调用方自觉」。
        如果 (对话框.画对话框() == 1) {
            // 什么都不画，本帧到此为止
        } 否则 {
            // 页号是我们自己的变量：交给标签栏画，收回新页号。
            页号 = 标签页.标签栏(页号, "首页,工具栏,危险动作");
            如果 (页号 == 0) { 画首页(); }
            如果 (页号 == 1) { 画工具页(); }
            如果 (页号 == 2) { 画危险页(); }
        }

        // 收答复。读一次就清，所以下面这两句不会被每帧重复触发。
        如果 (对话框.确认了() == 1) {
            待办条数 = 0;
            删过一次 = 1;
            IO.打印行("用户确认了删除。");
        }
        如果 (对话框.取消了() == 1) {
            IO.打印行("用户取消了删除。");
        }

        图形.帧结束(应用);
    }

    图形.关闭应用(应用);
    IO.打印行("窗口已关闭，干净退出。");
}
