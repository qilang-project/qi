// 奇语 Qi · 组件库示例 —— 接小球
//
// 一个从头玩到尾的完整小游戏：开始画面 → 玩 → 暂停 → 结束 → 再来一局。
// 全部游戏逻辑就是下面 入口() 里那几十行，剩下的杂活都归 组件.游戏框架 管。
//
// ── 怎么玩 ───────────────────────────────────────────────────────
//     空格      开始 / 再来一局
//     ← →       左右移动挡板（按住不放会一直走）
//     ESC       暂停 / 继续
//     关窗      退出
//
//   接住一个 +10 分，漏掉 3 个就结束，一局 60 秒。
//
// ── 这个例子想让你看见的三件事 ───────────────────────────────────
//
//   1. **状态机是免费的**。开始画面、暂停、结束、重开，一行都没写 ——
//      全在 游戏.下一帧() 里。你只管「球怎么动」。
//
//   2. **碰撞是借来的**。判断球和挡板撞上没有，用的是海龟包里
//      写好的 帮手.矩形相撞 —— 跨着两个包直接拿来用，不用重抄一遍。
//
//   3. **物理是小抄**。挡板别跑出屏幕（夹在）、球从哪冒出来（随机X），
//      这些一句话的算术都在 组件.精灵物理 里，名字就是它干的事。
//
// ── 自己改改看 ───────────────────────────────────────────────────
//     · 把 挡板宽 改小 → 立刻变难
//     · 把 能漏几个 改成 1 → 一次都不能错
//     · 让球左右晃：球X = 球X + 物理.随机在(0-2, 2);
//     · 接住的时候加分改成 球速 那么多分 → 越快的球越值钱
//
// 运行：
//     cd qi/示例/图形界面/组件
//     qi run 接小球.qi

包 主程序;

导入 标准库.输入输出 作为 IO;
导入 组件.游戏框架 作为 游戏;
导入 组件.精灵物理 作为 物理;
导入 组件.主题 作为 主题;
导入 海龟.游戏帮手 作为 帮手;

常量 屏宽 = 640;
常量 屏高 = 480;
常量 天空顶 = 34;          // 抬头横幅底下一点，球从这儿开始掉
常量 挡板宽 = 96;
常量 挡板高 = 14;
常量 球半径 = 15;
常量 能漏几个 = 3;
常量 一局多少秒 = 60;
常量 挡板步 = 9;           // 挡板每帧走几像素

// 这一局的东西在哪
变量 挡板X: 整数 = 0;
变量 球X: 整数 = 0;
变量 球Y: 整数 = 0;
变量 球速: 整数 = 5;
变量 球色号: 整数 = 0;
变量 漏了几个: 整数 = 0;
变量 接了几个: 整数 = 0;

函数 挡板Y() : 整数 { 返回 屏高 - 34; }

// 球换一种颜色出场，四种轮着来 —— 一眼看得出「这是新的一个球」。
函数 球的颜色() : 整数 {
    如果 (球色号 % 4 == 0) { 返回 主题.主色(); }
    如果 (球色号 % 4 == 1) { 返回 主题.成功色(); }
    如果 (球色号 % 4 == 2) { 返回 主题.警告色(); }
    返回 主题.危险色();
}

// 放一个新球到天上。横着随便挑个位置，但要留出半径，
// 不然球会有一半卡在屏幕外面。
函数 放新球() {
    球X = 物理.随机X(屏宽 - 球半径 * 2) + 球半径;
    球Y = 天空顶 + 球半径;
    球色号 = 球色号 + 1;
    // 接得越多掉得越快，但封顶 —— 再快就成了运气游戏，不好玩了。
    球速 = 5 + 接了几个 / 3;
    如果 (球速 > 13) { 球速 = 13; }
}

// 把这一局清回开局的样子。开局和「按空格重开」都会走到这儿。
函数 摆回原位() {
    挡板X = (屏宽 - 挡板宽) / 2;
    漏了几个 = 0;
    接了几个 = 0;
    球色号 = 0;
    放新球();
}

// 球和挡板撞上了吗？
//
// 借海龟包里现成的 矩形相撞：把圆球当成刚好套住它的一个方块。
// 方块比圆略大一圈，判定因此稍微宽松一点点 —— 对孩子来说这是好事，
// 擦着边接住会被算接住，玩起来不憋屈。
函数 接住了() : 整数 {
    返回 帮手.矩形相撞(球X - 球半径, 球Y - 球半径, 球半径 * 2, 球半径 * 2,
                      挡板X, 挡板Y(), 挡板宽, 挡板高);
}

// 画还能漏几个：三个小圆，漏一个灭一个。
// 比写「还剩 2 条命」直观 —— 不用读字，扫一眼就知道。
函数 画剩下的命() {
    对于 号 在 0 直到 能漏几个 {
        变量 色: 整数 = 主题.危险色();
        如果 (号 < 漏了几个) { 色 = 主题.边线色(); }      // 已经漏掉的，灰掉
        游戏.画圆(16 + 号 * 20, 屏高 - 12, 6, 色);
    }
}

函数 入口() {
    如果 (游戏.初始化("接小球 · 奇语 Qi", 屏宽, 屏高) == 0) {
        IO.打印行("窗口打不开（图形库不可用？）");
        返回;
    }
    游戏.开始倒计时(一局多少秒);
    IO.打印行("空格开始 · ← → 移动挡板 · ESC 暂停 · 关窗退出");

    当 (游戏.下一帧() == 1) {

        如果 (游戏.在开始画面() == 1) {
            游戏.画开始画面("接 小 球", "按空格开始");
        }

        如果 (游戏.进行中() == 1) {
            // 新的一局：东西全摆回原位。开局和重开都会进这里。
            如果 (游戏.刚开局() == 1) { 摆回原位(); }

            // ── 挡板：按住方向键就一直走，夹在屏幕里不许出界 ──
            如果 (游戏.按住("左") == 1) { 挡板X = 挡板X - 挡板步; }
            如果 (游戏.按住("右") == 1) { 挡板X = 挡板X + 挡板步; }
            挡板X = 物理.夹在(挡板X, 0, 屏宽 - 挡板宽);

            // ── 球：往下掉 ──
            球Y = 球Y + 球速;

            如果 (接住了() == 1) {
                接了几个 = 接了几个 + 1;
                游戏.加分(10);
                放新球();
            }

            // 掉到屏幕底下就算漏了。要整个球都出去才算 ——
            // 只碰到底边就判漏，擦着挡板下沿溜过去的球会显得很冤。
            如果 (球Y - 球半径 > 屏高) {
                漏了几个 = 漏了几个 + 1;
                放新球();
                如果 (漏了几个 >= 能漏几个) {
                    IO.打印行("漏了 " + 整数转字符串(漏了几个) + " 个，这局结束。得分 "
                        + 整数转字符串(游戏.得分()));
                    游戏.判负();
                }
            }

            // ── 画面 ──
            游戏.画圆(球X, 球Y, 球半径, 球的颜色());
            游戏.画方(挡板X, 挡板Y(), 挡板宽, 挡板高, 主题.主色());
            游戏.画方(0, 屏高 - 4, 屏宽, 4, 主题.边线色());     // 地面
            画剩下的命();
            游戏.画抬头();       // 抬头最后画，盖在最上面
        }

        如果 (游戏.在结束画面() == 1) {
            游戏.画结束画面();
        }
    }

    游戏.收场();
    IO.打印行("再见！最高分 " + 整数转字符串(游戏.最高分())
        + "，一共渲染 " + 整数转字符串(游戏.帧数()) + " 帧。");
}
