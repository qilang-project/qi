// 奇语 Qi · GUI 示例 —— 待办清单看板
//
// 用 标准库.图形化（基于 Tao + Skia）绘制一个原生窗口的待办清单：
//   朱砂色标题栏 + 若干待办行，每行一个复选框（已完成=翡翠绿实心，
//   未完成=浅灰），已完成项加一条删除线。
//
// 渲染模型：创建窗口 → 创建渲染器 → 清除画面 → 逐项绘制 → 运行(事件循环)。
// 注意：当前 图形化 模块未向 Qi 暴露「事件回调」，所以这是一个**渲染型**看板
//       （展示数据、可关窗），交互式增删待办需后续把事件回调接进 Qi。
//
// 运行： qi run 待办清单.qi      编译： qi compile 待办清单.qi -o 待办看板

包 主程序;

导入 标准库.图形化 作为 图形;
导入 标准库.输入输出 作为 IO;

常量 宽 = 540;
常量 高 = 460;

// 画一行待办：行号从 0 开始；完成=1 时画翡翠实心框+删除线，否则浅灰空框
函数 画待办行(渲染器: 整数, 行号: 整数, 完成: 整数, 文本: 字符串) {
    变量 顶: 整数 = 96 + 行号 * 60;
    变量 框X: 整数 = 28;
    变量 框宽: 整数 = 28;
    变量 文本X: 整数 = 72;
    变量 文本Y: 整数 = 顶 + 4;

    // 行底分隔线（浅灰）
    图形.绘制直线(渲染器, 24, 顶 + 46, 宽 - 24, 顶 + 46, 230, 224, 214);

    如果 (完成 == 1) {
        // 复选框：翡翠绿实心
        图形.绘制矩形(渲染器, 框X, 顶, 框宽, 框宽, 92, 180, 148);
        // 勾（用两条线近似）
        图形.绘制直线(渲染器, 框X + 6, 顶 + 14, 框X + 12, 顶 + 20, 250, 250, 250);
        图形.绘制直线(渲染器, 框X + 12, 顶 + 20, 框X + 22, 顶 + 6, 250, 250, 250);
        // 文本：灰色 + 删除线（绘制缩放文本 参数序：渲染器,文本,x,y,缩放,r,g,b）
        图形.绘制缩放文本(渲染器, 文本, 文本X, 文本Y, 2, 150, 140, 130);
        图形.绘制直线(渲染器, 文本X, 顶 + 16, 文本X + 360, 顶 + 16, 150, 140, 130);
    } 否则 {
        // 复选框：浅灰空框（实心浅灰底 + 深色描边近似）
        图形.绘制矩形(渲染器, 框X, 顶, 框宽, 框宽, 224, 218, 208);
        图形.绘制矩形(渲染器, 框X + 3, 顶 + 3, 框宽 - 6, 框宽 - 6, 245, 240, 232);
        // 文本：深色
        图形.绘制缩放文本(渲染器, 文本, 文本X, 文本Y, 2, 40, 35, 30);
    }
}

函数 入口() {
    变量 窗口: 整数 = 图形.创建窗口("奇语 Qi · 待办清单", 宽, 高);
    IO.打印行("窗口句柄 = ", 窗口);
    图形.显示窗口(窗口);

    变量 渲染器: 整数 = 图形.创建渲染器(窗口);
    IO.打印行("渲染器句柄 = ", 渲染器);

    // 背景：宣纸色
    图形.清除画面(渲染器, 245, 240, 232);

    // 顶部朱砂标题栏
    图形.绘制矩形(渲染器, 0, 0, 宽, 64, 214, 68, 47);
    图形.绘制缩放文本(渲染器, "我的待办", 24, 18, 3, 250, 250, 250);
    图形.绘制缩放文本(渲染器, "Qi GUI", 宽 - 120, 24, 2, 250, 235, 230);

    // 待办项（已完成 / 未完成）
    画待办行(渲染器, 0, 1, "写 qi-web 教程");
    画待办行(渲染器, 1, 1, "修复跨包编译重复符号");
    画待办行(渲染器, 2, 0, "给 qi-harness 加并发工具派发");
    画待办行(渲染器, 3, 0, "做一个待办 GUI 示例");
    画待办行(渲染器, 4, 0, "发布 Windows 安装包");

    // 底部统计条
    图形.绘制矩形(渲染器, 0, 高 - 36, 宽, 36, 236, 230, 220);
    图形.绘制缩放文本(渲染器, "共 5 项 · 已完成 2 · 待办 3", 24, 高 - 28, 2, 110, 100, 90);

    IO.打印行("进入事件循环（关闭窗口退出）…");
    图形.运行();
}
