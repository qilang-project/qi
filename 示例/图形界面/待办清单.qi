// 奇语 Qi · GUI 示例 —— 待办清单看板（egui 控件版）
//
// 单轨 egui 架构：用 复选框 / 标签 / 分隔线 / 滚动区 摆出一个可交互的待办清单。
// 勾选即时切换完成状态（immediate mode：每帧把状态传给控件、再收回新值），
// 底部实时统计已完成/待办数。老 tao 自绘看板已废弃。
//
// 运行：qi run 待办清单.qi（关窗退出）

包 主程序;

导入 标准库.图形化 作为 图形;
导入 标准库.输入输出 作为 IO;

// 五项待办的完成状态（0/1），immediate mode 每帧传入/收回
变量 完成1: 整数 = 1;
变量 完成2: 整数 = 1;
变量 完成3: 整数 = 0;
变量 完成4: 整数 = 0;
变量 完成5: 整数 = 0;

函数 入口() {
    变量 应用: 整数 = 图形.应用创建("奇语 Qi · 待办清单", 540, 520);
    如果 (应用 == 0) {
        IO.打印行("应用创建失败（GUI 库不可用？）");
        返回;
    }
    IO.打印行("窗口已弹出：勾选切换完成，底部实时统计。关窗退出。");

    当 (图形.帧开始(应用) == 1) {
        图形.设置主题(0);
        图形.标题文本("我的待办");
        图形.彩色标签("Qi GUI · egui 控件版", 214, 68, 47);
        图形.分隔线();

        完成1 = 图形.复选框("t1", "写 qi-web 教程", 完成1);
        完成2 = 图形.复选框("t2", "修复跨包编译重复符号", 完成2);
        完成3 = 图形.复选框("t3", "给 qi-harness 加并发工具派发", 完成3);
        完成4 = 图形.复选框("t4", "做一个待办 GUI 示例", 完成4);
        完成5 = 图形.复选框("t5", "发布 Windows 安装包", 完成5);

        图形.分隔线();
        变量 已完成: 整数 = 完成1 + 完成2 + 完成3 + 完成4 + 完成5;
        变量 待办: 整数 = 5 - 已完成;
        变量 统计: 字符串 = "共 5 项 · 已完成 " + 整数转字符串(已完成) + " · 待办 " + 整数转字符串(待办);
        图形.标签(统计);
        图形.进度条(已完成 * 20);

        图形.帧结束(应用);
    }

    图形.关闭应用(应用);
    IO.打印行("窗口已关闭，干净退出。");
}
