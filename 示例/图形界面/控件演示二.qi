// 奇语 Qi · GUI 示例 —— egui 第二批控件演示
//
// 覆盖 2026-07 新增的 16 个 FFI：滚动区 / 折叠区 / 单选 / 选择项 / 数字输入 /
// 浮点滑条 / 超链接 / 悬浮标签 / 表格 / 柱状图 / 图片显示 / 设置主题 /
// 界面缩放 / 设置窗口标题。
//
// 跑法同 控件演示.qi：qi run 控件演示二.qi（关窗退出）

包 主程序;

导入 标准库.图形化 作为 图形;
导入 标准库.输入输出 作为 IO;

// 界面状态（immediate mode：每帧传入/收回）
变量 深色: 整数 = 1;
变量 套餐: 整数 = 0;
变量 选中行: 整数 = 0;
变量 份数: 整数 = 2;
变量 辣度: 浮点数 = 1.5;

函数 入口() {
    变量 应用: 整数 = 图形.应用创建("奇语 Qi · 控件演示二", 760, 900);
    如果 (应用 == 0) {
        IO.打印行("应用创建失败（GUI 库不可用？）");
        返回;
    }
    IO.打印行("窗口已弹出：滚动、折叠、点单选、拖数字、开合主题。关窗即退出。");

    当 (图形.帧开始(应用) == 1) {
        图形.设置主题(深色);
        图形.标题文本("第二批控件全家福");

        // 主题切换 + 窗口标题联动
        图形.水平开始();
        如果 (图形.单选("深色", 深色) == 1) {
            深色 = 1;
            图形.设置窗口标题(应用, "奇语 Qi · 深色模式");
        }
        如果 (图形.单选("浅色", 深色 == 0) == 1) {
            深色 = 0;
            图形.设置窗口标题(应用, "奇语 Qi · 浅色模式");
        }
        图形.水平结束();
        图形.分隔线();

        // 折叠区：点餐表单（单选组 / 数字输入 / 浮点滑条）
        如果 (图形.折叠开始("🍜 点餐表单（折叠区）") == 1) {
            图形.水平开始();
            图形.标签("套餐：");
            如果 (图形.单选("牛肉面", 套餐 == 0) == 1) { 套餐 = 0; }
            如果 (图形.单选("担担面", 套餐 == 1) == 1) { 套餐 = 1; }
            如果 (图形.单选("阳春面", 套餐 == 2) == 1) { 套餐 = 2; }
            图形.水平结束();
            图形.水平开始();
            图形.标签("份数（拖拽改）：");
            份数 = 图形.数字输入("份数", 份数);
            图形.水平结束();
            图形.标签("辣度（浮点滑条）：");
            辣度 = 图形.浮点滑条("辣度", 辣度, 0.0, 5.0);
            图形.悬浮标签("👆 把鼠标悬停在我上面", "这是悬浮提示气泡！");
        }
        图形.折叠结束();
        图形.分隔线();

        // 滚动区：长列表 + 可选中行
        图形.标签("滚动区（20 行菜单，滚轮滚动，点击选中）：");
        图形.滚动开始("菜单", 160);
        对于 i 在 1 到 20 {
            变量 行文本: 字符串 = 模板"第 {i} 号菜品 · 招牌手工面";
            如果 (图形.选择项(行文本, 选中行 == i) == 1) {
                选中行 = i;
            }
        }
        图形.滚动结束();
        图形.标签(模板"当前选中：第 {选中行} 号");
        图形.分隔线();

        // 表格 + 柱状图
        图形.折叠开始("📊 本周销量（表格 + 柱状图）");
        图形.表格("销量表", "星期,销量,好评",
            "周一,38,97\n周二,52,98\n周三,41,96\n周四,66,99\n周五,88,99");
        图形.柱状图("销量图", "38,52,41,66,88", 0, 140);
        图形.折叠结束();

        // 超链接
        图形.超链接("qilang 官网仓库", "https://github.com/qilang-project/qi");

        图形.帧结束(应用);
    }

    图形.关闭应用(应用);
    IO.打印行(模板"再见！最后一单：套餐 {套餐} × {份数} 份，辣度 {辣度}");
}
