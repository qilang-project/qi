// 奇语 Qi · GUI 示例 —— 待办清单（egui 控件版）
//
// 对照老的裸画布 待办清单.qi（手搓矩形/直线/文本模拟复选框与删除线），本例用
// egui 控件层实现同样的功能，代码更短、且真正可交互：
//   输入框 + 「添加」按钮 → 往列表追加；每项一个复选框，勾选即标记完成。
//
// 数据用 标准库.列表 持有（字符串列表存文本、整数列表存完成状态），界面每帧
// 声明式重建 —— 这就是 immediate mode。
//
// 运行： qi run 待办控件版.qi

包 主程序;

导入 标准库.图形化 作为 图形;
导入 标准库.列表 作为 清单库;
导入 标准库.输入输出 作为 IO;

变量 待办: 整数 = 0;        // 字符串列表句柄
变量 完成: 整数 = 0;        // 整数列表句柄（0/1）
变量 输入内容: 字符串 = "";

函数 入口() {
    变量 应用: 整数 = 图形.应用创建("奇语 Qi · 待办（控件版）", 520, 640);
    如果 (应用 == 0) {
        IO.打印行("应用创建失败（GUI 库不可用？）");
        返回;
    }

    待办 = 清单库.创建字符串列表();
    完成 = 清单库.创建整数列表();
    // 预置几项
    清单库.添加字符串(待办, "写 qi-web 教程");
    清单库.添加整数(完成, 1);
    清单库.添加字符串(待办, "给 egui 控件层加折线图");
    清单库.添加整数(完成, 1);
    清单库.添加字符串(待办, "做一个待办控件版示例");
    清单库.添加整数(完成, 0);

    IO.打印行("待办窗口已弹出：输入 + 添加 + 勾选。关窗即退出。");

    当 (图形.帧开始(应用) == 1) {
        图形.标题文本("我的待办");
        图形.标签("输入内容后点「添加」，勾选表示完成。");
        图形.分隔线();

        // 添加一行：「添加」按钮 + 输入框（按钮在前，输入框自动填满剩余宽度）
        图形.水平开始();
        如果 (图形.按钮("添加") == 1) {
            如果 (字符串::字节长度(输入内容) > 0) {
                清单库.添加字符串(待办, 输入内容);
                清单库.添加整数(完成, 0);
                输入内容 = "";
            }
        }
        输入内容 = 图形.输入框("新待办", 输入内容);
        图形.水平结束();
        图形.分隔线();

        // 列表：每项一个复选框（标签即待办文本），勾选写回完成状态
        变量 总数: 整数 = 清单库.字符串列表大小(待办);
        变量 完成数: 整数 = 0;
        变量 序号: 整数 = 0;
        当 (序号 < 总数) {
            变量 文本: 字符串 = 清单库.获取字符串(待办, 序号);
            变量 状态: 整数 = 清单库.获取整数(完成, 序号);
            变量 行号: 字符串 = 整数转字符串(序号);
            变量 新状态: 整数 = 图形.复选框("待办" + 行号, 文本, 状态);
            如果 (新状态 != 状态) {
                清单库.设置整数(完成, 序号, 新状态);
            }
            如果 (新状态 == 1) {
                完成数 = 完成数 + 1;
            }
            序号 = 序号 + 1;
        }

        图形.分隔线();
        图形.彩色标签(
            "共 " + 整数转字符串(总数) + " 项 · 已完成 " + 整数转字符串(完成数),
            110,
            120,
            140,
        );

        图形.帧结束(应用);
    }

    图形.关闭应用(应用);
    IO.打印行("待办窗口已关闭，干净退出。");
}
