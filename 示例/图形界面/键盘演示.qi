// 奇语 Qi · GUI 示例 —— 键盘输入（做小游戏的基础）
//
// 键盘是做游戏的前提：没有它，贪吃蛇、接小球一个都写不了。图形化模块提供三个
// 查询函数，都在帧循环里调用，读的是**本帧**的按键快照：
//
//   图形.按键按住("左")    → 1/0  这一帧该键处于按下状态（持续触发，适合移动）
//   图形.按键刚按("空格")  → 1/0  这一帧刚按下的那一下（边沿触发，适合跳跃/开火）
//   图形.任意键刚按()      → 1/0  有任何键刚按下（用来做"按任意键开始"）
//
// 「按住」和「刚按」的区别，一句话记住：
//   按住 —— 你不松手，它每帧都返回 1（所以方块会一直走）
//   刚按 —— 你不松手，它只在按下的那一帧返回 1（所以颜色只换一次，不会狂闪）
//
// 键名不分大小写，中文英文都认：
//   方向键  "上" "下" "左" "右"（也认 "UP" "DOWN" "LEFT" "RIGHT"）
//   字母    "A" ~ "Z"（"w" 和 "W" 一样）
//   数字    "0" ~ "9"
//   其它    "空格" "回车" "ESC" "SHIFT" "TAB"
//   认不出的名字返回 0，并在终端提醒你一次。
//
// 玩法：
//   方向键 或 WASD  —— 移动方块（按住会一直走）
//   空格            —— 换方块颜色（按一下换一次）
//   数字 1 / 2 / 3  —— 直接跳到第 1/2/3 号颜色
//   ESC             —— 退出程序
//   关窗            —— 也退出
//
// 运行：qi run 键盘演示.qi

包 主程序;

导入 标准库.图形化 作为 图形;
导入 标准库.输入输出 作为 IO;

常量 宽 = 640;
常量 高 = 400;
常量 边长 = 40;
常量 步长 = 6;        // 每帧移动像素；60fps 下约每秒 360 像素

变量 方块X: 整数 = 300;
变量 方块Y: 整数 = 200;
变量 颜色号: 整数 = 0;
变量 换色次数: 整数 = 0;
变量 帧数: 整数 = 0;

// 三套颜色，按 颜色号 取。qi 暂无元组，拆成三个取值函数最直白。
函数 取红(号: 整数): 整数 {
    如果 (号 == 0) { 返回 255; }
    如果 (号 == 1) { 返回 90; }
    返回 255;
}

函数 取绿(号: 整数): 整数 {
    如果 (号 == 0) { 返回 184; }
    如果 (号 == 1) { 返回 210; }
    返回 110;
}

函数 取蓝(号: 整数): 整数 {
    如果 (号 == 0) { 返回 76; }
    如果 (号 == 1) { 返回 255; }
    返回 200;
}

// 把值夹在 [下限, 上限] 之间，免得方块跑出画布
函数 夹住(值: 整数, 下限: 整数, 上限: 整数): 整数 {
    如果 (值 < 下限) { 返回 下限; }
    如果 (值 > 上限) { 返回 上限; }
    返回 值;
}

函数 入口() {
    变量 应用: 整数 = 图形.应用创建("奇语 Qi · 键盘演示", 宽, 高 + 40);
    如果 (应用 == 0) {
        IO.打印行("应用创建失败（GUI 库不可用？）");
        返回;
    }

    IO.打印行("就绪：方向键/WASD 移动，空格换色，1/2/3 选色，ESC 或关窗退出。");

    当 (图形.帧开始(应用) == 1) {
        图形.设置主题(1);
        帧数 = 帧数 + 1;

        // ── 读键盘：按住类（每帧都问，所以按住不松就一直动）──
        如果 (图形.按键按住("左") == 1 || 图形.按键按住("A") == 1) {
            方块X = 方块X - 步长;
        }
        如果 (图形.按键按住("右") == 1 || 图形.按键按住("D") == 1) {
            方块X = 方块X + 步长;
        }
        如果 (图形.按键按住("上") == 1 || 图形.按键按住("W") == 1) {
            方块Y = 方块Y - 步长;
        }
        如果 (图形.按键按住("下") == 1 || 图形.按键按住("S") == 1) {
            方块Y = 方块Y + 步长;
        }
        方块X = 夹住(方块X, 0, 宽 - 边长);
        方块Y = 夹住(方块Y, 60, 高 - 边长);

        // ── 读键盘：刚按类（按住不松也只算一次）──
        如果 (图形.按键刚按("空格") == 1) {
            颜色号 = (颜色号 + 1) % 3;
            换色次数 = 换色次数 + 1;
        }
        如果 (图形.按键刚按("1") == 1) { 颜色号 = 0; }
        如果 (图形.按键刚按("2") == 1) { 颜色号 = 1; }
        如果 (图形.按键刚按("3") == 1) { 颜色号 = 2; }

        // ESC 退出：跟关窗一个效果
        如果 (图形.按键刚按("ESC") == 1) {
            IO.打印行("按下 ESC，退出。");
            图形.帧结束(应用);
            图形.关闭应用(应用);
            返回;
        }

        // ── 画面 ──
        图形.画布开始("场景", 宽, 高);
        图形.画布矩形(0, 0, 宽, 高, 18, 20, 28);
        图形.画布矩形(0, 0, 宽, 56, 36, 42, 58);
        图形.画布文本(16, 8, "方向键/WASD 移动 · 空格换色 · 1/2/3 选色 · ESC 退出", 15, 235, 238, 245);
        图形.画布文本(16, 30, "换色次数：" + 整数转字符串(换色次数)
            + "    位置：" + 整数转字符串(方块X) + "," + 整数转字符串(方块Y),
            14, 150, 160, 180);

        图形.画布矩形(方块X, 方块Y, 边长, 边长,
            取红(颜色号), 取绿(颜色号), 取蓝(颜色号));

        // 按住哪个方向就在下边亮哪个字，直观看到"按住"是持续的
        变量 提示: 字符串 = "按住：";
        如果 (图形.按键按住("左") == 1 || 图形.按键按住("A") == 1) { 提示 = 提示 + "← "; }
        如果 (图形.按键按住("右") == 1 || 图形.按键按住("D") == 1) { 提示 = 提示 + "→ "; }
        如果 (图形.按键按住("上") == 1 || 图形.按键按住("W") == 1) { 提示 = 提示 + "↑ "; }
        如果 (图形.按键按住("下") == 1 || 图形.按键按住("S") == 1) { 提示 = 提示 + "↓ "; }
        图形.画布文本(16, 高 - 26, 提示, 16, 120, 200, 160);

        图形.画布结束();
        图形.帧结束(应用);
    }

    图形.关闭应用(应用);
    // 帧数也打出来：自动化脚本靠它确认"真的渲染过"，不是开了窗一帧没画就退了
    IO.打印行("窗口已关闭，再见。共渲染 " + 整数转字符串(帧数) + " 帧。");
}
