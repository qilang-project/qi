// 奇语 Qi · GUI 示例 —— 画布精灵（把图片当"角色"用）
//
// 这是 Scratch「角色」的平替：一张 png 摆到画布上，能缩放、能绕中心转、能左右镜像。
// 拼小游戏就靠这三下。本例同时演示三种用法：
//
//   1. 小球沿画布边缘转圈       画布图片旋转(...)，球自己也在滚
//   2. 小猫始终朝向鼠标         画布图片旋转(...)，角度由鼠标位置算
//   3. 点一下，落一只镜像的猫   画布图片翻转(..., 1)
//
// 另外用 图片宽/图片高 读原始尺寸，按比例放大小猫（免得拉变形）。
//
// 素材：素材/小球.png、素材/小猫.png（32x32，由 素材/生成素材.py 现场画出来的，
// 不是下载来的）。**图片路径相对进程当前目录解析**，所以要先 cd 到本文件所在目录：
//
//     cd qi/示例/图形界面 && qi run 精灵演示.qi
//
// 路径写错也不会白屏——画不出来的地方会出现一个刺眼的品红方块，位置/大小/角度
// 跟真图一模一样，一眼就知道是哪一句的图没找到。关窗退出。

包 主程序;

导入 标准库.图形化 作为 图形;
导入 标准库.输入输出 作为 IO;
导入 标准库.数学 作为 数学;

// 朝向角度(dx, dy)：从原点指向 (dx, dy) 的方向角，角度制整数。
// 约定 0 度 = 正右方（小猫原图就是脸朝右画的），正数顺时针（屏幕 Y 轴朝下）。
// 标准库只有单参反正切，所以左半平面的象限要自己补 180 度。
函数 朝向角度(横差: 浮点数, 纵差: 浮点数) : 整数 {
    变量 圆周率: 浮点数 = 数学.圆周率();
    变量 弧度: 浮点数 = 0.0;
    如果 (横差 > 0.001 或 横差 < -0.001) {
        弧度 = 数学.反正切(纵差 / 横差);
        如果 (横差 < 0.0) {
            弧度 = 弧度 + 圆周率;
        }
    } 否则 {
        // 正上方 / 正下方：除法会炸，直接给 ±90 度
        如果 (纵差 >= 0.0) {
            弧度 = 圆周率 / 2.0;
        } 否则 {
            弧度 = 0.0 - 圆周率 / 2.0;
        }
    }
    返回 浮点数转整数(弧度 * 180.0 / 圆周率);
}

函数 入口() {
    变量 宽: 整数 = 640;
    变量 高: 整数 = 420;
    变量 小球图: 字符串 = "素材/小球.png";
    变量 小猫图: 字符串 = "素材/小猫.png";

    变量 应用: 整数 = 图形.应用创建("奇语 Qi · 画布精灵", 宽, 高);
    如果 (应用 == 0) {
        IO.打印行("应用创建失败（GUI 库不可用？）");
        返回;
    }
    如果 (图形.精灵层版本() == 0) {
        IO.打印行("提示：当前运行时没编进 GUI，精灵画不出来。");
    }

    // 读原始尺寸，按宽度等比放大 —— 不看原始比例硬填宽高，图就拉变形了
    变量 原宽: 整数 = 图形.图片宽(小猫图);
    变量 原高: 整数 = 图形.图片高(小猫图);
    IO.打印行("小猫原始尺寸：" + 整数转字符串(原宽) + " x " + 整数转字符串(原高));
    变量 猫宽: 整数 = 76;
    变量 猫高: 整数 = 76;
    如果 (原宽 > 0) {
        猫高 = 猫宽 * 原高 / 原宽;
    }

    变量 圆周率: 浮点数 = 数学.圆周率();
    变量 猫心X: 整数 = 宽 / 2;
    变量 猫心Y: 整数 = 高 / 2 + 10;

    // 这三个要跨帧记住，所以声明在循环外面
    变量 帧数: 整数 = 0;
    变量 点过: 整数 = 0;
    变量 落点X: 整数 = 0;
    变量 落点Y: 整数 = 0;

    IO.打印行("就绪：小球绕圈、小猫追鼠标；在画布上点一下会落一只镜像的猫。关窗退出。");

    当 (图形.帧开始(应用) == 1) {
        图形.设置主题(1);
        帧数 = 帧数 + 1;
        变量 毫秒: 整数 = 帧数 * 16;   // 60fps 下每帧约 16ms，当时间源用

        图形.画布开始("舞台", 宽, 高);

        // 背景 + 顶栏
        图形.画布矩形(0, 0, 宽, 高, 18, 20, 28);
        图形.画布矩形(0, 0, 宽, 52, 36, 42, 58);
        图形.画布文本(20, 15, "画布精灵 · 图片当角色用", 20, 235, 238, 245);

        // ① 小球沿边缘转圈：椭圆轨道贴着画布四边跑，球本身也在滚（角度 x2 更明显）
        变量 轨道角: 整数 = (毫秒 / 20) - ((毫秒 / 20) / 360) * 360;
        变量 轨道弧度: 浮点数 = 整数转浮点数(轨道角) * 圆周率 / 180.0;
        变量 球心X: 整数 = 宽 / 2 + 浮点数转整数(数学.余弦(轨道弧度) * 258.0);
        变量 球心Y: 整数 = 高 / 2 + 20 + 浮点数转整数(数学.正弦(轨道弧度) * 148.0);
        图形.画布图片旋转(小球图, 球心X, 球心Y, 48, 48, 轨道角 * 2);

        // ② 小猫朝鼠标：鼠标不在画布上时（返回 -1）就朝正右方待着
        变量 鼠标X: 整数 = 图形.画布鼠标X();
        变量 鼠标Y: 整数 = 图形.画布鼠标Y();
        变量 猫角度: 整数 = 0;
        如果 (鼠标X >= 0) {
            猫角度 = 朝向角度(整数转浮点数(鼠标X - 猫心X), 整数转浮点数(鼠标Y - 猫心Y));
            // 画一条从猫到鼠标的引导线，方便看出"确实在跟"
            图形.画布线(猫心X, 猫心Y, 鼠标X, 鼠标Y, 1, 70, 80, 100);
        }
        图形.画布图片旋转(小猫图, 猫心X, 猫心Y, 猫宽, 猫高, 猫角度);

        // ③ 点一下：在点击处落一只水平镜像的猫（脸朝左）
        如果 (图形.画布点击() == 1) {
            落点X = 图形.画布鼠标X();
            落点Y = 图形.画布鼠标Y();
            点过 = 1;
        }
        如果 (点过 == 1) {
            // 翻转版走左上角对齐，所以要自己把中心换算成左上角
            图形.画布图片翻转(小猫图, 落点X - 猫宽 / 2, 落点Y - 猫高 / 2, 猫宽, 猫高, 1);
            图形.画布文本(落点X - 24, 落点Y + 猫高 / 2, "镜像的我", 13, 150, 200, 240);
        }

        // 不带缩放的原样贴图：左下角放一个"图例"，顺带演示 画布图片
        图形.画布图片(小球图, 16, 高 - 44, 28, 28);
        图形.画布文本(52, 高 - 38, "画布图片 / 画布图片旋转 / 画布图片翻转", 13, 150, 160, 180);

        变量 角度文本: 字符串 = "帧 " + 整数转字符串(帧数) + "   猫朝向 " + 整数转字符串(猫角度) + " 度";
        图形.画布文本(20, 62, 角度文本, 14, 130, 145, 170);

        图形.画布结束();
        图形.帧结束(应用);
    }

    图形.关闭应用(应用);
    IO.打印行("窗口已关闭，干净退出。");
}
