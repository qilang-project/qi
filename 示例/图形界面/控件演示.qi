// 奇语 Qi · GUI 示例 —— egui 控件演示（immediate mode）
//
// 用 标准库.图形化 的 egui 控件层写一个真正带控件的原生窗口：标题 / 按钮计数 /
// 输入框回显 / 滑条 / 进度条 / 复选框 / 下拉选择 / 折线图。全部中文文本。
//
// 主循环模型（qilang 持有主循环，egui 手动驱动）：
//     应用 = 应用创建(标题, 宽, 高)
//     当 (帧开始(应用) == 1) {   // 帧开始 抽事件；窗口关闭时返回 0 退出循环
//         ...在这里声明式地摆控件，控件的值由本程序每帧传入/取回...
//         帧结束(应用)           // 一次性上屏 + 60fps 限帧
//     }
//     关闭应用(应用)
//
// 运行： qi run 控件演示.qi

包 主程序;

导入 标准库.图形化 作为 图形;
导入 标准库.输入输出 作为 IO;

// 界面状态由本程序持有（immediate mode：每帧把当前值交给控件，再收回新值）
变量 计数: 整数 = 0;
变量 名字: 字符串 = "奇语";
变量 音量: 整数 = 50;
变量 同意: 整数 = 0;
变量 语言序号: 整数 = 0;

函数 入口() {
    变量 应用: 整数 = 图形.应用创建("奇语 Qi · egui 控件演示", 720, 820);
    如果 (应用 == 0) {
        IO.打印行("应用创建失败（GUI 库不可用？）");
        返回;
    }

    IO.打印行("窗口已弹出：拖动滑条、点按钮、输入文字、勾选、切换下拉。关窗即退出。");

    当 (图形.帧开始(应用) == 1) {
        图形.标题文本("奇语 Qi · egui 控件演示");
        图形.标签("这是一个用 qilang 写的原生控件界面（immediate mode）。");
        图形.分隔线();

        // 按钮 + 计数
        图形.分组开始("按钮与计数");
        图形.水平开始();
        如果 (图形.按钮("点我 +1") == 1) {
            计数 = 计数 + 1;
        }
        如果 (图形.按钮("清零") == 1) {
            计数 = 0;
        }
        图形.标签("当前计数：" + 整数转字符串(计数));
        图形.水平结束();
        图形.分组结束();

        // 输入框回显
        图形.分组开始("文本输入");
        名字 = 图形.输入框("名字", 名字);
        图形.标签("你好，" + 名字 + "！");
        图形.分组结束();

        // 滑条 + 进度条
        图形.分组开始("滑条与进度");
        音量 = 图形.滑条("音量", 音量, 0, 100);
        图形.进度条(音量);
        图形.分组结束();

        // 复选 + 下拉 + 彩色标签
        图形.分组开始("复选与下拉");
        同意 = 图形.复选框("同意", "我同意用户条款", 同意);
        语言序号 = 图形.下拉选择("界面语言", "简体中文,English,Francais", 语言序号);
        如果 (同意 == 1) {
            图形.彩色标签("已同意，可以继续", 80, 180, 120);
        } 否则 {
            图形.彩色标签("请先勾选同意", 210, 90, 70);
        }
        图形.分组结束();

        // 折线图：训练损失曲线（AI 原理课画损失用）
        图形.分组开始("折线图 · 训练损失");
        图形.折线图("损失", "1.0,0.72,0.55,0.41,0.33,0.27,0.22,0.19,0.16,0.14,0.13", 660, 200);
        图形.分组结束();

        图形.帧结束(应用);
    }

    图形.关闭应用(应用);
    IO.打印行("窗口已关闭，干净退出。");
}
