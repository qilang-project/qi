// 奇语 Qi · GUI 示例 —— 待办「自动刷新」客户端（GUI + 定时器 + HTTP + 后端）
//
// 在「待办客户端」基础上加上**自动刷新**：窗口开一个定时器，每隔 2 秒
// 由事件循环投递一次「定时器事件」（事件类型=6）。回调收到后重新向
// qi-todo-api（qi-web + SQLite）后端拉取数据并重绘——这样即使别的客户端
// （比如 qi-todo-cli）改了数据库，本窗口也会自动跟上，无需手动刷新。
//
// 先启动后端：  qi run qi-todo-api/主程序.qi
// 再运行本程序：qi run 自动刷新待办.qi
// 点击某行可即时切换完成状态；同时每 2 秒自动与后端同步一次。
//
// 设置定时器(毫秒)：需在 运行 之前调用，0=关闭。

包 主程序;

导入 标准库.图形化 作为 图形;
导入 标准库.HTTP 作为 HTTP;
导入 标准库.JSON 作为 JSON;
导入 标准库.列表 作为 列表库;
导入 标准库.输入输出 作为 IO;

常量 宽 = 560;
常量 高 = 480;
常量 接口地址 = "http://127.0.0.1:43717/todos";
常量 行高 = 60;
常量 首行顶 = 96;
常量 刷新间隔毫秒 = 2000;

变量 渲染器: 整数 = 0;
变量 id表: 整数 = 0;        // 整数列表
变量 标题表: 整数 = 0;      // 字符串列表
变量 完成表: 整数 = 0;      // 整数列表（0/1）
变量 总数: 整数 = 0;
变量 上次Y: 整数 = 0;
变量 刷新计数: 整数 = 0;

函数 画待办行(行号: 整数, 完成: 整数, 文本: 字符串) {
    变量 顶: 整数 = 首行顶 + 行号 * 行高;
    图形.绘制直线(渲染器, 24, 顶 + 46, 宽 - 24, 顶 + 46, 230, 224, 214);
    如果 (完成 == 1) {
        图形.绘制矩形(渲染器, 28, 顶, 28, 28, 92, 180, 148);
        图形.绘制直线(渲染器, 34, 顶 + 14, 40, 顶 + 20, 250, 250, 250);
        图形.绘制直线(渲染器, 40, 顶 + 20, 50, 顶 + 6, 250, 250, 250);
        图形.绘制缩放文本(渲染器, 文本, 72, 顶 + 4, 2, 150, 140, 130);
        图形.绘制直线(渲染器, 72, 顶 + 16, 432, 顶 + 16, 150, 140, 130);
    } 否则 {
        图形.绘制矩形(渲染器, 28, 顶, 28, 28, 224, 218, 208);
        图形.绘制矩形(渲染器, 31, 顶 + 3, 22, 22, 245, 240, 232);
        图形.绘制缩放文本(渲染器, 文本, 72, 顶 + 4, 2, 40, 35, 30);
    }
}

// 从本地缓存重绘（不发网络请求）
// 用 开始绘制/结束绘制 包住整帧：所有绘制只写离屏缓冲，最后一次性上屏，
// 这样点击触发整帧重画时不会看到“先清屏再逐个图元冒出来”的闪烁（双缓冲消闪）。
函数 重绘() {
    图形.开始绘制(渲染器);
    图形.清除画面(渲染器, 245, 240, 232);
    图形.绘制矩形(渲染器, 0, 0, 宽, 64, 214, 68, 47);
    图形.绘制缩放文本(渲染器, "待办 · 自动刷新", 24, 18, 3, 250, 250, 250);
    图形.绘制缩放文本(渲染器, "同步 " + 整数转字符串(刷新计数), 宽 - 150, 24, 2, 250, 235, 230);
    变量 下标: 整数 = 0;
    当 (下标 < 总数) {
        画待办行(下标, 列表库.获取整数(完成表, 下标), 列表库.获取字符串(标题表, 下标));
        下标 = 下标 + 1;
    }
    图形.绘制矩形(渲染器, 0, 高 - 36, 宽, 36, 236, 230, 220);
    图形.绘制缩放文本(渲染器, "每 2 秒自动与后端同步 · 点击切换完成", 24, 高 - 28, 2, 110, 100, 90);
    图形.结束绘制(渲染器);
}

// 从后端拉取并填充本地缓存
函数 加载() {
    变量 组: 整数 = JSON.解码(HTTP.获取(接口地址));
    总数 = JSON.数组长度(组);
    id表 = 列表库.创建整数列表();
    标题表 = 列表库.创建字符串列表();
    完成表 = 列表库.创建整数列表();
    变量 i: 整数 = 0;
    当 (i < 总数) {
        变量 记录: 整数 = JSON.数组获取对象(组, i);
        列表库.添加整数(id表, JSON.获取整数(记录, "id"));
        列表库.添加字符串(标题表, JSON.获取字符串(记录, "标题"));
        列表库.添加整数(完成表, JSON.获取整数(记录, "完成"));
        i = i + 1;
    }
}

函数 处理事件(窗口: 整数, 事件类型: 整数, 甲: 整数, 乙: 整数) {
    // 6 = 定时器：自动刷新——重新拉取并重绘
    如果 (事件类型 == 6) {
        刷新计数 = 刷新计数 + 1;
        加载();
        重绘();
    }
    如果 (事件类型 == 4) {
        上次Y = 乙;
    }
    如果 (事件类型 == 3) {
        如果 (乙 == 1) {
            如果 (上次Y >= 首行顶) {
                变量 行号: 整数 = (上次Y - 首行顶) / 行高;
                如果 (行号 >= 0) {
                    如果 (行号 < 总数) {
                        变量 编号: 整数 = 列表库.获取整数(id表, 行号);
                        // 切换完成并即时反馈
                        变量 新值: 整数 = 1 - 列表库.获取整数(完成表, 行号);
                        列表库.设置整数(完成表, 行号, 新值);
                        重绘();
                        HTTP.更新(接口地址 + "/" + 整数转字符串(编号), "done");
                    }
                }
            }
        }
    }
}

函数 入口() {
    变量 窗口: 整数 = 图形.创建窗口("奇语 Qi · 自动刷新待办", 宽, 高);
    图形.显示窗口(窗口);
    渲染器 = 图形.创建渲染器(窗口);
    加载();
    重绘();
    图形.设置事件处理(窗口, 处理事件);
    图形.设置定时器(刷新间隔毫秒);
    IO.打印行("就绪：每 2 秒自动与后端同步（点击可切换完成）");
    图形.运行();
}
