// 奇语 Qi · GUI 示例 —— 待办「自动刷新」客户端（egui + 帧循环轮询 + HTTP + 后端）
//
// 单轨 egui 架构：在「待办客户端」基础上加**自动刷新**。egui 帧循环天然按帧驱动，
// 每约 120 帧（60fps ≈ 2 秒）重新向 qi-todo-api（qi-web + SQLite）后端拉一次数据
// 并刷新本地缓存——这样别的客户端改了库，本窗口也会自动跟上，无需定时器 FFI。
//
// 先启动后端：  qi run qi-todo-api/主程序.qi
// 再运行本程序：qi run 自动刷新待办.qi
// 勾选某行即时切换完成状态；同时每 2 秒自动与后端同步一次。

包 主程序;

导入 标准库.图形化 作为 图形;
导入 标准库.HTTP 作为 HTTP;
导入 标准库.JSON 作为 JSON;
导入 标准库.列表 作为 列表库;
导入 标准库.输入输出 作为 IO;

常量 接口地址 = "http://127.0.0.1:43717/todos";
常量 刷新帧数 = 120;   // 60fps 下约 2 秒刷新一次

变量 id表: 整数 = 0;        // 整数列表
变量 标题表: 整数 = 0;      // 字符串列表
变量 完成表: 整数 = 0;      // 整数列表（0/1）
变量 总数: 整数 = 0;
变量 帧计: 整数 = 0;
变量 刷新计数: 整数 = 0;

// 从后端拉取并填充本地缓存（后端未起时安全返回空）
函数 加载() {
    变量 组: 整数 = JSON.解码(HTTP.获取(接口地址));
    总数 = JSON.数组长度(组);
    id表 = 列表库.创建整数列表();
    标题表 = 列表库.创建字符串列表();
    完成表 = 列表库.创建整数列表();
    变量 i: 整数 = 0;
    当 (i < 总数) {
        变量 记录: 整数 = JSON.数组获取对象(组, i);
        列表库.添加整数(id表, JSON.获取整数(记录, "id"));
        列表库.添加字符串(标题表, JSON.获取字符串(记录, "标题"));
        列表库.添加整数(完成表, JSON.获取整数(记录, "完成"));
        i = i + 1;
    }
}

函数 入口() {
    变量 应用: 整数 = 图形.应用创建("奇语 Qi · 自动刷新待办", 560, 560);
    如果 (应用 == 0) {
        IO.打印行("应用创建失败（GUI 库不可用？）");
        返回;
    }
    加载();
    IO.打印行("就绪：每约 2 秒自动与后端同步（勾选可切换完成）。关窗退出。");

    当 (图形.帧开始(应用) == 1) {
        图形.设置主题(0);

        // 帧循环轮询：每 刷新帧数 帧自动重拉一次
        帧计 = 帧计 + 1;
        如果 (帧计 >= 刷新帧数) {
            帧计 = 0;
            刷新计数 = 刷新计数 + 1;
            加载();
        }

        图形.标题文本("待办 · 自动刷新");
        变量 同步文本: 字符串 = "已同步 " + 整数转字符串(刷新计数) + " 次 · qi-web 后端";
        图形.彩色标签(同步文本, 214, 68, 47);
        图形.分隔线();

        如果 (总数 == 0) {
            图形.标签("（列表为空：请先启动 qi-todo-api 后端）");
        }

        图形.滚动开始("列表", 380);
        变量 下标: 整数 = 0;
        当 (下标 < 总数) {
            变量 当前: 整数 = 列表库.获取整数(完成表, 下标);
            变量 标题: 字符串 = 列表库.获取字符串(标题表, 下标);
            变量 行id: 字符串 = "row" + 整数转字符串(下标);
            变量 新值: 整数 = 图形.复选框(行id, 标题, 当前);
            如果 (新值 != 当前) {
                列表库.设置整数(完成表, 下标, 新值);   // 乐观更新
                变量 编号: 整数 = 列表库.获取整数(id表, 下标);
                HTTP.更新(接口地址 + "/" + 整数转字符串(编号), "done");
            }
            下标 = 下标 + 1;
        }
        图形.滚动结束();

        图形.帧结束(应用);
    }

    图形.关闭应用(应用);
    IO.打印行("窗口已关闭，干净退出。");
}
