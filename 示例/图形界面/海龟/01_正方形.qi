// 海龟绘图 · 第 1 课：正方形
//
// ── 为什么这几行会画出一个正方形 ────────────────────────────────────
//
// 想象海龟站在纸中间，头朝上，背上绑着一支笔。
// 你只能对它说两句话：「往前走」和「向右转」。
//
//     前进(120)   →  它往前走 120 步，笔在纸上拖出一条 120 长的直线
//     右转(90)    →  它站在原地转个身，正好转四分之一圈（一个直角）
//
// 把这两句连着说四遍：走一条边、拐个直角、走一条边、拐个直角……
// 四条一样长的边 + 四个直角 = 正方形。走完第四个直角，海龟正好回到出发的
// 地方、又朝回一开始的方向 —— 图就闭上了。
//
// 试试看：把 90 改成 60 会画出什么？（提示：只画了三条边就闭合了，
// 因为 60 度转六次才是一圈，但只走四次…… 自己试！）
//
// 运行：qi run 01_正方形.qi   （关掉窗口就退出）

包 主程序;

导入 标准库.图形化 作为 图形;
导入 标准库.输入输出 作为 IO;
导入 标准库.操作系统 作为 系统;
导入 海龟.海龟 作为 海龟;
导入 海龟.游戏帮手 作为 帮手;

常量 纸宽 = 640;
常量 纸高 = 480;

// 自动测试用：环境变量 QI_DEMO_FRAMES 设了多少帧，就画满多少帧自动关窗。
// 平时不设，窗口一直开着，直到你自己关掉。
函数 演示帧上限() : 整数 {
    变量 文本: 字符串 = 系统.获取环境变量("QI_DEMO_FRAMES");
    如果 (长度(文本) == 0) { 返回 0; }
    返回 字符串转整数(文本);
}

函数 入口() {
    变量 应用: 整数 = 图形.应用创建("海龟绘图 · 正方形", 纸宽, 纸高 + 60);
    如果 (应用 == 0) {
        IO.打印行("窗口打不开（图形库不可用？）");
        返回;
    }

    // ——— 画画：只画一次，海龟把笔迹记在本子上了 ———
    海龟.背景颜色("白");
    海龟.画笔颜色("蓝");
    海龟.画笔粗细(4);

    对于 边 在 0 直到 4 {
        海龟.前进(120);
        海龟.右转(90);
    }

    IO.打印行("画好了，一共 " + 整数转字符串(海龟.线段数()) + " 笔。");

    // ——— 显示：每一帧把笔迹重画一遍 ———
    变量 上限: 整数 = 演示帧上限();
    变量 帧数: 整数 = 0;

    当 (图形.帧开始(应用) == 1) {
        图形.标题文本("正方形：走一条边，转一个直角，重复四次");
        海龟.开始画布(纸宽, 纸高);
        // 让海龟说句话。要写在 开始画布 和 结束画布 中间，气泡才会在图案上面。
        帮手.说话气泡(海龟.坐标X(), 海龟.坐标Y(), "画好啦！");
        海龟.结束画布();
        图形.帧结束(应用);

        帧数 = 帧数 + 1;
        如果 (上限 > 0 且 帧数 >= 上限) { 跳出; }
    }

    图形.关闭应用(应用);
}
