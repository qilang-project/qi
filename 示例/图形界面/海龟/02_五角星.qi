// 海龟绘图 · 第 2 课：五角星
//
// ── 为什么右转 144 度会画出五角星 ───────────────────────────────────
//
// 上一课画正方形是「走一边、转 90 度」四次。90 × 4 = 360，正好转满一圈。
// 五角星也是同样的道理，只是海龟每次要**转过头**：
//
//     144 × 5 = 720 度 = 整整两圈
//
// 转两圈才回到出发方向，笔尖走过的路就在中间交叉了一遍 —— 交叉出来的就是
// 五角星那五个尖和中间那个五边形的洞。
//
// 记住这个规律：想画有 N 个尖的星星，每次转
//     360 × 2 ÷ N 度
// 试试 N = 7（转 720÷7 ≈ 103 度，走七次），会得到一颗七角星。
//
// 运行：qi run 02_五角星.qi   （关掉窗口就退出）

包 主程序;

导入 标准库.图形化 作为 图形;
导入 标准库.输入输出 作为 IO;
导入 标准库.操作系统 作为 系统;
导入 海龟.海龟 作为 海龟;

常量 纸宽 = 640;
常量 纸高 = 480;
常量 边长 = 220;

函数 演示帧上限() : 整数 {
    变量 文本: 字符串 = 系统.获取环境变量("QI_DEMO_FRAMES");
    如果 (长度(文本) == 0) { 返回 0; }
    返回 字符串转整数(文本);
}

函数 入口() {
    变量 应用: 整数 = 图形.应用创建("海龟绘图 · 五角星", 纸宽, 纸高 + 60);
    如果 (应用 == 0) {
        IO.打印行("窗口打不开（图形库不可用？）");
        返回;
    }

    海龟.背景颜色("深蓝");
    海龟.画笔颜色("金");
    海龟.画笔粗细(3);

    // 先抬笔挪到左下角再落笔：星星是从一个角开始画的，
    // 不挪一下的话整颗星会偏到纸的右上角去。
    海龟.抬笔();
    海龟.移到(0 - 边长 / 2, 0 - 60);
    海龟.落笔();

    对于 尖 在 0 直到 5 {
        海龟.前进(边长);
        海龟.右转(144);
    }

    IO.打印行("画好了，一共 " + 整数转字符串(海龟.线段数()) + " 笔。");

    变量 上限: 整数 = 演示帧上限();
    变量 帧数: 整数 = 0;

    当 (图形.帧开始(应用) == 1) {
        图形.标题文本("五角星：走一条边，转 144 度，重复五次（一共转了两圈）");
        海龟.开始画布(纸宽, 纸高);
        海龟.结束画布();
        图形.帧结束(应用);

        帧数 = 帧数 + 1;
        如果 (上限 > 0 且 帧数 >= 上限) { 跳出; }
    }

    图形.关闭应用(应用);
}
