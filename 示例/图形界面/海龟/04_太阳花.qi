// 海龟绘图 · 第 4 课：太阳花（循环套循环）
//
// ── 一个循环里再放一个循环 ──────────────────────────────────────────
//
// 第 1 课已经会画正方形了：走一边、转直角，做四次。
// 这一课要画 18 个正方形，每画完一个就把整个人转 20 度再画下一个。
//
// 于是就有了两层循环：
//
//     外层：做 18 次 { 画一个正方形; 右转 20 度 }
//                        └── 内层：做 4 次 { 前进; 右转 90 }
//
// 内层循环负责「画一个正方形」，外层循环负责「转着圈画很多个」。
// 18 × 20 = 360 度，外层正好把一整圈平均分成 18 份，所以花瓣是均匀铺开的。
//
// 这就是**嵌套循环**：把一件已经会做的事（画正方形）当成一个整体，
// 放进另一个循环里反复做。程序里的图案几乎都是这么搭出来的。
//
// 试试看：把 18 和 20 一起改（保持 18×20=360 这个关系），比如 24 个花瓣
//         配 15 度、12 个花瓣配 30 度。再把内层的正方形换成三角形
//         （走 3 次、每次转 120 度）看看变成什么花。
//
// 运行：qi run 04_太阳花.qi   （关掉窗口就退出）

包 主程序;

导入 标准库.图形化 作为 图形;
导入 标准库.输入输出 作为 IO;
导入 标准库.操作系统 作为 系统;
导入 海龟.海龟 作为 海龟;

常量 纸宽 = 640;
常量 纸高 = 560;
常量 花瓣数 = 18;
常量 花瓣间隔 = 20;      // 18 × 20 = 360，正好一圈
常量 花瓣边长 = 130;

函数 演示帧上限() : 整数 {
    变量 文本: 字符串 = 系统.获取环境变量("QI_DEMO_FRAMES");
    如果 (长度(文本) == 0) { 返回 0; }
    返回 字符串转整数(文本);
}

// 六个颜色轮着来，花瓣就有层次
函数 花瓣颜色(序号: 整数) : 字符串 {
    变量 余: 整数 = 序号 % 6;
    如果 (余 == 0) { 返回 "橙红"; }
    如果 (余 == 1) { 返回 "橙"; }
    如果 (余 == 2) { 返回 "金"; }
    如果 (余 == 3) { 返回 "黄"; }
    如果 (余 == 4) { 返回 "浅绿"; }
    返回 "绿";
}

函数 入口() {
    变量 应用: 整数 = 图形.应用创建("海龟绘图 · 太阳花", 纸宽, 纸高 + 60);
    如果 (应用 == 0) {
        IO.打印行("窗口打不开（图形库不可用？）");
        返回;
    }

    海龟.背景颜色("深绿");
    海龟.画笔粗细(2);

    // ——— 外层循环：转着圈画 18 个正方形 ———
    对于 花瓣 在 0 直到 花瓣数 {
        海龟.画笔颜色(花瓣颜色(花瓣));

        // ——— 内层循环：画一个正方形（跟第 1 课一模一样）———
        对于 边 在 0 直到 4 {
            海龟.前进(花瓣边长);
            海龟.右转(90);
        }

        // 画完一片花瓣，整个人转一点，再画下一片
        海龟.右转(花瓣间隔);
    }

    海龟.隐藏海龟();
    IO.打印行("画好了，一共 " + 整数转字符串(海龟.线段数()) + " 笔（18 片花瓣 × 4 条边）。");

    变量 上限: 整数 = 演示帧上限();
    变量 帧数: 整数 = 0;

    当 (图形.帧开始(应用) == 1) {
        图形.标题文本("太阳花：画一个正方形，转 20 度，再画一个 …… 转满一圈");
        海龟.开始画布(纸宽, 纸高);
        海龟.结束画布();
        图形.帧结束(应用);

        帧数 = 帧数 + 1;
        如果 (上限 > 0 且 帧数 >= 上限) { 跳出; }
    }

    图形.关闭应用(应用);
}
