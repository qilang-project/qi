// 海龟绘图 · 第 3 课：彩虹螺旋
//
// ── 为什么会转出螺旋 ────────────────────────────────────────────────
//
// 第 1 课画正方形是「走 120 步，右转 90 度」重复四次，走成一个闭合的方框。
// 这一课只改了两个地方，图案就完全不一样了：
//
//   1. **每次多走一点点**：第一次走 4 步，第二次 6 步，第三次 8 步……
//      边越来越长，海龟就再也回不到出发点，只能一圈比一圈往外绕。
//
//   2. **转的角度不是 90，而是 89**：差这 1 度，走四条边之后海龟不是正好
//      朝回原来的方向，而是偏了 4 度。每转一圈偏一点，方框就被慢慢拧成了
//      螺旋 —— 这 1 度的误差正是螺旋好看的原因。
//
// 颜色是按顺序循环换的：红橙黄绿青蓝紫，七个一轮，转着转着就成了彩虹。
//
// 试试看：把 89 改成 90 会怎样？（变成一个正正方方的同心方框，不再旋转）
//         改成 60 呢？改成 120 呢？每个数字都是一个新图案。
//
// 运行：qi run 03_彩虹螺旋.qi   （关掉窗口就退出）

包 主程序;

导入 标准库.图形化 作为 图形;
导入 标准库.输入输出 作为 IO;
导入 标准库.操作系统 作为 系统;
导入 海龟.海龟 作为 海龟;

常量 纸宽 = 700;
常量 纸高 = 560;
常量 圈数 = 110;      // 一共走多少段
常量 转角 = 89;       // 每段之后转多少度（89 而不是 90，就是它把方框拧成螺旋）

函数 演示帧上限() : 整数 {
    变量 文本: 字符串 = 系统.获取环境变量("QI_DEMO_FRAMES");
    如果 (长度(文本) == 0) { 返回 0; }
    返回 字符串转整数(文本);
}

// 彩虹七色轮流来。序号除以 7 取余数，余数是几就用第几个颜色，
// 数到 7 又从头开始 —— 这就是「循环」的最简单写法。
函数 彩虹色(序号: 整数) : 字符串 {
    变量 余: 整数 = 序号 % 7;
    如果 (余 == 0) { 返回 "红"; }
    如果 (余 == 1) { 返回 "橙"; }
    如果 (余 == 2) { 返回 "黄"; }
    如果 (余 == 3) { 返回 "绿"; }
    如果 (余 == 4) { 返回 "青"; }
    如果 (余 == 5) { 返回 "蓝"; }
    返回 "紫";
}

函数 入口() {
    变量 应用: 整数 = 图形.应用创建("海龟绘图 · 彩虹螺旋", 纸宽, 纸高 + 60);
    如果 (应用 == 0) {
        IO.打印行("窗口打不开（图形库不可用？）");
        返回;
    }

    海龟.背景颜色("黑");
    海龟.画笔粗细(3);

    变量 步长: 整数 = 4;
    对于 段 在 0 直到 圈数 {
        海龟.画笔颜色(彩虹色(段));
        海龟.前进(步长);
        海龟.右转(转角);
        步长 = 步长 + 2;      // 下一段比这一段多走 2 步 —— 螺旋就是这么撑开的
    }

    // 画完了，把海龟藏起来，看干净的作品
    海龟.隐藏海龟();

    IO.打印行("画好了，一共 " + 整数转字符串(海龟.线段数()) + " 笔。");

    变量 上限: 整数 = 演示帧上限();
    变量 帧数: 整数 = 0;

    当 (图形.帧开始(应用) == 1) {
        图形.标题文本("彩虹螺旋：每段比上段长 2 步，每次转 89 度");
        海龟.开始画布(纸宽, 纸高);
        海龟.结束画布();
        图形.帧结束(应用);

        帧数 = 帧数 + 1;
        如果 (上限 > 0 且 帧数 >= 上限) { 跳出; }
    }

    图形.关闭应用(应用);
}
