// 奇语 Qi · GUI 示例 —— 渲染帧循环（60Hz 动画）
//
// 这是「渲染刷新」：设置帧率后，事件循环每帧（如 60Hz）向回调投递一个
// 渲染帧事件（事件类型=7，参数1=自启动以来毫秒，参数2=帧间隔毫秒）。
// 回调据此做**逐帧动画**——本例画一个左右弹跳的小球 + 一条进度条，
// 全部由时间驱动，所以无论机器快慢，运动速度一致。
//
//   设置帧率(FPS)：需在 运行 之前调用，0=关闭。常用 60 或 120。
//   与 设置定时器（数据同步，事件类型=6）相互独立，可同时开。
//
// 运行：qi run 动画演示.qi

包 主程序;

导入 标准库.图形化 作为 图形;
导入 标准库.输入输出 作为 IO;

常量 宽 = 640;
常量 高 = 360;
常量 半径 = 28;
常量 速度 = 260;   // 像素/秒，时间驱动

变量 渲染器: 整数 = 0;
变量 帧数: 整数 = 0;

函数 画一帧(毫秒: 整数) {
    图形.开始绘制(渲染器);   // 双缓冲：整帧画完再一次性上屏，60Hz 下无闪烁
    图形.清除画面(渲染器, 18, 20, 28);

    // 顶栏
    图形.绘制矩形(渲染器, 0, 0, 宽, 56, 36, 42, 58);
    图形.绘制缩放文本(渲染器, "渲染帧循环 · 60Hz", 20, 14, 3, 235, 238, 245);

    // 小球水平往返：用三角波由时间算出位置（时间驱动，速度恒定）
    变量 行程: 整数 = 宽 - 2 * 半径 - 32;   // 可移动范围
    变量 周期: 整数 = 行程 * 2;             // 一来一回
    变量 走过: 整数 = (毫秒 * 速度) / 1000;  // 已走的总像素
    变量 相: 整数 = 走过 - (走过 / 周期) * 周期;  // 取模到 [0,周期)
    变量 偏移: 整数 = 相;
    如果 (相 > 行程) {
        偏移 = 周期 - 相;                   // 回程
    }
    变量 球心X: 整数 = 16 + 半径 + 偏移;
    变量 球心Y: 整数 = 高 / 2 + 20;
    图形.绘制圆形(渲染器, 球心X, 球心Y, 半径, 255, 184, 76);
    图形.绘制圆形(渲染器, 球心X - 8, 球心Y - 8, 8, 255, 220, 150);

    // 底部进度条：随时间循环填充
    变量 条宽: 整数 = 宽 - 40;
    变量 进度: 整数 = (毫秒 / 12) - ((毫秒 / 12) / 条宽) * 条宽;
    图形.绘制矩形(渲染器, 20, 高 - 40, 条宽, 14, 44, 50, 66);
    图形.绘制矩形(渲染器, 20, 高 - 40, 进度, 14, 96, 200, 168);

    图形.绘制缩放文本(渲染器, "帧 " + 整数转字符串(帧数), 20, 高 - 76, 2, 150, 160, 180);
    图形.结束绘制(渲染器);
}

函数 处理事件(窗口: 整数, 事件类型: 整数, 甲: 整数, 乙: 整数) {
    // 7 = 渲染帧：甲=自启动以来毫秒，乙=帧间隔毫秒
    如果 (事件类型 == 7) {
        帧数 = 帧数 + 1;
        画一帧(甲);
    }
}

函数 入口() {
    变量 窗口: 整数 = 图形.创建窗口("奇语 Qi · 动画演示", 宽, 高);
    图形.显示窗口(窗口);
    渲染器 = 图形.创建渲染器(窗口);
    画一帧(0);
    图形.设置事件处理(窗口, 处理事件);
    图形.设置帧率(60);   // 60 FPS 渲染刷新
    IO.打印行("就绪：60Hz 渲染帧循环，小球时间驱动弹跳");
    图形.运行();
}
