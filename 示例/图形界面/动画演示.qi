// 奇语 Qi · GUI 示例 —— egui 画布逐帧动画（60Hz）
//
// 单轨 egui 架构：qilang 持有主循环，egui 每帧驱动。画布层（画布开始/结束 + 图元）
// 承接了老 tao 渲染器的能力，但**帧循环本身天然驱动动画**——每帧重画即可，
// 无需定时器/设置帧率。本例画一个左右弹跳的小球 + 一条循环进度条，全部由帧数
// （≈时间）驱动，运动平滑。
//
// 主循环：应用创建 → 当(帧开始){ 画布开始…图元…画布结束; 帧结束 } → 关闭应用
//
// 运行：qi run 动画演示.qi（关窗退出）

包 主程序;

导入 标准库.图形化 作为 图形;
导入 标准库.输入输出 作为 IO;

常量 宽 = 640;
常量 高 = 360;
常量 半径 = 28;
常量 速度 = 260;   // 像素/秒，时间驱动

变量 帧数: 整数 = 0;

函数 入口() {
    变量 应用: 整数 = 图形.应用创建("奇语 Qi · 动画演示", 宽, 高);
    如果 (应用 == 0) {
        IO.打印行("应用创建失败（GUI 库不可用？）");
        返回;
    }
    IO.打印行("就绪：egui 画布逐帧动画，小球时间驱动弹跳。关窗退出。");

    当 (图形.帧开始(应用) == 1) {
        图形.设置主题(1);
        帧数 = 帧数 + 1;
        变量 毫秒: 整数 = 帧数 * 16;   // 60fps 下每帧约 16ms，作时间源

        图形.画布开始("场景", 宽, 高);

        // 背景 + 顶栏
        图形.画布矩形(0, 0, 宽, 高, 18, 20, 28);
        图形.画布矩形(0, 0, 宽, 56, 36, 42, 58);
        图形.画布文本(20, 16, "egui 画布 · 逐帧动画", 20, 235, 238, 245);

        // 小球水平往返：三角波由时间算位置（速度恒定）
        变量 行程: 整数 = 宽 - 2 * 半径 - 32;
        变量 周期: 整数 = 行程 * 2;
        变量 走过: 整数 = (毫秒 * 速度) / 1000;
        变量 相: 整数 = 走过 - (走过 / 周期) * 周期;
        变量 偏移: 整数 = 相;
        如果 (相 > 行程) {
            偏移 = 周期 - 相;
        }
        变量 球心X: 整数 = 16 + 半径 + 偏移;
        变量 球心Y: 整数 = 高 / 2 + 20;
        图形.画布圆(球心X, 球心Y, 半径, 255, 184, 76);
        图形.画布圆(球心X - 8, 球心Y - 8, 8, 255, 220, 150);

        // 底部进度条：随时间循环填充
        变量 条宽: 整数 = 宽 - 40;
        变量 进度: 整数 = (毫秒 / 12) - ((毫秒 / 12) / 条宽) * 条宽;
        图形.画布矩形(20, 高 - 40, 条宽, 14, 44, 50, 66);
        图形.画布矩形(20, 高 - 40, 进度, 14, 96, 200, 168);

        变量 帧文本: 字符串 = "帧 " + 整数转字符串(帧数);
        图形.画布文本(20, 高 - 78, 帧文本, 16, 150, 160, 180);

        图形.画布结束();
        图形.帧结束(应用);
    }

    图形.关闭应用(应用);
    IO.打印行("窗口已关闭，干净退出。");
}
