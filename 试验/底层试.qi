导入 标准库.HTTP;
函数 入口() {
    变量 流: 整数 = HTTP::打开流("GET", "http://127.0.0.1:54431/", "", "", 5000, 0);
    打印行("句柄 " + 整数转字符串(流));
    打印行("状态码 " + 整数转字符串(HTTP::流状态码(流)));
    打印行("头 " + HTTP::流响应头(流));
    变量 i: 整数 = 0;
    当 (i < 40) {
        变量 块: 字符串 = HTTP::读取流(流, 2000);
        变量 态: 整数 = HTTP::流状态(流);
        打印行("[" + 整数转字符串(态) + "] 长度=" + 整数转字符串(字符串::字节长度(块)) + " <<" + 块 + ">>");
        如果 (态 == 2 || 态 == 3) { 跳出; }
        i = i + 1;
    }
    HTTP::关闭流(流);
}
