导入 标准库.JSON;
函数 入口() {
    打印行("查找('', '\\n\\n') = " + 整数转字符串(字符串::查找("", "\n\n")));
    打印行("查找('abc', '\\n\\n') = " + 整数转字符串(字符串::查找("abc", "\n\n")));
    打印行("查找('a\\n\\nb', '\\n\\n') = " + 整数转字符串(字符串::查找("a\n\nb", "\n\n")));
    变量 o: 整数 = JSON::创建对象();
    JSON::设置字符串(o, "k", "");
    打印行("空串取回长度 = " + 整数转字符串(字符串::字节长度(JSON::获取字符串(o, "k"))));
    JSON::设置字符串(o, "k", "data: x\n\n");
    打印行("取回 = <<" + JSON::获取字符串(o, "k") + ">>");
    打印行("其中查找 = " + 整数转字符串(字符串::查找(JSON::获取字符串(o, "k"), "\n\n")));
}
