// 标准库.事件流 —— SSE（Server-Sent Events）分帧，用 qi 写。
//
// 这个模块存在的意义就是证明「传输留 Rust、分帧交 qi」这条线能走通：
// 底下只用 标准库.HTTP 的 打开流/读取流/流状态 六个原语，SSE 协议本身
// （按空行切事件、按行拆 field: value、多个 data 行拼接、注释行忽略）
// 一行 Rust 都没有。
//
// 参照 WHATWG 的 EventSource 规范，只做**分帧**，不做自动重连和
// Last-Event-ID 续传 —— 那两件涉及策略（退避多久、重试几次），
// 该由调用方决定，塞进这里就成了不可换的默认行为。
//
// ## 用法
//
//     变量 流 = 事件流::打开("POST", 地址, 头JSON, 请求体);
//     当 (真) {
//         变量 条 = 事件流::下一条(流, 30000);
//         如果 (事件流::已结束(流)) { 跳出; }
//         如果 (事件流::是超时(流)) { 继续; }
//         打印行(事件流::数据(流));
//     }
//     事件流::关闭(流);
//
// ## 为什么状态不放在返回值里
//
// 一条 SSE 事件有 data / event / id 三个字段，还要区分「超时」「结束」。
// qi 没有多返回值，也没有能跨 FFI 传的结构体数组，所以走「取一条 → 分别问」
// 的路子，跟底下 HTTP 流状态 的形状一致。

包 事件流;

导入 标准库.HTTP;
// 「列表」是保留字（跟 数组 一样是类型关键字），只能带别名导入。
导入 标准库.列表 作为 串表;

// HTTP 流状态，跟 http_stream_ffi.rs 的常量对齐。
// qi 顶层只能放 变量，不能放 常量（语法层就不认），所以对外的那几个用函数 ——
// 函数外面改不了，而顶层 变量 谁都能赋值。
变量 底层_有数据: 整数 = 0;
变量 底层_超时: 整数 = 1;
变量 底层_结束: 整数 = 2;
变量 底层_出错: 整数 = 3;

// 本模块对外的状态码。名字都带 状态_ 前缀不只是为了整齐 ——
// 「超时」本身是保留字（通道 select 的 `情况 超时(毫秒)`），裸用编不过。
公开 函数 状态_有事件() : 整数 { 返回 0; }
公开 函数 状态_超时() : 整数 { 返回 1; }
公开 函数 状态_已完() : 整数 { 返回 2; }
公开 函数 状态_出错() : 整数 { 返回 3; }

// 同时只支持一条流的话就没法在一个 agent 里并行开两条，所以按句柄存。
// qi 侧没有泛型容器，用几张按句柄索引的 JSON 对象当表。
变量 缓冲表: 整数 = 0;
变量 字段表: 整数 = 0;
变量 状态表: 整数 = 0;

函数 确保表() {
    如果 (缓冲表 == 0) {
        缓冲表 = JSON::创建对象();
        字段表 = JSON::创建对象();
        状态表 = JSON::创建对象();
    }
}

函数 键(流: 整数) : 字符串 {
    返回 整数转字符串(流);
}

/// 打开一条 SSE 流。头里会自动补 Accept: text/event-stream。
/// 返回底层 HTTP 流句柄；负数表示失败（含义同 HTTP::打开流）。
公开 函数 打开(方法: 字符串, 地址: 字符串, 头JSON: 字符串, 请求体: 字符串) : 整数 {
    确保表();
    变量 头: 整数 = 0;
    如果 (字符串::字节长度(字符串::去空白(头JSON)) == 0) {
        头 = JSON::创建对象();
    } 否则 {
        头 = JSON::解码(头JSON);
    }
    // SSE 必须显式要，不然不少网关会按普通请求给你缓冲整个响应，
    // 于是「流式」在客户端这边看起来完全正常、就是一个字都不来。
    如果 (JSON::是否包含键(头, "Accept") == 0) {
        JSON::设置字符串(头, "Accept", "text/event-stream");
    }
    变量 流: 整数 = HTTP::打开流(方法, 地址, JSON::转字符串(头), 请求体, 10000, 0);
    JSON::删除(头);
    如果 (流 <= 0) { 返回 流; }
    JSON::设置字符串(缓冲表, 键(流), "");
    JSON::设置对象(字段表, 键(流), JSON::创建对象());
    JSON::设置整数(状态表, 键(流), 状态_有事件());
    返回 流;
}

/// 从缓冲里切出第一条**可派发**的事件（以空行结尾）。切到了返回 1 并填好字段表。
///
/// 「可派发」照 WHATWG 规范：没有 data 字段的块不产生事件。心跳就是这种 ——
/// 服务端每隔几十秒发一行 `: keep-alive` 保活，那是给中间的代理看的，不是事件。
/// 不滤掉的话调用方每收一次心跳就拿到一条 data 为空的事件，得自己判空跳过；
/// 而「空 data」在有些协议里是有意义的，调用方分不清哪个空是心跳哪个是真事件。
///
/// 内部循环而不是返回 0：一个网络块可能同时带来心跳和真事件，直接返回 0
/// 会让调用方跑去等下一次网络活动，明明缓冲里已经躺着能用的事件了。
函数 切一条(流: 整数) : 整数 {
    当 (真) {
        变量 切果: 整数 = 切一块(流);
        // 0 = 缓冲里没有完整块了；1 = 切出可派发事件；2 = 切掉一个不派发的块，继续看
        如果 (切果 != 2) { 返回 切果; }
    }
    返回 0;
}

/// 切一个块。返回 0 没有完整块 / 1 切出可派发事件 / 2 块被切掉但不派发。
函数 切一块(流: 整数) : 整数 {
    变量 缓冲: 字符串 = JSON::获取字符串(缓冲表, 键(流));
    // 事件以空行分隔。\r\n\r\n 和 \n\n 都要认 —— 规范允许两种，
    // 真实服务端两种都见过，只认一种会在另一种下**永远切不出事件**，
    // 表现是流明明有数据但一条都读不出来。
    变量 位: 整数 = 字符串::查找(缓冲, "\n\n");
    变量 分隔长: 整数 = 2;
    变量 位R: 整数 = 字符串::查找(缓冲, "\r\n\r\n");
    如果 (位R >= 0 && (位 < 0 || 位R < 位)) {
        位 = 位R;
        分隔长 = 4;
    }
    如果 (位 < 0) { 返回 0; }

    变量 一条: 字符串 = 字符串::子串(缓冲, 0, 位);
    变量 剩下: 字符串 = 字符串::子串从位置(缓冲, 位 + 分隔长);
    JSON::设置字符串(缓冲表, 键(流), 剩下);

    变量 字段: 整数 = JSON::创建对象();
    JSON::设置字符串(字段, "data", "");
    JSON::设置字符串(字段, "event", "");
    JSON::设置字符串(字段, "id", "");

    // 分割 返回的是**列表**句柄（qi_list_string_create），不是 JSON 数组。
    // 这两套句柄各有各的池，拿 JSON::数组长度 去量一个列表句柄不会报错 ——
    // 查不到就返回 0，于是「每条事件都解析出空字段」，看起来像协议没对上。
    // 跟 数组长度(原生数组) 掉进 JSON 池是同一个坑。
    变量 行列表: 整数 = 字符串::分割(一条, "\n");
    变量 数据: 字符串 = "";
    变量 有数据行: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < 串表::字符串列表大小(行列表)) {
        变量 行: 字符串 = 串表::获取字符串(行列表, i);
        i = i + 1;
        // \r\n 分行时每行尾巴上还挂着 \r，不去掉的话 "data: [DONE]\r"
        // 跟 "data: [DONE]" 比不相等 —— 判终止的地方就会漏。
        如果 (字符串::结束于(行, "\r") == 1) {
            行 = 字符串::子串(行, 0, 字符串::字节长度(行) - 1);
        }
        如果 (字符串::字节长度(行) == 0) { 继续; }
        // 冒号开头是注释（心跳常用 ": keep-alive"），整行忽略
        如果 (字符串::开始于(行, ":") == 1) { 继续; }

        变量 冒号: 整数 = 字符串::查找(行, ":");
        变量 名: 字符串 = 行;
        变量 值: 字符串 = "";
        如果 (冒号 >= 0) {
            名 = 字符串::子串(行, 0, 冒号);
            值 = 字符串::子串从位置(行, 冒号 + 1);
            // 规范：冒号后**恰好一个**空格要去掉，多的属于值
            如果 (字符串::开始于(值, " ") == 1) {
                值 = 字符串::子串从位置(值, 1);
            }
        }

        如果 (字符串::等于(名, "data") == 1) {
            // 多个 data 行按换行拼接（规范如此），不是后盖前
            如果 (有数据行 == 1) { 数据 = 数据 + "\n"; }
            数据 = 数据 + 值;
            有数据行 = 1;
        }
        如果 (字符串::等于(名, "event") == 1) { JSON::设置字符串(字段, "event", 值); }
        如果 (字符串::等于(名, "id") == 1) { JSON::设置字符串(字段, "id", 值); }
    }
    串表::删除列表(行列表);
    如果 (有数据行 == 0) {
        // 纯注释块（心跳）或只有 event/id 没有 data —— 按规范不派发
        JSON::删除(字段);
        返回 2;
    }
    JSON::设置字符串(字段, "data", 数据);
    JSON::设置对象(字段表, 键(流), 字段);
    返回 1;
}

/// 取下一条事件，最多等 超时毫秒。取到返回 1；否则 0，用 状态() 区分原因。
公开 函数 下一条(流: 整数, 超时毫秒: 整数) : 整数 {
    如果 (流 <= 0) {
        返回 0;
    }
    // 缓冲里可能已经躺着完整事件（上一次网络块带来了两条），先切干净再读网络。
    // 不先切的话，服务端一次推两条、之后就沉默，第二条要等到下一次网络活动
    // 才吐出来 —— 看起来就是「最后一条事件莫名延迟」。
    如果 (切一条(流) == 1) {
        JSON::设置整数(状态表, 键(流), 状态_有事件());
        返回 1;
    }

    当 (真) {
        变量 块: 字符串 = HTTP::读取流(流, 超时毫秒);
        变量 底: 整数 = HTTP::流状态(流);

        如果 (字符串::字节长度(块) > 0) {
            JSON::设置字符串(缓冲表, 键(流), JSON::获取字符串(缓冲表, 键(流)) + 块);
            如果 (切一条(流) == 1) {
                JSON::设置整数(状态表, 键(流), 状态_有事件());
                返回 1;
            }
        }

        如果 (底 == 底层_超时) {
            JSON::设置整数(状态表, 键(流), 状态_超时());
            返回 0;
        }
        如果 (底 == 底层_出错) {
            JSON::设置整数(状态表, 键(流), 状态_出错());
            返回 0;
        }
        如果 (底 == 底层_结束) {
            // 流结束时缓冲里可能还剩最后一条没有尾随空行的事件 —— 规范允许
            // 流末尾省略空行。不补这一下就会**静默丢掉最后一条**。
            变量 尾: 字符串 = 字符串::去空白(JSON::获取字符串(缓冲表, 键(流)));
            如果 (字符串::字节长度(尾) > 0) {
                JSON::设置字符串(缓冲表, 键(流), 尾 + "\n\n");
                如果 (切一条(流) == 1) {
                    JSON::设置整数(状态表, 键(流), 状态_有事件());
                    返回 1;
                }
            }
            JSON::设置整数(状态表, 键(流), 状态_已完());
            返回 0;
        }
        // 底层还有数据但还没凑成一条完整事件 —— 继续读
    }
    返回 0;
}

公开 函数 状态(流: 整数) : 整数 { 返回 JSON::获取整数(状态表, 键(流)); }
公开 函数 是超时(流: 整数) : 整数 { 如果 (状态(流) == 状态_超时()) { 返回 1; } 返回 0; }
公开 函数 已结束(流: 整数) : 整数 { 如果 (状态(流) == 状态_已完()) { 返回 1; } 返回 0; }
公开 函数 是出错(流: 整数) : 整数 { 如果 (状态(流) == 状态_出错()) { 返回 1; } 返回 0; }

公开 函数 数据(流: 整数) : 字符串 {
    返回 JSON::获取字符串(JSON::获取对象(字段表, 键(流)), "data");
}
公开 函数 事件名(流: 整数) : 字符串 {
    返回 JSON::获取字符串(JSON::获取对象(字段表, 键(流)), "event");
}
公开 函数 事件id(流: 整数) : 字符串 {
    返回 JSON::获取字符串(JSON::获取对象(字段表, 键(流)), "id");
}

公开 函数 错误(流: 整数) : 字符串 { 返回 HTTP::流错误(流); }

公开 函数 关闭(流: 整数) : 整数 { 返回 HTTP::关闭流(流); }
