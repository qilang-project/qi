导入 ./事件流;
函数 入口() {
    变量 流: 整数 = 事件流.打开("GET", "http://127.0.0.1:54655/", "", "");
    打印行("句柄 " + 整数转字符串(流));
    变量 n: 整数 = 0;
    当 (n < 20) {
        变量 有: 整数 = 事件流.下一条(流, 2000);
        打印行("下一条=" + 整数转字符串(有) + " 状态=" + 整数转字符串(事件流.状态(流)));
        如果 (有 == 1) {
            n = n + 1;
            打印行("  name=[" + 事件流.事件名(流) + "] id=[" + 事件流.事件id(流) + "] data=[" + 事件流.数据(流) + "]");
            继续;
        }
        如果 (事件流.已结束(流) == 1) { 打印行("结束"); 跳出; }
        如果 (事件流.是出错(流) == 1) { 打印行("出错 " + 事件流.错误(流)); 跳出; }
    }
    事件流.关闭(流);
}
