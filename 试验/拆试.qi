导入 标准库.JSON;
函数 入口() {
    变量 行数组: 整数 = 字符串::分割("data: hello", "\n");
    打印行("段数 = " + 整数转字符串(JSON::数组长度(行数组)));
    打印行("第0段 = <<" + JSON::数组获取字符串(行数组, 0) + ">>");

    变量 父: 整数 = JSON::创建对象();
    变量 子: 整数 = JSON::创建对象();
    JSON::设置字符串(子, "data", "hello");
    JSON::设置对象(父, "k", 子);
    变量 取回: 整数 = JSON::获取对象(父, "k");
    打印行("取回句柄 = " + 整数转字符串(取回));
    打印行("取回 data = <<" + JSON::获取字符串(取回, "data") + ">>");
    打印行("父整体 = " + JSON::转字符串(父));
}
