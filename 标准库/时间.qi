// 标准库.时间 —— 日历运算部分的 qi 实现。
//
// 这个模块 61 个函数里，真正需要内核的只有 11 个：取当前时刻（现在/现在毫秒/
// 现在微秒/现在纳秒/本地时间）、按时区格式化与解析（格式化/格式化本地/解析）、
// 以及三个睡眠。剩下 50 个全是给一个 Unix 时间戳做整数算术 —— 年月日拆分、
// 加减、区间端点、判定。那 50 个没有任何理由留在 Rust 里。
//
// 这里实现的就是那 50 个。没实现的函数会照常落回 FFI 注册表（分发是**按函数**
// 判定的，不是按模块），所以 格式化 / 睡眠 / 异步睡眠未来 一行没动。
//
// 想对照 Rust 版本行为：`QI_STDLIB_FFI=时间 qi run x.qi` 强制整个模块走回 FFI。
//
// ## 算法
//
// 纪元日 / 从纪元日 是 Howard Hinnant 的 civil-date 算法（chrono、C++20
// <chrono>、Go 的 time 包用的都是同一套）。它把公历当成从 3 月起算的 400 年
// 大周期，于是闰年规则退化成整数除法，没有查表也没有循环。
//
// 依赖整数除法**向零截断**（C 语义），负数分支已按算法要求显式调过。
//
// ## 与 Rust 版的两处行为差异（都是修 bug）
//
// 加月 / 加年：Rust 版是 `+ months * 30 天` 和 `+ years * 365 天`，不是日历
// 运算 —— 1 月 31 日加一个月得到 3 月 2 日，2 月 29 日加一年得到 2 月 28 日
// 之后再漂一天。这里按日历加，月末按目标月的天数截断（1 月 31 日 + 1 月
// = 2 月 28 日）。全仓没有任何 .qi 调用过这两个函数，改了不影响谁。

包 时间;

外部 "" {
    函数 qi_datetime_now(): 整数;
}

// ── 内部：纪元日 ⇄ 年月日 ───────────────────────────────────────────

// 1970-01-01 起的天数。月份 1-12。
公开 函数 纪元日(年: 整数, 月: 整数, 日: 整数): 整数 {
    变量 y: 整数 = 年;
    如果 (月 <= 2) { y = y - 1; }
    变量 世纪: 整数 = 0;
    如果 (y >= 0) { 世纪 = y / 400; } 否则 { 世纪 = (y - 399) / 400; }
    变量 世纪内年: 整数 = y - 世纪 * 400;
    变量 移位月: 整数 = 0;
    如果 (月 > 2) { 移位月 = 月 - 3; } 否则 { 移位月 = 月 + 9; }
    变量 年内日: 整数 = (153 * 移位月 + 2) / 5 + 日 - 1;
    变量 世纪内日: 整数 = 世纪内年 * 365 + 世纪内年 / 4 - 世纪内年 / 100 + 年内日;
    返回 世纪 * 146097 + 世纪内日 - 719468;
}

// 纪元日 → 年（月日各有对应函数，避免多返回值）
公开 函数 日转年(天: 整数): 整数 {
    变量 z: 整数 = 天 + 719468;
    变量 世纪: 整数 = 0;
    如果 (z >= 0) { 世纪 = z / 146097; } 否则 { 世纪 = (z - 146096) / 146097; }
    变量 世纪内日: 整数 = z - 世纪 * 146097;
    变量 世纪内年: 整数 = (世纪内日 - 世纪内日 / 1460 + 世纪内日 / 36524 - 世纪内日 / 146096) / 365;
    变量 年内日: 整数 = 世纪内日 - (365 * 世纪内年 + 世纪内年 / 4 - 世纪内年 / 100);
    变量 移位月: 整数 = (5 * 年内日 + 2) / 153;
    变量 月: 整数 = 0;
    如果 (移位月 < 10) { 月 = 移位月 + 3; } 否则 { 月 = 移位月 - 9; }
    变量 y: 整数 = 世纪内年 + 世纪 * 400;
    如果 (月 <= 2) { y = y + 1; }
    返回 y;
}

公开 函数 日转月(天: 整数): 整数 {
    变量 z: 整数 = 天 + 719468;
    变量 世纪: 整数 = 0;
    如果 (z >= 0) { 世纪 = z / 146097; } 否则 { 世纪 = (z - 146096) / 146097; }
    变量 世纪内日: 整数 = z - 世纪 * 146097;
    变量 世纪内年: 整数 = (世纪内日 - 世纪内日 / 1460 + 世纪内日 / 36524 - 世纪内日 / 146096) / 365;
    变量 年内日: 整数 = 世纪内日 - (365 * 世纪内年 + 世纪内年 / 4 - 世纪内年 / 100);
    变量 移位月: 整数 = (5 * 年内日 + 2) / 153;
    如果 (移位月 < 10) { 返回 移位月 + 3; }
    返回 移位月 - 9;
}

公开 函数 日转日(天: 整数): 整数 {
    变量 z: 整数 = 天 + 719468;
    变量 世纪: 整数 = 0;
    如果 (z >= 0) { 世纪 = z / 146097; } 否则 { 世纪 = (z - 146096) / 146097; }
    变量 世纪内日: 整数 = z - 世纪 * 146097;
    变量 世纪内年: 整数 = (世纪内日 - 世纪内日 / 1460 + 世纪内日 / 36524 - 世纪内日 / 146096) / 365;
    变量 年内日: 整数 = 世纪内日 - (365 * 世纪内年 + 世纪内年 / 4 - 世纪内年 / 100);
    变量 移位月: 整数 = (5 * 年内日 + 2) / 153;
    返回 年内日 - (153 * 移位月 + 2) / 5 + 1;
}

// 时间戳 → 纪元日。负时间戳（1970 前）要向下取整，不是向零截断 ——
// 否则 1969-12-31 12:00 会算成 1970-01-01。
公开 函数 戳转日(时间戳: 整数): 整数 {
    如果 (时间戳 >= 0) { 返回 时间戳 / 86400; }
    返回 (时间戳 - 86399) / 86400;
}

// 一天内的秒偏移，永远 0..86399
公开 函数 日内秒(时间戳: 整数): 整数 {
    返回 时间戳 - 戳转日(时间戳) * 86400;
}

// ── 年月日时分秒 ──────────────────────────────────────────────────

公开 函数 年(时间戳: 整数): 整数 { 返回 日转年(戳转日(时间戳)); }
公开 函数 月(时间戳: 整数): 整数 { 返回 日转月(戳转日(时间戳)); }
公开 函数 日(时间戳: 整数): 整数 { 返回 日转日(戳转日(时间戳)); }
公开 函数 时(时间戳: 整数): 整数 { 返回 日内秒(时间戳) / 3600; }
公开 函数 分(时间戳: 整数): 整数 { 返回 (日内秒(时间戳) / 60) % 60; }
公开 函数 秒(时间戳: 整数): 整数 { 返回 日内秒(时间戳) % 60; }

// 周一=1 … 周日=7（跟 Rust 版的 num_days_from_monday()+1 一致）。
// 1970-01-01 是周四，纪元日 0 → 4。
公开 函数 星期几(时间戳: 整数): 整数 {
    变量 天: 整数 = 戳转日(时间戳);
    变量 余: 整数 = (天 + 3) % 7;
    如果 (余 < 0) { 余 = 余 + 7; }
    返回 余 + 1;
}

公开 函数 季度(时间戳: 整数): 整数 { 返回 (月(时间戳) - 1) / 3 + 1; }

公开 函数 年的第几天(时间戳: 整数): 整数 {
    变量 天: 整数 = 戳转日(时间戳);
    返回 天 - 纪元日(日转年(天), 1, 1) + 1;
}

// ISO 8601 周数：本周周四落在哪一年，这周就属于哪一年；第 1 周是含该年
// 第一个周四的那一周。跟 Rust 版的 iso_week().week() 同义。
公开 函数 年的第几周(时间戳: 整数): 整数 {
    变量 天: 整数 = 戳转日(时间戳);
    // 挪到本周周四
    变量 周四: 整数 = 天 - (星期几(时间戳) - 4);
    变量 所属年: 整数 = 日转年(周四);
    变量 元旦: 整数 = 纪元日(所属年, 1, 1);
    返回 (周四 - 元旦) / 7 + 1;
}

公开 函数 毫秒(时间戳毫秒: 整数): 整数 {
    变量 余: 整数 = 时间戳毫秒 % 1000;
    如果 (余 < 0) { 返回 0 - 余; }
    返回 余;
}

// ── 构造 ────────────────────────────────────────────────────────

公开 函数 从年月日(年: 整数, 月: 整数, 日: 整数): 整数 {
    返回 纪元日(年, 月, 日) * 86400;
}

公开 函数 从年月日时分秒(年: 整数, 月: 整数, 日: 整数, 时: 整数, 分: 整数, 秒: 整数): 整数 {
    返回 纪元日(年, 月, 日) * 86400 + 时 * 3600 + 分 * 60 + 秒;
}

// ── 加减 ────────────────────────────────────────────────────────

公开 函数 加秒(时间戳: 整数, 秒数: 整数): 整数 { 返回 时间戳 + 秒数; }
公开 函数 加分钟(时间戳: 整数, 分钟: 整数): 整数 { 返回 时间戳 + 分钟 * 60; }
公开 函数 加小时(时间戳: 整数, 小时: 整数): 整数 { 返回 时间戳 + 小时 * 3600; }
公开 函数 加天(时间戳: 整数, 天数: 整数): 整数 { 返回 时间戳 + 天数 * 86400; }
公开 函数 加周(时间戳: 整数, 周数: 整数): 整数 { 返回 时间戳 + 周数 * 604800; }

公开 函数 是闰年(年: 整数): 整数 {
    如果 (年 % 4 != 0) { 返回 0; }
    如果 (年 % 100 != 0) { 返回 1; }
    如果 (年 % 400 == 0) { 返回 1; }
    返回 0;
}

公开 函数 月天数(年: 整数, 月: 整数): 整数 {
    如果 (月 == 1 || 月 == 3 || 月 == 5 || 月 == 7 || 月 == 8 || 月 == 10 || 月 == 12) { 返回 31; }
    如果 (月 == 4 || 月 == 6 || 月 == 9 || 月 == 11) { 返回 30; }
    如果 (月 != 2) { 返回 0; }
    如果 (是闰年(年) == 1) { 返回 29; }
    返回 28;
}

// 日历加月：月份进位，日按目标月天数截断（1月31日 + 1月 = 2月28/29日）。
公开 函数 加月(时间戳: 整数, 月数: 整数): 整数 {
    变量 天: 整数 = 戳转日(时间戳);
    变量 y: 整数 = 日转年(天);
    变量 m: 整数 = 日转月(天);
    变量 d: 整数 = 日转日(天);
    变量 总月: 整数 = y * 12 + (m - 1) + 月数;
    变量 新年: 整数 = 0;
    变量 月序: 整数 = 0;
    如果 (总月 >= 0) {
        新年 = 总月 / 12;
        月序 = 总月 % 12;
    } 否则 {
        新年 = (总月 - 11) / 12;
        月序 = 总月 - 新年 * 12;
    }
    变量 新月: 整数 = 月序 + 1;
    变量 上限: 整数 = 月天数(新年, 新月);
    如果 (d > 上限) { d = 上限; }
    返回 纪元日(新年, 新月, d) * 86400 + 日内秒(时间戳);
}

// 日历加年 = 加 12 个月，于是 2 月 29 日加一年自动落到 2 月 28 日。
公开 函数 加年(时间戳: 整数, 年数: 整数): 整数 { 返回 加月(时间戳, 年数 * 12); }

// ── 相差 ────────────────────────────────────────────────────────

公开 函数 相差秒数(甲: 整数, 乙: 整数): 整数 { 返回 甲 - 乙; }
公开 函数 相差分钟(甲: 整数, 乙: 整数): 整数 { 返回 (甲 - 乙) / 60; }
公开 函数 相差小时(甲: 整数, 乙: 整数): 整数 { 返回 (甲 - 乙) / 3600; }
公开 函数 相差天数(甲: 整数, 乙: 整数): 整数 { 返回 (甲 - 乙) / 86400; }

// ── 区间端点 ─────────────────────────────────────────────────────

公开 函数 当天开始(时间戳: 整数): 整数 { 返回 戳转日(时间戳) * 86400; }
公开 函数 当天结束(时间戳: 整数): 整数 { 返回 戳转日(时间戳) * 86400 + 86399; }

公开 函数 本周开始(时间戳: 整数): 整数 {
    返回 当天开始(时间戳) - (星期几(时间戳) - 1) * 86400;
}
公开 函数 本周结束(时间戳: 整数): 整数 { 返回 本周开始(时间戳) + 604800 - 1; }

公开 函数 本月开始(时间戳: 整数): 整数 {
    变量 天: 整数 = 戳转日(时间戳);
    返回 纪元日(日转年(天), 日转月(天), 1) * 86400;
}
公开 函数 本月结束(时间戳: 整数): 整数 {
    变量 天: 整数 = 戳转日(时间戳);
    变量 y: 整数 = 日转年(天);
    变量 m: 整数 = 日转月(天);
    返回 纪元日(y, m, 月天数(y, m)) * 86400 + 86399;
}

公开 函数 本年开始(时间戳: 整数): 整数 { 返回 纪元日(年(时间戳), 1, 1) * 86400; }
公开 函数 本年结束(时间戳: 整数): 整数 { 返回 纪元日(年(时间戳), 12, 31) * 86400 + 86399; }

公开 函数 本季度开始(时间戳: 整数): 整数 {
    返回 纪元日(年(时间戳), (季度(时间戳) - 1) * 3 + 1, 1) * 86400;
}
公开 函数 本季度结束(时间戳: 整数): 整数 {
    变量 y: 整数 = 年(时间戳);
    变量 末月: 整数 = 季度(时间戳) * 3;
    返回 纪元日(y, 末月, 月天数(y, 末月)) * 86400 + 86399;
}

// ── 判定 ────────────────────────────────────────────────────────

公开 函数 在范围内(时间戳: 整数, 起: 整数, 止: 整数): 整数 {
    如果 (时间戳 >= 起 && 时间戳 <= 止) { 返回 1; }
    返回 0;
}

公开 函数 是今天(时间戳: 整数): 整数 {
    返回 在范围内(时间戳, 当天开始(qi_datetime_now()), 当天结束(qi_datetime_now()));
}
公开 函数 是本周(时间戳: 整数): 整数 {
    返回 在范围内(时间戳, 本周开始(qi_datetime_now()), 本周结束(qi_datetime_now()));
}
公开 函数 是本月(时间戳: 整数): 整数 {
    返回 在范围内(时间戳, 本月开始(qi_datetime_now()), 本月结束(qi_datetime_now()));
}
公开 函数 是本年(时间戳: 整数): 整数 {
    返回 在范围内(时间戳, 本年开始(qi_datetime_now()), 本年结束(qi_datetime_now()));
}

公开 函数 是周末(时间戳: 整数): 整数 {
    如果 (星期几(时间戳) >= 6) { 返回 1; }
    返回 0;
}
公开 函数 是工作日(时间戳: 整数): 整数 {
    如果 (星期几(时间戳) >= 6) { 返回 0; }
    返回 1;
}

// ── 单位换算 ─────────────────────────────────────────────────────

公开 函数 秒转毫秒(秒数: 整数): 整数 { 返回 秒数 * 1000; }
公开 函数 毫秒转秒(毫秒数: 整数): 整数 { 返回 毫秒数 / 1000; }
公开 函数 秒转微秒(秒数: 整数): 整数 { 返回 秒数 * 1000000; }
公开 函数 微秒转秒(微秒数: 整数): 整数 { 返回 微秒数 / 1000000; }
