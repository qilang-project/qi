// 标准库.大模型 —— 非流式的 对话 与 嵌入，qi 实现。
//
// 这个模块只接管 44 个函数里的两个。分发按函数走，流式那一票、工具调用、
// 会话管理照常落回 Rust（llm_ffi.rs）。
//
// ## 缝划在哪，为什么
//
// 三条约束互相咬死，逼出了「qi 管形状、Rust 管其余」这个分法：
//
// 1. **密钥不能进 qi**。HTTP 只能留在 Rust 那边发。
// 2. **会话池只能有一个**。流式和工具还在 Rust，跟 对话 共用同一份历史；
//    qi 另起一套会话的话，用户 对话 完再 流式对话 就接不上上文。
// 3. **磁带键必须逐字节一致**。键是请求体序列化文本的哈希，而 serde_json
//    开了 preserve_order —— 键序即插入序。字段顺序错一个，AIOne 课程那批
//    录制磁带就**静默全部回放未命中**。所以键只能在 Rust 那边算。
//
// 于是 qi 拿到的是「会话视图」（不含密钥），拼好请求体交给 交换，
// 拿回响应体自己归一化，最后 落账。
//
// **改这个文件时最要小心的就是字段顺序。** 下面每个 build 函数里的
// 设置 调用顺序 = 请求体里的键顺序 = 磁带键。看着无关紧要的一行挪动
// 会让所有历史录制失效，而且不报错。tests/大模型磁带键.rs 盯着这件事。

包 大模型;

导入 标准库.JSON;
导入 标准库.输入输出;
导入 标准库.事件流;
导入 标准库.字节切片;

// ── 会话视图小工具 ────────────────────────────────────────────

函数 视图(会话: 整数) : 整数 {
    返回 JSON::解码(大模型::会话视图(会话));
}

函数 配置串(视: 整数, 键: 字符串, 缺省: 字符串) : 字符串 {
    变量 配: 整数 = JSON::获取对象(视, "配置");
    如果 (JSON::是否包含键(配, 键) == 0) { 返回 缺省; }
    变量 值: 字符串 = JSON::获取字符串(配, 键);
    如果 (字符串::字节长度(值) == 0) { 返回 缺省; }
    返回 值;
}

函数 温度(视: 整数) : 浮点数 {
    返回 字符串转浮点数(配置串(视, "temperature", "0.7"));
}

函数 最大令牌(视: 整数) : 整数 {
    返回 字符串转整数(配置串(视, "max_tokens", "2000"));
}

// ── 消息组装（OpenAI 规范表示，各家再翻译）────────────────────

// 历史 + 新 user 消息 + 可能的 system。返回 JSON 数组句柄。
函数 组装消息(视: 整数, 用户文本: 字符串) : 整数 {
    变量 出: 整数 = JSON::创建数组();
    变量 历史: 整数 = JSON::获取数组(视, "历史");

    // system 注入：配置里有 system 且历史首条不是 system 时，插到最前面。
    // 注意判定看的是**历史**的首条，不是拼完之后 —— 跟 Rust 版一致。
    变量 系统: 字符串 = 配置串(视, "system", "");
    变量 已有系统: 整数 = 0;
    如果 (JSON::数组长度(历史) > 0) {
        变量 首: 整数 = JSON::数组获取对象(历史, 0);
        如果 (字符串::等于(JSON::获取字符串(首, "role"), "system") == 1) { 已有系统 = 1; }
    }
    如果 (字符串::字节长度(系统) > 0 && 已有系统 == 0) {
        变量 条: 整数 = JSON::创建对象();
        JSON::设置字符串(条, "role", "system");
        JSON::设置字符串(条, "content", 系统);
        JSON::数组添加对象(出, 条);
    }

    变量 i: 整数 = 0;
    当 (i < JSON::数组长度(历史)) {
        JSON::数组添加对象(出, JSON::数组获取对象(历史, i));
        i = i + 1;
    }

    变量 用户: 整数 = JSON::创建对象();
    JSON::设置字符串(用户, "role", "user");
    JSON::设置字符串(用户, "content", 用户文本);
    JSON::数组添加对象(出, 用户);
    返回 出;
}

// 只有历史（+ 可能的 system），不追加新 user 消息。继续工具对话 用。
函数 组装历史(视: 整数) : 整数 {
    变量 全: 整数 = 组装消息(视, "");
    // 组装消息 末尾那条是 content 为空串的占位 user，去掉
    变量 出: 整数 = JSON::创建数组();
    变量 末: 整数 = JSON::数组长度(全) - 1;
    变量 i: 整数 = 0;
    当 (i < 末) {
        JSON::数组添加对象(出, JSON::数组获取对象(全, i));
        i = i + 1;
    }
    返回 出;
}

// 同 组装消息，但新 user 消息的 content 是**块数组**（多模态：文本 + 图）。
// 历史里的既有条目原样拷过来 —— 数组 content 也照样跟着走，
// 所以看过图之后的追问仍带着图的上下文。
函数 组装消息带内容(视: 整数, 用户内容: 整数) : 整数 {
    变量 出: 整数 = 组装消息(视, "");
    // 组装消息 末尾那条是 content 为空串的占位 user，换成块数组版本
    变量 末: 整数 = JSON::数组长度(出) - 1;
    变量 用户: 整数 = JSON::创建对象();
    JSON::设置字符串(用户, "role", "user");
    JSON::设置数组(用户, "content", 用户内容);
    // 没有「替换第 i 个元素」的接口，重建一遍数组
    变量 新出: 整数 = JSON::创建数组();
    变量 i: 整数 = 0;
    当 (i < 末) {
        JSON::数组添加对象(新出, JSON::数组获取对象(出, i));
        i = i + 1;
    }
    JSON::数组添加对象(新出, 用户);
    返回 新出;
}

// content 可能是字符串也可能是块数组。qi 侧 JSON 没有类型查询，
// 但 获取数组 对非数组返回 0，够用来分辨。
函数 内容是数组(m: 整数) : 整数 {
    如果 (JSON::获取数组(m, "content") != 0) { 返回 1; }
    返回 0;
}

// ── 请求体：OpenAI ───────────────────────────────────────────
//
// 键序：model, messages, temperature, max_tokens, [response_format]
// 跟 llm_ffi.rs 的 构建OpenAI请求体 一致。别动。

函数 建OpenAI请求(视: 整数, 消息: 整数, 带工具: 整数, 流式: 整数) : 整数 {
    变量 体: 整数 = JSON::创建对象();
    JSON::设置字符串(体, "model", JSON::获取字符串(视, "模型"));
    JSON::设置数组(体, "messages", 消息);
    JSON::设置浮点数(体, "temperature", 温度(视));
    JSON::设置整数(体, "max_tokens", 最大令牌(视));
    // stream 必须排在 tools **之前**，跟 Rust 版一致。
    //
    // 平常看不出：磁带键会先把 stream 删掉。但 serde_json 开了 preserve_order，
    // 底层 IndexMap 的 remove 是 **swap_remove** —— 把最后一个元素挪到被删的位置。
    // 所以 stream 在中间还是在末尾，删完之后剩下的键序**不一样**：
    //   stream 在 tools 前  → 删后 …max_tokens, tool_choice, tools
    //   stream 在最末尾      → 删后 …max_tokens, tools, tool_choice
    // 纯文本流两边 stream 都在末尾，所以只有**带工具的流**会对不上键。
    如果 (流式 == 1) { JSON::设置布尔(体, "stream", 1); }
    // tools / tool_choice 排在 response_format **之前** —— 顺序即磁带键
    变量 工具: 整数 = JSON::获取数组(视, "工具列表");
    如果 (带工具 == 1 && 工具 != 0 && JSON::数组长度(工具) > 0) {
        JSON::设置数组(体, "tools", 工具);
        JSON::设置字符串(体, "tool_choice", "auto");
    }
    注入响应格式(视, 体);
    返回 体;
}

函数 注入响应格式(视: 整数, 体: 整数) {
    变量 格式: 字符串 = 字符串::去空白(配置串(视, "response_format", ""));
    如果 (字符串::字节长度(格式) == 0) { 返回; }
    如果 (字符串::等于(格式, "json") == 1 || 字符串::等于(格式, "json_object") == 1) {
        变量 rf: 整数 = JSON::创建对象();
        JSON::设置字符串(rf, "type", "json_object");
        JSON::设置对象(体, "response_format", rf);
        返回;
    }
    // 以 { 开头 → 当作完整的 response_format 对象原样放进去
    如果 (字符串::开始于(格式, "{") == 1) {
        变量 v: 整数 = JSON::解码(格式);
        如果 (v != 0) { JSON::设置对象(体, "response_format", v); }
    }
}

// ── 请求体：Anthropic ────────────────────────────────────────
//
// 键序：model, max_tokens, messages, temperature, [system]

函数 建Anthropic请求(视: 整数, 消息: 整数, 带工具: 整数, 流式: 整数) : 整数 {
    变量 系统: 字符串 = "";
    变量 消息出: 整数 = JSON::创建数组();
    变量 i: 整数 = 0;
    当 (i < JSON::数组长度(消息)) {
        变量 m: 整数 = JSON::数组获取对象(消息, i);
        i = i + 1;
        变量 角色: 字符串 = JSON::获取字符串(m, "role");
        如果 (字符串::等于(角色, "system") == 1) {
            // 多条 system 用换行接起来（跟 Rust 版一致）
            如果 (字符串::字节长度(系统) > 0) { 系统 = 系统 + "\n"; }
            系统 = 系统 + JSON::获取字符串(m, "content");
            继续;
        }
        如果 (字符串::等于(角色, "tool") == 1) {
            // 工具结果在 Anthropic 里是**一条 user 消息**，内容是 tool_result 块。
            // 漏了这条的后果很隐蔽：续传时模型看不到工具结果，于是又把同一个
            // 工具调一遍，看起来像「模型不听话」而不是形状拼错了。
            变量 结果块: 整数 = JSON::创建对象();
            JSON::设置字符串(结果块, "type", "tool_result");
            JSON::设置字符串(结果块, "tool_use_id", JSON::获取字符串(m, "tool_call_id"));
            JSON::设置字符串(结果块, "content", JSON::获取字符串(m, "content"));
            变量 块组2: 整数 = JSON::创建数组();
            JSON::数组添加对象(块组2, 结果块);
            变量 工具条: 整数 = JSON::创建对象();
            JSON::设置字符串(工具条, "role", "user");
            JSON::设置数组(工具条, "content", 块组2);
            JSON::数组添加对象(消息出, 工具条);
            继续;
        }
        如果 (字符串::等于(角色, "assistant") == 1) {
            // Anthropic 的 assistant 消息 content 是**块数组**，不是字符串。
            // 原样传字符串的话第一轮看不出问题（历史是空的），从第二轮起请求体
            // 就跟 Rust 版不同了 —— 直接后果是磁带键变了、所有录制静默未命中。
            变量 块组: 整数 = JSON::创建数组();
            变量 文: 字符串 = JSON::获取字符串(m, "content");
            如果 (字符串::字节长度(文) > 0) {
                变量 块: 整数 = JSON::创建对象();
                JSON::设置字符串(块, "type", "text");
                JSON::设置字符串(块, "text", 文);
                JSON::数组添加对象(块组, 块);
            }
            // assistant 发起的工具调用 → tool_use 块
            变量 调组: 整数 = JSON::获取数组(m, "tool_calls");
            如果 (调组 != 0) {
                变量 t: 整数 = 0;
                当 (t < JSON::数组长度(调组)) {
                    变量 调: 整数 = JSON::数组获取对象(调组, t);
                    t = t + 1;
                    变量 fb: 整数 = JSON::获取对象(调, "function");
                    变量 入参: 整数 = JSON::解码(JSON::获取字符串(fb, "arguments"));
                    如果 (入参 == 0) { 入参 = JSON::创建对象(); }
                    变量 用块: 整数 = JSON::创建对象();
                    JSON::设置字符串(用块, "type", "tool_use");
                    JSON::设置字符串(用块, "id", JSON::获取字符串(调, "id"));
                    JSON::设置字符串(用块, "name", JSON::获取字符串(fb, "name"));
                    JSON::设置对象(用块, "input", 入参);
                    JSON::数组添加对象(块组, 用块);
                }
            }
            变量 条: 整数 = JSON::创建对象();
            JSON::设置字符串(条, "role", "assistant");
            JSON::设置数组(条, "content", 块组);
            JSON::数组添加对象(消息出, 条);
            继续;
        }
        // user（以及其它角色）
        变量 用户条: 整数 = JSON::创建对象();
        JSON::设置字符串(用户条, "role", "user");
        如果 (内容是数组(m) == 1) {
            // 多模态：text 块原样，image_url → {"type":"image","source":{...}}
            变量 源块: 整数 = JSON::获取数组(m, "content");
            变量 出块: 整数 = JSON::创建数组();
            变量 j: 整数 = 0;
            当 (j < JSON::数组长度(源块)) {
                变量 块: 整数 = JSON::数组获取对象(源块, j);
                j = j + 1;
                如果 (字符串::等于(JSON::获取字符串(块, "type"), "image_url") == 1) {
                    变量 源: 整数 = JSON::创建对象();
                    JSON::设置字符串(源, "type", "url");
                    JSON::设置字符串(源, "url",
                        JSON::获取字符串(JSON::获取对象(块, "image_url"), "url"));
                    变量 新块: 整数 = JSON::创建对象();
                    JSON::设置字符串(新块, "type", "image");
                    JSON::设置对象(新块, "source", 源);
                    JSON::数组添加对象(出块, 新块);
                } 否则 {
                    JSON::数组添加对象(出块, 块);
                }
            }
            JSON::设置数组(用户条, "content", 出块);
        } 否则 {
            JSON::设置字符串(用户条, "content", JSON::获取字符串(m, "content"));
        }
        JSON::数组添加对象(消息出, 用户条);
    }

    变量 体: 整数 = JSON::创建对象();
    JSON::设置字符串(体, "model", JSON::获取字符串(视, "模型"));
    JSON::设置整数(体, "max_tokens", 最大令牌(视));
    JSON::设置数组(体, "messages", 消息出);
    JSON::设置浮点数(体, "temperature", 温度(视));
    如果 (字符串::字节长度(系统) > 0) { JSON::设置字符串(体, "system", 系统); }
    如果 (流式 == 1) { JSON::设置布尔(体, "stream", 1); }
    // Anthropic 的工具形状：{name, description, input_schema}
    变量 工具: 整数 = JSON::获取数组(视, "工具列表");
    如果 (带工具 == 1 && 工具 != 0 && JSON::数组长度(工具) > 0) {
        变量 出工具: 整数 = JSON::创建数组();
        变量 j: 整数 = 0;
        当 (j < JSON::数组长度(工具)) {
            变量 t: 整数 = JSON::数组获取对象(工具, j);
            j = j + 1;
            变量 f: 整数 = JSON::获取对象(t, "function");
            如果 (f == 0) { f = t; }
            变量 一个: 整数 = JSON::创建对象();
            JSON::设置字符串(一个, "name", JSON::获取字符串(f, "name"));
            JSON::设置字符串(一个, "description", JSON::获取字符串(f, "description"));
            变量 参: 整数 = JSON::获取对象(f, "parameters");
            如果 (参 == 0) { 参 = 空对象模式(); }
            JSON::设置对象(一个, "input_schema", 参);
            JSON::数组添加对象(出工具, 一个);
        }
        JSON::设置数组(体, "tools", 出工具);
    }
    返回 体;
}

// {"type":"object","properties":{}} —— 工具没声明参数时的占位
函数 空对象模式() : 整数 {
    变量 o: 整数 = JSON::创建对象();
    JSON::设置字符串(o, "type", "object");
    JSON::设置对象(o, "properties", JSON::创建对象());
    返回 o;
}

// ── 请求体：Gemini ───────────────────────────────────────────
//
// 键序：contents, generationConfig{temperature, maxOutputTokens}, [systemInstruction]

函数 建Gemini请求(视: 整数, 消息: 整数, 带工具: 整数, 流式: 整数) : 整数 {
    变量 系统: 字符串 = "";
    变量 内容: 整数 = JSON::创建数组();
    变量 i: 整数 = 0;
    当 (i < JSON::数组长度(消息)) {
        变量 m: 整数 = JSON::数组获取对象(消息, i);
        i = i + 1;
        变量 角色: 字符串 = JSON::获取字符串(m, "role");
        如果 (字符串::等于(角色, "system") == 1) {
            如果 (字符串::字节长度(系统) > 0) { 系统 = 系统 + "\n"; }
            系统 = 系统 + JSON::获取字符串(m, "content");
            继续;
        }
        如果 (字符串::等于(角色, "tool") == 1) {
            // 工具结果 → user 角色下的 functionResponse 部件
            变量 回应: 整数 = JSON::创建对象();
            JSON::设置字符串(回应, "result", JSON::获取字符串(m, "content"));
            变量 fr: 整数 = JSON::创建对象();
            JSON::设置字符串(fr, "name", JSON::获取字符串(m, "name"));
            JSON::设置对象(fr, "response", 回应);
            变量 段g: 整数 = JSON::创建对象();
            JSON::设置对象(段g, "functionResponse", fr);
            变量 段组g: 整数 = JSON::创建数组();
            JSON::数组添加对象(段组g, 段g);
            变量 条g: 整数 = JSON::创建对象();
            JSON::设置字符串(条g, "role", "user");
            JSON::设置数组(条g, "parts", 段组g);
            JSON::数组添加对象(内容, 条g);
            继续;
        }
        // Gemini 的角色只有 user / model
        变量 g角色: 字符串 = "user";
        如果 (字符串::等于(角色, "assistant") == 1) { g角色 = "model"; }

        变量 段组: 整数 = JSON::创建数组();
        如果 (内容是数组(m) == 1) {
            // 多模态：text → {"text":..}，image_url → {"file_data":{"file_uri":..}}，
            // 其它类型丢掉（跟 Rust 版的 filter_map 一致）
            变量 源块: 整数 = JSON::获取数组(m, "content");
            变量 j: 整数 = 0;
            当 (j < JSON::数组长度(源块)) {
                变量 块: 整数 = JSON::数组获取对象(源块, j);
                j = j + 1;
                变量 类: 字符串 = JSON::获取字符串(块, "type");
                如果 (字符串::等于(类, "text") == 1) {
                    变量 段: 整数 = JSON::创建对象();
                    JSON::设置字符串(段, "text", JSON::获取字符串(块, "text"));
                    JSON::数组添加对象(段组, 段);
                }
                如果 (字符串::等于(类, "image_url") == 1) {
                    变量 文件: 整数 = JSON::创建对象();
                    JSON::设置字符串(文件, "file_uri",
                        JSON::获取字符串(JSON::获取对象(块, "image_url"), "url"));
                    变量 段: 整数 = JSON::创建对象();
                    JSON::设置对象(段, "file_data", 文件);
                    JSON::数组添加对象(段组, 段);
                }
            }
        } 否则 {
            // 空字符串不产生 part（跟 Rust 版一致）
            变量 文: 字符串 = JSON::获取字符串(m, "content");
            如果 (字符串::字节长度(文) > 0) {
                变量 段: 整数 = JSON::创建对象();
                JSON::设置字符串(段, "text", 文);
                JSON::数组添加对象(段组, 段);
            }
        }
        // assistant 发起的工具调用 → functionCall 部件
        变量 调组g: 整数 = JSON::获取数组(m, "tool_calls");
        如果 (调组g != 0) {
            变量 t: 整数 = 0;
            当 (t < JSON::数组长度(调组g)) {
                变量 调: 整数 = JSON::数组获取对象(调组g, t);
                t = t + 1;
                变量 fb: 整数 = JSON::获取对象(调, "function");
                变量 入参: 整数 = JSON::解码(JSON::获取字符串(fb, "arguments"));
                如果 (入参 == 0) { 入参 = JSON::创建对象(); }
                变量 fc: 整数 = JSON::创建对象();
                JSON::设置字符串(fc, "name", JSON::获取字符串(fb, "name"));
                JSON::设置对象(fc, "args", 入参);
                变量 段c: 整数 = JSON::创建对象();
                JSON::设置对象(段c, "functionCall", fc);
                JSON::数组添加对象(段组, 段c);
            }
        }

        变量 条: 整数 = JSON::创建对象();
        JSON::设置字符串(条, "role", g角色);
        JSON::设置数组(条, "parts", 段组);
        JSON::数组添加对象(内容, 条);
    }

    变量 生成配置: 整数 = JSON::创建对象();
    JSON::设置浮点数(生成配置, "temperature", 温度(视));
    JSON::设置整数(生成配置, "maxOutputTokens", 最大令牌(视));

    变量 体: 整数 = JSON::创建对象();
    JSON::设置数组(体, "contents", 内容);
    JSON::设置对象(体, "generationConfig", 生成配置);
    如果 (字符串::字节长度(系统) > 0) {
        变量 段: 整数 = JSON::创建对象();
        JSON::设置字符串(段, "text", 系统);
        变量 段组: 整数 = JSON::创建数组();
        JSON::数组添加对象(段组, 段);
        变量 指令: 整数 = JSON::创建对象();
        JSON::设置数组(指令, "parts", 段组);
        JSON::设置对象(体, "systemInstruction", 指令);
    }
    // Gemini 的工具形状：tools:[{functionDeclarations:[{name,description,parameters}]}]
    变量 工具: 整数 = JSON::获取数组(视, "工具列表");
    如果 (带工具 == 1 && 工具 != 0 && JSON::数组长度(工具) > 0) {
        变量 声明: 整数 = JSON::创建数组();
        变量 j: 整数 = 0;
        当 (j < JSON::数组长度(工具)) {
            变量 t: 整数 = JSON::数组获取对象(工具, j);
            j = j + 1;
            变量 f: 整数 = JSON::获取对象(t, "function");
            如果 (f == 0) { f = t; }
            变量 一个: 整数 = JSON::创建对象();
            JSON::设置字符串(一个, "name", JSON::获取字符串(f, "name"));
            JSON::设置字符串(一个, "description", JSON::获取字符串(f, "description"));
            变量 参: 整数 = JSON::获取对象(f, "parameters");
            如果 (参 == 0) { 参 = 空对象模式(); }
            JSON::设置对象(一个, "parameters", 参);
            JSON::数组添加对象(声明, 一个);
        }
        变量 声明包: 整数 = JSON::创建对象();
        JSON::设置数组(声明包, "functionDeclarations", 声明);
        变量 组: 整数 = JSON::创建数组();
        JSON::数组添加对象(组, 声明包);
        JSON::设置数组(体, "tools", 组);
    }
    返回 体;
}

// 建请求 = 按提供商成形 + 合并 extra_body。
//
// extra_body 的**合并时机**是键序的一部分，而键序就是磁带键：单轮是
// 「合完就发」，多候选是「合完再加 n」。所以合并放在这里（成形的最后一步），
// 之后再加的字段一律排在 extra_body 新键之后 —— 跟 Rust 原实现同序。
函数 建请求(会话: 整数, 视: 整数, 提供商: 字符串, 消息: 整数) : 整数 {
    返回 建请求全(会话, 视, 提供商, 消息, 0, 0);
}

函数 建请求带工具(会话: 整数, 视: 整数, 提供商: 字符串, 消息: 整数, 带工具: 整数) : 整数 {
    返回 建请求全(会话, 视, 提供商, 消息, 带工具, 0);
}

函数 建请求全(会话: 整数, 视: 整数, 提供商: 字符串, 消息: 整数, 带工具: 整数, 流式: 整数) : 整数 {
    变量 体: 整数 = 0;
    如果 (字符串::等于(提供商, "anthropic") == 1) {
        体 = 建Anthropic请求(视, 消息, 带工具, 流式);
    } 否则 {
        如果 (字符串::等于(提供商, "gemini") == 1) {
            体 = 建Gemini请求(视, 消息, 带工具, 流式);
        } 否则 {
            体 = 建OpenAI请求(视, 消息, 带工具, 流式);
        }
    }
    返回 JSON::解码(大模型::合并额外参数(会话, JSON::转字符串(体)));
}

// ── 响应归一化 ───────────────────────────────────────────────

// 取回答文本。各家形状不同，统一成一段文本。
函数 取文本(体: 整数, 提供商: 字符串) : 字符串 {
    如果 (字符串::等于(提供商, "anthropic") == 1) {
        变量 块组: 整数 = JSON::获取数组(体, "content");
        变量 文: 字符串 = "";
        变量 i: 整数 = 0;
        当 (i < JSON::数组长度(块组)) {
            变量 块: 整数 = JSON::数组获取对象(块组, i);
            i = i + 1;
            如果 (字符串::等于(JSON::获取字符串(块, "type"), "text") == 1) {
                文 = 文 + JSON::获取字符串(块, "text");
            }
        }
        返回 文;
    }
    如果 (字符串::等于(提供商, "gemini") == 1) {
        变量 候选: 整数 = JSON::获取数组(体, "candidates");
        如果 (JSON::数组长度(候选) == 0) { 返回 ""; }
        变量 首: 整数 = JSON::数组获取对象(候选, 0);
        变量 段组: 整数 = JSON::获取数组(JSON::获取对象(首, "content"), "parts");
        变量 文: 字符串 = "";
        变量 i: 整数 = 0;
        当 (i < JSON::数组长度(段组)) {
            文 = 文 + JSON::获取字符串(JSON::数组获取对象(段组, i), "text");
            i = i + 1;
        }
        返回 文;
    }
    变量 候选组: 整数 = JSON::获取数组(体, "choices");
    如果 (JSON::数组长度(候选组) == 0) { 返回 ""; }
    返回 JSON::获取字符串(JSON::获取对象(JSON::数组获取对象(候选组, 0), "message"), "content");
}

// 用量三元组存进一个 JSON 对象返回（qi 没有多返回值）
函数 取用量(体: 整数, 提供商: 字符串) : 整数 {
    变量 出: 整数 = JSON::创建对象();
    如果 (字符串::等于(提供商, "anthropic") == 1) {
        变量 u: 整数 = JSON::获取对象(体, "usage");
        变量 入: 整数 = JSON::获取整数(u, "input_tokens");
        变量 出t: 整数 = JSON::获取整数(u, "output_tokens");
        JSON::设置整数(出, "p", 入);
        JSON::设置整数(出, "c", 出t);
        JSON::设置整数(出, "t", 入 + 出t);
        返回 出;
    }
    如果 (字符串::等于(提供商, "gemini") == 1) {
        变量 u: 整数 = JSON::获取对象(体, "usageMetadata");
        变量 p: 整数 = JSON::获取整数(u, "promptTokenCount");
        变量 c: 整数 = JSON::获取整数(u, "candidatesTokenCount");
        变量 t: 整数 = JSON::获取整数(u, "totalTokenCount");
        JSON::设置整数(出, "p", p);
        JSON::设置整数(出, "c", c);
        如果 (t > 0) { JSON::设置整数(出, "t", t); } 否则 { JSON::设置整数(出, "t", p + c); }
        返回 出;
    }
    变量 u: 整数 = JSON::获取对象(体, "usage");
    JSON::设置整数(出, "p", JSON::获取整数(u, "prompt_tokens"));
    JSON::设置整数(出, "c", JSON::获取整数(u, "completion_tokens"));
    JSON::设置整数(出, "t", JSON::获取整数(u, "total_tokens"));
    返回 出;
}

// ── 对外：对话 ───────────────────────────────────────────────

/// 一轮非流式对话。返回回答文本；失败返回以「LLM调用失败: 」开头的说明
/// （沿用原 FFI 的约定 —— 上面压着 qi-harness 等一堆调用方按这个前缀判错）。
// 发一次请求并**记账**，但不写历史。返回 JSON：
//   成功 {"ok":1,"文本":...,"p":..,"c":..,"t":..}
//   失败 {"ok":0,"错误":"..."}
//
// 抽出来是因为多候选在 anthropic/gemini 上要串行调 n 次，那 n 次都不能写历史
// （历史最后只写一次、只写第一个候选）。直接复用公开的 对话 会写 n 遍，
// 后续对话的上下文里就多出 n-1 组重复问答。
函数 一次请求(会话: 整数, 视: 整数, 提供商: 字符串, 提示: 字符串) : 整数 {
    变量 出: 整数 = JSON::创建对象();
    变量 消息: 整数 = 组装消息(视, 提示);
    变量 请求: 整数 = 建请求(会话, 视, 提供商, 消息);
    变量 回: 整数 = JSON::解码(大模型::交换(会话, "chat", JSON::转字符串(请求)));
    如果 (JSON::获取布尔(回, "ok") == 0) {
        JSON::设置整数(出, "ok", 0);
        JSON::设置字符串(出, "错误", JSON::获取字符串(回, "error"));
        返回 出;
    }
    变量 体: 整数 = JSON::获取对象(回, "body");
    变量 用量: 整数 = 取用量(体, 提供商);
    JSON::设置整数(出, "ok", 1);
    JSON::设置字符串(出, "文本", 取文本(体, 提供商));
    JSON::设置整数(出, "p", JSON::获取整数(用量, "p"));
    JSON::设置整数(出, "c", JSON::获取整数(用量, "c"));
    JSON::设置整数(出, "t", JSON::获取整数(用量, "t"));
    返回 出;
}

// 只记账不写历史（串行多候选的每一次）
函数 只记账(会话: 整数, 果: 整数) {
    大模型::落账(会话, "", "",
        JSON::获取整数(果, "p"), JSON::获取整数(果, "c"), JSON::获取整数(果, "t"));
}

// 只写历史不动用量（总量传 -1）
函数 只写历史(会话: 整数, 提示: 字符串, 回答: 字符串) {
    变量 用户条: 整数 = JSON::创建对象();
    JSON::设置字符串(用户条, "role", "user");
    JSON::设置字符串(用户条, "content", 提示);
    变量 助手条: 整数 = JSON::创建对象();
    JSON::设置字符串(助手条, "role", "assistant");
    JSON::设置字符串(助手条, "content", 回答);
    大模型::落账(会话, JSON::转字符串(用户条), JSON::转字符串(助手条), 0 - 1, 0 - 1, 0 - 1);
}

公开 函数 对话(会话: 整数, 提示: 字符串) : 字符串 {
    变量 视: 整数 = 视图(会话);
    如果 (JSON::是否包含键(视, "模型") == 0) {
        返回 "LLM调用失败: 无效会话句柄";
    }
    变量 提供商: 字符串 = JSON::获取字符串(视, "提供商");
    变量 果: 整数 = 一次请求(会话, 视, 提供商, 提示);
    如果 (JSON::获取整数(果, "ok") == 0) {
        返回 "LLM调用失败: " + JSON::获取字符串(果, "错误");
    }
    变量 文: 字符串 = JSON::获取字符串(果, "文本");
    // 历史里存的是纯文本 user/assistant 两条，跟原实现一致
    变量 用户条: 整数 = JSON::创建对象();
    JSON::设置字符串(用户条, "role", "user");
    JSON::设置字符串(用户条, "content", 提示);
    变量 助手条: 整数 = JSON::创建对象();
    JSON::设置字符串(助手条, "role", "assistant");
    JSON::设置字符串(助手条, "content", 文);
    大模型::落账(会话, JSON::转字符串(用户条), JSON::转字符串(助手条),
        JSON::获取整数(果, "p"), JSON::获取整数(果, "c"), JSON::获取整数(果, "t"));
    返回 文;
}

// ── 对外：对话图像 ───────────────────────────────────────────

/// 文本 + 单张图 URL 的多模态对话。返回回答文本；失败返回「LLM调用失败: ...」。
///
/// 内部统一用 OpenAI 的多模态 content 数组当规范表示，各家在自己的成形函数里
/// 翻译（anthropic → image/source，gemini → file_data/file_uri）。
/// **入历史的是那个数组**，不是提示文本 —— 这样后面追问还带着图的上下文。
公开 函数 对话图像(会话: 整数, 提示: 字符串, 图像URL: 字符串) : 字符串 {
    变量 视: 整数 = 视图(会话);
    如果 (JSON::是否包含键(视, "模型") == 0) {
        返回 "LLM调用失败: 无效会话句柄";
    }
    变量 提供商: 字符串 = JSON::获取字符串(视, "提供商");

    变量 文块: 整数 = JSON::创建对象();
    JSON::设置字符串(文块, "type", "text");
    JSON::设置字符串(文块, "text", 提示);
    变量 图地址: 整数 = JSON::创建对象();
    JSON::设置字符串(图地址, "url", 图像URL);
    变量 图块: 整数 = JSON::创建对象();
    JSON::设置字符串(图块, "type", "image_url");
    JSON::设置对象(图块, "image_url", 图地址);
    变量 用户内容: 整数 = JSON::创建数组();
    JSON::数组添加对象(用户内容, 文块);
    JSON::数组添加对象(用户内容, 图块);

    变量 消息: 整数 = 组装消息带内容(视, 用户内容);
    变量 请求: 整数 = 建请求(会话, 视, 提供商, 消息);
    变量 回: 整数 = JSON::解码(大模型::交换(会话, "chat", JSON::转字符串(请求)));
    如果 (JSON::获取布尔(回, "ok") == 0) {
        返回 "LLM调用失败: " + JSON::获取字符串(回, "error");
    }
    变量 体: 整数 = JSON::获取对象(回, "body");
    变量 文: 字符串 = 取文本(体, 提供商);
    变量 用量: 整数 = 取用量(体, 提供商);

    变量 用户条: 整数 = JSON::创建对象();
    JSON::设置字符串(用户条, "role", "user");
    JSON::设置数组(用户条, "content", 用户内容);
    变量 助手条: 整数 = JSON::创建对象();
    JSON::设置字符串(助手条, "role", "assistant");
    JSON::设置字符串(助手条, "content", 文);
    大模型::落账(会话, JSON::转字符串(用户条), JSON::转字符串(助手条),
        JSON::获取整数(用量, "p"), JSON::获取整数(用量, "c"), JSON::获取整数(用量, "t"));
    返回 文;
}

// ── 工具调用 ─────────────────────────────────────────────────
//
// 注册工具 / 清空工具 仍在 Rust（改会话状态）。这里接管的是**形状**那部分：
// 带工具的请求怎么拼、响应里的 tool_calls 怎么读、工具结果怎么进历史。
//
// 工具定义在注册时就已经成形好（OpenAI 形状 + provider-safe 名），
// 会话视图 原样交过来，这里按 provider 再翻译。

// Qi 工具名 → provider-safe 名。规则跟 Rust 的 工具安全名称 一致：
// 纯 ASCII 字母数字/下划线/连字符原样；否则 "qi_tool_" + 每个字节的十六进制。
// 中文工具名走的就是后一条 —— 各家 API 都只认 ASCII 函数名。
函数 工具安全名(名: 字符串) : 字符串 {
    变量 b: 整数 = 字节切片::从字符串(名);
    变量 n: 整数 = 字节切片::长度(b);
    变量 全安全: 整数 = 0;
    如果 (n > 0) {
        全安全 = 1;
        变量 i: 整数 = 0;
        当 (i < n) {
            变量 c: 整数 = 字节切片::获取(b, i);
            变量 好: 整数 = 0;
            如果 (c >= 48 && c <= 57) { 好 = 1; }
            如果 (c >= 65 && c <= 90) { 好 = 1; }
            如果 (c >= 97 && c <= 122) { 好 = 1; }
            如果 (c == 95 || c == 45) { 好 = 1; }
            如果 (好 == 0) { 全安全 = 0; }
            i = i + 1;
        }
    }
    如果 (全安全 == 1) {
        字节切片::释放切片(b);
        返回 名;
    }
    变量 十六: 字符串 = 字节切片::转十六进制(b);
    字节切片::释放切片(b);
    返回 "qi_tool_" + 十六;
}

// 从 assistant 消息 JSON 里取第 序 个 tool_call；取不到返回 0。
函数 取工具调用(消息JSON: 字符串, 序: 整数) : 整数 {
    变量 m: 整数 = JSON::解码(消息JSON);
    如果 (m == 0) { 返回 0; }
    变量 组: 整数 = JSON::获取数组(m, "tool_calls");
    如果 (组 == 0) { 返回 0; }
    如果 (序 < 0 || 序 >= JSON::数组长度(组)) { 返回 0; }
    返回 JSON::数组获取对象(组, 序);
}

公开 函数 有工具调用(消息JSON: 字符串) : 整数 {
    如果 (取工具调用(消息JSON, 0) == 0) { 返回 0; }
    返回 1;
}

公开 函数 工具调用数量(消息JSON: 字符串) : 整数 {
    变量 m: 整数 = JSON::解码(消息JSON);
    如果 (m == 0) { 返回 0; }
    变量 组: 整数 = JSON::获取数组(m, "tool_calls");
    如果 (组 == 0) { 返回 0; }
    返回 JSON::数组长度(组);
}

公开 函数 工具调用ID索引(消息JSON: 字符串, 序: 整数) : 字符串 {
    变量 调: 整数 = 取工具调用(消息JSON, 序);
    如果 (调 == 0) { 返回 ""; }
    返回 JSON::获取字符串(调, "id");
}

公开 函数 工具调用ID(消息JSON: 字符串) : 字符串 {
    返回 工具调用ID索引(消息JSON, 0);
}

公开 函数 工具调用参数索引(消息JSON: 字符串, 序: 整数) : 字符串 {
    变量 调: 整数 = 取工具调用(消息JSON, 序);
    如果 (调 == 0) { 返回 ""; }
    返回 JSON::获取字符串(JSON::获取对象(调, "function"), "arguments");
}

公开 函数 工具调用参数(消息JSON: 字符串) : 字符串 {
    返回 工具调用参数索引(消息JSON, 0);
}

/// 取工具名，并**还原成 Qi 原名**（发出去的是 provider-safe 名，
/// 回来的也是那个；不查映射的话调用方拿到的是 qi_tool_e4bda0… 这种十六进制）。
公开 函数 工具调用名称索引(会话: 整数, 消息JSON: 字符串, 序: 整数) : 字符串 {
    变量 调: 整数 = 取工具调用(消息JSON, 序);
    如果 (调 == 0) { 返回 ""; }
    变量 安全名: 字符串 = JSON::获取字符串(JSON::获取对象(调, "function"), "name");
    变量 视: 整数 = 视图(会话);
    变量 映射: 整数 = JSON::获取对象(视, "工具名称映射");
    如果 (映射 != 0 && JSON::是否包含键(映射, 安全名) == 1) {
        返回 JSON::获取字符串(映射, 安全名);
    }
    返回 安全名;
}

公开 函数 工具调用名称(会话: 整数, 消息JSON: 字符串) : 字符串 {
    返回 工具调用名称索引(会话, 消息JSON, 0);
}

/// 把工具执行结果作为 tool 消息追加进历史。
公开 函数 添加工具结果(会话: 整数, 调用ID: 字符串, 工具名: 字符串, 结果值: 字符串) : 整数 {
    变量 视: 整数 = 视图(会话);
    如果 (JSON::是否包含键(视, "模型") == 0) { 返回 0 - 1; }
    变量 条: 整数 = JSON::创建对象();
    JSON::设置字符串(条, "role", "tool");
    JSON::设置字符串(条, "tool_call_id", 调用ID);
    JSON::设置字符串(条, "content", 结果值);
    变量 安全名: 字符串 = 工具安全名(工具名);
    如果 (字符串::字节长度(安全名) > 0) {
        JSON::设置字符串(条, "name", 安全名);
    }
    大模型::落账(会话, JSON::转字符串(条), "", 0 - 1, 0 - 1, 0 - 1);
    返回 1;
}

// 归一化响应里的 assistant 消息（含 tool_calls），返回 JSON 对象句柄。
// 跟 取文本 是同一份响应，但这里要的是**完整消息**：工具派发和入历史都靠它。
函数 取助手消息(体: 整数, 提供商: 字符串) : 整数 {
    变量 消息: 整数 = JSON::创建对象();
    JSON::设置字符串(消息, "role", "assistant");
    变量 文: 字符串 = "";
    变量 调用组: 整数 = JSON::创建数组();

    如果 (字符串::等于(提供商, "anthropic") == 1) {
        变量 块组: 整数 = JSON::获取数组(体, "content");
        变量 i: 整数 = 0;
        当 (i < JSON::数组长度(块组)) {
            变量 块: 整数 = JSON::数组获取对象(块组, i);
            i = i + 1;
            变量 类: 字符串 = JSON::获取字符串(块, "type");
            如果 (字符串::等于(类, "text") == 1) { 文 = 文 + JSON::获取字符串(块, "text"); }
            如果 (字符串::等于(类, "tool_use") == 1) {
                变量 参: 整数 = JSON::获取对象(块, "input");
                如果 (参 == 0) { 参 = JSON::创建对象(); }
                JSON::数组添加对象(调用组, 造工具调用(JSON::获取字符串(块, "id"),
                    JSON::获取字符串(块, "name"), JSON::转字符串(参)));
            }
        }
    } 否则 {
        如果 (字符串::等于(提供商, "gemini") == 1) {
            变量 候选: 整数 = JSON::获取数组(体, "candidates");
            如果 (JSON::数组长度(候选) > 0) {
                变量 段组: 整数 = JSON::获取数组(
                    JSON::获取对象(JSON::数组获取对象(候选, 0), "content"), "parts");
                变量 i: 整数 = 0;
                当 (i < JSON::数组长度(段组)) {
                    变量 段: 整数 = JSON::数组获取对象(段组, i);
                    文 = 文 + JSON::获取字符串(段, "text");
                    变量 调: 整数 = JSON::获取对象(段, "functionCall");
                    如果 (调 != 0) {
                        变量 参: 整数 = JSON::获取对象(调, "args");
                        如果 (参 == 0) { 参 = JSON::创建对象(); }
                        // Gemini 不给调用 id，按部件序号编一个（跟 Rust 版一致）
                        JSON::数组添加对象(调用组, 造工具调用("call_" + 整数转字符串(i),
                            JSON::获取字符串(调, "name"), JSON::转字符串(参)));
                    }
                    i = i + 1;
                }
            }
        } 否则 {
            变量 选: 整数 = JSON::获取数组(体, "choices");
            如果 (JSON::数组长度(选) > 0) {
                变量 原消息: 整数 = JSON::获取对象(JSON::数组获取对象(选, 0), "message");
                // OpenAI 的 message 本来就是规范形状，原样返回
                返回 原消息;
            }
        }
    }

    // anthropic / gemini：content 在「没有文本但有工具调用」时是 null
    如果 (字符串::字节长度(文) == 0 && JSON::数组长度(调用组) > 0) {
        // 没有文本只有工具调用时 content 是 **null**，不是空串也不是缺键 ——
        // 各家 API 后续轮次会照这条历史回发，形状不对会被拒。
        JSON::设置对象(消息, "content", JSON::解码("null"));
    } 否则 {
        JSON::设置字符串(消息, "content", 文);
    }
    如果 (JSON::数组长度(调用组) > 0) {
        JSON::设置数组(消息, "tool_calls", 调用组);
    }
    返回 消息;
}

函数 造工具调用(id: 字符串, 名: 字符串, 参数文: 字符串) : 整数 {
    变量 函数体: 整数 = JSON::创建对象();
    JSON::设置字符串(函数体, "name", 名);
    JSON::设置字符串(函数体, "arguments", 参数文);
    变量 调: 整数 = JSON::创建对象();
    JSON::设置字符串(调, "id", id);
    JSON::设置字符串(调, "type", "function");
    JSON::设置对象(调, "function", 函数体);
    返回 调;
}

/// 带工具定义发一轮。返回**完整 assistant 消息 JSON**（可能带 tool_calls）；
/// 失败返回「工具对话失败: ...」。
公开 函数 工具对话(会话: 整数, 提示: 字符串) : 字符串 {
    变量 视: 整数 = 视图(会话);
    如果 (JSON::是否包含键(视, "模型") == 0) { 返回 "LLM调用失败: 无效会话句柄"; }
    变量 提供商: 字符串 = JSON::获取字符串(视, "提供商");
    变量 消息: 整数 = 组装消息(视, 提示);
    变量 请求: 整数 = 建请求带工具(会话, 视, 提供商, 消息, 1);
    变量 回: 整数 = JSON::解码(大模型::交换(会话, "chat", JSON::转字符串(请求)));
    如果 (JSON::获取布尔(回, "ok") == 0) {
        返回 "工具对话失败: " + JSON::获取字符串(回, "error");
    }
    变量 体: 整数 = JSON::获取对象(回, "body");
    变量 助手: 整数 = 取助手消息(体, 提供商);
    变量 用量: 整数 = 取用量(体, 提供商);

    变量 用户条: 整数 = JSON::创建对象();
    JSON::设置字符串(用户条, "role", "user");
    JSON::设置字符串(用户条, "content", 提示);
    大模型::落账(会话, JSON::转字符串(用户条), JSON::转字符串(助手),
        JSON::获取整数(用量, "p"), JSON::获取整数(用量, "c"), JSON::获取整数(用量, "t"));
    返回 JSON::转字符串(助手);
}

/// 添加工具结果之后继续推理。历史里已经有 user 消息，不再补。
公开 函数 继续工具对话(会话: 整数) : 字符串 {
    变量 视: 整数 = 视图(会话);
    如果 (JSON::是否包含键(视, "模型") == 0) { 返回 "LLM调用失败: 无效会话句柄"; }
    变量 提供商: 字符串 = JSON::获取字符串(视, "提供商");
    // 续传：不追加新 user 消息，历史原样发出去
    变量 消息: 整数 = 组装历史(视);
    变量 请求: 整数 = 建请求带工具(会话, 视, 提供商, 消息, 1);
    变量 回: 整数 = JSON::解码(大模型::交换(会话, "chat", JSON::转字符串(请求)));
    如果 (JSON::获取布尔(回, "ok") == 0) {
        返回 "继续工具对话失败: " + JSON::获取字符串(回, "error");
    }
    变量 体: 整数 = JSON::获取对象(回, "body");
    变量 助手: 整数 = 取助手消息(体, 提供商);
    变量 用量: 整数 = 取用量(体, 提供商);
    大模型::落账(会话, "", JSON::转字符串(助手),
        JSON::获取整数(用量, "p"), JSON::获取整数(用量, "c"), JSON::获取整数(用量, "t"));
    返回 JSON::转字符串(助手);
}

// ── 对外：流式对话 ───────────────────────────────────────────
//
// 三个函数一组：流式对话 开流、读取流 逐块取、关闭流 收尾。
//
// Rust 只做两件：带鉴权把请求发出去（密钥不出 Rust），以及流式磁带的存取。
// SSE 分帧交给 标准库.事件流，增量拼接和历史落账在这里。
//
// 只支持 OpenAI 形状的 SSE（choices[0].delta.content）—— 跟原实现一样。
// anthropic / gemini 的流式事件形状完全不同，原来也没做。
//
// ## 状态为什么摊成一排平表，而不是一个嵌套对象
//
// **qi 的 JSON 子对象是深拷贝，不是引用。** `JSON::获取对象(父,键)` 拿到的是
// 副本，往里写不会反映到父上；`JSON::设置对象` 存进去的也是副本，之后改原句柄
// 同样没用。实测过：父里放个子对象，改取回来的副本、再改原来的句柄，父都纹丝不动。
//
// 第一版就是把流状态塞进一个嵌套对象，于是每次 累计 += 片段 全部丢失 ——
// 片段照常一个个吐出来，只有最后写历史时发现累计是空的。不报错。
// 摊平之后每次都是对**顶层表**的 设置，这条路是通的。

变量 流底层表: 整数 = 0;
变量 流会话表: 整数 = 0;
变量 流提示表: 整数 = 0;
变量 流累计表: 整数 = 0;
变量 流完成表: 整数 = 0;
变量 流请求表: 整数 = 0;
变量 流要录表: 整数 = 0;
变量 流录制块表: 整数 = 0;
变量 流回放块表: 整数 = 0;
变量 流回放位表: 整数 = 0;
变量 流有效表: 整数 = 0;
变量 流带工具表: 整数 = 0;
变量 流续传表: 整数 = 0;
// 工具分块：流式 tool_calls 是**增量**的 —— 第一块给 index/id/name，
// 后续块只往 arguments 上拼。按 index 存 {id,name,args}，收尾时组装。
变量 流工具分块表: 整数 = 0;

函数 确保流表() {
    如果 (流底层表 == 0) {
        流底层表 = JSON::创建对象();
        流会话表 = JSON::创建对象();
        流提示表 = JSON::创建对象();
        流累计表 = JSON::创建对象();
        流完成表 = JSON::创建对象();
        流请求表 = JSON::创建对象();
        流要录表 = JSON::创建对象();
        流录制块表 = JSON::创建对象();
        流回放块表 = JSON::创建对象();
        流回放位表 = JSON::创建对象();
        流有效表 = JSON::创建对象();
        流带工具表 = JSON::创建对象();
        流续传表 = JSON::创建对象();
        流工具分块表 = JSON::创建对象();
    }
}

函数 流键(流: 整数) : 字符串 { 返回 整数转字符串(流); }

函数 流有效(流: 整数) : 整数 {
    确保流表();
    如果 (JSON::是否包含键(流有效表, 流键(流)) == 0) { 返回 0; }
    返回 JSON::获取整数(流有效表, 流键(流));
}

// 流句柄自增、不复用。复用的话「关完还留着旧句柄」的调用方会静默读到别人的流。
变量 流号计数: 整数 = 0;
函数 下个流号() : 整数 {
    流号计数 = 流号计数 + 1;
    返回 流号计数;
}

/// 开一条流式对话。返回流句柄（正数）；失败返回 -1。
///
/// 回放档（QI_LLM_REPLAY）命中磁带时**不联网**，直接从录制的块列表里放。
公开 函数 流式对话(会话: 整数, 提示: 字符串) : 整数 {
    返回 开流(会话, 提示, 0, 0);
}

/// 带工具定义开一条流。内容片段照常从 读取流 流出，tool_calls 在这边按
/// index 累积，读完用 流取助手消息 取完整 assistant 消息。
公开 函数 流式工具对话(会话: 整数, 提示: 字符串) : 整数 {
    返回 开流(会话, 提示, 1, 0);
}

/// 回填工具结果之后继续流式推理。历史里已经有 user 消息，不再补。
公开 函数 流式继续工具对话(会话: 整数) : 整数 {
    返回 开流(会话, "", 1, 1);
}

函数 开流(会话: 整数, 提示: 字符串, 带工具: 整数, 是续传: 整数) : 整数 {
    确保流表();
    变量 视: 整数 = 视图(会话);
    如果 (JSON::是否包含键(视, "模型") == 0) { 返回 0 - 1; }
    变量 提供商: 字符串 = JSON::获取字符串(视, "提供商");

    变量 消息: 整数 = 0;
    如果 (是续传 == 1) {
        消息 = 组装历史(视);
    } 否则 {
        消息 = 组装消息(视, 提示);
    }
    // stream 放哪儿是照搬 Rust 的，包括它自己两条路的**不一致**：
    //   流式对话 / 流式工具对话 → 构建请求体(…, 流式=true)，stream 在 tools 之前
    //   流式继续工具对话       → 构建继续请求体(true) 之后再补，stream 在**末尾**
    // 这个不一致本身不影响发出去的请求（服务端不看键序），但**影响磁带键**：
    // IndexMap 的 remove 是 swap_remove，删掉 stream 之后剩下的键序取决于
    // 它原来在哪儿。要跟存量磁带对得上，就只能一处一处照着来。
    变量 请求: 整数 = 0;
    如果 (是续传 == 1) {
        请求 = 建请求全(会话, 视, 提供商, 消息, 带工具, 0);
        JSON::设置布尔(请求, "stream", 1);
    } 否则 {
        请求 = 建请求全(会话, 视, 提供商, 消息, 带工具, 1);
    }
    变量 请求文: 字符串 = JSON::转字符串(请求);

    变量 磁带: 整数 = JSON::解码(大模型::流式磁带查(请求文));
    变量 命中: 整数 = JSON::获取整数(磁带, "命中");
    如果 (命中 == 0 && JSON::获取整数(磁带, "回放") == 1) {
        输入输出::打印错误行("流式对话失败: 流式磁带回放未命中(QI_LLM_REPLAY)：无此请求的录制。键="
            + JSON::获取字符串(磁带, "键") + "。先用 QI_LLM_RECORD=1 录制。");
        返回 0 - 1;
    }

    变量 底层: 整数 = 0;
    如果 (命中 == 0) {
        底层 = 大模型::打开流传输(会话, 请求文);
        如果 (底层 <= 0) { 返回 0 - 1; }
        事件流::接管(底层);
    }

    变量 号: 整数 = 下个流号();
    变量 k: 字符串 = 流键(号);
    JSON::设置整数(流底层表, k, 底层);
    JSON::设置整数(流会话表, k, 会话);
    JSON::设置字符串(流提示表, k, 提示);
    JSON::设置字符串(流累计表, k, "");
    JSON::设置整数(流完成表, k, 0);
    JSON::设置字符串(流请求表, k, 请求文);
    // 回放出来的就是录过的，不重复写回
    如果 (命中 == 1) {
        JSON::设置整数(流要录表, k, 0);
        JSON::设置数组(流回放块表, k, JSON::获取数组(磁带, "块"));
    } 否则 {
        JSON::设置整数(流要录表, k, JSON::获取整数(磁带, "要录"));
        JSON::设置数组(流回放块表, k, JSON::创建数组());
    }
    JSON::设置数组(流录制块表, k, JSON::创建数组());
    JSON::设置整数(流回放位表, k, 0);
    JSON::设置整数(流有效表, k, 1);
    JSON::设置整数(流带工具表, k, 带工具);
    JSON::设置整数(流续传表, k, 是续传);
    变量 分块: 整数 = JSON::创建数组();
    如果 (命中 == 1 && JSON::是否包含键(磁带, "工具调用") == 1) {
        // 回放工具流：磁带里存着完整的 tool_calls，直接还原成分块形态
        变量 已录: 整数 = JSON::获取数组(磁带, "工具调用");
        变量 t: 整数 = 0;
        当 (t < JSON::数组长度(已录)) {
            变量 调: 整数 = JSON::数组获取对象(已录, t);
            t = t + 1;
            变量 fb: 整数 = JSON::获取对象(调, "function");
            变量 一块: 整数 = JSON::创建对象();
            JSON::设置字符串(一块, "id", JSON::获取字符串(调, "id"));
            JSON::设置字符串(一块, "name", JSON::获取字符串(fb, "name"));
            JSON::设置字符串(一块, "args", JSON::获取字符串(fb, "arguments"));
            JSON::数组添加对象(分块, 一块);
        }
    }
    JSON::设置数组(流工具分块表, k, 分块);
    返回 号;
}

/// 读下一个内容片段。流结束返回空串。
公开 函数 读取流(流: 整数) : 字符串 {
    如果 (流有效(流) == 0) { 返回 ""; }
    变量 k: 字符串 = 流键(流);
    如果 (JSON::获取整数(流完成表, k) == 1) { 返回 ""; }

    // 回放流：直接从录好的块列表里挨个交出
    变量 底层: 整数 = JSON::获取整数(流底层表, k);
    如果 (底层 == 0) {
        变量 块组: 整数 = JSON::获取数组(流回放块表, k);
        变量 位: 整数 = JSON::获取整数(流回放位表, k);
        如果 (位 >= JSON::数组长度(块组)) {
            JSON::设置整数(流完成表, k, 1);
            返回 "";
        }
        变量 片: 字符串 = JSON::数组获取字符串(块组, 位);
        JSON::设置整数(流回放位表, k, 位 + 1);
        JSON::设置字符串(流累计表, k, JSON::获取字符串(流累计表, k) + 片);
        返回 片;
    }

    // 真流：一条 SSE 事件可能不带内容（[DONE]、只有 role 的首块、心跳），
    // 那种要继续读而不是返回空串 —— 空串是「流结束」的信号，提前返回
    // 会让调用方以为答完了，实际才收到第一个 role 块。
    当 (真) {
        如果 (事件流::下一条(底层, 120000) == 1) {
            变量 数据: 字符串 = 事件流::数据(底层);
            如果 (字符串::等于(数据, "[DONE]") == 1) {
                JSON::设置整数(流完成表, k, 1);
                返回 "";
            }
            如果 (JSON::获取整数(流带工具表, k) == 1) { 累积工具分块(k, 数据); }
            变量 片: 字符串 = 取增量(数据);
            如果 (字符串::字节长度(片) > 0) {
                JSON::设置字符串(流累计表, k, JSON::获取字符串(流累计表, k) + 片);
                如果 (JSON::获取整数(流要录表, k) == 1) {
                    变量 录: 整数 = JSON::获取数组(流录制块表, k);
                    JSON::数组添加字符串(录, 片);
                    JSON::设置数组(流录制块表, k, 录);
                }
                返回 片;
            }
            继续;
        }
        如果 (事件流::已结束(底层) == 1) {
            JSON::设置整数(流完成表, k, 1);
            返回 "";
        }
        如果 (事件流::是出错(底层) == 1) {
            输入输出::打印错误行("流式读取失败: " + 事件流::错误(底层));
            JSON::设置整数(流完成表, k, 1);
            返回 "";
        }
        // 超时：继续等。流式回答中间隔几十秒不出字是常态（reasoning 模型），
        // 这里退出会把长思考误判成结束。
    }
    返回 "";
}

// 流式 tool_calls 是**增量**的：第一块给 index/id/name，后续块只往 arguments
// 上拼。不按 index 累积而是每块覆盖的话，arguments 只会剩最后一小片 JSON 碎片，
// 解析出来是空对象 —— 工具照常被调用，参数却全丢，且不报错。
函数 累积工具分块(k: 字符串, 数据: 字符串) {
    变量 v: 整数 = JSON::解码(数据);
    如果 (v == 0) { 返回; }
    变量 选: 整数 = JSON::获取数组(v, "choices");
    如果 (选 == 0) { 返回; }
    如果 (JSON::数组长度(选) == 0) { 返回; }
    变量 增: 整数 = JSON::获取对象(JSON::数组获取对象(选, 0), "delta");
    如果 (增 == 0) { 返回; }
    变量 调组: 整数 = JSON::获取数组(增, "tool_calls");
    如果 (调组 == 0) { 返回; }

    变量 分块: 整数 = JSON::获取数组(流工具分块表, k);
    变量 i: 整数 = 0;
    当 (i < JSON::数组长度(调组)) {
        变量 调: 整数 = JSON::数组获取对象(调组, i);
        i = i + 1;
        变量 序: 整数 = JSON::获取整数(调, "index");
        // 补齐到 序，中间空位用空块占住（模型可以先给 index 1 再给 index 0）
        当 (JSON::数组长度(分块) <= 序) {
            变量 空块: 整数 = JSON::创建对象();
            JSON::设置字符串(空块, "id", "");
            JSON::设置字符串(空块, "name", "");
            JSON::设置字符串(空块, "args", "");
            JSON::数组添加对象(分块, 空块);
        }
        // 没有「改数组第 n 项」的接口，整条重建
        变量 新分块: 整数 = JSON::创建数组();
        变量 j: 整数 = 0;
        当 (j < JSON::数组长度(分块)) {
            变量 旧: 整数 = JSON::数组获取对象(分块, j);
            如果 (j == 序) {
                变量 新块: 整数 = JSON::创建对象();
                变量 旧id: 字符串 = JSON::获取字符串(旧, "id");
                变量 来id: 字符串 = JSON::获取字符串(调, "id");
                如果 (字符串::字节长度(来id) > 0) { 旧id = 来id; }
                JSON::设置字符串(新块, "id", 旧id);

                变量 fb: 整数 = JSON::获取对象(调, "function");
                变量 旧名: 字符串 = JSON::获取字符串(旧, "name");
                变量 旧参: 字符串 = JSON::获取字符串(旧, "args");
                如果 (fb != 0) {
                    变量 来名: 字符串 = JSON::获取字符串(fb, "name");
                    如果 (字符串::字节长度(来名) > 0) { 旧名 = 来名; }
                    旧参 = 旧参 + JSON::获取字符串(fb, "arguments");
                }
                JSON::设置字符串(新块, "name", 旧名);
                JSON::设置字符串(新块, "args", 旧参);
                JSON::数组添加对象(新分块, 新块);
            } 否则 {
                JSON::数组添加对象(新分块, 旧);
            }
            j = j + 1;
        }
        分块 = 新分块;
    }
    JSON::设置数组(流工具分块表, k, 分块);
}

// 分块 → OpenAI 形状的 tool_calls 数组
函数 组装工具调用(k: 字符串) : 整数 {
    变量 出: 整数 = JSON::创建数组();
    变量 分块: 整数 = JSON::获取数组(流工具分块表, k);
    如果 (分块 == 0) { 返回 出; }
    变量 i: 整数 = 0;
    当 (i < JSON::数组长度(分块)) {
        变量 b: 整数 = JSON::数组获取对象(分块, i);
        i = i + 1;
        JSON::数组添加对象(出, 造工具调用(JSON::获取字符串(b, "id"),
            JSON::获取字符串(b, "name"), JSON::获取字符串(b, "args")));
    }
    返回 出;
}

/// 流读完之后取完整 assistant 消息（内容 + tool_calls），供派发工具 / 入历史。
公开 函数 流取助手消息(流: 整数) : 字符串 {
    如果 (流有效(流) == 0) { 返回 ""; }
    变量 k: 字符串 = 流键(流);
    返回 JSON::转字符串(造助手消息(k));
}

函数 造助手消息(k: 字符串) : 整数 {
    变量 消息: 整数 = JSON::创建对象();
    JSON::设置字符串(消息, "role", "assistant");
    变量 累计: 字符串 = JSON::获取字符串(流累计表, k);
    如果 (字符串::字节长度(累计) == 0) {
        JSON::设置对象(消息, "content", JSON::解码("null"));
    } 否则 {
        JSON::设置字符串(消息, "content", 累计);
    }
    变量 调用: 整数 = 组装工具调用(k);
    如果 (JSON::数组长度(调用) > 0) {
        JSON::设置数组(消息, "tool_calls", 调用);
    }
    返回 消息;
}

// 从一条 SSE data 里取 choices[0].delta.content
函数 取增量(数据: 字符串) : 字符串 {
    变量 v: 整数 = JSON::解码(数据);
    如果 (v == 0) { 返回 ""; }
    变量 选: 整数 = JSON::获取数组(v, "choices");
    如果 (选 == 0) { 返回 ""; }
    如果 (JSON::数组长度(选) == 0) { 返回 ""; }
    变量 增: 整数 = JSON::获取对象(JSON::数组获取对象(选, 0), "delta");
    如果 (增 == 0) { 返回 ""; }
    返回 JSON::获取字符串(增, "content");
}

/// 关流：写历史，录制档下把整条流落盘。
公开 函数 关闭流(流: 整数) : 整数 {
    如果 (流有效(流) == 0) { 返回 0 - 1; }
    变量 k: 字符串 = 流键(流);
    变量 底层: 整数 = JSON::获取整数(流底层表, k);
    变量 累计: 字符串 = JSON::获取字符串(流累计表, k);

    // 只在读尽时落盘。半途关流不录，否则磁带里存的是个截断的回答，
    // 之后每次回放都拿到半句话，而且完全看不出是磁带的问题。
    如果 (JSON::获取整数(流要录表, k) == 1 && JSON::获取整数(流完成表, k) == 1) {
        变量 工具文: 字符串 = "";
        如果 (JSON::获取整数(流带工具表, k) == 1) {
            // 工具流一律传数组（哪怕是空的）—— 磁带形状由「是不是工具流」定，
            // 不是由「有没有调用」定，否则两种实现存出不同形状，互放对不上。
            工具文 = JSON::转字符串(组装工具调用(k));
        }
        大模型::流式磁带存(JSON::获取字符串(流请求表, k),
            JSON::转字符串(JSON::获取数组(流录制块表, k)), 工具文);
    }

    如果 (JSON::获取整数(流带工具表, k) == 1) {
        // 工具流：assistant 消息要带 tool_calls，否则后续 continue / 工具结果
        // 对不上是哪个调用。续传流历史里已有 user 消息，不重复写。
        变量 用户文: 字符串 = "";
        如果 (JSON::获取整数(流续传表, k) == 0) {
            变量 用户条: 整数 = JSON::创建对象();
            JSON::设置字符串(用户条, "role", "user");
            JSON::设置字符串(用户条, "content", JSON::获取字符串(流提示表, k));
            用户文 = JSON::转字符串(用户条);
        }
        大模型::落账(JSON::获取整数(流会话表, k), 用户文,
            JSON::转字符串(造助手消息(k)), 0 - 1, 0 - 1, 0 - 1);
    } 否则 {
        // 纯文本流只在有内容时入历史（跟原实现一致：空回答不写）
        如果 (字符串::字节长度(累计) > 0) {
            只写历史(JSON::获取整数(流会话表, k), JSON::获取字符串(流提示表, k), 累计);
        }
    }

    如果 (底层 > 0) { 事件流::关闭(底层); }
    JSON::设置整数(流有效表, k, 0);
    返回 1;
}

// ── 对外：对话多候选 ─────────────────────────────────────────

/// 一次要 n 个候选回答。返回 JSON 数组文本（每个元素一个候选的文本）；
/// 失败返回以「LLM调用失败: 」开头的说明（**不是** JSON 数组，跟原实现一致）。
///
/// 各家差别与计费：
/// - openai 家族：请求体带 "n"，服务端一次采样 n 个，prompt tokens 只计一次。
/// - anthropic / gemini 没有 n 语义 → **串行调 n 次**，各次独立采样，
///   计费等于 n 次完整请求（prompt tokens 也乘 n），耗时线性叠加。
///
/// 历史只能走一条线：**只把第一个候选**作为 assistant 消息入历史，
/// 其余只作返回值。否则历史就分叉了，后续对话不知道接在哪个候选之后。
公开 函数 对话多候选(会话: 整数, 提示: 字符串, 个数: 整数) : 字符串 {
    变量 n: 整数 = 个数;
    如果 (n < 1) { n = 1; }

    变量 视: 整数 = 视图(会话);
    如果 (JSON::是否包含键(视, "模型") == 0) {
        返回 "LLM调用失败: 无效会话句柄";
    }
    变量 提供商: 字符串 = JSON::获取字符串(视, "提供商");

    // 无 n 语义的两家：退化成串行 n 次完整对话。每次都要重新取会话视图 ——
    // 上一轮已经把 user/assistant 写进历史了，不重取的话第二次采样发出去的
    // messages 还是第一次那份，等于把同一个提示问了 n 遍且不带上下文。
    如果 (字符串::等于(提供商, "anthropic") == 1 || 字符串::等于(提供商, "gemini") == 1) {
        变量 出: 整数 = JSON::创建数组();
        变量 i: 整数 = 0;
        当 (i < n) {
            // 历史在这 n 次里**不变**（跟原实现一致），所以视图取一次就够，
            // 而且 n 次请求体完全相同 —— 磁带上是同一个键，回放时 n 次都命中。
            变量 果: 整数 = 一次请求(会话, 视, 提供商, 提示);
            如果 (JSON::获取整数(果, "ok") == 0) {
                返回 "LLM调用失败: " + JSON::获取字符串(果, "错误");
            }
            只记账(会话, 果);
            JSON::数组添加字符串(出, JSON::获取字符串(果, "文本"));
            i = i + 1;
        }
        // 历史最后只写一次，且只写第一个候选
        只写历史(会话, 提示, JSON::数组获取字符串(出, 0));
        返回 JSON::转字符串(出);
    }

    变量 消息: 整数 = 组装消息(视, 提示);
    变量 请求: 整数 = 建请求(会话, 视, 提供商, 消息);
    // n 排在 extra_body 合并**之后** —— 建请求 里已经合过了，顺序即磁带键
    JSON::设置整数(请求, "n", n);

    变量 回: 整数 = JSON::解码(大模型::交换(会话, "chat", JSON::转字符串(请求)));
    如果 (JSON::获取布尔(回, "ok") == 0) {
        返回 "LLM调用失败: " + JSON::获取字符串(回, "error");
    }
    变量 体: 整数 = JSON::获取对象(回, "body");
    变量 候选组: 整数 = JSON::获取数组(体, "choices");
    如果 (JSON::数组长度(候选组) == 0) {
        返回 "LLM调用失败: 响应格式错误：choices 为空";
    }
    变量 出: 整数 = JSON::创建数组();
    变量 i: 整数 = 0;
    当 (i < JSON::数组长度(候选组)) {
        变量 消息体: 整数 = JSON::获取对象(JSON::数组获取对象(候选组, i), "message");
        JSON::数组添加字符串(出, JSON::获取字符串(消息体, "content"));
        i = i + 1;
    }

    变量 用量: 整数 = 取用量(体, 提供商);
    变量 用户条: 整数 = JSON::创建对象();
    JSON::设置字符串(用户条, "role", "user");
    JSON::设置字符串(用户条, "content", 提示);
    变量 助手条: 整数 = JSON::创建对象();
    JSON::设置字符串(助手条, "role", "assistant");
    JSON::设置字符串(助手条, "content", JSON::数组获取字符串(出, 0));
    大模型::落账(会话, JSON::转字符串(用户条), JSON::转字符串(助手条),
        JSON::获取整数(用量, "p"), JSON::获取整数(用量, "c"), JSON::获取整数(用量, "t"));

    返回 JSON::转字符串(出);
}

// ── 对外：嵌入 ───────────────────────────────────────────────

/// 文本嵌入。返回浮点数组；失败返回空数组并往 stderr 说一声
/// （跟原实现一样 —— 嵌入失败返回空向量，静默的话调用方会拿它去算余弦相似度，
/// 得到一堆 0 相似度而不知道是没请求成功）。
///
/// 只读会话：不写历史、不动预算。
公开 函数 嵌入(会话: 整数, 文本: 字符串) : 数组<浮点数> {
    变量 视: 整数 = 视图(会话);
    如果 (JSON::是否包含键(视, "模型") == 0) {
        输入输出::打印错误行("[qi-llm] 嵌入失败: 无效会话句柄 " + 整数转字符串(会话));
        返回 数组<浮点数>(0);
    }
    // 请求体只有 model 和 input 两个键，顺序即磁带键
    变量 请求: 整数 = JSON::创建对象();
    JSON::设置字符串(请求, "model", JSON::获取字符串(视, "模型"));
    JSON::设置字符串(请求, "input", 文本);

    变量 回: 整数 = JSON::解码(大模型::交换(会话, "embed", JSON::转字符串(请求)));
    如果 (JSON::获取布尔(回, "ok") == 0) {
        输入输出::打印错误行("[qi-llm] 嵌入失败: " + JSON::获取字符串(回, "error"));
        返回 数组<浮点数>(0);
    }
    变量 体: 整数 = JSON::获取对象(回, "body");
    变量 数据: 整数 = JSON::获取数组(体, "data");
    如果 (JSON::数组长度(数据) == 0) {
        输入输出::打印错误行("[qi-llm] 嵌入失败: 响应缺少 data[0].embedding");
        返回 数组<浮点数>(0);
    }
    变量 向量: 整数 = JSON::获取数组(JSON::数组获取对象(数据, 0), "embedding");
    变量 n: 整数 = JSON::数组长度(向量);
    变量 出: 数组<浮点数> = 数组<浮点数>(n);
    变量 i: 整数 = 0;
    当 (i < n) {
        出[i] = JSON::数组获取浮点数(向量, i);
        i = i + 1;
    }
    返回 出;
}
