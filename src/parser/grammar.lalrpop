    <vis:Visibility> "枚举" <name:Identifier> <tps:TypeParamsDecl> "{" <variants:Comma<EnumVariantDecl>> "}" <sp_r:@R> => AstNode::枚举声明(EnumDeclaration {
        name,
        type_params: tps,
        variants,
        visibility: vis,
        span: Span::new(sp_l, sp_r),
