use crate::parser::ast::*;
use crate::lexer::tokens::Span;

grammar;

pub Program: Program = {
    <package:PackageDeclaration?> <imports:ImportStatement*> <statements:Statement*> => Program {
        package_name: package,
        imports,
        statements,
        source_span: Default::default(),
    }
};

PackageDeclaration: String = {
    "包" <path:ModulePath> ";" => path.join("."),
    "包" <path:ModulePath> "；" => path.join(".")
};

ImportStatement: ImportStatement = {
    <sp_l:@L> "导入" <path:ModulePath> "::" "{" <items:ImportItemList> "}" ";" <sp_r:@R> => ImportStatement {
        module_path: path,
        items: Some(items),
        alias: None,
        is_public: false,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "导入" <path:ModulePath> "::" "{" <items:ImportItemList> "}" "；" <sp_r:@R> => ImportStatement {
        module_path: path,
        items: Some(items),
        alias: None,
        is_public: false,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "导入" <path:ModulePath> ";" <sp_r:@R> => ImportStatement {
        module_path: path,
        items: None,
        alias: None,
        is_public: false,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "导入" <path:ModulePath> "；" <sp_r:@R> => ImportStatement {
        module_path: path,
        items: None,
        alias: None,
        is_public: false,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "导入" <path:ModulePath> "作为" <alias:Identifier> ";" <sp_r:@R> => ImportStatement {
        module_path: path,
        items: None,
        alias: Some(alias),
        is_public: false,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "导入" <path:ModulePath> "作为" <alias:Identifier> "；" <sp_r:@R> => ImportStatement {
        module_path: path,
        items: None,
        alias: Some(alias),
        is_public: false,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "公开" "导入" <path:ModulePath> ";" <sp_r:@R> => ImportStatement {
        module_path: path,
        items: None,
        alias: None,
        is_public: true,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "公开" "导入" <path:ModulePath> "；" <sp_r:@R> => ImportStatement {
        module_path: path,
        items: None,
        alias: None,
        is_public: true,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "公开" "导入" <path:ModulePath> "::" "{" <items:ImportItemList> "}" ";" <sp_r:@R> => ImportStatement {
        module_path: path,
        items: Some(items),
        alias: None,
        is_public: true,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "公开" "导入" <path:ModulePath> "::" "{" <items:ImportItemList> "}" "；" <sp_r:@R> => ImportStatement {
        module_path: path,
        items: Some(items),
        alias: None,
        is_public: true,
        span: Span::new(sp_l, sp_r),
    },
};

ImportItemList: Vec<String> = {
    <items:Comma<ModuleIdentifier>> => items,
};

ModulePath: Vec<String> = {
    // Relative paths: ./module, ../module, ../../module.submodule
    // Can use either . or / as separator after initial . or ..
    <first:RelativePathStart> <rest:(PathSep <PathComponent>)*> => {
        let mut path = vec![first];
        path.extend(rest);
        path
    },
    // Traditional dot-separated paths: 标准库.io
    <first:ModuleIdentifier> <rest:("." <ModuleIdentifier>)*> => {
        let mut path = vec![first];
        path.extend(rest);
        path
    }
};

RelativePathStart: String = {
    "." => ".".to_string(),
    ".." => "..".to_string(),
};

PathSep: () = {
    "." => (),
    "/" => (),
};

PathComponent: String = {
    "." => ".".to_string(),
    ".." => "..".to_string(),
    <id:ModuleIdentifier> => id,
};

ModuleIdentifier: String = {
    <id:r"[a-zA-Z_][a-zA-Z0-9_\u4e00-\u9fff]*"> => id.to_string(),
    <id:r"[\u4e00-\u9fff][a-zA-Z0-9_\u4e00-\u9fff]*"> => id.to_string(),
    "字符串" => "字符串".to_string(),
    "整数" => "整数".to_string(),
    "长整数" => "长整数".to_string(),
    "短整数" => "短整数".to_string(),
    "字节" => "字节".to_string(),
    "浮点数" => "浮点数".to_string(),
    "布尔" => "布尔".to_string(),
    "字符" => "字符".to_string(),
    "空" => "空".to_string(),
    "数组" => "数组".to_string(),
    "字典" => "字典".to_string(),
    "列表" => "列表".to_string(),
    "集合" => "集合".to_string(),
    "指针" => "指针".to_string(),
    "引用" => "引用".to_string(),
    "可变引用" => "可变引用".to_string(),
};

Statement: AstNode = {
    VariableDeclaration,
    FunctionDeclaration,
    InlineFunctionDeclaration,
    TypeDeclaration,
    EnumDeclaration,
    ExportStatement,
    UnionDeclaration,
    ExternBlock,
    TraitDeclaration,
    ImplementationBlock,
    ReturnStatement,
    BreakStatement,
    ContinueStatement,
    IfStatement,
    WhileStatement,
    ForStatement,
    TryStatement,
    ThrowStatement,
    <sp_l:@L> <e:Expr> ";" <sp_r:@R> => AstNode::表达式语句(ExpressionStatement {
        expression: Box::new(e),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <e:Expr> "；" <sp_r:@R> => AstNode::表达式语句(ExpressionStatement {
        expression: Box::new(e),
        span: Span::new(sp_l, sp_r),
    }),
    // 匹配 statement (like 如果/当: bare block is a statement).
    // Trailing ; optional -- keeps the old `匹配 x {...};` form compatible.
    // NOTE: MatchExpression was moved out of Atom (expression position):
    // keeping it there made `匹配 x {...}` at statement start genuinely
    // ambiguous (reduce-reduce vs Expr ";"). Codegen never produced a value
    // for match-as-expression, so no working program is affected.
    <m:MatchExpression> => m,
    <m:MatchExpression> ";" => m,
    <m:MatchExpression> "；" => m,
    <sp_l:@L> // Select statement must be separate to avoid conflicts with expressions
    "选择" "{" <cases:SelectCaseList> <default_case:DefaultCase?> "}" <sp_r:@R> => {
        // 超时分支以 SelectCase 形式混在 cases 里（情况 超时(ms): …），
        // 在这里分离出来放进 timeout_case，其余仍是普通通道 case。
        let mut chan_cases = Vec::new();
        let mut timeout_case = None;
        for c in cases {
            if matches!(c.kind, SelectCaseKind::超时 { .. }) {
                timeout_case = Some(c);
            } else {
                chan_cases.push(c);
            }
        }
        AstNode::选择表达式(SelectExpression {
            cases: chan_cases,
            default_case,
            timeout_case,
            span: Span::new(sp_l, sp_r),
        })
    },
};

ExportStatement: AstNode = {
    <sp_l:@L> "导出" <_module:Identifier> "::" <_name:Identifier> ";" <sp_r:@R> => AstNode::块语句(BlockStatement {
        statements: vec![],
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "导出" <_module:Identifier> "::" <_name:Identifier> "；" <sp_r:@R> => AstNode::块语句(BlockStatement {
        statements: vec![],
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "导出" <_name:Identifier> ";" <sp_r:@R> => AstNode::块语句(BlockStatement {
        statements: vec![],
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "导出" <_name:Identifier> "；" <sp_r:@R> => AstNode::块语句(BlockStatement {
        statements: vec![],
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> // 反向 FFI：以 C ABI 导出一个 Qi 函数（默认用函数原名当 C 符号）。
    // 复用完整的 FunctionDeclaration 产生式（参数/返回/中英文括号全支持）。
    "导出" <f:FunctionDeclaration> <sp_r:@R> => AstNode::导出函数(ExportFunction {
        c_name: None,
        decl: Box::new(f),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> // 显式 C 符号名：`导出 "qi_add" 函数 ...`（供 Rust/Go 等用干净 ASCII 名链接）。
    "导出" <s:r#""([^"\\]|\\.)*""#> <f:FunctionDeclaration> <sp_r:@R> => AstNode::导出函数(ExportFunction {
        c_name: Some(unescape_string(&s[1..s.len()-1])),
        decl: Box::new(f),
        span: Span::new(sp_l, sp_r),
    }),
};

VariableDeclaration: AstNode = {
    <sp_l:@L> // Uninitialized variable declarations (no = value)
    "变量" <name:Identifier> ":" <type_annotation:Type> ";" <sp_r:@R> => AstNode::变量声明(VariableDeclaration {
        name,
        type_annotation: Some(type_annotation),
        initializer: None,
        is_mutable: true,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "变量" <name:Identifier> "：" <type_annotation:Type> ";" <sp_r:@R> => AstNode::变量声明(VariableDeclaration {
        name,
        type_annotation: Some(type_annotation),
        initializer: None,
        is_mutable: true,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "变量" <name:Identifier> ":" <type_annotation:Type> "；" <sp_r:@R> => AstNode::变量声明(VariableDeclaration {
        name,
        type_annotation: Some(type_annotation),
        initializer: None,
        is_mutable: true,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "变量" <name:Identifier> "：" <type_annotation:Type> "；" <sp_r:@R> => AstNode::变量声明(VariableDeclaration {
        name,
        type_annotation: Some(type_annotation),
        initializer: None,
        is_mutable: true,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "变量" <name:Identifier> ":" <type_annotation:Type> "=" <value:Expr> ";" <sp_r:@R> => AstNode::变量声明(VariableDeclaration {
        name,
        type_annotation: Some(type_annotation),
        initializer: Some(Box::new(value)),
        is_mutable: true,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "变量" <name:Identifier> "：" <type_annotation:Type> "=" <value:Expr> ";" <sp_r:@R> => AstNode::变量声明(VariableDeclaration {
        name,
        type_annotation: Some(type_annotation),
        initializer: Some(Box::new(value)),
        is_mutable: true,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "变量" <name:Identifier> ":" <type_annotation:Type> "=" <value:Expr> "；" <sp_r:@R> => AstNode::变量声明(VariableDeclaration {
        name,
        type_annotation: Some(type_annotation),
        initializer: Some(Box::new(value)),
        is_mutable: true,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "变量" <name:Identifier> "：" <type_annotation:Type> "=" <value:Expr> "；" <sp_r:@R> => AstNode::变量声明(VariableDeclaration {
        name,
        type_annotation: Some(type_annotation),
        initializer: Some(Box::new(value)),
        is_mutable: true,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "变量" <name:Identifier> "=" <value:Expr> ";" <sp_r:@R> => AstNode::变量声明(VariableDeclaration {
        name,
        type_annotation: None,
        initializer: Some(Box::new(value)),
        is_mutable: true,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "变量" <name:Identifier> "=" <value:Expr> "；" <sp_r:@R> => AstNode::变量声明(VariableDeclaration {
        name,
        type_annotation: None,
        initializer: Some(Box::new(value)),
        is_mutable: true,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "常量" <name:Identifier> ":" <type_annotation:Type> "=" <value:Expr> ";" <sp_r:@R> => AstNode::变量声明(VariableDeclaration {
        name,
        type_annotation: Some(type_annotation),
        initializer: Some(Box::new(value)),
        is_mutable: false,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "常量" <name:Identifier> "：" <type_annotation:Type> "=" <value:Expr> ";" <sp_r:@R> => AstNode::变量声明(VariableDeclaration {
        name,
        type_annotation: Some(type_annotation),
        initializer: Some(Box::new(value)),
        is_mutable: false,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "常量" <name:Identifier> ":" <type_annotation:Type> "=" <value:Expr> "；" <sp_r:@R> => AstNode::变量声明(VariableDeclaration {
        name,
        type_annotation: Some(type_annotation),
        initializer: Some(Box::new(value)),
        is_mutable: false,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "常量" <name:Identifier> "：" <type_annotation:Type> "=" <value:Expr> "；" <sp_r:@R> => AstNode::变量声明(VariableDeclaration {
        name,
        type_annotation: Some(type_annotation),
        initializer: Some(Box::new(value)),
        is_mutable: false,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "常量" <name:Identifier> "=" <value:Expr> ";" <sp_r:@R> => AstNode::变量声明(VariableDeclaration {
        name,
        type_annotation: None,
        initializer: Some(Box::new(value)),
        is_mutable: false,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "常量" <name:Identifier> "=" <value:Expr> "；" <sp_r:@R> => AstNode::变量声明(VariableDeclaration {
        name,
        type_annotation: None,
        initializer: Some(Box::new(value)),
        is_mutable: false,
        span: Span::new(sp_l, sp_r),
    }),
};

Visibility: Visibility = {
    "公开" => Visibility::公开,
    => Visibility::私有,  // Default to private if not specified
};

// 泛型类型参数声明：`<T>` / `<T, E>`（函数/枚举/结构体声明名字后可选）。
// 名字任意标识符；个数上限由 codegen 校验（1 或 2）。
TypeParamsDecl: Vec<String> = {
    "<" <tps:Comma<TypeParamDecl>> ">" => tps,
};

// 单个类型参数：`T` 或带特性约束的 `T: 可比较`。
// 约束编码成 "T:可比较" 随 Vec<String> 流转（AST 不变），
// 登记泛型函数模板 时拆开校验；结构体/枚举模板不支持约束（登记处报错）。
TypeParamDecl: String = {
    <n:Identifier> => n,
    <n:Identifier> ":" <b:Identifier> => format!("{}:{}", n, b),
    <n:Identifier> "：" <b:Identifier> => format!("{}:{}", n, b),
};

FunctionDeclaration: AstNode = {
    <sp_l:@L> // 带接收器的函数(方法) - Go 风格
    <vis:Visibility> "函数" "(" <receiver_name:ReceiverIdentifier> <receiver_type:Identifier> ")" <name:Identifier> "(" ")" ":" <return_type:Type> "{" <body:Statement*> "}" <sp_r:@R> => AstNode::方法声明(MethodDeclaration {
        receiver_name,
        receiver_type,
        is_receiver_mutable: false,
        method_name: name,
        parameters: vec![],
        return_type: Some(return_type),
        body,
        visibility: vis,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <vis:Visibility> "函数" "(" <receiver_name:ReceiverIdentifier> <receiver_type:Identifier> ")" <name:Identifier> "(" ")" "{" <body:Statement*> "}" <sp_r:@R> => AstNode::方法声明(MethodDeclaration {
        receiver_name,
        receiver_type,
        is_receiver_mutable: false,
        method_name: name,
        parameters: vec![],
        return_type: None,
        body,
        visibility: vis,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <vis:Visibility> "函数" "(" <receiver_name:ReceiverIdentifier> <receiver_type:Identifier> ")" <name:Identifier> "(" <params:ParameterList> ")" ":" <return_type:Type> "{" <body:Statement*> "}" <sp_r:@R> => AstNode::方法声明(MethodDeclaration {
        receiver_name,
        receiver_type,
        is_receiver_mutable: false,
        method_name: name,
        parameters: params,
        return_type: Some(return_type),
        body,
        visibility: vis,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <vis:Visibility> "函数" "(" <receiver_name:ReceiverIdentifier> <receiver_type:Identifier> ")" <name:Identifier> "(" <params:ParameterList> ")" "{" <body:Statement*> "}" <sp_r:@R> => AstNode::方法声明(MethodDeclaration {
        receiver_name,
        receiver_type,
        is_receiver_mutable: false,
        method_name: name,
        parameters: params,
        return_type: None,
        body,
        visibility: vis,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> // 可变接收器的函数
    <vis:Visibility> "函数" "(" "变量" <receiver_name:ReceiverIdentifier> <receiver_type:Identifier> ")" <name:Identifier> "(" ")" ":" <return_type:Type> "{" <body:Statement*> "}" <sp_r:@R> => AstNode::方法声明(MethodDeclaration {
        receiver_name,
        receiver_type,
        is_receiver_mutable: true,
        method_name: name,
        parameters: vec![],
        return_type: Some(return_type),
        body,
        visibility: vis,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <vis:Visibility> "函数" "(" "变量" <receiver_name:ReceiverIdentifier> <receiver_type:Identifier> ")" <name:Identifier> "(" ")" "{" <body:Statement*> "}" <sp_r:@R> => AstNode::方法声明(MethodDeclaration {
        receiver_name,
        receiver_type,
        is_receiver_mutable: true,
        method_name: name,
        parameters: vec![],
        return_type: None,
        body,
        visibility: vis,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <vis:Visibility> "函数" "(" "变量" <receiver_name:ReceiverIdentifier> <receiver_type:Identifier> ")" <name:Identifier> "(" <params:ParameterList> ")" ":" <return_type:Type> "{" <body:Statement*> "}" <sp_r:@R> => AstNode::方法声明(MethodDeclaration {
        receiver_name,
        receiver_type,
        is_receiver_mutable: true,
        method_name: name,
        parameters: params,
        return_type: Some(return_type),
        body,
        visibility: vis,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <vis:Visibility> "函数" "(" "变量" <receiver_name:ReceiverIdentifier> <receiver_type:Identifier> ")" <name:Identifier> "(" <params:ParameterList> ")" "{" <body:Statement*> "}" <sp_r:@R> => AstNode::方法声明(MethodDeclaration {
        receiver_name,
        receiver_type,
        is_receiver_mutable: true,
        method_name: name,
        parameters: params,
        return_type: None,
        body,
        visibility: vis,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> // 普通函数(无接收器)
    <vis:Visibility> <is_async_kw:"异步"?> "函数" <name:Identifier> <tps:TypeParamsDecl?> "(" ")" ":" <return_type:Type> "{" <body:Statement*> "}" <sp_r:@R> => AstNode::函数声明(FunctionDeclaration {
        name,
        type_params: tps.unwrap_or_default(),
        parameters: vec![],
        return_type: Some(return_type),
        body,
        visibility: vis,
        is_inline: false,
        is_async: is_async_kw.is_some(),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <vis:Visibility> <is_async_kw:"异步"?> "函数" <name:Identifier> <tps:TypeParamsDecl?> "(" ")" "{" <body:Statement*> "}" <sp_r:@R> => AstNode::函数声明(FunctionDeclaration {
        name,
        type_params: tps.unwrap_or_default(),
        parameters: vec![],
        return_type: None,
        body,
        visibility: vis,
        is_inline: false,
        is_async: is_async_kw.is_some(),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <vis:Visibility> <is_async_kw:"异步"?> "函数" <name:Identifier> <tps:TypeParamsDecl?> "(" <params:ParameterList> ")" ":" <return_type:Type> "{" <body:Statement*> "}" <sp_r:@R> => AstNode::函数声明(FunctionDeclaration {
        name,
        type_params: tps.unwrap_or_default(),
        parameters: params,
        return_type: Some(return_type),
        body,
        visibility: vis,
        is_inline: false,
        is_async: is_async_kw.is_some(),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <vis:Visibility> <is_async_kw:"异步"?> "函数" <name:Identifier> <tps:TypeParamsDecl?> "(" <params:ParameterList> ")" "{" <body:Statement*> "}" <sp_r:@R> => AstNode::函数声明(FunctionDeclaration {
        name,
        type_params: tps.unwrap_or_default(),
        parameters: params,
        return_type: None,
        body,
        visibility: vis,
        is_inline: false,
        is_async: is_async_kw.is_some(),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> // 中文标点符号版本
    <vis:Visibility> <is_async_kw:"异步"?> "函数" <name:Identifier> <tps:TypeParamsDecl?> "（" "）" ":" <return_type:Type> "【" <body:Statement*> "】" <sp_r:@R> => AstNode::函数声明(FunctionDeclaration {
        name,
        type_params: tps.unwrap_or_default(),
        parameters: vec![],
        return_type: Some(return_type),
        body,
        visibility: vis,
        is_inline: false,
        is_async: is_async_kw.is_some(),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <vis:Visibility> <is_async_kw:"异步"?> "函数" <name:Identifier> <tps:TypeParamsDecl?> "（" "）" "【" <body:Statement*> "】" <sp_r:@R> => AstNode::函数声明(FunctionDeclaration {
        name,
        type_params: tps.unwrap_or_default(),
        parameters: vec![],
        return_type: None,
        body,
        visibility: vis,
        is_inline: false,
