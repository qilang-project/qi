    <sp_l:@L> <vis:Visibility> "枚举" <name:Identifier> "{" "}" <sp_r:@R> => AstNode::枚举声明(EnumDeclaration {
        name,
        type_params: vec![],
        variants: vec![],
        visibility: vis,
        span: Span::new(sp_l, sp_r),
    }),
};

