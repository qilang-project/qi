Block: Vec<AstNode> = {
    "{" <statements:Statement*> "}" => statements,
    "【" <statements:Statement*> "】" => statements
};

IfStatement: AstNode = {
    IfWithElse,
    IfWithoutElse,
};

// If statements with else (higher precedence to resolve dangling-else)
//
// `否则如果`（else if 链）：语法层直接用连续两个 token `"否则" "如果"` 匹配。
// LALRPOP 内部词法器最大匹配：源码里连写 `否则如果` 与空格分开 `否则 如果`
// 都会被切成 `否则`+`如果` 两个 token（终结符表里没有 `否则如果` 组合词），
// 因此两种写法天然都对。语义上脱糖为 else { if ... } 嵌套（codegen 零改动）。
IfWithElse: AstNode = {
    <sp_l:@L> "如果" <condition:Expr> <then_branch:Block> "否则" <else_branch:Block> <sp_r:@R> => {
        AstNode::如果语句(IfStatement {
            condition: Box::new(condition),
            then_branch,
            else_branch: Some(Box::new(AstNode::块语句(BlockStatement {
                statements: else_branch,
                span: Span::new(sp_l, sp_r),
            }))),
            span: Span::new(sp_l, sp_r),
        })
    },
    <sp_l:@L> "如果" <condition:Expr> <then_branch:Block> "否则" <else_if:IfWithElse> <sp_r:@R> => {
        AstNode::如果语句(IfStatement {
            condition: Box::new(condition),
            then_branch,
            else_branch: Some(Box::new(else_if)),
            span: Span::new(sp_l, sp_r),
        })
    },
};

// If statements without else — 也支持 else-if 链但整条链末尾没有 `否则` 兜底分支。
IfWithoutElse: AstNode = {
    <sp_l:@L> "如果" <condition:Expr> <then_branch:Block> <sp_r:@R> => {
        AstNode::如果语句(IfStatement {
            condition: Box::new(condition),
            then_branch,
            else_branch: None,
            span: Span::new(sp_l, sp_r),
        })
    },
    <sp_l:@L> "如果" <condition:Expr> <then_branch:Block> "否则" <else_if:IfWithoutElse> <sp_r:@R> => {
        AstNode::如果语句(IfStatement {
            condition: Box::new(condition),
            then_branch,
            else_branch: Some(Box::new(else_if)),
            span: Span::new(sp_l, sp_r),
        })
    },
};

WhileStatement: AstNode = {
    <sp_l:@L> "当" <condition:Expr> <body:Block> <sp_r:@R> => AstNode::当语句(WhileStatement {
        condition: Box::new(condition),
        body,
        span: Span::new(sp_l, sp_r),
    }),
};

ForStatement: AstNode = {
    <sp_l:@L> "对于" <variable:Identifier> "在" <range:ForTarget> <body:Block> <sp_r:@R> => AstNode::对于语句(ForStatement {
        variable,
        range: Box::new(range),
        body,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "对于" "(" <variable:Identifier> "在" <range:ForTarget> ")" <body:Block> <sp_r:@R> => AstNode::对于语句(ForStatement {
        variable,
        range: Box::new(range),
        body,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "对于" "（" <variable:Identifier> "在" <range:ForTarget> "）" <body:Block> <sp_r:@R> => AstNode::对于语句(ForStatement {
        variable,
        range: Box::new(range),
        body,
        span: Span::new(sp_l, sp_r),
    }),
};

// 对于 循环目标：普通表达式（数组遍历）或整数区间。
// `起..止` 半开（不含 止，Rust 惯例）；`起 直到 止` 半开（不含 止，中文自然读法，
// 典型 `0 直到 长度(数组)` 取代 `0 到 长度(数组) - 1`）；`起 到 止` 闭区间（含 止）。
ForTarget: AstNode = {
    <e:Expr> => e,
    <sp_l:@L> <start:Expr> ".." <end:Expr> <sp_r:@R> => AstNode::区间表达式(RangeExpression {
        start: Box::new(start),
        end: Box::new(end),
        inclusive: false,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <start:Expr> "直到" <end:Expr> <sp_r:@R> => AstNode::区间表达式(RangeExpression {
        start: Box::new(start),
        end: Box::new(end),
        inclusive: false,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <start:Expr> "到" <end:Expr> <sp_r:@R> => AstNode::区间表达式(RangeExpression {
        start: Box::new(start),
        end: Box::new(end),
        inclusive: true,
        span: Span::new(sp_l, sp_r),
    }),
};

