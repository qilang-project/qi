        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "返回" <value:Expr> "；" <sp_r:@R> => AstNode::返回语句(ReturnStatement {
        value: Some(Box::new(value)),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "返回" ";" <sp_r:@R> => AstNode::返回语句(ReturnStatement {
