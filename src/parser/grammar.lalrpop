    <methods:TraitMethod+> => methods,
};

// 特性方法签名: 函数 名称(参数) : 返回类型;
TraitMethod: TraitMethod = {
    <sp_l:@L> "函数" <name:Identifier> "(" ")" ":" <return_type:Type> ";" <sp_r:@R> => TraitMethod {
        name,
        parameters: vec![],
        return_type: Some(return_type),
        has_default_impl: false,
        default_body: None,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "函数" <name:Identifier> "(" <params:ParameterList> ")" ":" <return_type:Type> ";" <sp_r:@R> => TraitMethod {
        name,
        parameters: params,
        return_type: Some(return_type),
        has_default_impl: false,
        default_body: None,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "函数" <name:Identifier> "(" ")" ";" <sp_r:@R> => TraitMethod {
        name,
        parameters: vec![],
        return_type: None,
        has_default_impl: false,
        default_body: None,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "函数" <name:Identifier> "(" <params:ParameterList> ")" ";" <sp_r:@R> => TraitMethod {
        name,
        parameters: params,
        return_type: None,
        has_default_impl: false,
        default_body: None,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> // ── 带默认实现的特性方法：签名后跟 `{ ... }` 体（实现块未覆盖时按具体类型合成）──
    "函数" <name:Identifier> "(" ")" ":" <return_type:Type> "{" <body:Statement*> "}" <sp_r:@R> => TraitMethod {
        name,
        parameters: vec![],
        return_type: Some(return_type),
        has_default_impl: true,
        default_body: Some(body),
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "函数" <name:Identifier> "(" <params:ParameterList> ")" ":" <return_type:Type> "{" <body:Statement*> "}" <sp_r:@R> => TraitMethod {
        name,
        parameters: params,
        return_type: Some(return_type),
        has_default_impl: true,
        default_body: Some(body),
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "函数" <name:Identifier> "(" ")" "{" <body:Statement*> "}" <sp_r:@R> => TraitMethod {
        name,
        parameters: vec![],
        return_type: None,
        has_default_impl: true,
        default_body: Some(body),
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "函数" <name:Identifier> "(" <params:ParameterList> ")" "{" <body:Statement*> "}" <sp_r:@R> => TraitMethod {
        name,
        parameters: params,
        return_type: None,
        has_default_impl: true,
        default_body: Some(body),
        span: Span::new(sp_l, sp_r),
    },
};

// 外部 C 函数声明块: 外部 "库名" { 函数 名(参数): 类型; ... }
// 库名为空串 "" 表示不额外链接（符号已在，如已链的 libc）。
ExternBlock: AstNode = {
    <sp_l:@L> "外部" <lib:LibName> "{" <fns:ExternFn*> "}" <sp_r:@R> => AstNode::外部声明(ExternBlock {
        library: lib,
        functions: fns,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "外部" <lib:LibName> "【" <fns:ExternFn*> "】" <sp_r:@R> => AstNode::外部声明(ExternBlock {
        library: lib,
        functions: fns,
        span: Span::new(sp_l, sp_r),
    }),
};

// 库名字符串（复用字符串字面量正则，去掉两端引号并反转义）。
LibName: String = {
    <s:r#""([^"\\]|\\.)*""#> => unescape_string(&s[1..s.len()-1]),
};

// 块内单个外部函数签名（无函数体，分号结尾）。
ExternFn: ExternFn = {
    <sp_l:@L> "函数" <name:Identifier> "(" ")" ":" <rt:Type> ExternSemi <sp_r:@R> => ExternFn {
        name, parameters: vec![], return_type: Some(rt), span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "函数" <name:Identifier> "(" <params:ParameterList> ")" ":" <rt:Type> ExternSemi <sp_r:@R> => ExternFn {
        name, parameters: params, return_type: Some(rt), span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "函数" <name:Identifier> "(" ")" ExternSemi <sp_r:@R> => ExternFn {
        name, parameters: vec![], return_type: None, span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "函数" <name:Identifier> "(" <params:ParameterList> ")" ExternSemi <sp_r:@R> => ExternFn {
        name, parameters: params, return_type: None, span: Span::new(sp_l, sp_r),
    },
};

ExternSemi: () = {
    ";" => (),
    "；" => (),
};

// 实现块: 实现 特性 对于 类型 { 方法... } 或 实现 类型 { 方法... }
ImplementationBlock: AstNode = {
    <sp_l:@L> // 实现特性: 实现 特性名 对于 类型名 { ... }
    "实现" <trait_name:Identifier> "对于" <target_type:Identifier> "{" <methods:ImplMethodList> "}" <sp_r:@R> => AstNode::实现块(ImplementationBlock {
        trait_name: Some(trait_name),
        target_type,
        methods,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "实现" <trait_name:Identifier> "对于" <target_type:Identifier> "{" "}" <sp_r:@R> => AstNode::实现块(ImplementationBlock {
        trait_name: Some(trait_name),
        target_type,
        methods: vec![],
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> // 直接实现: 实现 类型名 { ... }
    "实现" <target_type:Identifier> "{" <methods:ImplMethodList> "}" <sp_r:@R> => AstNode::实现块(ImplementationBlock {
        trait_name: None,
        target_type,
        methods,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "实现" <target_type:Identifier> "{" "}" <sp_r:@R> => AstNode::实现块(ImplementationBlock {
        trait_name: None,
        target_type,
        methods: vec![],
        span: Span::new(sp_l, sp_r),
    }),
};

ImplMethodList: Vec<MethodDeclaration> = {
    <methods:ImplMethod+> => methods,
};

// 实现块中的方法
ImplMethod: MethodDeclaration = {
    <sp_l:@L> "函数" <name:Identifier> "(" ")" ":" <return_type:Type> "{" <body:Statement*> "}" <sp_r:@R> => MethodDeclaration {
        receiver_name: "自己".to_string(),
        receiver_type: String::new(),  // Will be filled from context
        is_receiver_mutable: false,
        method_name: name,
        parameters: vec![],
        return_type: Some(return_type),
        body,
        visibility: Visibility::公开,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "函数" <name:Identifier> "(" <params:ParameterList> ")" ":" <return_type:Type> "{" <body:Statement*> "}" <sp_r:@R> => MethodDeclaration {
        receiver_name: "自己".to_string(),
        receiver_type: String::new(),
        is_receiver_mutable: false,
        method_name: name,
        parameters: params,
        return_type: Some(return_type),
        body,
        visibility: Visibility::公开,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "函数" <name:Identifier> "(" ")" "{" <body:Statement*> "}" <sp_r:@R> => MethodDeclaration {
        receiver_name: "自己".to_string(),
        receiver_type: String::new(),
        is_receiver_mutable: false,
        method_name: name,
        parameters: vec![],
        return_type: None,
        body,
        visibility: Visibility::公开,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> "函数" <name:Identifier> "(" <params:ParameterList> ")" "{" <body:Statement*> "}" <sp_r:@R> => MethodDeclaration {
        receiver_name: "自己".to_string(),
        receiver_type: String::new(),
        is_receiver_mutable: false,
        method_name: name,
        parameters: params,
        return_type: None,
        body,
        visibility: Visibility::公开,
        span: Span::new(sp_l, sp_r),
    },
};

StructFieldList: Vec<StructField> = {
    <fields:LegacyStructField+> => fields,
    <fields:SemiSeparated<StructField>> => fields,
    <fields:Comma<StructField>> => fields,
};

// 传统 C 风格字段声明（`整数 计数;`）不支持默认值 —— 默认值一律 None。
LegacyStructField: StructField = {
    <sp_l:@L> <vis:Visibility> <type_annotation:Type> <name:FieldIdentifier> ";" <sp_r:@R> => StructField { name, type_annotation, is_embedded: false, visibility: vis, default: None, span: Span::new(sp_l, sp_r) },
    <sp_l:@L> <vis:Visibility> <type_annotation:Type> <name:FieldIdentifier> "；" <sp_r:@R> => StructField { name, type_annotation, is_embedded: false, visibility: vis, default: None, span: Span::new(sp_l, sp_r) },
};

// 字段声明可选带默认值：`图宽: 整数 = 1200`。默认值语法上收全表达式，
// 语义上仅允许常量字面量（整数/浮点/字符串/布尔），非字面量在 登记结构体名字 报错。
StructField: StructField = {
    <sp_l:@L> <vis:Visibility> <name:FieldIdentifier> ":" <type_annotation:Type> <default:("=" <Expr>)?> <sp_r:@R> => StructField { name, type_annotation, is_embedded: false, visibility: vis, default: default.map(Box::new), span: Span::new(sp_l, sp_r) },
    <sp_l:@L> <vis:Visibility> <name:FieldIdentifier> "：" <type_annotation:Type> <default:("=" <Expr>)?> <sp_r:@R> => StructField { name, type_annotation, is_embedded: false, visibility: vis, default: default.map(Box::new), span: Span::new(sp_l, sp_r) },
};


SelectCaseList: Vec<SelectCase> = {
    <cases:SelectCase+> => cases,
};

SelectCase: SelectCase = {
    <sp_l:@L> // Timeout case: 情况 超时(毫秒): <body>  —— 超时 是关键字 token，先于通道 case 匹配
    "情况" "超时" "(" <ms:Expr> ")" ":" <body:StatementList> <sp_r:@R> => SelectCase {
        kind: SelectCaseKind::超时 {
            毫秒: Box::new(ms),
        },
        body,
        span: Span::new(sp_l, sp_r),
    },

    <sp_l:@L> // Send case must come first: 情况 channel <- value:
    // This has higher priority to avoid ambiguity
    "情况" <channel:ChannelExpr> "<-" <value:Expr> ":" <body:StatementList> <sp_r:@R> => SelectCase {
        kind: SelectCaseKind::通道发送 {
            channel: Box::new(channel),
            value: Box::new(value),
        },
        body,
        span: Span::new(sp_l, sp_r),
    },
    
    <sp_l:@L> // Receive case with variable: 情况 variable := <-channel:
    "情况" <var:Identifier> ":=" "<-" <channel:Expr> ":" <body:StatementList> <sp_r:@R> => SelectCase {
        kind: SelectCaseKind::通道接收 {
            channel: Box::new(channel),
            variable: Some(var),
        },
        body,
        span: Span::new(sp_l, sp_r),
    },
    
    <sp_l:@L> // Receive case without variable: 情况 <-channel:
    "情况" "<-" <channel:Expr> ":" <body:StatementList> <sp_r:@R> => SelectCase {
        kind: SelectCaseKind::通道接收 {
            channel: Box::new(channel),
            variable: None,
        },
        body,
        span: Span::new(sp_l, sp_r),
    },
};

// Channel expression (no arrow operator to avoid conflicts)
ChannelExpr: AstNode = {
    Primary,
};

DefaultCase: SelectCase = {
    <sp_l:@L> "默认" ":" <body:StatementList> <sp_r:@R> => SelectCase {
        kind: SelectCaseKind::默认,
        body,
        span: Span::new(sp_l, sp_r),
    },
};

StatementList: Vec<AstNode> = {
    <stmts:Statement*> => stmts,
};

// Expression hierarchy using tiered approach like Solang
// Each level handles operators of the same precedence
pub Expr: AstNode = {
    Precedence1,
};

// Level 1: Assignment (lowest precedence, right-associative)
// Only Precedence8 (postfix) expressions can be assigned to (identifiers, field access, array subscript)
Precedence1: AstNode = {
    <sp_l:@L> // Compound assignment operators (desugar to binary operation + assignment)
    <left:Precedence8> "+=" <right:Precedence1> <sp_r:@R> => {
        match &left {
            AstNode::标识符表达式(_) | AstNode::字段访问表达式(_) | AstNode::数组访问表达式(_) => {
                AstNode::赋值表达式(AssignmentExpression {
                    target: Box::new(left.clone()),
                    value: Box::new(AstNode::二元操作表达式(BinaryExpression {
                        left: Box::new(left),
                        operator: BinaryOperator::加,
                        right: Box::new(right),
                        span: Span::new(sp_l, sp_r),
                    })),
                    span: Span::new(sp_l, sp_r),
                })
            },
            _ => panic!("Invalid assignment target")
        }
    },
    <sp_l:@L> <left:Precedence8> "-=" <right:Precedence1> <sp_r:@R> => {
        match &left {
            AstNode::标识符表达式(_) | AstNode::字段访问表达式(_) | AstNode::数组访问表达式(_) => {
                AstNode::赋值表达式(AssignmentExpression {
                    target: Box::new(left.clone()),
                    value: Box::new(AstNode::二元操作表达式(BinaryExpression {
                        left: Box::new(left),
                        operator: BinaryOperator::减,
                        right: Box::new(right),
                        span: Span::new(sp_l, sp_r),
                    })),
                    span: Span::new(sp_l, sp_r),
                })
            },
            _ => panic!("Invalid assignment target")
        }
    },
    <sp_l:@L> <left:Precedence8> "*=" <right:Precedence1> <sp_r:@R> => {
        match &left {
            AstNode::标识符表达式(_) | AstNode::字段访问表达式(_) | AstNode::数组访问表达式(_) => {
                AstNode::赋值表达式(AssignmentExpression {
                    target: Box::new(left.clone()),
                    value: Box::new(AstNode::二元操作表达式(BinaryExpression {
                        left: Box::new(left),
                        operator: BinaryOperator::乘,
                        right: Box::new(right),
                        span: Span::new(sp_l, sp_r),
                    })),
                    span: Span::new(sp_l, sp_r),
                })
            },
            _ => panic!("Invalid assignment target")
        }
    },
    <sp_l:@L> <left:Precedence8> "/=" <right:Precedence1> <sp_r:@R> => {
        match &left {
            AstNode::标识符表达式(_) | AstNode::字段访问表达式(_) | AstNode::数组访问表达式(_) => {
                AstNode::赋值表达式(AssignmentExpression {
                    target: Box::new(left.clone()),
                    value: Box::new(AstNode::二元操作表达式(BinaryExpression {
                        left: Box::new(left),
                        operator: BinaryOperator::除,
                        right: Box::new(right),
                        span: Span::new(sp_l, sp_r),
                    })),
                    span: Span::new(sp_l, sp_r),
                })
            },
            _ => panic!("Invalid assignment target")
        }
    },
    <sp_l:@L> <left:Precedence8> "%=" <right:Precedence1> <sp_r:@R> => {
        match &left {
            AstNode::标识符表达式(_) | AstNode::字段访问表达式(_) | AstNode::数组访问表达式(_) => {
                AstNode::赋值表达式(AssignmentExpression {
                    target: Box::new(left.clone()),
                    value: Box::new(AstNode::二元操作表达式(BinaryExpression {
                        left: Box::new(left),
                        operator: BinaryOperator::取余,
                        right: Box::new(right),
                        span: Span::new(sp_l, sp_r),
                    })),
                    span: Span::new(sp_l, sp_r),
                })
            },
            _ => panic!("Invalid assignment target")
        }
    },

    <sp_l:@L> // Regular assignment
    <left:Precedence8> "=" <right:Precedence1> <sp_r:@R> => {
        // Validate that left is a valid LValue
        match &left {
            AstNode::标识符表达式(_) |
            AstNode::字段访问表达式(_) |
            AstNode::数组访问表达式(_) => {
                AstNode::赋值表达式(AssignmentExpression {
                    target: Box::new(left),
                    value: Box::new(right),
                    span: Span::new(sp_l, sp_r),
                })
            },
            _ => panic!("Invalid assignment target: only identifiers, field access, and array subscript are allowed")
        }
    },
    <sp_l:@L> <channel:Precedence8> "<-" <value:Precedence1> <sp_r:@R> => AstNode::通道发送表达式(ChannelSendExpression {
        channel: Box::new(channel),
        value: Box::new(value),
        span: Span::new(sp_l, sp_r),
    }),
    Precedence2,
};

// Level 2: Logical OR
Precedence2: AstNode = {
    <sp_l:@L> <left:Precedence2> "或" <right:Precedence3> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::或,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence2> "||" <right:Precedence3> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::或,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    Precedence3,
};

// Level 3: Logical AND
Precedence3: AstNode = {
    <sp_l:@L> <left:Precedence3> "与" <right:Precedence4> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::与,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence3> "&&" <right:Precedence4> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::与,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> // `且` 是 `与` / `&&` 的等价写法（逻辑与），优先级完全一致。
    <left:Precedence3> "且" <right:Precedence4> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::与,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    Precedence4,
};

// Level 4: Comparison operators
Precedence4: AstNode = {
    <sp_l:@L> <left:Precedence5> "==" <right:Precedence5> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::等于,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence5> "等于" <right:Precedence5> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::等于,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence5> "!=" <right:Precedence5> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::不等于,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence5> "不等于" <right:Precedence5> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::不等于,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence5> ">" <right:Precedence5> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::大于,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence5> "大于" <right:Precedence5> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::大于,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence5> ">=" <right:Precedence5> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::大于等于,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence5> "大于等于" <right:Precedence5> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::大于等于,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence5> "<" <right:Precedence5> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::小于,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence5> "小于" <right:Precedence5> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::小于,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence5> "<=" <right:Precedence5> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::小于等于,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence5> "小于等于" <right:Precedence5> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::小于等于,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    Precedence5,
};

// Level 5: Type conversion (作为)
Precedence5: AstNode = {
    <sp_l:@L> // 转换目标只允许基础类型关键字：TypeKeyworded 里的 函数(...):Type 尾随
    // 完整 Type，`x 作为 函数():T < y` 会让 `<`（比较）与 `T<整数>`（泛型）
    // 真歧义（Local ambiguity）。语义上 作为 也只支持标量转换。
    <expr:Precedence5_5> "作为" <target_type:BasicTypeKeyword> <sp_r:@R> => AstNode::类型转换表达式(TypeCastExpression {
        expression: Box::new(expr),
        target_type,
        span: Span::new(sp_l, sp_r),
    }),
    Precedence5_5,
};

// Level 5.5: Addition and subtraction
Precedence5_5: AstNode = {
    <sp_l:@L> <left:Precedence5_5> "+" <right:Precedence6> <sp_r:@R> => {
        // Check if both operands are strings - if so, create StringConcatExpression
        let is_string_concat = match (&left, &right) {
            (AstNode::字面量表达式(lit_left), AstNode::字面量表达式(lit_right)) => {
                matches!(&lit_left.value, LiteralValue::字符串(_)) &&
                matches!(&lit_right.value, LiteralValue::字符串(_))
            },
            (AstNode::字面量表达式(lit), _) => matches!(&lit.value, LiteralValue::字符串(_)),
            (_, AstNode::字面量表达式(lit)) => matches!(&lit.value, LiteralValue::字符串(_)),
            _ => false,
        };

        if is_string_concat {
            AstNode::字符串连接表达式(StringConcatExpression {
                left: Box::new(left),
                right: Box::new(right),
                span: Span::new(sp_l, sp_r),
            })
        } else {
            AstNode::二元操作表达式(BinaryExpression {
                left: Box::new(left),
                operator: BinaryOperator::加,
                right: Box::new(right),
                span: Span::new(sp_l, sp_r),
            })
        }
    },
    <sp_l:@L> <left:Precedence5_5> "加" <right:Precedence6> <sp_r:@R> => {
        // Check if both operands are strings - if so, create StringConcatExpression
        let is_string_concat = match (&left, &right) {
            (AstNode::字面量表达式(lit_left), AstNode::字面量表达式(lit_right)) => {
                matches!(&lit_left.value, LiteralValue::字符串(_)) &&
                matches!(&lit_right.value, LiteralValue::字符串(_))
            },
            (AstNode::字面量表达式(lit), _) => matches!(&lit.value, LiteralValue::字符串(_)),
            (_, AstNode::字面量表达式(lit)) => matches!(&lit.value, LiteralValue::字符串(_)),
            _ => false,
        };

        if is_string_concat {
            AstNode::字符串连接表达式(StringConcatExpression {
                left: Box::new(left),
                right: Box::new(right),
                span: Span::new(sp_l, sp_r),
            })
        } else {
            AstNode::二元操作表达式(BinaryExpression {
                left: Box::new(left),
                operator: BinaryOperator::加,
                right: Box::new(right),
                span: Span::new(sp_l, sp_r),
            })
        }
    },
    <sp_l:@L> <left:Precedence5_5> "-" <right:Precedence6> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::减,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence5_5> "减" <right:Precedence6> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::减,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> // 位或 / 位异或：Go 风格，与 + - 同层（低于 * / << >> &）
    <left:Precedence5_5> "|" <right:Precedence6> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::位或,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence5_5> "^" <right:Precedence6> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::位异或,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    Precedence6,
};

// Level 6: Multiplication, division, and modulo
Precedence6: AstNode = {
    <sp_l:@L> <left:Precedence6> "*" <right:Precedence7> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::乘,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence6> "乘" <right:Precedence7> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::乘,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence6> "/" <right:Precedence7> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::除,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence6> "除" <right:Precedence7> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::除,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence6> "%" <right:Precedence7> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::取余,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence6> "取余" <right:Precedence7> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::取余,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> // 位移 / 位与：Go 风格，与 * / % 同层（高于 + - | ^）
    <left:Precedence6> "<<" <right:Precedence7> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::左移,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence6> ">>" <right:Precedence7> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::右移,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <left:Precedence6> "&" <right:Precedence7> <sp_r:@R> => AstNode::二元操作表达式(BinaryExpression {
        left: Box::new(left),
        operator: BinaryOperator::位与,
        right: Box::new(right),
        span: Span::new(sp_l, sp_r),
    }),
    Precedence7,
};

// Level 7: Unary operators
Precedence7: AstNode = {
    <sp_l:@L> "等待" <expr:Precedence7> <sp_r:@R> => AstNode::等待表达式(AwaitExpression {
        expression: Box::new(expr),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "启动" <expr:Precedence7> <sp_r:@R> => AstNode::协程启动表达式(GoroutineSpawnExpression {
        expression: Box::new(expr),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "创建通道" "(" <element_type:Type> ")" <sp_r:@R> => AstNode::通道创建表达式(ChannelCreateExpression {
        element_type,
        capacity: None,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "创建通道" "(" <element_type:Type> "," <capacity:Precedence7> ")" <sp_r:@R> => AstNode::通道创建表达式(ChannelCreateExpression {
        element_type,
        capacity: Some(Box::new(capacity)),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "<-" <channel:Precedence7> <sp_r:@R> => AstNode::通道接收表达式(ChannelReceiveExpression {
        channel: Box::new(channel),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "-" <expr:Precedence7> <sp_r:@R> => AstNode::一元操作表达式(UnaryExpression {
        operator: UnaryOperator::负,
        operand: Box::new(expr),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "+" <expr:Precedence7> <sp_r:@R> => AstNode::一元操作表达式(UnaryExpression {
        operator: UnaryOperator::正,
        operand: Box::new(expr),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "!" <expr:Precedence7> <sp_r:@R> => AstNode::一元操作表达式(UnaryExpression {
        operator: UnaryOperator::非,
        operand: Box::new(expr),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "非" <expr:Precedence7> <sp_r:@R> => AstNode::一元操作表达式(UnaryExpression {
        operator: UnaryOperator::非,
        operand: Box::new(expr),
        span: Span::new(sp_l, sp_r),
    }),
    Precedence8,
};

// Level 8: Postfix operators (field access, array subscript, function call)
Precedence8: AstNode = {
    <sp_l:@L> // Special handling for String module static methods since "字符串" is a reserved keyword
    "字符串" "::" <method:MethodIdentifier> "(" <args:ExprList> ")" <sp_r:@R> => {
        let module_ident = AstNode::标识符表达式(IdentifierExpression {
            name: "字符串".to_string(),
            span: Span::new(sp_l, sp_r),
        });
        AstNode::方法调用表达式(MethodCallExpression {
            object: Box::new(module_ident),
            method_name: format!("::{}", method),
            arguments: args,
            span: Span::new(sp_l, sp_r),
        })
    },
    <sp_l:@L> "字符串" "::" <method:MethodIdentifier> "(" ")" <sp_r:@R> => {
        let module_ident = AstNode::标识符表达式(IdentifierExpression {
            name: "字符串".to_string(),
            span: Span::new(sp_l, sp_r),
        });
        AstNode::方法调用表达式(MethodCallExpression {
            object: Box::new(module_ident),
            method_name: format!("::{}", method),
            arguments: vec![],
            span: Span::new(sp_l, sp_r),
        })
    },
    <sp_l:@L> // Special handling for Future static methods since "未来" is a reserved keyword
    "未来" "::" <method:MethodIdentifier> "(" <args:ExprList> ")" <sp_r:@R> => {
        // Future static method call: 未来::就绪(42)
        // Create a fake identifier for "未来" and treat as method call
        let type_ident = AstNode::标识符表达式(IdentifierExpression {
            name: "未来".to_string(),
            span: Span::new(sp_l, sp_r),
        });
        AstNode::方法调用表达式(MethodCallExpression {
            object: Box::new(type_ident),
            method_name: format!("::{}", method),
            arguments: args,
            span: Span::new(sp_l, sp_r),
        })
    },
    <sp_l:@L> "未来" "::" <method:MethodIdentifier> "(" ")" <sp_r:@R> => {
        // Future static method call with no args
        let type_ident = AstNode::标识符表达式(IdentifierExpression {
            name: "未来".to_string(),
            span: Span::new(sp_l, sp_r),
        });
        AstNode::方法调用表达式(MethodCallExpression {
            object: Box::new(type_ident),
            method_name: format!("::{}", method),
            arguments: vec![],
            span: Span::new(sp_l, sp_r),
        })
    },
    // 显式泛型调用（turbofish）：最大::<整数>(3, 5) / 嵌套 最大::<盒装<整数> >(...)
    // 纯 LR(1) 下 `最大<整数>(3,5)` 与比较 `a<b` 单 token 前瞻不可判定（Rust 同因取舍）。
    <sp_l:@L> <callee:Precedence8> "::" "<" <targs:Comma<Type>> ">" "(" <args:ExprList> ")" <sp_r:@R> =>? 泛型调用动作3(callee, targs, args, sp_l, sp_r),
    <sp_l:@L> <callee:Precedence8> "::" "<" <targs:Comma<Type>> ">" "(" ")" <sp_r:@R> =>? 泛型调用动作3(callee, targs, vec![], sp_l, sp_r),
    <sp_l:@L> <callee:Precedence8> "::" "<" <targs:Comma<Type>> ">" "（" <args:ExprList> "）" <sp_r:@R> =>? 泛型调用动作3(callee, targs, args, sp_l, sp_r),
    <sp_l:@L> <callee:Precedence8> "::" "<" <targs:Comma<Type>> ">" "（" "）" <sp_r:@R> =>? 泛型调用动作3(callee, targs, vec![], sp_l, sp_r),
    <sp_l:@L> <base:Precedence8> "::" <method:MethodIdentifier> <sp_r:@R> => {
        // Static method call: Type::method parsed as a field access for now
        // The codegen layer will convert this to the appropriate static method call
        AstNode::字段访问表达式(FieldAccessExpression {
            object: Box::new(base),
            field: format!("::{}",  method),  // Mark as static method with :: prefix
            span: Span::new(sp_l, sp_r),
        })
    },
    <sp_l:@L> <base:Precedence8> "." <field:MemberFieldIdentifier> <sp_r:@R> => {
        AstNode::字段访问表达式(FieldAccessExpression {
            object: Box::new(base),
            field,
            span: Span::new(sp_l, sp_r),
        })
    },
    <sp_l:@L> <array:Precedence8> "[" <index:Expr> "]" <sp_r:@R> => {
        AstNode::数组访问表达式(ArrayAccessExpression {
            array: Box::new(array),
            index: Box::new(index),
            span: Span::new(sp_l, sp_r),
        })
    },
    <sp_l:@L> // 通道类型构造器：通道<类型>() or 通道<类型>(容量)
    <channel_type:ChannelTypeConstructor> "(" ")" <sp_r:@R> => AstNode::通道创建表达式(ChannelCreateExpression {
        element_type: channel_type,
        capacity: None,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <channel_type:ChannelTypeConstructor> "(" <capacity:Expr> ")" <sp_r:@R> => AstNode::通道创建表达式(ChannelCreateExpression {
        element_type: channel_type,
        capacity: Some(Box::new(capacity)),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <channel_type:ChannelTypeConstructor> "（" "）" <sp_r:@R> => AstNode::通道创建表达式(ChannelCreateExpression {
        element_type: channel_type,
        capacity: None,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <channel_type:ChannelTypeConstructor> "（" <capacity:Expr> "）" <sp_r:@R> => AstNode::通道创建表达式(ChannelCreateExpression {
        element_type: channel_type,
        capacity: Some(Box::new(capacity)),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> <callee:Precedence8> "(" <args:ExprList> ")" <sp_r:@R> => {
        match callee {
            AstNode::标识符表达式(ident) => AstNode::函数调用表达式(FunctionCallExpression {
                module_qualifier: None,
                callee: ident.name,
                type_arguments: vec![],
                arguments: args,
                span: Span::new(sp_l, sp_r),
            }),
            AstNode::字段访问表达式(field_access) => {
                // 统一解析为方法调用，让 codegen 层根据上下文区分是模块调用还是方法调用
                AstNode::方法调用表达式(MethodCallExpression {
                    object: field_access.object,
                    method_name: field_access.field,
                    arguments: args,
                    span: Span::new(sp_l, sp_r),
                })
            },
            _ => callee,
        }
    },
    <sp_l:@L> <callee:Precedence8> "(" ")" <sp_r:@R> => {
        match callee {
            AstNode::标识符表达式(ident) => AstNode::函数调用表达式(FunctionCallExpression {
                module_qualifier: None,
                callee: ident.name,
                type_arguments: vec![],
                arguments: vec![],
                span: Span::new(sp_l, sp_r),
            }),
            AstNode::字段访问表达式(field_access) => {
                // 统一解析为方法调用，让 codegen 层根据上下文区分是模块调用还是方法调用
                AstNode::方法调用表达式(MethodCallExpression {
                    object: field_access.object,
                    method_name: field_access.field,
                    arguments: vec![],
                    span: Span::new(sp_l, sp_r),
                })
            },
            _ => callee,
        }
    },
    <sp_l:@L> // 中文括号版本
    <callee:Precedence8> "（" <args:ExprList> "）" <sp_r:@R> => {
        match callee {
            AstNode::标识符表达式(ident) => AstNode::函数调用表达式(FunctionCallExpression {
                module_qualifier: None,
                callee: ident.name,
                type_arguments: vec![],
                arguments: args,
                span: Span::new(sp_l, sp_r),
            }),
            AstNode::字段访问表达式(field_access) => {
                // 统一解析为方法调用，让 codegen 层根据上下文区分是模块调用还是方法调用
                AstNode::方法调用表达式(MethodCallExpression {
                    object: field_access.object,
                    method_name: field_access.field,
                    arguments: args,
                    span: Span::new(sp_l, sp_r),
                })
            },
            _ => callee,
        }
    },
    <sp_l:@L> <callee:Precedence8> "（" "）" <sp_r:@R> => {
        match callee {
            AstNode::标识符表达式(ident) => AstNode::函数调用表达式(FunctionCallExpression {
                module_qualifier: None,
                callee: ident.name,
                type_arguments: vec![],
                arguments: vec![],
                span: Span::new(sp_l, sp_r),
            }),
            AstNode::字段访问表达式(field_access) => {
                // 统一解析为方法调用，让 codegen 层根据上下文区分是模块调用还是方法调用
                AstNode::方法调用表达式(MethodCallExpression {
                    object: field_access.object,
                    method_name: field_access.field,
                    arguments: vec![],
                    span: Span::new(sp_l, sp_r),
                })
            },
            _ => callee,
        }
    },
    UnaryPrefix,
};

// Unary prefix operators: 取地址 (address-of) and 解引用 (dereference)
UnaryPrefix: AstNode = {
    <sp_l:@L> "取地址" <expr:UnaryPrefix> <sp_r:@R> => AstNode::取地址表达式(AddressOfExpression {
        expression: Box::new(expr),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "&" <expr:UnaryPrefix> <sp_r:@R> => AstNode::取地址表达式(AddressOfExpression {
        expression: Box::new(expr),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "解引用" <expr:UnaryPrefix> <sp_r:@R> => AstNode::解引用表达式(DereferenceExpression {
        expression: Box::new(expr),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "*" <expr:UnaryPrefix> <sp_r:@R> => AstNode::解引用表达式(DereferenceExpression {
        expression: Box::new(expr),
        span: Span::new(sp_l, sp_r),
    }),
    Primary,
};

// Primary expressions (literals, identifiers, parenthesized expressions)
// Note: Struct literals are parsed in Atom within parentheses to avoid ambiguity
// with blocks in control flow statements. To use struct literals as expressions,
// Struct literals require parentheses to avoid ambiguity with blocks
// Syntax: (结构体名 { 字段: 值 }) or （结构体名 { 字段: 值 }）
Primary: AstNode = {
    <sp_l:@L> <name:Identifier> <sp_r:@R> => AstNode::标识符表达式(IdentifierExpression {
        name,
        span: Span::new(sp_l, sp_r),
    }),
    Atom,
};

// Atomic expressions - the lowest level
// Struct literals can use: 新建 结构体名 { 字段: 值 } or parentheses for backwards compatibility
Atom: AstNode = {
    BooleanLiteral,
    IntegerLiteral,
    FloatLiteral,
    StringLiteral,
    FormatStringLiteral,
    CharLiteral,
    ArrayLiteral,
    ClosureExpression,
    AsyncBlockExpression,
    // Parenthesized expressions
    "(" <Expr> ")",
    "（" <Expr> "）",
    <sp_l:@L> // Struct literals with 新建 keyword (preferred syntax)
    "新建" <name:Identifier> "{" <fields:StructFieldValueList> "}" <sp_r:@R> => AstNode::结构体实例化表达式(StructLiteralExpression {
        struct_name: name,
        type_arguments: vec![],
        fields,
        spread_base: None,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> // spread 更新：新建 名 { ..基, 字段: 值, … } —— 基后可选跟若干覆写字段。
    // `..` 仅在 ForTarget 位构成区间，普通 Expr 不含 `..`，故此处 `{ ..` 无 LR 冲突。
    "新建" <name:Identifier> "{" ".." <base:Expr> <fields:("," <StructFieldValue>)*> "}" <sp_r:@R> => AstNode::结构体实例化表达式(StructLiteralExpression {
        struct_name: name,
        type_arguments: vec![],
        fields,
        spread_base: Some(Box::new(base)),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> // 泛型结构体字面量（新建 形态）：新建 对<整数> { 左: 1, 右: 2 }
    "新建" <name:Identifier> "<" <targs:Comma<Type>> ">" "{" <fields:StructFieldValueList> "}" <sp_r:@R> => AstNode::结构体实例化表达式(StructLiteralExpression {
        struct_name: name,
        type_arguments: targs,
        fields,
        spread_base: None,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "新建" <name:Identifier> "<" <targs:Comma<Type>> ">" "{" "}" <sp_r:@R> => AstNode::结构体实例化表达式(StructLiteralExpression {
        struct_name: name,
        type_arguments: targs,
        fields: vec![],
        spread_base: None,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "新建" <name:Identifier> "{" "}" <sp_r:@R> => AstNode::结构体实例化表达式(StructLiteralExpression {
        struct_name: name,
        type_arguments: vec![],
        fields: vec![],
        spread_base: None,
        span: Span::new(sp_l, sp_r),
    }),
    // 括号结构体字面量 (名 { ... }) 已删除 —— 统一用 新建 名 { ... }。
    // 删除原因：括号形式语义不直观（看着像普通括号表达式）；新建 一词自带语义。
};

// 闭包表达式: 闭包 [捕获列表]? (参数列表) : 返回类型 { 函数体 }
// 捕获列表用于弱捕获标注：`闭包 [弱 自身] {...}` —— 打破 self.回调=闭包{self} 引用环。
ClosureExpression: AstNode = {
    <sp_l:@L> "闭包" "(" <params:ParameterList> ")" ":" <return_type:Type> <body:Block> <sp_r:@R> => AstNode::闭包表达式(ClosureExpression {
        parameters: params,
        return_type: Some(return_type),
        body,
        captures: vec![],
        weak_captures: vec![],
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "闭包" "(" <params:ParameterList> ")" <body:Block> <sp_r:@R> => AstNode::闭包表达式(ClosureExpression {
        parameters: params,
        return_type: None,
        body,
        captures: vec![],
        weak_captures: vec![],
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "闭包" "(" ")" ":" <return_type:Type> <body:Block> <sp_r:@R> => AstNode::闭包表达式(ClosureExpression {
        parameters: vec![],
        return_type: Some(return_type),
        body,
        captures: vec![],
        weak_captures: vec![],
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "闭包" "(" ")" <body:Block> <sp_r:@R> => AstNode::闭包表达式(ClosureExpression {
        parameters: vec![],
        return_type: None,
        body,
        captures: vec![],
        weak_captures: vec![],
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> // ── 带捕获列表的形式（[弱 x, ...]）──
    "闭包" <caps:CaptureList> "(" <params:ParameterList> ")" ":" <return_type:Type> <body:Block> <sp_r:@R> => AstNode::闭包表达式(ClosureExpression {
        parameters: params,
        return_type: Some(return_type),
        body,
        captures: vec![],
        weak_captures: caps,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "闭包" <caps:CaptureList> "(" <params:ParameterList> ")" <body:Block> <sp_r:@R> => AstNode::闭包表达式(ClosureExpression {
        parameters: params,
        return_type: None,
        body,
        captures: vec![],
        weak_captures: caps,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "闭包" <caps:CaptureList> "(" ")" ":" <return_type:Type> <body:Block> <sp_r:@R> => AstNode::闭包表达式(ClosureExpression {
        parameters: vec![],
        return_type: Some(return_type),
        body,
        captures: vec![],
        weak_captures: caps,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "闭包" <caps:CaptureList> "(" ")" <body:Block> <sp_r:@R> => AstNode::闭包表达式(ClosureExpression {
        parameters: vec![],
        return_type: None,
        body,
        captures: vec![],
        weak_captures: caps,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> // 无参、仅捕获列表：闭包 [弱 按钮] { 按钮.响应(); }
    "闭包" <caps:CaptureList> <body:Block> <sp_r:@R> => AstNode::闭包表达式(ClosureExpression {
        parameters: vec![],
        return_type: None,
        body,
        captures: vec![],
        weak_captures: caps,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> // 简化语法: |参数| 表达式
    // 注意：竖线闭包参数不允许默认值表达式 —— 引入二元 `|`（位或）后，
    // `|x: T = a | b|` 里的 `|` 无法判定是位或还是闭包收尾（真歧义）。
    // 需要默认值请用 闭包(x: 类型 = 默认值) {...} 完整语法。
    "|" <params:BarClosureParamList> "|" <body:Block> <sp_r:@R> => AstNode::闭包表达式(ClosureExpression {
        parameters: params,
        return_type: None,
        body,
        captures: vec![],
        weak_captures: vec![],
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "|" "|" <body:Block> <sp_r:@R> => AstNode::闭包表达式(ClosureExpression {
        parameters: vec![],
        return_type: None,
        body,
        captures: vec![],
        weak_captures: vec![],
        span: Span::new(sp_l, sp_r),
    }),
};

// 闭包捕获列表：`[弱 x, y, 弱 z]` —— 只返回被标注 `弱` 的变量名（弱捕获名单）。
// 未标注 `弱` 的条目允许写出（作显式捕获文档），但不影响自动捕获行为。
CaptureList: Vec<String> = {
    "[" <es:Comma<CaptureEntry>> "]" => es.into_iter().flatten().collect(),
};

CaptureEntry: Option<String> = {
    "弱" <name:FieldIdentifier> => Some(name),
    <name:FieldIdentifier> => None,
};

// 竖线闭包专用参数表：仅 名字 / 名字:类型，无默认值、无变参
BarClosureParamList: Vec<Parameter> = {
    <params:Comma<BarClosureParameter>> => params,
};

BarClosureParameter: Parameter = {
    <sp_l:@L> <name:FieldIdentifier> ":" <type_annotation:Type> <sp_r:@R> => Parameter {
        name,
        type_annotation: Some(type_annotation),
        default_value: None,
        is_variadic: false,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> <name:FieldIdentifier> "：" <type_annotation:Type> <sp_r:@R> => Parameter {
        name,
        type_annotation: Some(type_annotation),
        default_value: None,
        is_variadic: false,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> <name:Identifier> <sp_r:@R> => Parameter {
        name,
        type_annotation: None,
        default_value: None,
        is_variadic: false,
        span: Span::new(sp_l, sp_r),
    },
};

// 匹配表达式: 匹配 值 { 分支... }
MatchExpression: AstNode = {
    <sp_l:@L> "匹配" <value:Expr> "{" <arms:MatchArmList> "}" <sp_r:@R> => AstNode::匹配表达式(MatchExpression {
        value: Box::new(value),
        arms,
        span: Span::new(sp_l, sp_r),
    }),
};

MatchArmList: Vec<MatchArm> = {
    <arms:MatchArm+> => arms,
};

MatchArm: MatchArm = {
    <sp_l:@L> // 模式 => { 语句块 }
    <pattern:MatchPattern> "=>" <body:Block> <sp_r:@R> => MatchArm {
        pattern,
        guard: None,
        body,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> // 模式 如果 守卫条件 => { 语句块 }
    <pattern:MatchPattern> "如果" <guard:Expr> "=>" <body:Block> <sp_r:@R> => MatchArm {
        pattern,
        guard: Some(Box::new(guard)),
        body,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> // 模式 => 表达式;
    <pattern:MatchPattern> "=>" <expr:Expr> ";" <sp_r:@R> => MatchArm {
        pattern,
        guard: None,
        body: vec![AstNode::表达式语句(ExpressionStatement {
            expression: Box::new(expr),
            span: Span::new(sp_l, sp_r),
        })],
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> // 模式 => 表达式；
    <pattern:MatchPattern> "=>" <expr:Expr> "；" <sp_r:@R> => MatchArm {
        pattern,
        guard: None,
        body: vec![AstNode::表达式语句(ExpressionStatement {
            expression: Box::new(expr),
            span: Span::new(sp_l, sp_r),
        })],
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> // 模式 => 表达式,
    <pattern:MatchPattern> "=>" <expr:Expr> "," <sp_r:@R> => MatchArm {
        pattern,
        guard: None,
        body: vec![AstNode::表达式语句(ExpressionStatement {
            expression: Box::new(expr),
            span: Span::new(sp_l, sp_r),
        })],
        span: Span::new(sp_l, sp_r),
    },
};

MatchPattern: MatchPattern = {
    // 简单模式（通配符、字面量、变量绑定）
    MatchPatternAtom,
    // 或模式: 模式1 | 模式2
    <first:MatchPatternAtom> "|" <rest:MatchPatternOrList> => {
        let mut patterns = vec![first];
        patterns.extend(rest);
        MatchPattern::或模式(patterns)
    },
};

MatchPatternAtom: MatchPattern = {
    "_" => MatchPattern::通配符,
    <n:r"[0-9]+"> => MatchPattern::字面量(LiteralValue::整数(n.parse().unwrap())),
    <n:r"[0-9]+\.[0-9]+"> => MatchPattern::字面量(LiteralValue::浮点数(n.parse().unwrap())),
    <s:r#""([^"\\]|\\.)*""#> => MatchPattern::字面量(LiteralValue::字符串(unescape_string(&s[1..s.len()-1]))),
    "真" => MatchPattern::字面量(LiteralValue::布尔(true)),
    "假" => MatchPattern::字面量(LiteralValue::布尔(false)),
    // 枚举变体解构：`圆(半径)` / `矩形(宽, 高)`（无载荷变体 `点` 走下面的裸标识符，
    // codegen 据 scrutinee 是枚举类型把裸名当变体名解析）。
    <name:Identifier> "(" <bindings:Comma<MatchPatternAtom>> ")" => MatchPattern::枚举变体模式 {
        enum_name: None,
        variant_name: name,
        bindings,
    },
    <name:Identifier> => MatchPattern::变量绑定(name),
};

MatchPatternOrList: Vec<MatchPattern> = {
    <first:MatchPatternAtom> => vec![first],
    <first:MatchPatternAtom> "|" <rest:MatchPatternOrList> => {
        let mut patterns = vec![first];
        patterns.extend(rest);
        patterns
    },
};

// 异步块表达式: 异步块 { ... }
// 注：以前是 异步 { ... }，但跟 异步 函数 X(...) 函数前缀冲突。改 异步块 完全消歧。
AsyncBlockExpression: AstNode = {
    <sp_l:@L> "异步块" <body:Block> <sp_r:@R> => AstNode::异步块表达式(AsyncBlockExpression {
        body,
        span: Span::new(sp_l, sp_r),
    }),
};

BooleanLiteral: AstNode = {
    <sp_l:@L> "真" <sp_r:@R> => AstNode::字面量表达式(LiteralExpression {
        value: LiteralValue::布尔(true),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "假" <sp_r:@R> => AstNode::字面量表达式(LiteralExpression {
        value: LiteralValue::布尔(false),
        span: Span::new(sp_l, sp_r),
    }),
};

IntegerLiteral: AstNode = {
    <sp_l:@L> <n:r"[0-9]+"> <sp_r:@R> => AstNode::字面量表达式(LiteralExpression {
        value: LiteralValue::整数(n.parse().unwrap()),
        span: Span::new(sp_l, sp_r),
    }),
};

FloatLiteral: AstNode = {
    <sp_l:@L> <n:r"[0-9]+\.[0-9]+"> <sp_r:@R> => AstNode::字面量表达式(LiteralExpression {
        value: LiteralValue::浮点数(n.parse().unwrap()),
        span: Span::new(sp_l, sp_r),
    }),
};

StringLiteral: AstNode = {
    <sp_l:@L> <s:r#""([^"\\]|\\.)*""#> <sp_r:@R> => AstNode::字面量表达式(LiteralExpression {
        value: LiteralValue::字符串(unescape_string(&s[1..s.len()-1])),
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> // 原始字符串字面量：反引号包裹，内部**不做转义**，" 直接写、可跨行。
    // 用于内嵌 JSON / 正则 / Windows 路径 / 模板，免去满屏 \"。
    <s:r#"`[^`]*`"#> <sp_r:@R> => AstNode::字面量表达式(LiteralExpression {
        value: LiteralValue::字符串(s[1..s.len()-1].to_string()),
        span: Span::new(sp_l, sp_r),
    }),
};

// Format string literal: f"text {expression} more text"
// The regex matches f"..." with escape sequences and interpolation expressions
FormatStringLiteral: AstNode = {
    <sp_l:@L> <s:r#"f"([^"\\]|\\.|\{[^}]*\})*""#> <sp_r:@R> => {
        let mut node = parse_format_string(&s[2..s.len()-1]);
        if let AstNode::格式字符串表达式(ref mut f) = node {
            f.span = Span::new(sp_l, sp_r);
        }
        node
    }
};

CharLiteral: AstNode = {
    <sp_l:@L> // 支持普通字符 'A' 与转义字符 '\n' '\t' '\r' '\\' '\'' '\"' '\0'
    <c:r"'([^\\']|\\.)'"> <sp_r:@R> => AstNode::字面量表达式(LiteralExpression {
        value: LiteralValue::字符(unescape_string(&c[1..c.len()-1]).chars().next().unwrap_or('\0')),
        span: Span::new(sp_l, sp_r),
    }),
};

ArrayLiteral: AstNode = {
    <sp_l:@L> "[" <elements:ExprList> "]" <sp_r:@R> => AstNode::数组字面量表达式(ArrayLiteralExpression {
        elements,
        span: Span::new(sp_l, sp_r),
    }),
    <sp_l:@L> "[" "]" <sp_r:@R> => AstNode::数组字面量表达式(ArrayLiteralExpression {
        elements: vec![],
        span: Span::new(sp_l, sp_r),
    }),
};


StructFieldValueList: Vec<StructFieldValue> = {
    <fields:Comma<StructFieldValue>> => fields,
};

StructFieldValue: StructFieldValue = {
    <sp_l:@L> <name:FieldIdentifier> ":" <value:Expr> <sp_r:@R> => StructFieldValue {
        name,
        value: Box::new(value),
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> <name:FieldIdentifier> "：" <value:Expr> <sp_r:@R> => StructFieldValue {
        name,
        value: Box::new(value),
        span: Span::new(sp_l, sp_r),
    },
};

ParameterWithVariadic: Vec<ParameterWithVariadic> = {
    <sp_l:@L> <params:Comma<Parameter>> <sp_r:@R> => {
        // Convert all parameters to ParameterWithVariadic
        let len = params.len();
        params.into_iter().enumerate().map(|(i, p)| {
            // Last parameter is variadic
            let is_variadic = i == len - 1;
            ParameterWithVariadic {
                name: p.name,
                type_annotation: p.type_annotation,
                default_value: p.default_value,
                is_variadic,
                span: Span::new(sp_l, sp_r),
            }
        }).collect()
    }
};

// ParameterList is an alias for Comma<Parameter>
ParameterList: Vec<Parameter> = {
    <params:Comma<Parameter>> => params,
};

Parameter: Parameter = {
    <sp_l:@L> // Fix syntax - use proper colon token
    <name:FieldIdentifier> ":" <type_annotation:Type> <sp_r:@R> => Parameter {
        name,
        type_annotation: Some(type_annotation),
        default_value: None,
        is_variadic: false,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> <name:FieldIdentifier> ":" <type_annotation:Type> "=" <default_value:Expr> <sp_r:@R> => Parameter {
        name,
        type_annotation: Some(type_annotation),
        default_value: Some(Box::new(default_value)),
        is_variadic: false,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> <name:FieldIdentifier> "：" <type_annotation:Type> <sp_r:@R> => Parameter {
        name,
        type_annotation: Some(type_annotation),
        default_value: None,
        is_variadic: false,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> <name:FieldIdentifier> "：" <type_annotation:Type> "=" <default_value:Expr> <sp_r:@R> => Parameter {
        name,
        type_annotation: Some(type_annotation),
        default_value: Some(Box::new(default_value)),
        is_variadic: false,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> <name:FieldIdentifier> "..." ":" <type_annotation:Type> <sp_r:@R> => Parameter {
        name,
        type_annotation: Some(type_annotation),
        default_value: None,
        is_variadic: true,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> <name:FieldIdentifier> "..." "：" <type_annotation:Type> <sp_r:@R> => Parameter {
        name,
        type_annotation: Some(type_annotation),
        default_value: None,
        is_variadic: true,
        span: Span::new(sp_l, sp_r),
    },
    <sp_l:@L> <name:Identifier> <sp_r:@R> => Parameter {
        name,
        type_annotation: None,
        default_value: None,
        is_variadic: false,
        span: Span::new(sp_l, sp_r),
    },
};

// Helper macro for comma-separated lists
Comma<T>: Vec<T> = {
    <first:T> => vec![first],
    <first:T> "," => vec![first],
    <first:T> "," <rest:Comma<T>> => {
        let mut rest = rest;
        rest.insert(0, first);
        rest
    },
    <first:T> "，" => vec![first],
    <first:T> "，" <rest:Comma<T>> => {
        let mut rest = rest;
        rest.insert(0, first);
        rest
    },
};

// Helper macro for semicolon-separated lists
SemiSeparated<T>: Vec<T> = {
    <first:T> ";" => vec![first],
    <first:T> ";" <rest:SemiSeparated<T>> => {
        let mut rest = rest;
        rest.insert(0, first);
        rest
    },
    <first:T> "；" => vec![first],
    <first:T> "；" <rest:SemiSeparated<T>> => {
        let mut rest = rest;
        rest.insert(0, first);
        rest
    }
};

ExprList: Vec<AstNode> = {
    <exprs:Comma<Expr>> => exprs,
};

// Type = 关键字类型 | 裸自定义类型名 | 泛型用户类型（对<整数> / 盒装<字符串> …）。
// `作为` 的转换目标只允许关键字类型（TypeKeyworded）：若允许裸 TypeName，
// `x 作为 T < y`（比较）会把 `<` 注入 TypeName 归约的 FOLLOW，与
// GenericUserType 的 `TypeName . "<"` 移进在 LR 表里相撞。
// （编译器本就只支持基础类型转换；自定义类型 cast 无语义。）
Type: TypeNode = {
    TypeKeyworded,
    <name:TypeName> => TypeNode::自定义类型(name),
    GenericUserType,
};

// 泛型用户类型：名字<类型实参, ...>（嵌套请写 `盒装<对<整数> >`，`>>` 是右移记号）
GenericUserType: TypeNode = {
    <name:TypeName> "<" <args:Comma<Type>> ">" => TypeNode::泛型类型(GenericType {
        base_type: name,
        type_arguments: args,
    }),
};

// 关键字开头的类型（函数/容器/基础/内建泛型），供 Type 与 `作为` 共用
TypeKeyworded: TypeNode = {
    "函数" "(" ")" ":" <return_type:Type> => TypeNode::函数类型(FunctionType {
        parameters: vec![],
        return_type: Box::new(return_type),
    }),
    "函数" "(" ")" "：" <return_type:Type> => TypeNode::函数类型(FunctionType {
        parameters: vec![],
        return_type: Box::new(return_type),
    }),
    "函数" "(" <params:FunctionTypeParameterList> ")" ":" <return_type:Type> => TypeNode::函数类型(FunctionType {
        parameters: params,
        return_type: Box::new(return_type),
    }),
    "函数" "(" <params:FunctionTypeParameterList> ")" "：" <return_type:Type> => TypeNode::函数类型(FunctionType {
        parameters: params,
        return_type: Box::new(return_type),
    }),
    // 容器类型 - 使用特殊语法避免冲突
    "数组" "<" <element_type:Type> ">" => TypeNode::数组类型(ArrayType {
        element_type: Box::new(element_type),
        size: None,
    }),
    "字典" "<" <key_type:Type> "," <value_type:Type> ">" => TypeNode::字典类型(DictionaryType {
        key_type: Box::new(key_type),
        value_type: Box::new(value_type),
    }),
    "列表" "<" <element_type:Type> ">" => TypeNode::列表类型(ListType {
        element_type: Box::new(element_type),
    }),
    "通道" "<" <element_type:Type> ">" => TypeNode::通道类型(ChannelType {
        element_type: Box::new(element_type),
    }),
    "集合" "<" <element_type:Type> ">" => TypeNode::集合类型(SetType {
        element_type: Box::new(element_type),
    }),

    // 未来类型 (Future type for async operations)
    "未来" "<" <inner_type:Type> ">" => TypeNode::未来类型(Box::new(inner_type)),

    // 结果类型 (Result type for error handling)
    "结果" "<" <ok_type:Type> "," <err_type:Type> ">" => TypeNode::结果类型(ResultType {
        ok_type: Box::new(ok_type),
        err_type: Box::new(err_type),
    }),

    // 结果<T> 单参形式（错误类型固定为字符串，v1 务实）
    "结果" "<" <ok_type:Type> ">" => TypeNode::结果类型(ResultType {
        ok_type: Box::new(ok_type),
        err_type: Box::new(TypeNode::基础类型(BasicType::字符串)),
    }),

    // 选项类型 (Option type for nullable values)
    "选项" "<" <inner_type:Type> ">" => TypeNode::选项类型(OptionType {
        inner_type: Box::new(inner_type),
    }),

    // 指针和引用类型
    // 裸 `指针` = 不透明 C void*（C FFI 句柄：malloc/free/上下文指针）。
    "指针" => TypeNode::基础类型(BasicType::指针),
    "指针" "<" <target_type:Type> ">" => TypeNode::指针类型(PointerType {
        target_type: Box::new(target_type),
    }),
    "引用" "<" <target_type:Type> ">" => TypeNode::引用类型(ReferenceType {
        target_type: Box::new(target_type),
        is_mutable: false,
    }),
    "可变引用" "<" <target_type:Type> ">" => TypeNode::引用类型(ReferenceType {
        target_type: Box::new(target_type),
        is_mutable: true,
    }),

    // 基础类型 - 使用关键字而不是标识符
    BasicTypeKeyword,
};

FunctionTypeParameterList: Vec<TypeNode> = {
    <params:Comma<Type>> => params,
};

// 用于类型名称的标识符，避免与其他Identifier冲突
TypeName: String = {
    <id:r"[a-zA-Z_][a-zA-Z0-9_\u4e00-\u9fff]*"> => id.to_string(),
    <id:r"[\u4e00-\u9fff][a-zA-Z0-9_\u4e00-\u9fff]*"> =>? {
        // Simplified check - use individual checks to avoid long match patterns
        if id == "变量" || id == "常量" || id == "函数" || id == "异步" || id == "返回" ||
           id == "如果" || id == "否则" || id == "当" || id == "对于" || id == "在" || id == "真" || id == "假" ||
           id == "等待" || id == "循环" || id == "包" || id == "导入" || id == "导出" || id == "作为" ||
           id == "公开" || id == "私有" || id == "模块" || id == "自己" ||
           id == "结构体" || id == "枚举" || id == "实现" || id == "特性" || id == "弱" ||
           id == "等于" || id == "不等于" || id == "大于" || id == "小于" || id == "大于等于" || id == "小于等于" ||
           id == "取余" || id == "加" || id == "减" || id == "乘" || id == "除" {
            return Err(lalrpop_util::ParseError::User {
                error: Box::leak(format!("「{id}」是奇语保留关键字，不能用作类型名。请换一个名字。").into_boxed_str()),
            });
        }
        Ok(id.to_string())
    }
};

// 基础类型关键字解析
BasicTypeKeyword: TypeNode = {
    "整数" => TypeNode::基础类型(BasicType::整数),
    "长整数" => TypeNode::基础类型(BasicType::长整数),
    "短整数" => TypeNode::基础类型(BasicType::短整数),
    "字节" => TypeNode::基础类型(BasicType::字节),
    "浮点数" => TypeNode::基础类型(BasicType::浮点数),
    "布尔" => TypeNode::基础类型(BasicType::布尔),
    "字符" => TypeNode::基础类型(BasicType::字符),
    "字符串" => TypeNode::基础类型(BasicType::字符串),
    "空" => TypeNode::基础类型(BasicType::空),
};

Identifier: String = {
    <id:r"[a-zA-Z_][a-zA-Z0-9_\u4e00-\u9fff]*"> => id.to_string(),
    "长度" => "长度".to_string(),
    <id:r"[\u4e00-\u9fff][a-zA-Z0-9_\u4e00-\u9fff]*"> =>? {
        // Check if it's a forbidden keyword using individual checks
        // Note: 自身, 自己, 自我 are allowed as they are used for method receivers
        if id == "变量" || id == "常量" || id == "函数" || id == "异步" || id == "返回" ||
           id == "如果" || id == "否则" || id == "当" || id == "对于" || id == "在" || id == "真" || id == "假" ||
           id == "等待" || id == "循环" || id == "中断" || id == "继续" || id == "匹配" || id == "跳转" ||
           id == "抛出" || id == "捕获" || id == "尝试" || id == "选项" || id == "结果" ||
           id == "拥有" || id == "借用" || id == "移动" || id == "克隆" || id == "释放" || id == "新建" ||
           id == "并行" || id == "并发" || id == "启动" || id == "线程" || id == "锁" || id == "原子" ||
           id == "通道" || id == "选择" || id == "情况" || id == "未来" ||
           id == "包" || id == "导入" ||
           id == "导出" || id == "作为" || id == "公开" || id == "私有" || id == "模块" ||
           id == "结构体" || id == "枚举" || id == "内联" || id == "最终" || id == "默认" ||
           id == "联合体" || id == "实现" || id == "特性" || id == "主程序入口" || id == "弱" ||
           id == "等于" || id == "不等于" || id == "大于" || id == "小于" || id == "大于等于" || id == "小于等于" ||
           id == "取余" || id == "加" || id == "减" || id == "乘" || id == "除" ||
           id == "列表" || id == "字典" || id == "集合" || id == "数组" ||
           id == "整数" || id == "长整数" || id == "短整数" || id == "字节" || id == "浮点数" ||
           id == "布尔" || id == "字符" || id == "字符串" || id == "空" ||
           id == "指针" || id == "引用" || id == "可变引用" {
            // 关键字不能当标识符：返回带关键字名的友好解析错误，而不是 panic 崩溃。
            return Err(lalrpop_util::ParseError::User {
                error: Box::leak(format!("「{id}」是奇语保留关键字，不能用作标识符（变量名 / 函数名 / 字段名）。请换一个名字，例如加后缀：`任务` → `任务甲`、`数组` → `数列`。").into_boxed_str()),
            });
        }
        Ok(id.to_string())
    },
};

// 方法接收者标识符 - 允许使用 "自身"、"自己" 等关键字
ReceiverIdentifier: String = {
    <id:r"[a-zA-Z_][a-zA-Z0-9_\u4e00-\u9fff]*"> => id.to_string(),
    <id:r"[\u4e00-\u9fff][a-zA-Z0-9_\u4e00-\u9fff]*"> =>? {
        // Allow 自身, 自己, 自我 as receiver names
        // Still forbid other keywords
        if id == "变量" || id == "常量" || id == "函数" || id == "异步" || id == "返回" ||
           id == "如果" || id == "否则" || id == "当" || id == "对于" || id == "在" || id == "真" || id == "假" ||
           id == "等待" || id == "循环" || id == "中断" || id == "继续" || id == "匹配" || id == "跳转" ||
           id == "抛出" || id == "捕获" || id == "尝试" || id == "选项" || id == "结果" ||
           id == "拥有" || id == "借用" || id == "移动" || id == "克隆" || id == "释放" || id == "新建" ||
           id == "并行" || id == "并发" || id == "启动" || id == "线程" || id == "锁" || id == "原子" ||
           id == "通道" || id == "选择" || id == "情况" || id == "未来" ||
           id == "包" || id == "导入" ||
           id == "导出" || id == "作为" || id == "公开" || id == "私有" || id == "模块" ||
           id == "结构体" || id == "枚举" || id == "内联" || id == "最终" || id == "默认" ||
           id == "联合体" || id == "实现" || id == "特性" || id == "主程序入口" || id == "弱" ||
           id == "等于" || id == "不等于" || id == "大于" || id == "小于" || id == "大于等于" || id == "小于等于" ||
           id == "取余" || id == "加" || id == "减" || id == "乘" || id == "除" ||
           id == "列表" || id == "字典" || id == "集合" || id == "数组" ||
           id == "整数" || id == "长整数" || id == "短整数" || id == "字节" || id == "浮点数" ||
           id == "布尔" || id == "字符" || id == "字符串" || id == "空" ||
           id == "指针" || id == "引用" || id == "可变引用" {
            return Err(lalrpop_util::ParseError::User {
                error: Box::leak(format!("「{id}」是奇语保留关键字，不能用作方法接收者名。请换一个名字（如 `自身`、`自己`）。").into_boxed_str()),
            });
        }
        Ok(id.to_string())
    },
};


IdentifierExpression: AstNode = {
    <sp_l:@L> <name:Identifier> <sp_r:@R> => AstNode::标识符表达式(IdentifierExpression {
        name,
        span: Span::new(sp_l, sp_r),
    }),
};

// FieldIdentifier allows certain keyword tokens to be used as struct field names
// e.g. "类型", "通道" are reserved words but commonly used as field names in qi-web
FieldIdentifier: String = {
    <id:Identifier> => id,
    "类型" => "类型".to_string(),
    "通道" => "通道".to_string(),
    "结果" => "结果".to_string(),
    "选项" => "选项".to_string(),
    "继续" => "继续".to_string(),
    "匹配" => "匹配".to_string(),
    // 常用名词类保留字松绑：在字段名 / 形参名等安全位置放行为普通名字，
    // 关键字在类型 / 语句位置的本职用法不受影响（列表<T>、数组<T>、默认分支、最终块）。
    "列表" => "列表".to_string(),
    "数组" => "数组".to_string(),
    "默认" => "默认".to_string(),
    "最终" => "最终".to_string(),
};

// MethodIdentifier allows keyword tokens to be used as method names after ::
MethodIdentifier: String = {
    <id:Identifier> => id,
    "等于" => "等于".to_string(),
    "不等于" => "不等于".to_string(),
    "大于" => "大于".to_string(),
    "小于" => "小于".to_string(),
};

// MemberFieldIdentifier: 用于 `对象.成员` 的成员名位置。
// 标准库注册表里存在与关键字撞名的函数（如 文本.等于、向量.加、HTTP.选项），
// 在成员位置放行这些关键字作为普通名字；关键字在表达式/类型位置的本职用法不受影响。
MemberFieldIdentifier: String = {
    <id:FieldIdentifier> => id,
    "等于" => "等于".to_string(),
    "不等于" => "不等于".to_string(),
    "大于" => "大于".to_string(),
    "小于" => "小于".to_string(),
    "大于等于" => "大于等于".to_string(),
    "小于等于" => "小于等于".to_string(),
    "加" => "加".to_string(),
    "减" => "减".to_string(),
    "乘" => "乘".to_string(),
    "除" => "除".to_string(),
    "取余" => "取余".to_string(),
    // 注：选项 已由 FieldIdentifier 放行（HTTP.选项 走那条），这里不重复
};

ChannelTypeConstructor: TypeNode = {
    "通道" "<" <element_type:Type> ">" => TypeNode::通道类型(ChannelType {
        element_type: Box::new(element_type),
    }),
};
