// 容器化模板的示例应用：一个最小的 HTTP 服务。
//
// 只用标准库和 Web 包，没有别的依赖 —— 目的是把「容器怎么跑起来」这件事
// 单独验清楚，而不是顺带测业务逻辑。
//
//   docker build -f qi/docker/Dockerfile \
//     --build-arg APP=qi/docker/示例/健康页.qi \
//     --build-arg PACKAGES=qi_packages \
//     -t qi-hello .
//   docker run --rm -p 47901:47901 qi-hello
包 主程序;

导入 Web::{应用, 上下文, 响应, 创建应用, 配置, 运行应用, 获取, 文本, JSON};
导入 标准库.HTTP 作为 网;
导入 标准库.进程 作为 进程;
导入 标准库.字符串;
导入 标准库.操作系统 作为 系统;
导入 标准库.输入输出 作为 IO;

函数 取或默认(键: 字符串, 默认值: 字符串) : 字符串 {
    变量 设的: 字符串 = 系统.获取环境变量(键);
    如果 (字符串::字节长度(设的) > 0) { 返回 设的; }
    返回 默认值;
}

函数 首页(上下文值: 上下文) : 响应 {
    返回 文本("qi 在容器里跑着呢\n");
}

// 健康检查：容器编排（compose/k8s）靠它判断要不要把流量切过来。
// 返回 JSON 而不是纯文本，方便探针顺带看一眼版本。
函数 健康(上下文值: 上下文) : 响应 {
    返回 JSON("{\"ok\":true,\"who\":\"qi-docker-demo\"}");
}

// 自带探针：`app --探活` 打自己的健康端点，通了退 0、不通退 1。
//
// **健康检查不该依赖运行层装工具**：运行层里没有 curl（也不该有），
// compose/k8s 的 `test: ["CMD","curl",...]` 会一直报
// `executable file not found`，容器于是永远 unhealthy —— 而应用其实好好的。
// 让二进制自己带探针，运行层就能保持最小。
函数 探活() : 整数 {
    变量 地址: 字符串 = "http://127.0.0.1:" + 取或默认("PORT", "47901") + "/健康";
    变量 回: 字符串 = 网.获取(地址);
    如果 (字符串::包含(回, "\"ok\":true") == 1) {
        返回 0;
    }
    IO.打印行("探活失败: " + 回);
    返回 1;
}

函数 入口() {
    // 带 --探活 就当探针跑，不起服务
    如果 (字符串::字节长度(系统.获取环境变量("QI_HEALTHCHECK")) > 0) {
        进程.退出(探活());
        返回;
    }

    // **必须听 0.0.0.0**：容器里听 127.0.0.1 的话，端口映射过去也连不上 ——
    // 这是容器化最常见的一个坑，表现是「docker run 起来了但访问不了」。
    变量 主机: 字符串 = 取或默认("HOST", "0.0.0.0");
    变量 端口: 整数 = 字符串转整数(取或默认("PORT", "47901"));

    变量 应用值: 应用 = 配置(创建应用(), 主机, 端口);
    应用值 = 获取(应用值, "/", 首页);
    应用值 = 获取(应用值, "/健康", 健康);
    IO.打印行("听在 " + 主机 + ":" + 整数转字符串(端口));
    运行应用(应用值);
}
