包 主程序;

函数 阶乘(n: 整数) : 整数 {
    如果 (n <= 1) { 返回 1; }
    返回 n * 阶乘(n - 1);
}

函数 入口() {
    打印行("你好，世界");
    变量 a: 整数 = 7;
    变量 b: 整数 = 6;
    打印行("7*6 = " + 整数转字符串(a * b));
    变量 名: 字符串 = "奇";
    打印行("拼接：" + 名 + "语言");
    如果 (a > b) { 打印行("a 大"); } 否则 { 打印行("b 大"); }
    变量 i: 整数 = 0;
    当 (i < 3) {
        打印行("循环 " + 整数转字符串(i));
        i = i + 1;
    }
    打印行("5! = " + 整数转字符串(阶乘(5)));
}
