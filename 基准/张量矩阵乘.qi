包 主程序;

导入 标准库.时间;
导入 标准库.张量;

// 标准库.张量 的 f32 矩阵乘吞吐：n×n · n×n，报每次耗时与 GFLOP/s（2n³ 次浮点运算）。
// 后端看第一行；QI_TENSOR_BACKEND=rust 强制纯 Rust（matrixmultiply）。
// 对照：同目录 矩阵乘.qi（手写 i-k-j 三重循环，f64）、matmul_np.py（NumPy）。

函数 测(n: 整数, 次数: 整数) {
    变量 甲: 整数 = 张量.随机均匀(n, n, 0.0 - 1.0, 1.0, 1);
    变量 乙: 整数 = 张量.随机均匀(n, n, 0.0 - 1.0, 1.0, 2);
    // 预热：第一次会 dlopen 后端、起线程
    张量.释放(张量.矩阵乘(甲, 乙));
    // 报平均与最快一组：分 20 组计时，取最快一组的每次耗时。机器忙时平均值受调度干扰大，
    // 最快一组更接近实际能力；小矩阵一次不到 1 微秒，按组计时才量得准。
    变量 每组: 整数 = 次数 / 20;
    变量 最快: 整数 = 1000000000000;
    变量 开始: 整数 = 时间.现在纳秒();
    对于 g 在 0 直到 20 {
        变量 t0: 整数 = 时间.现在纳秒();
        对于 r 在 0 直到 每组 {
            张量.释放(张量.矩阵乘(甲, 乙));
        }
        变量 用时: 整数 = 时间.现在纳秒() - t0;
        如果 (用时 < 最快) { 最快 = 用时; }
    }
    变量 纳秒: 整数 = 时间.现在纳秒() - 开始;
    次数 = 每组 * 20;
    最快 = 最快 / 每组;
    变量 运算: 浮点数 = 2.0 * 整数转浮点数(n) * 整数转浮点数(n) * 整数转浮点数(n);
    变量 平均吞吐: 浮点数 = 运算 * 整数转浮点数(次数) / 整数转浮点数(纳秒);
    变量 最快吞吐: 浮点数 = 运算 / 整数转浮点数(最快);
    打印行("n=${n} 平均 ${纳秒 / 次数 / 1000} 微秒 ${浮点数转整数(平均吞吐)} GFLOP/s | 最快 ${最快 / 1000} 微秒 ${浮点数转整数(最快吞吐)} GFLOP/s");
    张量.释放(甲);
    张量.释放(乙);
}

函数 入口() {
    打印行("后端 ${张量.后端()}");
    测(64, 20000);
    测(128, 4000);
    测(256, 500);
    测(512, 100);
    测(1024, 20);
}
