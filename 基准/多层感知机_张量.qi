包 主程序;
导入 标准库.数学;
导入 标准库.时间;
导入 标准库.环境;
导入 标准库.张量;

// 与 多层感知机.qi 同一个任务：64 → 128(ReLU) → 10，softmax 交叉熵；同一份 LCG 数据与初始化。
// 区别：小批量 SGD（批大小 批），矩阵运算交给 标准库.张量（f32）。
// 学习率按线性缩放规则取 逐样本学习率 × 批（梯度是批内平均）。
// 环境变量 BATCH / EPOCHS 可改批大小与轮数，默认 32、5。

函数 随机(状态: 数组<整数>) : 浮点数 {
    状态[0] = (状态[0] * 1103515245 + 12345) % 2147483648;
    返回 整数转浮点数(状态[0]) / 2147483648.0;
}

函数 入口() {
    变量 样本数: 整数 = 2000;
    变量 输入维: 整数 = 64;
    变量 隐藏维: 整数 = 128;
    变量 类别数: 整数 = 10;
    变量 批: 整数 = 32;
    变量 轮数: 整数 = 5;
    变量 批设定: 字符串 = 环境.获取("BATCH");
    如果 (批设定 != "") { 批 = 字符串转整数(批设定); }
    变量 轮设定: 字符串 = 环境.获取("EPOCHS");
    如果 (轮设定 != "") { 轮数 = 字符串转整数(轮设定); }
    // 解析失败得 0：批为 0 时下面的 当 循环永远走不完
    如果 (批 < 1) { 批 = 32; }
    变量 学习率: 浮点数 = 0.01 * 整数转浮点数(批);
    变量 状态: 数组<整数> = 数组<整数>(1);
    状态[0] = 42;

    // ── 数据与初始化：逐个随机数的顺序与 多层感知机.qi 完全相同 ──
    变量 老师: 数组<浮点数> = 数组<浮点数>(类别数 * 输入维);
    对于 i 在 0 直到 类别数 * 输入维 { 老师[i] = 随机(状态) * 2.0 - 1.0; }
    变量 输入: 数组<浮点数> = 数组<浮点数>(样本数 * 输入维);
    变量 标签: 数组<整数> = 数组<整数>(样本数);
    对于 n 在 0 直到 样本数 {
        对于 j 在 0 直到 输入维 { 输入[n * 输入维 + j] = 随机(状态) * 2.0 - 1.0; }
        变量 最好: 整数 = 0;
        变量 最高: 浮点数 = 0.0 - 1000000000.0;
        对于 c 在 0 直到 类别数 {
            变量 和: 浮点数 = 0.0;
            对于 j 在 0 直到 输入维 { 和 = 和 + 老师[c * 输入维 + j] * 输入[n * 输入维 + j]; }
            如果 (和 > 最高) { 最高 = 和; 最好 = c; }
        }
        标签[n] = 最好;
    }
    变量 权1初值: 数组<浮点数> = 数组<浮点数>(隐藏维 * 输入维);
    对于 i 在 0 直到 隐藏维 * 输入维 { 权1初值[i] = (随机(状态) * 2.0 - 1.0) * 0.1; }
    变量 权2初值: 数组<浮点数> = 数组<浮点数>(类别数 * 隐藏维);
    对于 i 在 0 直到 类别数 * 隐藏维 { 权2初值[i] = (随机(状态) * 2.0 - 1.0) * 0.1; }

    变量 开始: 整数 = 时间.现在纳秒();
    变量 X: 整数 = 张量.从数组(输入, 样本数, 输入维);
    变量 权1: 整数 = 张量.从数组(权1初值, 隐藏维, 输入维);   // 隐藏维×输入维，与原版同布局
    变量 权2: 整数 = 张量.从数组(权2初值, 类别数, 隐藏维);
    变量 偏1: 整数 = 张量.全零(1, 隐藏维);
    变量 偏2: 整数 = 张量.全零(1, 类别数);

    对于 轮 在 0 直到 轮数 {
        变量 总损失: 浮点数 = 0.0;
        变量 起: 整数 = 0;
        当 (起 < 样本数) {
            变量 本批: 整数 = 样本数 - 起;
            如果 (本批 > 批) { 本批 = 批; }
            变量 批标签: 数组<整数> = 数组<整数>(本批);
            对于 i 在 0 直到 本批 { 批标签[i] = 标签[起 + i]; }
            变量 x: 整数 = 张量.切行(X, 起, 本批);
            // 前向
            变量 线1: 整数 = 张量.乘转置(x, 权1);          // 本批×隐藏维
            变量 前: 整数 = 张量.加偏置(线1, 偏1);
            变量 隐: 整数 = 张量.ReLU(前);
            变量 线2: 整数 = 张量.乘转置(隐, 权2);         // 本批×类别数
            变量 出: 整数 = 张量.加偏置(线2, 偏2);
            变量 概率: 整数 = 张量.按行softmax(出);
            总损失 = 总损失 + 张量.交叉熵(概率, 批标签) * 整数转浮点数(本批);
            // 反向
            变量 梯出: 整数 = 张量.交叉熵梯度(概率, 批标签);  // (p - 独热)/本批
            变量 梯权2: 整数 = 张量.转置乘(梯出, 隐);        // 类别数×隐藏维
            变量 梯偏2: 整数 = 张量.按列求和(梯出);
            变量 梯隐: 整数 = 张量.矩阵乘(梯出, 权2);        // 本批×隐藏维
            变量 梯前: 整数 = 张量.ReLU反传(梯隐, 前);
            变量 梯权1: 整数 = 张量.转置乘(梯前, x);         // 隐藏维×输入维
            变量 梯偏1: 整数 = 张量.按列求和(梯前);
            张量.加缩放(权2, 梯权2, 0.0 - 学习率);
            张量.加缩放(偏2, 梯偏2, 0.0 - 学习率);
            张量.加缩放(权1, 梯权1, 0.0 - 学习率);
            张量.加缩放(偏1, 梯偏1, 0.0 - 学习率);
            张量.释放(x); 张量.释放(线1); 张量.释放(前); 张量.释放(隐);
            张量.释放(线2); 张量.释放(出); 张量.释放(概率); 张量.释放(梯出);
            张量.释放(梯权2); 张量.释放(梯偏2); 张量.释放(梯隐); 张量.释放(梯前);
            张量.释放(梯权1); 张量.释放(梯偏1);
            起 = 起 + 本批;
        }
        变量 平均: 浮点数 = 总损失 / 整数转浮点数(样本数);
        变量 刻度: 整数 = 浮点数转整数(数学.四舍五入(平均 * 1000000.0));
        打印行("epoch ${轮 + 1} loss ${刻度}");
    }

    变量 线1全: 整数 = 张量.乘转置(X, 权1);
    变量 前全: 整数 = 张量.加偏置(线1全, 偏1);
    变量 隐全: 整数 = 张量.ReLU(前全);
    变量 线2全: 整数 = 张量.乘转置(隐全, 权2);
    变量 出全: 整数 = 张量.加偏置(线2全, 偏2);
    变量 预测: 数组<整数> = 张量.按行最大下标(出全);
    张量.释放(线1全); 张量.释放(前全); 张量.释放(隐全); 张量.释放(线2全); 张量.释放(出全);
    张量.释放(X); 张量.释放(权1); 张量.释放(权2); 张量.释放(偏1); 张量.释放(偏2);
    变量 对: 整数 = 0;
    对于 n 在 0 直到 样本数 {
        如果 (预测[n] == 标签[n]) { 对 = 对 + 1; }
    }
    变量 毫秒: 整数 = (时间.现在纳秒() - 开始) / 1000000;
    打印行("acc ${对}/${样本数}");
    打印行("批 ${批} 轮 ${轮数} 训练+评估 ${毫秒} ms 存活张量 ${张量.存活数()}");
}
